second-wind-cinematic/**/guides/**/*.exr
second-wind-cinematic/**/guides/**/*.gif
second-wind-cinematic/**/guides/**/*.mp4
second-wind-cinematic/**/guides/**/*.mov
second-wind-cinematic/**/guides/**/*.glb
second-wind-cinematic/**/guides/**/*.blend
second-wind-cinematic/**/*.blend
second-wind-cinematic/**/*.blend1
second-wind-cinematic/corvus-approach/layers/*.png
second-wind-cinematic/nessas-yard/layers/*.png
second-wind-cinematic/road-and-port/cards/*.png
second-wind-cinematic/corvus-approach/assets/traffic-lane-v1-*.png
