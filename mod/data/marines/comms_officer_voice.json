{
	# Comms officer mood framing — prefix and suffix lines that wrap the
	# archetype-driven briefing prose. The same patron meeting reads
	# differently depending on the officer's current mood (which is
	# itself a function of the company's state — see OfficerMoodReader).
	#
	# Composition shape (per-briefing):
	#   "<prefix>" + " " + "<archetype briefing variant>" + " " + "<suffix>"
	#
	# Suffix is rolled in deterministically per contract; not every
	# briefing carries one (see BriefingComposer for the probability and
	# seeding). Prefix is always present.
	#
	# Summary lines are a SEPARATE surface — the officer's header line
	# displayed above the dossier stack on the mission-select screen.
	# Two sub-pools per mood:
	#   "overview" — no client selected; references total / lapsing counts
	#   "client"   — a client is selected; references that patron + counts
	#
	# Schema:
	#   {
	#     "moods": {
	#       "<MOOD_NAME>": {
	#         "prefix":  ["...", ...],
	#         "suffix":  ["...", ...],
	#         "summary": {
	#           "overview": ["...", ...],
	#           "client":   ["...", ...]
	#         }
	#       }
	#     }
	#   }
	#
	# - Every OfficerMood enum value MUST appear as a key.
	# - Each mood MUST have at least one prefix, one suffix, one overview
	#   summary, and one client summary variant.
	# - prefix/suffix lines should be MOOD-PURE and NOT reference any
	#   specific patron, archetype, or contract — that's what the wrapped
	#   briefing body carries.
	# - Summary lines reference COUNTS + the selected patron only; never
	#   specific mission names or per-contract details (those are dossier
	#   content, not summary content).
	#
	# Summary substitution tokens:
	#   overview: {offerCount}, {clientCount}, {lapsingCount}
	#   client:   {patron}, {offerCount}, {lapsingCount}
	#
	# Voice notes per mood:
	#   DESPERATE — books are bleeding, no runway; officer urges acceptance,
	#               negotiating leverage we don't have
	#   GREEN     — new officer or new company; earnest, over-explains,
	#               aware they're missing context they should have
	#   STEADY    — default working state; terse, businesslike, no editorial
	#   SEASONED  — experienced, reads the room, editorializes with weight,
	#               calls out what an inexperienced officer would miss

	"moods": {
		"DESPERATE": {
			"prefix": [
				"Captain. We need to take something. Anything.",
				"Hate to say it, but we can't afford to be choosy this month.",
				"Books are bleeding. Walk-ins are walk-ins. Here:",
				"Look — we don't have the runway to turn this down without a real reason.",
				"Captain. Brought this one in personally — we need the work."
			],
			"suffix": [
				"We need this one.",
				"I'd take it if I were you.",
				"We're not in a position to push back on terms.",
				"Not the time to be picky.",
				"Tell me to chase it. Please."
			],
			"summary": {
				"overview": [
					"Books are bleeding, captain. {offerCount} pending — we need to take some of them.",
					"{offerCount} on the board across {clientCount} clients. Can't sit on these.",
					"Money's tight. {offerCount} clients waiting. Pick something.",
					"{offerCount} pending. {lapsingCount} of them about to lapse — let's not waste options."
				],
				"client": [
					"{patron} has {offerCount} pending. We need this work.",
					"{patron} again — {offerCount} on the table. Not a time to be picky.",
					"{patron}'s offers are on the console. {offerCount} of them. I'd say yes.",
					"{patron} brought {offerCount} our way. {lapsingCount} won't keep — focus there."
				]
			}
		},

		"GREEN": {
			"prefix": [
				"Captain. Got a new file for you.",
				"Another one came in — want me to run through it?",
				"Trying to keep these straight. Bear with me on the details.",
				"Captain — hope I caught everything important in the meeting.",
				"New contract, fresh off the meeting. I think I got the gist."
			],
			"suffix": [
				"Hope that's enough. Wasn't sure what else to ask.",
				"Let me know if I should follow up on anything.",
				"I think that's everything. I hope.",
				"Sorry if I missed something obvious — still learning the shorthand.",
				"Want me to set up a follow-up call to confirm anything?"
			],
			"summary": {
				"overview": [
					"{offerCount} contracts in. Want me to walk through them?",
					"Got {offerCount} pending across {clientCount} clients. Hope that's manageable.",
					"{offerCount} on the board. Let me know which to detail.",
					"{offerCount} pending — {lapsingCount} running short, I think? Double-check me."
				],
				"client": [
					"{patron} has {offerCount} on the table. I'll walk through each.",
					"{offerCount} pending from {patron}. Trying to keep them straight — bear with me.",
					"Got {offerCount} from {patron}. I think I caught everything important.",
					"{patron} sent {offerCount}. {lapsingCount} of them are getting tight — I think."
				]
			}
		},

		"STEADY": {
			"prefix": [
				"Captain. Got a new file in.",
				"Brought you this one — read it and let me know.",
				"Captain. New contract on the console.",
				"Got a fresh one for the board.",
				"Captain — file's ready when you are."
			],
			"suffix": [
				"Up to you.",
				"Standard stuff.",
				"Let me know what you decide.",
				"Flag me if you want a follow-up.",
				"Filed under the usual."
			],
			"summary": {
				"overview": [
					"{offerCount} pending. Ready when you are.",
					"{offerCount} on the board across {clientCount} clients. Standard load.",
					"Got {offerCount} for you to look over.",
					"{offerCount} pending. {lapsingCount} on a clock."
				],
				"client": [
					"{patron} — {offerCount} pending.",
					"{offerCount} from {patron}. Take a look.",
					"{patron}'s board: {offerCount} contracts open.",
					"{patron} — {offerCount} on the table, {lapsingCount} running short."
				]
			}
		},

		"SEASONED": {
			"prefix": [
				"Captain. You're going to want to sit down for this one.",
				"Got something. Worth a look, even if you pass.",
				"I've seen this shape before. Worth your time.",
				"Captain — brought this one in. Read it carefully.",
				"This one's got a tell. Hear me out."
			],
			"suffix": [
				"I'd push back on the timeline if we accept.",
				"Smells right. Smells wrong. Hard to say.",
				"We've worked with worse. We've worked with better.",
				"My read: take it, but eyes open.",
				"If we take it, I'd want our best captain on it."
			],
			"summary": {
				"overview": [
					"{offerCount} pending. A couple worth your time.",
					"Got {offerCount} for you. {lapsingCount} running short — those first.",
					"{offerCount} on the console. {clientCount} clients, mixed quality.",
					"{offerCount} pending. Half are noise. I've sorted the good ones to the top."
				],
				"client": [
					"{patron} — {offerCount} on the table. Worth a read.",
					"{patron}'s got {offerCount} for us. {lapsingCount} of them won't keep.",
					"{offerCount} pending from {patron}. I've got opinions on most of them.",
					"{patron} again — {offerCount} this time. Two patterns I'd flag."
				]
			}
		}
	},

	# Returning-patron callbacks. These lines are outcome-pure: they may
	# acknowledge only the terminal contract snapshot persisted by
	# PatronEngagementMemory. Supported tokens are {patron}, {contract}, and
	# {priorCount}, and {engagementNumber}.
	"memory": {
		"COMPLETED": [
			"{patron}'s people again. Last {contract} closed cleanly.",
			"We've worked for {patron} before. They remember the result.",
			"{patron} came back. Our last job for them ended well.",
			"This would be engagement {engagementNumber} with {patron}. The previous one held up."
		],
		"FAILED": [
			"{patron}'s people again. Last {contract} ended badly; expect less patience.",
			"We've got history with {patron}, and the last result wasn't good.",
			"{patron} came back despite the last failure. I wouldn't waste that.",
			"This would be engagement {engagementNumber} with {patron}. We're still carrying the last miss."
		],
		"WITHDREW": [
			"{patron} came back despite our withdrawal. Don't assume they forgot.",
			"We've walked away from {patron}'s work before. They're offering again.",
			"{patron}'s people know we withdrew from the last {contract}. Read the terms closely.",
			"This would be engagement {engagementNumber} with {patron}. The last one ended by our choice."
		],
		"EMPLOYER_BREACHED": [
			"{patron}'s name again. Their side broke terms last time.",
			"We've worked for {patron} before. Payment failed on their end.",
			"{patron} is back after the last breach. I checked the terms twice.",
			"This would be engagement {engagementNumber} with {patron}. Remember who broke the last agreement."
		]
	},

	# Two-engagement factual patterns. Supported tokens add
	# {previousContract}, {previousOutcome}, {latestContract}, and
	# {latestOutcome} to the single-memory token set above.
	"continuity": {
		"SUCCESS_STREAK": [
			"{patron} again. The last two jobs — {previousContract}, then {latestContract} — both closed cleanly.",
			"We've delivered twice running for {patron}. The newest was the {latestContract}.",
			"This would be engagement {engagementNumber} with {patron}. Two good results behind us.",
			"Our last two files with {patron} both ended in completion. That's the pattern on record."
		],
		"RECOVERY": [
			"{patron} again. The last {latestContract} ended well after the job before it did not.",
			"Our newest result for {patron} was a completion. The prior file ended in {previousOutcome}.",
			"The record with {patron} improved last time: {previousOutcome}, then completion.",
			"This would be engagement {engagementNumber} with {patron}. We recovered on the most recent one."
		],
		"PLAYER_SETBACK": [
			"We had a clean result with {patron}, then the last {latestContract} ended in {latestOutcome}.",
			"{patron}'s back. Our record went from completion to {latestOutcome} on the last two files.",
			"The last two with {patron}: one completion, then one {latestOutcome}. Keep that sequence in mind.",
			"This would be engagement {engagementNumber} with {patron}. The newest result followed a good one."
		],
		"REPEATED_PLAYER_TROUBLE": [
			"{patron} again. Our last two files ended in {previousOutcome} and {latestOutcome}.",
			"We've had two rough results running with {patron}: {previousOutcome}, then {latestOutcome}.",
			"The last two jobs for {patron} both ended on our side of the ledger, neither cleanly.",
			"This would be engagement {engagementNumber} with {patron}. The last two did not end in completion."
		],
		"BREACH_AFTER_SUCCESS": [
			"We delivered for {patron}, then their side broke terms on the last {latestContract}.",
			"{patron}'s record with us went from completion to employer breach. I checked this file twice.",
			"The last two with {patron}: a clean result, then broken terms on their side.",
			"This would be engagement {engagementNumber} with {patron}. Their latest breach followed our completion."
		],
		"REPEATED_PATRON_BREACH": [
			"{patron} again. Their side broke terms on each of the last two jobs.",
			"Two employer breaches running with {patron}. That's not an inference; it's the file.",
			"The last two agreements with {patron} both failed on their side.",
			"This would be engagement {engagementNumber} with {patron}. They've breached twice already."
		],
		"MUTUAL_TROUBLE": [
			"Our last two files with {patron} cut both ways: trouble on our side once, broken terms on theirs once.",
			"{patron} again. Across the last two jobs, each side owns one bad ending.",
			"The recent record with {patron} includes one employer breach and one player-side miss.",
			"This would be engagement {engagementNumber} with {patron}. The last two had problems on both sides."
		]
	},

	# First-time-patron local context, sourced from one recent engagement with
	# a different house at the same market. Supported tokens are {otherPatron},
	# {otherContract}, {otherOutcome}, {daysAgo}, and the formatted {age}.
	"localEcho": {
		"COMPLETED": [
			"Local context: our last file here was {otherPatron}'s {otherContract}. It ended in completion.",
			"We've worked another local account recently: {otherPatron}, {otherContract}, clean result.",
			"The recent local ledger includes a completed {otherContract} for {otherPatron}.",
			"Different client, same market: we closed a {otherContract} for {otherPatron} {age}."
		],
		"FAILED": [
			"Local context: our last file here was {otherPatron}'s {otherContract}. It ended in failure.",
			"We've worked another local account recently: {otherPatron}, {otherContract}, failed result.",
			"The recent local ledger includes a failed {otherContract} for {otherPatron}.",
			"Different client, same market: our {otherContract} for {otherPatron} failed {age}."
		],
		"WITHDREW": [
			"Local context: our last file here was {otherPatron}'s {otherContract}. We withdrew.",
			"We've worked another local account recently: {otherPatron}. We withdrew from their {otherContract}.",
			"The recent local ledger records our withdrawal from a {otherContract} for {otherPatron}.",
			"Different client, same market: we left {otherPatron}'s {otherContract} {age}."
		],
		"EMPLOYER_BREACHED": [
			"Local context: our last file here was {otherPatron}'s {otherContract}. Their side broke terms.",
			"We've worked another local account recently: {otherPatron}. Their {otherContract} ended in employer breach.",
			"The recent local ledger records broken terms on {otherPatron}'s side of a {otherContract}.",
			"Different client, same market: {otherPatron} broke terms on a {otherContract} {age}."
		]
	},

	# Confirmed Chronicle facts linked directly to the current patron. These
	# callbacks never interpret why the fact matters to the offered contract.
	# Supported tokens are {patron}, {otherHouse}, {chronicleOutcome},
	# {daysAgo}, and the formatted {age}.
	"chronicleReference": {
		"CHAIN_ACTOR": [
			"Chronicle note: {patron}'s move against {otherHouse} was recorded as {chronicleOutcome} {age}.",
			"The Chronicle closed {patron}'s campaign against {otherHouse} as {chronicleOutcome}.",
			"One confirmed item on {patron}: their action against {otherHouse} ended {chronicleOutcome} {age}.",
			"The file cross-references a Chronicle entry — {patron} against {otherHouse}, {chronicleOutcome}."
		],
		"CHAIN_TARGET": [
			"Chronicle note: {otherHouse}'s move against {patron} was recorded as {chronicleOutcome} {age}.",
			"The Chronicle closed {otherHouse}'s campaign against {patron} as {chronicleOutcome}.",
			"One confirmed item on {patron}: {otherHouse}'s action against them ended {chronicleOutcome} {age}.",
			"The file cross-references a Chronicle entry — {otherHouse} against {patron}, {chronicleOutcome}."
		],
		"THRONE_CLAIMANT": [
			"Chronicle note: {patron} displaced {otherHouse} in a confirmed faction transfer {age}.",
			"The Chronicle records {patron}'s accession over {otherHouse}.",
			"One confirmed item on {patron}: they displaced {otherHouse} {age}.",
			"The file cross-references the faction transfer from {otherHouse} to {patron}."
		],
		"THRONE_DISPLACED": [
			"Chronicle note: {otherHouse} displaced {patron} in a confirmed faction transfer {age}.",
			"The Chronicle records {otherHouse}'s accession over {patron}.",
			"One confirmed item on {patron}: {otherHouse} displaced them {age}.",
			"The file cross-references the faction transfer from {patron} to {otherHouse}."
		],
		"TESTAMENT_CLAIMANT": [
			"Chronicle note: a testament from {otherHouse} followed {patron}'s accession {age}.",
