			"One confirmed item on {patron}: their accession was followed by {otherHouse}'s testament.",
			"The file cross-references the testament sealed after {patron} displaced {otherHouse}."
		],
		"TESTAMENT_DEPOSED": [
			"Chronicle note: {patron}'s testament followed {otherHouse}'s accession {age}.",
			"The Chronicle records {patron}'s testament after {otherHouse} took power.",
			"One confirmed item on {patron}: their displacement was followed by a sealed testament.",
			"The file cross-references the testament sealed after {otherHouse} displaced {patron}."
		]
	}
}
