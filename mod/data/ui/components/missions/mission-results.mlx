<template props="salvageClasses,salvageTurns,salvageReplay,salvageStop,sceneClasses,sceneImage,sceneCaption,storyClasses,storyPortrait,storySender,storyProgress,storyMessage,title,outcomeClasses,outcomeLabel,missionName,missionMeta,resultRows,personnelHeader,squadRows,personnelEmpty,primaryLabel,primaryAction,secondaryClasses,secondaryLabel,secondaryAction">
  <div id="mission-results-root" class="mission-results-root">
    <div id="mission-results-header" class="mission-flow-header console-header">
      <img id="mission-results-header-lock" class="flow-header-lock" src="graphics/ui/console/locking-plate.svg" />
      <div id="mission-results-heading" class="mission-flow-heading">
        <div id="mission-results-title" class="label title tone-edge">{title}</div>
        <div id="mission-results-subtitle" class="label tone-muted">Operation settlement and personnel disposition</div>
      </div>
      <div id="mission-results-context" class="label heading tone-accent mission-flow-context">MISSION DEBRIEF</div>
    </div>
    <div id="mission-results-body" class="mission-results-body">
      <div id="mission-results-summary" class="console-section results-summary">
        <div id="mission-results-outcome" class="{outcomeClasses}">{outcomeLabel}</div>
        <div id="mission-results-name" class="label title results-mission-name">{missionName}</div>
        <div id="mission-results-meta" class="label tone-muted results-mission-meta">{missionMeta}</div>
        <div id="mission-results-story" class="{storyClasses}">
          <div id="story-dispatch-heading" class="story-dispatch-heading">
            <img id="story-dispatch-portrait" class="story-portrait" src="{storyPortrait}" />
            <div id="story-dispatch-sender" class="label heading story-sender">{storySender}</div>
          </div>
          <div id="story-dispatch-progress" class="label tone-good story-progress">{storyProgress}</div>
          <div id="story-dispatch-message" class="label story-message">{storyMessage}</div>
        </div>
        <div id="mission-results-rows" class="result-rows console-readout">
          <div each="row in resultRows" key="{row.id}" id="{row.id}" class="result-row">
            <div id="{row.labelId}" class="label heading tone-muted">{row.label}</div>
            <div id="{row.valueId}" class="{row.tone}">{row.value}</div>
          </div>
        </div>
      </div>
      <div id="mission-results-personnel" class="console-section results-personnel">
        <div id="salvage-conversation" class="{salvageClasses}">
          <div id="salvage-conversation-heading" class="salvage-heading">
            <div id="salvage-conversation-status" class="label heading tone-accent">RECOVERY AGREEMENT / TRANSCRIPT</div>
            <button id="salvage-replay" class="salvage-play console-action" onclick="{salvageReplay}">Replay</button>
            <button id="salvage-stop" class="salvage-play console-action" onclick="{salvageStop}">Stop</button>
          </div>
          <div id="salvage-turns" class="salvage-turns">
            <div each="turn in salvageTurns" key="{turn.id}" id="{turn.id}" class="salvage-turn">
              <img id="{turn.portraitId}" class="salvage-portrait" src="{turn.portrait}" />
              <div id="{turn.copyId}" class="salvage-copy">
                <div id="{turn.speakerId}" class="label heading tone-accent salvage-speaker">{turn.speaker}</div>
                <div id="{turn.textId}" class="label salvage-text">{turn.text}</div>
              </div>
            </div>
          </div>
        </div>
        <div id="mission-results-scene" class="{sceneClasses}">
          <img id="results-scene-image" class="results-scene-image" src="{sceneImage}" />
          <div id="results-scene-caption" class="label heading tone-muted scene-caption">{sceneCaption}</div>
        </div>
        <div id="mission-results-personnel-heading" class="personnel-heading surface-dark">
          <div id="mission-results-personnel-title" class="label heading tone-edge">{personnelHeader}</div>
          <div id="mission-results-personnel-subtitle" class="label tone-muted">Returned / wounded / missing / killed</div>
        </div>
        <div id="mission-results-squads" class="results-squad-grid">
          <div each="squad in squadRows" key="{squad.id}" id="{squad.id}" class="results-squad-card console-readout">
            <div id="{squad.topId}" class="results-squad-top">
              <div id="{squad.nameId}" class="label heading">{squad.name}</div>
              <div id="{squad.summaryId}" class="{squad.tone}">{squad.summary}</div>
            </div>
            <div id="{squad.membersId}" class="label tone-muted">{squad.members}</div>
          </div>
        </div>
        <div id="mission-results-personnel-empty" class="label tone-muted personnel-empty">{personnelEmpty}</div>
      </div>
    </div>
    <div id="mission-results-actions" class="mission-flow-actions console-section">
      <div id="mission-results-action-spacer" class="action-spacer"></div>
      <button id="mission-results-secondary" class="{secondaryClasses}" onclick="{secondaryAction}">{secondaryLabel}</button>
      <button id="mission-results-primary" class="good-surface console-action" onclick="{primaryAction}">{primaryLabel}</button>
    </div>
  </div>
</template>

<style>
  .mission-results-root { flex-direction: column; padding: 10px; gap: 8px; border-width: 2px; overflow: hidden; }
  .label { overflow: hidden; }
  .mission-flow-header { flex-direction: row; height: 58px; padding: 7px 10px; gap: 10px; border-width: 1px; }
  .mission-flow-heading { flex-direction: column; flex-grow: 1; gap: 4px; }
  .mission-flow-heading .title { height: 24px; }
  .mission-flow-context { width: 300px; padding: 11px 4px; text-align: right; }
  .mission-results-body { flex-direction: row; height: 0px; flex-grow: 1; gap: 8px; overflow: hidden; }
  .results-summary { flex-direction: column; width: 560px; padding: 12px; gap: 9px; border-width: 1px; overflow: hidden; }
  .results-outcome { height: 86px; padding: 22px 14px; border-width: 1px; font-family: title; }
  .results-outcome.victory { color: #78d494; background-color: #132b22; border-color: #78d494; }
  .results-outcome.defeat { color: #e98b83; background-color: #3d2a26; border-color: #e98b83; }
  .results-mission-name { height: 34px; padding: 4px; }
  .results-mission-meta { height: 24px; padding: 4px; }
  .result-rows { flex-direction: column; gap: 1px; padding: 6px; border-width: 1px; }
  .result-row { flex-direction: row; height: 49px; padding: 14px 8px; border-width: 1px; border-color: #263b51; }
  .result-row .heading { width: 185px; }
  .result-value { width: 0px; flex-grow: 1; text-align: right; }
  .results-personnel { flex-direction: column; width: 0px; flex-grow: 1; padding: 8px; gap: 7px; border-width: 1px; overflow: hidden; }
  .personnel-heading { flex-direction: row; height: 52px; padding: 10px; gap: 10px; border-width: 1px; }
  .personnel-heading .heading { width: 520px; }
  .personnel-heading .tone-muted { width: 0px; flex-grow: 1; text-align: right; }
  .results-squad-grid { display: grid; height: 0px; flex-grow: 1; gap: 7px; overflow: scroll; }
  .results-squad-card { flex-direction: column; width: 360px; height: 86px; padding: 10px; gap: 10px; border-width: 1px; border-color: #31485f; }
  .results-squad-top { flex-direction: row; height: 20px; }
  .results-squad-top .label { width: 0px; flex-grow: 1; }
  .results-squad-summary { width: 190px; text-align: right; }
  .personnel-empty { height: 22px; }
  .mission-flow-actions { flex-direction: row; height: 42px; padding: 4px; gap: 8px; border-width: 1px; }
  .mission-flow-actions button { width: 250px; padding: 7px; border-width: 1px; text-align: center; font-family: heading; }
  .action-spacer { width: 0px; flex-grow: 1; }
  .hidden { width: 0px; height: 0px; padding: 0px; border-width: 0px; opacity: 0; overflow: hidden; }
  .flow-header-lock { width: 32px; height: 38px; }
  .mission-flow-actions button { height: 32px; padding: 5px 10px; }
  .story-dispatch { flex-direction: column; height: 270px; padding: 9px; gap: 8px; border-width: 1px; }
  .story-dispatch-heading { flex-direction: row; height: 52px; gap: 12px; align-items: center; }
  .story-portrait { width: 52px; height: 52px; }
  .story-sender { width: 0px; flex-grow: 1; height: auto; white-space: normal; }
  .story-progress { height: auto; white-space: normal; }
  .story-message { height: auto; white-space: normal; }
  .results-summary { width: 470px; padding: 10px; gap: 7px; }
  .results-outcome { height: 62px; padding: 15px 12px; }
  .results-mission-name { height: 30px; }
  .result-rows { display: grid; width: 100%; height: 0px; flex-grow: 1; gap: 6px; padding: 7px; overflow: scroll; }
  .result-row { flex-direction: column; width: 195px; height: 84px; padding: 7px; gap: 6px; background-color: #182228; border-color: #46545e; }
  .result-row .heading { width: 100%; height: 18px; }
  .result-value { width: 100%; height: 42px; flex-grow: 0; text-align: left; white-space: normal; }
  .personnel-heading { height: 50px; padding: 9px; }
  .personnel-heading .heading { width: 360px; }
  .results-squad-card { width: 440px; height: 100px; padding: 9px; gap: 8px; }
  .results-squad-card .tone-muted { white-space: normal; height: 52px; }
  .results-squad-summary { width: 220px; }
  .results-scene { flex-direction: column; height: 426px; padding: 7px; gap: 6px; border-width: 2px; overflow: hidden; pointer-events: none; }
  .results-scene-image { width: 100%; height: 384px; }
  .scene-caption { height: 18px; }
  .salvage-conversation { flex-direction: column; height: 426px; padding: 10px; gap: 10px; border-width: 1px; }
  .salvage-heading { flex-direction: row; height: 30px; gap: 8px; align-items: center; }
  #salvage-conversation-status { width: 0px; flex-grow: 1; height: 20px; }
  .salvage-play { width: 76px; height: 24px; padding: 0px; text-align: center; }
  .salvage-turns { flex-direction: column; height: 0px; flex-grow: 1; gap: 8px; overflow: scroll; }
  .salvage-turn { flex-direction: row; height: 78px; gap: 12px; padding: 5px; background-color: #18201e; }
  .salvage-portrait { width: 68px; height: 68px; }
  .salvage-copy { flex-direction: column; width: 0px; flex-grow: 1; gap: 5px; }
  .salvage-speaker { height: 18px; }
  .salvage-text { height: 50px; white-space: normal; }
</style>
