<template props="commsText,commsProgress,commsSkipAction">
  <div id="mission-comms-dialog" class="comms-dialogue comms-hidden">
    <div id="mission-comms-transcript" class="comms-transcript">
      <div id="mission-comms-text" class="comms-text">{commsText}</div>
    </div>
    <div id="mission-comms-controls" class="comms-controls">
      <button id="mission-comms-skip" onclick="{commsSkipAction}">{i18n.briefingCommsSkip}</button>
      <div id="mission-comms-status" class="comms-progress">{commsProgress}</div>
    </div>
  </div>
</template>
<style>
  .comms-dialogue { height: 200px; flex-direction: column; gap: 12px; }
  .comms-transcript { height: 0px; flex-grow: 1; overflow: scroll; }
  .comms-text { height: auto; white-space: normal; color: #ffffff; }
  .comms-controls { height: 32px; flex-direction: row; gap: 8px; align-items: center; }
  .comms-controls button { width: 138px; height: 28px; padding: 2px 4px; text-align: center; font-family: heading; }
  .comms-progress { width: 0px; flex-grow: 1; height: auto; text-align: right; color: #a7b2a9; }
  .comms-hidden { display: none; }
</style>
