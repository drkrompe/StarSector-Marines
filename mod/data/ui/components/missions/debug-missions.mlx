<template props="places,sequence,cards,tab0,tab1,tab2,tabClass0,tabClass1,tabClass2,pageLabel,previous,next,previousDisabled,nextDisabled,launch,back,launchDisabled,ravOptionsDisabled,ravDensityLabel,ravBiomeLabel,ravSeedLabel,ravDensity,ravBiome,ravSeed,title,description,preset,image">
  <div id="debug-missions-root" class="debug-root">
    <div id="debug-node-1" class="debug-header console-header">
      <img id="debug-node-2" class="console-header-lock" src="graphics/ui/console/locking-plate.svg" />
      <div id="debug-node-3" class="debug-heading"><div id="debug-node-4" class="label title tone-edge">DEBUG / MISSION LAUNCHER</div><div id="debug-node-5" class="label tone-muted">All chapters unlocked / disposable forces / no campaign settlement</div></div>
      <div id="debug-back-rail" class="debug-back-rail console-command-rail">
        <button id="debug-back" onclick="{back}">
          <div id="debug-back-signal" class="console-command-signal" />
          <div id="debug-back-legend" class="console-key-legend">BACK</div>
          <img id="debug-back-grip" class="console-key-grip" src="graphics/ui/console/key-grip.svg" />
        </button>
      </div>
      <img id="debug-header-vent" class="console-header-vent" src="graphics/ui/console/vent-plate.svg" />
    </div>
    <div id="debug-node-6" class="debug-body">
      <div id="debug-node-7" class="debug-catalog panel">
        <div id="debug-node-8" class="debug-tabs console-command-rail">
          <button id="debug-node-9" class="{tabClass0}" onclick="{tab0}"><div id="debug-tab-lamp-0" class="console-toggle-lamp" /><div id="debug-tab-legend-0" class="console-key-legend">STORY + REPEATABLE</div></button>
          <button id="debug-node-10" class="{tabClass1}" onclick="{tab1}"><div id="debug-tab-lamp-1" class="console-toggle-lamp" /><div id="debug-tab-legend-1" class="console-key-legend">STANDARD OPERATIONS</div></button>
          <button id="debug-node-11" class="{tabClass2}" onclick="{tab2}"><div id="debug-tab-lamp-2" class="console-toggle-lamp" /><div id="debug-tab-legend-2" class="console-key-legend">DIAGNOSTICS</div></button>
        </div>
        <div id="debug-places" class="debug-places">
          <button each="place in places" key="{place.id}" id="{place.id}" class="{place.classes}" onclick="{place.action}">
            <div id="{place.globeWrapId}" class="{place.globeClasses}">
              <canvas id="{place.globeId}" class="debug-place-globe" width="48" height="48" />
              <div id="{place.unknownId}" class="{place.unknownClasses}">?</div>
            </div>
            <div id="{place.labelId}" class="label debug-place-label">{place.label}</div>
          </button>
        </div>
        <div id="debug-cards" class="debug-cards">
          <button each="card in cards" key="{card.id}" id="{card.id}" class="{card.classes}" onclick="{card.action}">
            <div id="{card.badgeId}" class="label title debug-card-badge">{card.badge}</div>
            <div id="{card.copyId}" class="debug-card-copy">
              <div id="{card.groupId}" class="label tone-muted">{card.group}</div>
              <div id="{card.titleId}" class="label heading debug-card-title">{card.title}</div>
              <div id="{card.forceId}" class="label tone-accent debug-card-force">{card.force}</div>
            </div>
          </button>
        </div>
        <div id="debug-node-15" class="debug-pages console-command-rail">
          <button id="debug-node-16" disabled="{previousDisabled}" onclick="{previous}">
            <img id="debug-previous-grip" class="console-key-grip" src="graphics/ui/console/key-grip.svg" />
            <div id="debug-previous-legend" class="console-key-legend">PREVIOUS</div>
          </button>
          <div id="debug-node-17" class="label tone-muted debug-page-label">{pageLabel}</div>
          <button id="debug-node-18" disabled="{nextDisabled}" onclick="{next}">
            <div id="debug-next-legend" class="console-key-legend">NEXT</div>
            <img id="debug-next-grip" class="console-key-grip" src="graphics/ui/console/key-grip.svg" />
          </button>
        </div>
      </div>
      <div id="debug-node-19" class="debug-detail panel">
        <div id="debug-scene-well" class="debug-scene-well console-well"><img id="debug-node-20" class="debug-scene" src="{image}" /></div>
        <div id="debug-node-21" class="label title debug-title">{title}</div>
        <div id="debug-sequence" class="label tone-accent debug-sequence">{sequence}</div>
        <div id="debug-node-22" class="debug-description"><div id="debug-node-23" class="label debug-copy">{description}</div></div>
        <div id="debug-node-24" class="debug-preset console-readout"><div id="debug-node-25" class="label heading tone-accent">DEFAULT FIELD FORCE</div><div id="debug-node-26" class="label debug-copy">{preset}</div><div id="debug-node-27" class="label tone-muted debug-copy">Fresh personnel and boats on every launch. Story missions use field security rifles and fatigues. Support Hounds carry the recovered chaingun fit.</div></div>
        <div id="debug-rav-options" class="debug-rav console-command-rail">
          <button id="debug-rav-density" disabled="{ravOptionsDisabled}" onclick="{ravDensity}"><div id="debug-rav-density-legend" class="console-key-legend">{ravDensityLabel}</div></button>
          <button id="debug-rav-biome" disabled="{ravOptionsDisabled}" onclick="{ravBiome}"><div id="debug-rav-biome-legend" class="console-key-legend">{ravBiomeLabel}</div></button>
          <button id="debug-rav-seed" disabled="{ravOptionsDisabled}" onclick="{ravSeed}"><div id="debug-rav-seed-legend" class="console-key-legend">{ravSeedLabel}</div></button>
        </div>
        <div id="debug-launch-rail" class="debug-launch-rail console-command-rail">
          <button id="debug-launch" class="good-surface" disabled="{launchDisabled}" onclick="{launch}">
            <div id="debug-launch-signal" class="console-command-signal" />
            <div id="debug-launch-legend" class="console-key-legend">BRIEF WITH DEFAULT LOADOUT</div>
            <img id="debug-launch-grip" class="console-key-grip" src="graphics/ui/console/key-grip.svg" />
          </button>
        </div>
        <div id="debug-node-28" class="label tone-muted debug-copy debug-footnote">Review the map and Deploy in the briefing. Developer overrides remain optional.</div>
      </div>
    </div>
  </div>
</template>
<style>
.debug-root { flex-direction: column; padding: 12px; gap: 10px; border-width: 2px; overflow: hidden; }
.debug-header { flex-direction: row; align-items: center; height: 72px; padding: 10px; gap: 12px; border-width: 2px; }
.debug-heading { flex-direction: column; flex-grow: 1; gap: 7px; }
.debug-heading .label { height: 24px; }
.debug-back-rail { flex-direction: row; width: 180px; height: 42px; padding: 3px; border-width: 2px; }
.debug-body { flex-direction: row; flex-grow: 1; gap: 12px; overflow: hidden; }
.debug-catalog { width: 58%; flex-direction: column; gap: 10px; padding: 12px; border-width: 1px; }
.debug-tabs { flex-direction: row; height: 44px; gap: 5px; padding: 4px; border-width: 2px; }
.debug-tab { flex-direction: row; align-items: center; width: 0px; flex-grow: 1; padding: 2px 12px; gap: 8px; border-width: 2px; }
.debug-places { flex-direction: row; height: 36px; gap: 6px; }
.debug-place { flex-direction: row; align-items: center; justify-content: center; width: 0px; flex-grow: 1; padding: 2px 6px; gap: 6px; border-width: 1px; }
.debug-place-globe-wrap { width: 26px; height: 26px; }
.debug-place-globe-wrap.hidden { display: none; }
.debug-place-globe { width: 26px; height: 26px; pointer-events: none; }
.debug-place-unknown { position: absolute; left: 0px; top: 0px; width: 26px; height: 26px; padding: 4px 0px; text-align: center; color: #edc273; pointer-events: none; }
.debug-place-unknown.hidden { display: none; }
.debug-place-label { height: 20px; pointer-events: none; }
.debug-cards { display: grid; flex-grow: 1; gap: 10px; padding: 1px; overflow: scroll; }
.debug-card { flex-direction: row; align-items: center; width: 46%; height: 96px; padding: 10px 12px; gap: 12px; border-width: 1px; text-align: left; }
.debug-card-badge { width: 54px; height: 54px; padding: 14px 2px; border-width: 1px; text-align: center; }
.debug-card-copy { flex-direction: column; width: 0px; flex-grow: 1; gap: 6px; overflow: hidden; }
.debug-card .label { height: 20px; }
.debug-card .debug-card-title { height: auto; min-height: 22px; white-space: normal; }
.type-assault .debug-card-badge { color: #e98b83; }
.type-sabotage .debug-card-badge { color: #ffd464; }
.type-raid .debug-card-badge { color: #c9a0f0; }
.type-extraction .debug-card-badge { color: #6ed7ff; }
.type-conquest .debug-card-badge { color: #ff7770; }
.debug-pages { flex-direction: row; align-items: center; height: 42px; gap: 10px; padding: 3px; border-width: 2px; }
.debug-pages button { flex-direction: row; align-items: center; width: 150px; height: 32px; padding: 2px 8px; gap: 6px; border-width: 3px; }
.debug-page-label { flex-grow: 1; text-align: center; }
.debug-detail { flex-direction: column; width: 0px; flex-grow: 1; padding: 14px; gap: 12px; border-width: 1px; }
.debug-scene-well { height: 236px; padding: 6px; border-width: 2px; overflow: hidden; }
.debug-scene { width: 100%; height: 220px; }
.debug-title { min-height: 32px; white-space: normal; }
.debug-sequence { min-height: 24px; white-space: normal; }
.debug-description { height: 0px; flex-grow: 1; overflow: scroll; }
.debug-copy { min-height: 24px; white-space: normal; }
.debug-preset { height: 150px; flex-direction: column; padding: 12px; gap: 10px; border-width: 2px; }
.debug-preset .heading { height: 22px; }
.debug-rav { flex-direction: row; height: 40px; gap: 5px; padding: 3px; border-width: 2px; }
.debug-rav button { flex-direction: row; align-items: center; width: 0px; flex-grow: 1; padding: 2px 6px; border-width: 2px; }
.debug-launch-rail { flex-direction: row; height: 52px; padding: 4px; border-width: 2px; }
.debug-launch-rail button, .debug-back-rail button { flex-direction: row; align-items: center; width: 0px; flex-grow: 1; padding: 2px 10px; gap: 8px; border-width: 3px; }
.debug-footnote { min-height: 20px; text-align: center; }
</style>
