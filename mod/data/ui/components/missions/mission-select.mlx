<template props="companyNewsClasses,companyNewsLabel,companyNewsAction,detailImageClasses,detailImage,brokerClasses,brokerPortrait,brokerName,brokerRole,brokerIntroduction,brokerProgress,screenTitle,locationLabel,planetImage,clientHeader,catalogHeader,detailHeader,clients,clientEmpty,missionHeader,missionSummary,missions,stationingRows,missionEmpty,detailClasses,detailKicker,detailTitle,detailMeta,detailFlavor,detailDialogue,detailDialogueStyle,detailFlavorStyle,detailRows,briefLabel,briefDisabled,briefAction,declineDisabled,declineAction,backAction,armoryAction">
  <div id="mission-select-root" class="mission-select-root">
    <div id="mission-select-header" class="mission-select-header console-header">
      <img id="mission-select-lock" class="console-header-lock" src="graphics/ui/console/locking-plate.svg" />
      <div id="mission-select-title-block" class="mission-select-title-block">
        <div id="mission-select-title" class="label title tone-edge">{screenTitle}</div>
        <div id="mission-select-location" class="label tone-muted">{locationLabel}</div>
      </div>
      <button id="mission-company-news" class="{companyNewsClasses}" onclick="{companyNewsAction}">{companyNewsLabel}</button>
      <div id="mission-select-purpose" class="label heading tone-accent">{i18n.missionSelectBoard}</div>
      <img id="mission-select-vent" class="console-header-vent" src="graphics/ui/console/vent-plate.svg" />
    </div>
    <div id="mission-select-body" class="mission-select-body">
      <div id="mission-client-panel" class="panel mission-client-panel">
        <div id="mission-client-header" class="label heading tone-edge section-heading console-section">{clientHeader}</div>
        <div id="mission-client-list" class="mission-client-list">
          <button each="client in clients" key="{client.id}" id="{client.id}" class="{client.classes}" disabled="{client.disabled}" onclick="{client.action}">
            <img id="{client.crestId}" class="client-crest" src="{client.crest}" />
            <div id="{client.copyId}" class="client-copy">
              <div id="{client.nameId}" class="label heading client-name">{client.name}</div>
              <div id="{client.repId}" class="label tone-muted client-reputation">{client.reputation}</div>
            </div>
          </button>
        </div>
        <div id="mission-client-empty" class="label tone-muted empty-copy">{clientEmpty}</div>
        <div id="mission-client-footer" class="mission-client-footer console-command-rail">
          <button id="mission-back" onclick="{backAction}">
            <div id="mission-back-signal" class="console-command-signal" />
            <div id="mission-back-legend" class="console-key-legend">{i18n.missionSelectBack}</div>
            <img id="mission-back-grip" class="console-key-grip" src="graphics/ui/console/key-grip.svg" />
          </button>
          <button id="mission-armory" onclick="{armoryAction}">
            <div id="mission-armory-signal" class="console-command-signal" />
            <div id="mission-armory-legend" class="console-key-legend">{i18n.missionSelectBarracks}</div>
            <img id="mission-armory-grip" class="console-key-grip" src="graphics/ui/console/key-grip.svg" />
          </button>
        </div>
      </div>
      <div id="mission-catalog-panel" class="panel mission-catalog-panel">
        <div id="mission-catalog-heading" class="catalog-heading surface-dark">
          <div id="mission-catalog-kicker" class="label heading tone-edge">{catalogHeader}</div>
          <div id="mission-catalog-title" class="label title">{missionHeader}</div>
          <div id="mission-catalog-summary" class="label tone-muted">{missionSummary}</div>
        </div>
        <div id="mission-broker-dossier" class="{brokerClasses}">
          <img id="mission-broker-portrait" class="broker-portrait" src="{brokerPortrait}" />
          <div id="mission-broker-copy" class="broker-copy">
            <div id="mission-broker-name" class="label heading">{brokerName}</div>
            <div id="mission-broker-role" class="label tone-accent broker-role">{brokerRole}</div>
            <div id="mission-broker-progress" class="label tone-good broker-progress">{brokerProgress}</div>
            <div id="mission-broker-introduction" class="label broker-introduction">{brokerIntroduction}</div>
          </div>
        </div>
        <div id="mission-list-empty" class="label tone-muted empty-copy">{missionEmpty}</div>
        <div id="mission-stationing-list" class="stationing-list">
          <button each="stationing in stationingRows" key="{stationing.id}" id="{stationing.id}" class="stationing-card good-surface" onclick="{stationing.action}">
            <div id="{stationing.titleId}" class="label heading">{stationing.title}</div>
            <div id="{stationing.actionId}" class="label tone-good stationing-action">{stationing.actionLabel}</div>
          </button>
        </div>
        <div id="mission-list" class="mission-list">
          <button each="mission in missions" key="{mission.id}" id="{mission.id}" class="{mission.classes}" onclick="{mission.action}">
            <div id="{mission.glyphId}" class="label title mission-glyph">{mission.glyph}</div>
            <div id="{mission.copyId}" class="mission-card-copy">
              <div id="{mission.titleId}" class="label heading mission-card-title">{mission.title}</div>
              <div id="{mission.metaId}" class="label tone-muted mission-card-meta">{mission.meta}</div>
            </div>
            <div id="{mission.payoutId}" class="label heading mission-card-payout">{mission.payout}</div>
          </button>
        </div>
      </div>
      <div id="mission-detail-panel" class="{detailClasses}">
        <div id="mission-detail-image-wrap" class="{detailImageClasses}">
          <div id="mission-detail-scope" class="mission-detail-scope console-well">
            <img id="mission-detail-reticle" class="mission-detail-reticle" src="graphics/ui/console/operation-scope.svg" />
            <img id="mission-detail-image" class="mission-detail-image" src="{detailImage}" />
          </div>
          <div id="mission-detail-image-label" class="label heading tone-edge">{detailHeader}</div>
        </div>
        <div id="mission-detail-copy" class="mission-detail-copy">
          <div id="mission-detail-kicker" class="label heading tone-accent">{detailKicker}</div>
          <div id="mission-detail-title" class="label title mission-detail-title">{detailTitle}</div>
          <div id="mission-detail-meta" class="label tone-muted mission-detail-meta">{detailMeta}</div>
          <div id="mission-detail-flavor" class="label mission-detail-flavor console-well" style="{detailFlavorStyle}">{detailFlavor}</div>
          <div id="mission-detail-dialogue" class="mission-detail-flavor console-well" style="{detailDialogueStyle}">
            <mission-dialogue turns="{detailDialogue}" />
          </div>
          <div id="mission-detail-rows" class="mission-detail-rows">
            <div each="row in detailRows" key="{row.id}" id="{row.id}" class="detail-row console-readout">
              <div id="{row.labelId}" class="label heading tone-muted detail-label">{row.label}</div>
              <div id="{row.valueId}" class="label detail-value">{row.value}</div>
            </div>
          </div>
        </div>
        <div id="mission-detail-actions" class="mission-detail-actions console-command-rail">
          <button id="mission-brief" class="mission-brief good-surface" disabled="{briefDisabled}" onclick="{briefAction}">
            <div id="mission-brief-signal" class="console-command-signal" />
            <div id="mission-brief-legend" class="console-key-legend">{briefLabel}</div>
            <img id="mission-brief-grip" class="console-key-grip" src="graphics/ui/console/key-grip.svg" />
          </button>
          <button id="mission-collapse" disabled="{declineDisabled}" onclick="{declineAction}">
            <div id="mission-collapse-signal" class="console-command-signal" />
            <div id="mission-collapse-legend" class="console-key-legend">{i18n.missionSelectCollapse}</div>
            <img id="mission-collapse-grip" class="console-key-grip" src="graphics/ui/console/key-grip.svg" />
          </button>
        </div>
      </div>
    </div>
  </div>
</template>

<style>
  .company-news { padding: 5px 10px; color: #ffd464; border-color: #aa8742; }
  .company-news.hidden { position: absolute; width: 0px; height: 0px; padding: 0px; border-width: 0px; opacity: 0; overflow: hidden; pointer-events: none; }
  .mission-select-root { flex-direction: column; padding: 10px; gap: 8px; border-width: 2px; overflow: hidden; }
  .label { overflow: hidden; }
  .mission-select-header { flex-direction: row; height: 58px; padding: 8px 10px; gap: 10px; border-width: 2px; }
  .mission-select-title-block { flex-direction: column; flex-grow: 1; gap: 4px; }
  #mission-select-title { height: 24px; }
  #mission-select-location { height: 18px; }
  #mission-select-purpose { width: 260px; padding: 10px 4px; text-align: right; }
  .mission-select-body { flex-direction: row; flex-grow: 1; gap: 8px; overflow: hidden; }
  .section-heading { height: 24px; padding: 4px 5px; }
  .mission-client-panel { flex-direction: column; width: 18%; padding: 8px; gap: 7px; border-width: 1px; overflow: hidden; }
  .mission-client-list { flex-direction: column; height: 0px; flex-grow: 1; gap: 5px; overflow: scroll; }
  .client-card { flex-direction: row; height: 74px; padding: 7px; gap: 8px; border-width: 1px; text-align: left; }

  .client-card.locked { opacity: 0.45; }
  .client-crest { width: 38px; height: 38px; }
  .client-copy { flex-direction: column; width: 0px; flex-grow: 1; gap: 5px; overflow: hidden; }
  .client-name { height: 32px; white-space: normal; }
  .client-reputation { height: 30px; white-space: normal; }
  .mission-client-footer { flex-direction: row; height: 32px; padding: 3px; gap: 4px; border-width: 2px; }
  .mission-client-footer button { flex-direction: row; align-items: center; width: 0px; flex-grow: 1; padding: 2px 4px; gap: 4px; border-width: 3px; text-align: center; font-family: heading; }
  .mission-catalog-panel { flex-direction: column; width: 37%; padding: 8px; gap: 7px; border-width: 1px; overflow: hidden; }
  .catalog-heading { flex-direction: column; height: 76px; padding: 8px; gap: 5px; border-width: 1px; }
  #mission-catalog-kicker { height: 16px; }
  #mission-catalog-title { height: 23px; }
  #mission-catalog-summary { height: 18px; }
  .broker-dossier { flex-direction: row; height: 150px; padding: 10px; gap: 12px; border-width: 1px; }
  .broker-hidden { width: 0px; height: 0px; padding: 0px; border-width: 0px; opacity: 0; overflow: hidden; pointer-events: none; }
  .broker-portrait { width: 96px; height: 96px; }
  .broker-copy { flex-direction: column; width: 0px; flex-grow: 1; gap: 8px; }
  .broker-progress { height: auto; white-space: normal; }
  .broker-role { height: auto; white-space: normal; }
  .broker-introduction { height: auto; white-space: normal; }
  .stationing-list { flex-direction: column; gap: 5px; }
  .stationing-card { flex-direction: row; height: 38px; padding: 8px; border-width: 1px; text-align: left; }
  .stationing-card .label { width: 0px; flex-grow: 1; }
  .stationing-action { text-align: right; }
  .mission-list { flex-direction: column; height: 0px; flex-grow: 1; gap: 6px; padding: 1px; overflow: scroll; }
  .mission-card { flex-direction: row; height: 76px; padding: 8px; gap: 9px; border-width: 1px; text-align: left; }

  .mission-glyph { width: 31px; height: 31px; padding: 4px; text-align: center; }
  .mission-card-copy { flex-direction: column; width: 0px; flex-grow: 1; gap: 6px; overflow: hidden; }
  .mission-card-title { height: 30px; white-space: normal; }
  .mission-card-meta { height: 30px; white-space: normal; }
  .mission-card-payout { width: 118px; height: 20px; padding: 3px; text-align: right; }
  .type-assault .mission-glyph { color: #e98b83; }
  .type-sabotage .mission-glyph { color: #ffd464; }
  .type-raid .mission-glyph { color: #c9a0f0; }
  .type-extraction .mission-glyph { color: #6ed7ff; }
  .type-conquest .mission-glyph { color: #ff7770; }
  .mission-detail { flex-direction: column; width: 0px; flex-grow: 1; padding: 8px; gap: 8px; border-width: 1px; overflow: hidden; }
  .mission-detail-image-wrap { flex-direction: column; height: 182px; padding: 7px; gap: 4px; border-width: 1px; overflow: hidden; }
  .mission-detail-scope { height: 140px; border-width: 2px; overflow: hidden; }
  .mission-detail-reticle { width: 100%; height: 140px; pointer-events: none; }
  .mission-detail-image { position: absolute; left: 0px; top: 0px; width: 100%; height: 140px; pointer-events: none; }
  #mission-detail-image-label { height: 18px; }
  .mission-detail-copy { flex-direction: column; height: 0px; flex-grow: 1; padding: 6px; gap: 8px; overflow: scroll; }
  #mission-detail-kicker { height: 18px; }
  .mission-detail-title { height: auto; white-space: normal; }
  .mission-detail-meta { height: auto; white-space: normal; }
  .mission-detail-flavor { height: auto; padding: 10px; border-width: 2px; white-space: normal; }
  .mission-detail-rows { flex-direction: column; gap: 4px; }
  .detail-row { flex-direction: column; height: 52px; padding: 8px; gap: 5px; border-width: 1px; }
  .detail-label { height: 16px; }
  .detail-value { height: 30px; white-space: normal; }
  .mission-detail-actions { flex-direction: row; height: 32px; padding: 3px; gap: 5px; border-width: 2px; }
  .mission-detail-actions button { flex-direction: row; align-items: center; width: 0px; flex-grow: 1; padding: 2px 5px; gap: 5px; border-width: 3px; font-family: heading; text-align: center; }
  .mission-detail-actions .mission-brief { flex-grow: 3; }
  .empty-copy { height: auto; padding: 4px; white-space: normal; }
  .story-location { height: 280px; }
  .story-location .mission-detail-scope { height: 248px; }
  .story-location .mission-detail-image { height: 248px; }
  .story-location .mission-detail-reticle { opacity: 0; }
</style>
