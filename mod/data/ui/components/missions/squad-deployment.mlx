<template props="title,missionName,missionMeta,readinessTone,readinessSummary,commandSummary,capacitySummary,reserveSummary,squadRows,emptyMessage,backAction,armoryAction">
  <div id="squad-deployment-root" class="squad-deployment-root">
    <div id="squad-deployment-header" class="mission-flow-header surface-dark">
      <div id="squad-deployment-heading" class="mission-flow-heading">
        <div id="squad-deployment-title" class="label title tone-edge">{title}</div>
        <div id="squad-deployment-mission" class="label tone-muted">{missionName}</div>
      </div>
      <div id="squad-deployment-context" class="label heading tone-accent mission-flow-context">PRE-BATTLE MUSTER</div>
    </div>
    <div id="squad-deployment-body" class="mission-flow-body">
      <div id="squad-deployment-summary" class="panel deployment-summary">
        <div id="squad-deployment-summary-heading" class="label heading tone-edge section-heading">FORCE ENVELOPE</div>
        <div id="squad-deployment-meta" class="label title deployment-mission">{missionMeta}</div>
        <div id="squad-deployment-ready-block" class="summary-block surface-dark">
          <div id="squad-deployment-ready-label" class="label heading tone-muted">READY PERSONNEL</div>
          <div id="squad-deployment-readiness" class="{readinessTone}">{readinessSummary}</div>
        </div>
        <div id="squad-deployment-command-block" class="summary-block surface-dark">
          <div id="squad-deployment-command-label" class="label heading tone-muted">TASK FORCE COMMAND</div>
          <div id="squad-deployment-command-value" class="label summary-value">{commandSummary}</div>
        </div>
        <div id="squad-deployment-capacity-block" class="summary-block surface-dark">
          <div id="squad-deployment-capacity-label" class="label heading tone-muted">LIFT CAPACITY</div>
          <div id="squad-deployment-capacity-value" class="label summary-value">{capacitySummary}</div>
        </div>
        <div id="squad-deployment-reserve-block" class="summary-block surface-dark">
          <div id="squad-deployment-reserve-label" class="label heading tone-muted">RESERVE POLICY</div>
          <div id="squad-deployment-reserve-value" class="label summary-value">{reserveSummary}</div>
        </div>
        <div id="squad-deployment-note" class="label tone-muted deployment-note">Whole squads are committed here. Their actual fire teams board the available lifts at launch.</div>
      </div>
      <div id="squad-deployment-roster" class="panel deployment-roster">
        <div id="squad-deployment-roster-heading" class="roster-heading surface-dark">
          <div id="squad-deployment-roster-copy" class="roster-heading-copy">
            <div id="squad-deployment-roster-title" class="label heading tone-edge section-heading">AVAILABLE LINE SQUADS</div>
            <div id="squad-deployment-roster-subtitle" class="label tone-muted">Select formations; home officers remain visible in each card.</div>
          </div>
          <div id="squad-deployment-roster-rule" class="label heading tone-accent roster-rule">SELECTED SQUADS DEPLOY</div>
        </div>
        <div id="squad-deployment-grid" class="deployment-grid">
          <button each="squad in squadRows" key="{squad.id}" id="{squad.id}" class="{squad.classes}" disabled="{squad.disabled}" onclick="{squad.action}">
            <div id="{squad.topId}" class="squad-card-top">
              <div id="{squad.nameId}" class="label heading squad-card-name">{squad.name}</div>
              <div id="{squad.readinessId}" class="{squad.tone}">{squad.readiness}</div>
            </div>
            <div id="{squad.loadoutId}" class="label tone-muted squad-card-loadout">{squad.loadout}</div>
            <div id="{squad.commandId}" class="label tone-muted squad-card-command">{squad.command}</div>
            <div id="{squad.casualtyId}" class="{squad.casualtyTone}">{squad.casualties}</div>
          </button>
        </div>
        <div id="squad-deployment-empty" class="label tone-muted empty-copy">{emptyMessage}</div>
      </div>
    </div>
    <div id="squad-deployment-actions" class="mission-flow-actions panel surface-dark">
      <button id="squad-deployment-back" onclick="{backAction}">BACK TO BRIEFING</button>
      <button id="squad-deployment-armory" onclick="{armoryAction}">MANAGE PERSONNEL</button>
    </div>
  </div>
</template>

<style>
  .squad-deployment-root { flex-direction: column; padding: 10px; gap: 8px; border-width: 2px; overflow: hidden; }
  .label { overflow: hidden; }
  .mission-flow-header { flex-direction: row; height: 58px; padding: 8px 10px; border-width: 1px; }
  .mission-flow-heading { flex-direction: column; flex-grow: 1; gap: 4px; }
  .mission-flow-heading .title { height: 24px; }
  .mission-flow-context { width: 330px; padding: 11px 4px; text-align: right; }
  .mission-flow-body { flex-direction: row; height: 0px; flex-grow: 1; gap: 8px; overflow: hidden; }
  .deployment-summary { flex-direction: column; width: 390px; padding: 10px; gap: 9px; border-width: 1px; overflow: hidden; }
  .section-heading { height: 20px; }
  .deployment-mission { height: 56px; padding: 10px; border-width: 1px; border-color: #263b51; }
  .summary-block { flex-direction: column; height: 82px; padding: 10px; gap: 9px; border-width: 1px; }
  .summary-value { height: 38px; }
  #squad-deployment-readiness { height: 29px; }
  .deployment-note { height: 70px; padding: 10px; border-width: 1px; border-color: #263b51; }
  .deployment-roster { flex-direction: column; width: 0px; flex-grow: 1; padding: 8px; gap: 7px; border-width: 1px; overflow: hidden; }
  .roster-heading { flex-direction: row; height: 60px; padding: 9px; border-width: 1px; }
  .roster-heading-copy { flex-direction: column; flex-grow: 1; gap: 5px; }
  .roster-rule { width: 270px; padding: 12px 4px; text-align: right; }
  .deployment-grid { display: grid; height: 0px; flex-grow: 1; gap: 7px; overflow: scroll; }
  .deployment-squad-card { flex-direction: column; width: 330px; height: 126px; padding: 9px; gap: 6px; border-width: 1px; text-align: left; }
  .deployment-squad-card.selected { background-color: #183b50; border-color: #ffd464; }
  .squad-card-top { flex-direction: row; height: 22px; gap: 8px; }
  .squad-card-name { width: 0px; flex-grow: 1; }
  .squad-card-readiness { width: 90px; text-align: right; }
  .squad-card-loadout, .squad-card-command, .squad-card-casualty { height: 18px; }
  .mission-flow-actions { flex-direction: row; height: 42px; padding: 4px; gap: 8px; border-width: 1px; }
  .mission-flow-actions button { width: 240px; padding: 7px; border-width: 1px; text-align: center; font-family: heading; }
  .empty-copy { height: 20px; }
</style>
