<template props="employerFactionName,employerFactionCrest,employerFactionCrestStyle,oppositionFactionName,oppositionFactionCrest,oppositionFactionCrestStyle,termActionsStyle,rewardHeader,rewardValue,rewardTerms,surveyStatus,surveyDetails,surveyObjectives,operationScale,operationRisk,scaleIndicators,riskIndicators,forceSelected,forceRecommended,forceSegments,forceAssessment,forceAssessmentClasses,deploymentStatus,carrierEmpty,carrierEmptyStyle,screenHeader,missionKicker,missionTitle,missionFlavor,missionRows,termActions,captainHeader,captainRoleSummary,groupCommandHeading,groupCommandSummary,groupCommandStyle,captains,captainEmpty,captainEmptyStyle,powerEmptyStyle,sourceEmptyStyle,debugToggleArrow,debugToggleClasses,debugToggleLabel,debugToggleDisabled,debugToggleAction,debugHeader,tierSummary,tierSteps,debugControls,airRows,commitmentHeader,personnelSummary,personnelClasses,experienceSummary,taskForceRows,forceSummaryStyle,forceCardsStyle,commandHeader,commandSummary,powerRows,powerEmpty,sourceHeader,sourceRows,sourceEmpty,transportHeader,landingCraftTitle,landingCraftCapacity,landingCraftSchedule,landingCraftOrigin,landingCraftImage,landingCraftImageStyle,landingCraftScheduleClasses,carrierHeader,carrierRows,employerHeader,employerRows,assignLabel,assignClasses,assignDisabled,assignAction,deployLabel,deployClasses,deployDisabled,deployAction,backAction">
  <div id="mission-briefing-root" class="mission-briefing-root">
    <div id="mission-briefing-header" class="mission-briefing-header console-header">
      <img id="mission-briefing-lock" class="console-header-lock" src="graphics/ui/console/locking-plate.svg" />
      <div id="mission-briefing-heading" class="mission-briefing-heading">
        <div id="mission-briefing-kicker" class="label heading tone-accent">{missionKicker}</div>
        <div id="mission-briefing-title" class="label title tone-edge">{missionTitle}</div>
      </div>
      <div id="mission-briefing-purpose" class="label heading tone-muted">{screenHeader}</div>
      <button id="mission-debug-toggle" class="{debugToggleClasses}" disabled="{debugToggleDisabled}" onclick="{debugToggleAction}">
        <img id="mission-debug-toggle-arrow" class="debug-toggle-arrow" src="{debugToggleArrow}" />
        <div id="mission-debug-toggle-legend" class="console-key-legend">{debugToggleLabel}</div>
        <img id="mission-debug-toggle-grip" class="console-key-grip" src="graphics/ui/console/key-grip.svg" />
      </button>
      <img id="mission-briefing-vent" class="console-header-vent" src="graphics/ui/console/vent-plate.svg" />
    </div>
    <div id="mission-briefing-body" class="mission-briefing-body">
      <div id="mission-overview" class="mission-overview">
        <div id="mission-overview-copy" class="mission-overview-copy">
          <div id="mission-threat" class="mission-threat" tabindex="0">
            <div id="mission-scale-symbols" class="threat-symbols">
              <img each="pip in scaleIndicators" key="{pip.id}" id="{pip.id}" class="{pip.classes}" src="{pip.image}" />
            </div>
            <div id="mission-scale-name" class="label title tone-accent">{operationScale}</div>
            <div id="mission-risk-symbols" class="threat-symbols">
              <div id="mission-risk-pips" class="threat-symbols">
                <img each="pip in riskIndicators" key="{pip.id}" id="{pip.id}" class="{pip.classes}" src="{pip.image}" />
              </div>
              <div id="mission-risk-name" class="label heading tone-accent">{operationRisk}</div>
            </div>
          </div>
          <div id="mission-factions" class="mission-factions">
            <div id="mission-employer-identity" class="faction-identity">
              <img id="mission-employer-crest" class="faction-crest" style="{employerFactionCrestStyle}" src="{employerFactionCrest}" />
              <div id="mission-employer-identity-copy" class="faction-identity-copy">
                <div id="mission-employer-identity-label" class="label heading tone-muted">EMPLOYER</div>
                <div id="mission-employer-faction-name" class="label faction-name">{employerFactionName}</div>
              </div>
            </div>
            <div id="mission-opposition-identity" class="faction-identity">
              <img id="mission-opposition-crest" class="faction-crest" style="{oppositionFactionCrestStyle}" src="{oppositionFactionCrest}" />
              <div id="mission-opposition-identity-copy" class="faction-identity-copy">
                <div id="mission-opposition-identity-label" class="label heading tone-muted">OPPOSITION</div>
                <div id="mission-opposition-faction-name" class="label faction-name">{oppositionFactionName}</div>
              </div>
            </div>
          </div>
          <div id="mission-reward" class="mission-reward console-readout">
            <div id="mission-reward-header" class="label heading tone-accent">{rewardHeader}</div>
            <div id="mission-reward-value" class="label title tone-good">{rewardValue}</div>
            <div id="mission-reward-terms" class="label tone-muted">{rewardTerms}</div>
          </div>
          <div id="mission-flavor" class="label mission-flavor surface-dark">{missionFlavor}</div>
          <div id="mission-info-rows" class="mission-info-rows">
            <div each="row in missionRows" key="{row.id}" id="{row.id}" class="info-row">
              <div id="{row.labelId}" class="label heading tone-muted info-label">{row.label}</div>
              <div id="{row.valueId}" class="{row.valueClasses}">{row.value}</div>
            </div>
          </div>
          <div id="mission-term-actions" class="mission-term-actions" style="{termActionsStyle}">
            <button each="term in termActions" key="{term.id}" id="{term.id}" class="{term.classes}" disabled="{term.disabled}" onclick="{term.action}">
              <div id="{term.titleId}" class="label heading choice-title">{term.title}</div>
              <div id="{term.detailId}" class="label tone-muted choice-detail">{term.detail}</div>
            </button>
          </div>
        </div>
        <div id="mission-captain-block" class="mission-captain-block">
          <div id="mission-captain-heading" class="label heading tone-edge section-heading">{captainHeader}</div>
          <div id="mission-captain-role" class="label captain-role-summary">{captainRoleSummary}</div>
          <div id="mission-captain-list" class="mission-captain-list">
            <button each="captain in captains" key="{captain.id}" id="{captain.id}" class="{captain.classes}" disabled="{captain.disabled}" onclick="{captain.action}">
              <img id="{captain.indicatorId}" class="console-rocker" src="{captain.indicatorSource}" />
              <img id="{captain.iconId}" class="choice-icon" src="{captain.icon}" />
              <div id="{captain.copyId}" class="choice-copy">
                <div id="{captain.titleId}" class="label heading choice-title">{captain.title}</div>
                <div id="{captain.detailId}" class="label tone-muted choice-detail">{captain.detail}</div>
              </div>
            </button>
          </div>
          <div id="mission-captain-empty" class="label tone-muted empty-copy" style="{captainEmptyStyle}">{captainEmpty}</div>
        </div>
      </div>

      <div id="mission-planning" class="mission-planning">
        <div id="mission-commitment" class="mission-commitment">
          <div id="mission-plan-sections" class="mission-plan-sections">
          <div id="mission-force-summary" class="briefing-section" style="{forceSummaryStyle}">
            <div id="mission-force-heading-row" class="force-heading-row">
            <div id="mission-force-heading" class="label heading tone-edge section-heading">{commitmentHeader}</div>
            <button id="mission-assign" class="{assignClasses}" disabled="{assignDisabled}" onclick="{assignAction}">
              <div id="mission-assign-signal" class="console-command-signal" />
              <div id="mission-assign-legend" class="console-key-legend">{assignLabel}</div>
              <img id="mission-assign-grip" class="console-key-grip" src="graphics/ui/console/key-grip.svg" />
            </button>
            </div>
            <div id="mission-force-comparison" class="force-comparison" tabindex="0">
              <img id="mission-force-symbol" src="graphics/ui/briefing/infantry.svg" />
              <div id="mission-force-numbers" class="force-numbers">
                <div id="mission-force-counts" class="force-counts">
                  <div id="mission-force-selected" class="label title tone-edge">{forceSelected}</div>
                  <div id="mission-force-unit" class="label tone-muted">ready marines</div>
                  <div id="mission-force-recommended" class="label tone-accent">{forceRecommended}</div>
                </div>
                <div id="mission-force-meter" class="force-meter">
                  <div each="pip in forceSegments" key="{pip.id}" id="{pip.id}" class="{pip.classes}" />
                </div>
                <div id="mission-force-assessment" class="{forceAssessmentClasses}">{forceAssessment}</div>
              </div>
            </div>
            <div id="mission-personnel-summary" class="{personnelClasses}">{personnelSummary}</div>
            <div id="mission-experience-summary" class="label tone-muted commitment-note">{experienceSummary}</div>
            <div id="mission-group-command" class="group-command-copy" style="{groupCommandStyle}">
              <div id="mission-group-command-heading" class="label heading tone-edge">{groupCommandHeading}</div>
              <div id="mission-group-command-summary" class="label group-command-summary">{groupCommandSummary}</div>
            </div>
            <div id="mission-task-force" class="force-card-grid" style="{forceCardsStyle}">
              <div each="row in taskForceRows" key="{row.id}" id="{row.id}" class="force-card console-readout" tabindex="0">
                <img id="{row.portraitId}" class="{row.portraitClasses}" src="{row.portrait}" />
                <div id="{row.copyId}" class="force-card-copy">
                  <div id="{row.roleId}" class="{row.roleClasses}">{row.role}</div>
                  <div id="{row.nameId}" class="label heading tone-edge force-card-title">{row.name}</div>
                  <div id="{row.detailId}" class="{row.detailClasses}">{row.detail}</div>
                </div>
              </div>
            </div>
          </div>
          <div id="mission-loadout-grid" class="mission-loadout-grid">
            <div id="mission-command-deck" class="briefing-section command-deck">
              <div id="mission-command-heading" class="deck-heading-row">
                <div id="mission-command-title" class="label heading tone-edge">{commandHeader}</div>
                <div id="mission-command-summary" class="label heading tone-accent">{commandSummary}</div>
              </div>
              <div id="mission-power-list" class="command-power-list">
                <button each="power in powerRows" key="{power.id}" id="{power.id}" class="{power.classes}" disabled="{power.disabled}" onclick="{power.action}">
                  <img id="{power.indicatorId}" class="console-rocker" src="{power.indicatorSource}" />
                  <img id="{power.iconId}" class="power-icon" src="{power.icon}" />
                  <div id="{power.copyId}" class="choice-copy">
                    <div id="{power.titleId}" class="label heading choice-title">{power.title}</div>
                    <div id="{power.detailId}" class="label tone-muted choice-detail">{power.detail}</div>
                  </div>
                </button>
              </div>
              <div id="mission-power-empty" class="label tone-muted empty-copy" style="{powerEmptyStyle}">{powerEmpty}</div>
            </div>
            <div id="mission-logistics" class="mission-logistics">
              <div id="mission-source-block" class="briefing-section">
                <div id="mission-source-heading" class="label heading tone-edge section-heading">{sourceHeader}</div>
                <div id="mission-source-list" class="choice-list source-list">
                  <button each="source in sourceRows" key="{source.id}" id="{source.id}" class="{source.classes}" disabled="{source.disabled}" onclick="{source.action}">
                    <img id="{source.indicatorId}" class="console-rocker" src="{source.indicatorSource}" />
                    <img id="{source.iconId}" class="choice-icon" src="{source.icon}" />
                    <div id="{source.copyId}" class="choice-copy">
                      <div id="{source.titleId}" class="label heading choice-title">{source.title}</div>
                      <div id="{source.detailId}" class="label tone-muted choice-detail">{source.detail}</div>
                    </div>
                  </button>
                </div>
                <div id="mission-source-empty" class="label tone-muted empty-copy" style="{sourceEmptyStyle}">{sourceEmpty}</div>
              </div>
              <div id="mission-support-stack" class="mission-support-stack">
                  <div id="mission-transport-block" class="briefing-section">
                    <div id="mission-transport-heading" class="label heading tone-edge section-heading">{transportHeader}</div>
                    <div id="mission-transport-readout" class="landing-craft-readout console-readout" tabindex="0">
                      <img id="mission-transport-image" class="landing-craft-image" style="{landingCraftImageStyle}" src="{landingCraftImage}" />
                      <div id="mission-transport-copy" class="landing-craft-copy">
                        <div id="mission-transport-name" class="label heading landing-craft-line">{landingCraftTitle}</div>
                        <div id="mission-transport-capacity" class="label landing-craft-line">{landingCraftCapacity}</div>
                        <div id="mission-transport-schedule" class="{landingCraftScheduleClasses}">{landingCraftSchedule}</div>
                        <div id="mission-transport-origin" class="label tone-muted landing-craft-line">{landingCraftOrigin}</div>
                      </div>
                    </div>
                  </div>
                  <div id="mission-carrier-block" class="briefing-section">
                    <div id="mission-carrier-heading" class="label heading tone-edge section-heading">{carrierHeader}</div>
                    <div id="mission-carrier-empty" class="label tone-muted empty-copy" style="{carrierEmptyStyle}">{carrierEmpty}</div>
                    <div id="mission-carrier-list" class="choice-list carrier-list">
                      <button each="carrier in carrierRows" key="{carrier.id}" id="{carrier.id}" class="{carrier.classes}" disabled="{carrier.disabled}" onclick="{carrier.action}">
                        <img id="{carrier.indicatorId}" class="console-rocker" src="{carrier.indicatorSource}" />
                        <div id="{carrier.copyId}" class="choice-copy">
                          <div id="{carrier.titleId}" class="label heading choice-title">{carrier.title}</div>
                          <div id="{carrier.detailId}" class="label tone-muted choice-detail">{carrier.detail}</div>
                        </div>
                      </button>
                    </div>
                  </div>
                <div id="mission-employer-block" class="briefing-section">
                  <div id="mission-employer-heading" class="label heading tone-edge section-heading">{employerHeader}</div>
                  <div id="mission-employer-list" class="info-list">
                    <div each="row in employerRows" key="{row.id}" id="{row.id}" class="info-row compact-row">
                      <div id="{row.labelId}" class="label heading tone-muted info-label">{row.label}</div>
                      <div id="{row.valueId}" class="{row.valueClasses}">{row.value}</div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
          </div>

        </div>

        <div id="mission-survey-slot" class="mission-survey-slot">
          <div id="mission-survey" class="mission-survey console-well">
            <div id="mission-survey-heading" class="label heading tone-accent">TACTICAL INTELLIGENCE / AREA SURVEY</div>
            <div id="mission-survey-status" class="label tone-edge">{surveyStatus}</div>
            <canvas id="mission-survey-canvas" width="560" height="410" />
            <div id="mission-survey-legend" class="label tone-muted">CYAN / DROP ZONES     AMBER / OBJECTIVES &amp; LANES</div>
            <div id="mission-survey-details" class="label tone-muted">{surveyDetails}</div>
            <div id="mission-survey-objectives" class="survey-objectives">
              <div each="row in surveyObjectives" key="{row.id}" id="{row.id}" class="label survey-objective">{row.value}</div>
            </div>
            <div id="mission-survey-footer" class="label tone-muted">Terrain survey only. Enemy positions unconfirmed.</div>
          </div>
        <div id="mission-debug-drawer" class="debug-drawer expanded">
          <div id="mission-debug-workspace" class="panel debug-workspace">
            <div id="mission-debug-rack-header" class="console-header debug-rack-header">
              <img id="mission-debug-service-plate" class="debug-service-plate" src="graphics/ui/console/service-plate.svg" />
              <div id="mission-debug-heading" class="label heading tone-accent">{debugHeader} / SCALE &amp; FIXTURE</div>
            </div>
            <div id="mission-tier-summary" class="label tone-edge tier-summary console-readout">{tierSummary}</div>
            <div id="mission-tier-track" class="mission-tier-track">
              <button each="step in tierSteps" key="{step.id}" id="{step.id}" class="{step.classes}" disabled="{step.disabled}" onclick="{step.action}">
                <div id="{step.indicatorId}" class="console-tier-lamp" />
                <div id="{step.numeralId}" class="label heading tier-numeral">{step.numeral}</div>
                <div id="{step.labelId}" class="label tier-label">{step.label}</div>
              </button>
            </div>
            <div id="mission-debug-controls" class="mission-debug-controls">
              <div each="control in debugControls" key="{control.id}" id="{control.id}" class="debug-control-row console-readout">
                <div id="{control.labelId}" class="label heading tone-muted debug-control-label">{control.label}</div>
                <div id="{control.bankId}" class="debug-control-bank">
                  <button id="{control.farMinusId}" class="{control.farMinusClasses}" disabled="{control.farMinusDisabled}" onclick="{control.farMinusAction}">{control.farMinusLabel}</button>
                  <button id="{control.minusId}" disabled="{control.minusDisabled}" onclick="{control.minusAction}">{control.minusLabel}</button>
                  <div id="{control.valueId}" class="label heading debug-control-value console-well">{control.value}</div>
                  <button id="{control.plusId}" disabled="{control.plusDisabled}" onclick="{control.plusAction}">{control.plusLabel}</button>
                  <button id="{control.farPlusId}" class="{control.farPlusClasses}" disabled="{control.farPlusDisabled}" onclick="{control.farPlusAction}">{control.farPlusLabel}</button>
                  <button id="{control.cycleId}" class="{control.cycleClasses}" disabled="{control.cycleDisabled}" onclick="{control.cycleAction}">{control.cycleLabel}</button>
                </div>
              </div>
            </div>
            <div id="mission-debug-air-heading" class="label heading tone-edge section-heading">AIR SUPPORT</div>
            <div id="mission-debug-air" class="mission-debug-air">
              <div each="air in airRows" key="{air.id}" id="{air.id}" class="debug-air-row console-readout">
                <img id="{air.imageId}" class="debug-air-image" src="{air.image}" />
                <div id="{air.labelId}" class="label heading tone-muted debug-air-label">{air.label}</div>
                <button id="{air.attackId}" class="{air.attackClasses}" onclick="{air.attackAction}">
                  <img id="{air.attackIndicatorId}" class="console-rocker" src="{air.attackIndicatorSource}" />
                  <div id="{air.attackLegendId}" class="console-key-legend">{air.attackLabel}</div>
                </button>
                <button id="{air.defendId}" class="{air.defendClasses}" onclick="{air.defendAction}">
                  <img id="{air.defendIndicatorId}" class="console-rocker" src="{air.defendIndicatorSource}" />
                  <div id="{air.defendLegendId}" class="console-key-legend">{air.defendLabel}</div>
                </button>
              </div>
            </div>
          </div>
        </div>
        </div>
      </div>
    </div>
          <div id="mission-briefing-actions" class="mission-briefing-actions console-command-rail">
            <button id="mission-briefing-back" onclick="{backAction}">
              <div id="mission-briefing-back-signal" class="console-command-signal" />
              <div id="mission-briefing-back-legend" class="console-key-legend">BACK</div>
              <img id="mission-briefing-back-grip" class="console-key-grip" src="graphics/ui/console/key-grip.svg" />
            </button>

            <div id="mission-action-spacer" />
            <div id="mission-deployment-status" class="label tone-muted">{deploymentStatus}</div>
            <button id="mission-deploy" class="{deployClasses}" disabled="{deployDisabled}" onclick="{deployAction}">
              <div id="mission-deploy-signal" class="console-command-signal" />
              <div id="mission-deploy-legend" class="console-key-legend">{deployLabel}</div>
              <img id="mission-deploy-grip" class="console-key-grip" src="graphics/ui/console/key-grip.svg" />
            </button>

          </div>
  </div>
</template>

<style>
  .mission-briefing-root { flex-direction: column; padding: 10px; gap: 8px; border-width: 2px; overflow: hidden; }
  .label { overflow: hidden; }
  .mission-briefing-header { flex-direction: row; align-items: center; height: 62px; padding: 8px 10px; gap: 10px; border-width: 2px; }
  .mission-briefing-heading { flex-direction: column; height: 48px; flex-grow: 1; gap: 4px; }
  #mission-briefing-kicker { height: 17px; }
  #mission-briefing-title { height: 27px; }
  #mission-briefing-purpose { width: 280px; padding: 14px 4px; text-align: right; }
  .mission-briefing-body { flex-direction: row; flex-grow: 1; gap: 8px; overflow: hidden; }
  .mission-info-rows, .info-list { flex-direction: column; gap: 4px; }
  .compact-row { height: 30px; padding: 3px; }
  .mission-captain-list, .choice-list { flex-direction: column; gap: 4px; overflow: scroll; }
  .choice-row { flex-direction: row; align-items: center; height: 32px; padding: 3px 5px; gap: 5px; border-width: 2px; text-align: left; }
  .choice-icon { width: 28px; height: 28px; }
  .choice-copy { flex-direction: column; width: 0px; flex-grow: 1; height: 30px; gap: 2px; overflow: hidden; }
  .choice-title { height: 14px; white-space: nowrap; }
  .choice-detail { height: 14px; white-space: nowrap; }
  .empty-copy { height: 18px; padding: 3px; }
  .mission-planning { flex-direction: row; width: 0px; flex-grow: 1; gap: 8px; overflow: hidden; }
  .debug-drawer { flex-direction: column; width: 432px; gap: 6px; overflow: hidden; }
  .debug-drawer-toggle { flex-direction: row; align-items: center; width: 112px; height: 24px; padding: 3px 5px; gap: 6px; border-width: 3px; font-family: heading; text-align: center; }
  .debug-workspace { flex-direction: column; height: 0px; flex-grow: 1; padding: 5px; gap: 5px; border-width: 2px; overflow: hidden; }
  .tier-summary { height: 30px; padding: 6px; border-width: 1px; white-space: normal; }
  .mission-tier-track { flex-direction: row; height: 54px; gap: 3px; }
  .tier-step { flex-direction: column; width: 0px; flex-grow: 1; padding: 3px; gap: 2px; border-width: 2px; text-align: center; }
  .tier-step.locked { opacity: 0.28; }
  .tier-numeral { height: 17px; text-align: center; }
  .tier-label { height: 24px; font-family: compact; text-align: center; white-space: normal; }
  .mission-debug-controls { flex-direction: column; height: 0px; flex-grow: 1; gap: 3px; padding: 1px; overflow: scroll; }
  .debug-control-row { flex-direction: row; align-items: center; height: 28px; padding: 3px; gap: 4px; border-width: 1px; }
  .debug-control-bank { flex-direction: row; align-items: center; width: 0px; flex-grow: 1; height: 28px; gap: 2px; }
  .debug-control-label { width: 112px; height: auto; white-space: normal; }
  .debug-control-row button { width: 22px; padding: 2px 1px; border-width: 2px; text-align: center; font-family: heading; }
  .debug-control-row .debug-cycle { width: 48px; font-family: compact; }
  .debug-control-row .debug-cycle-absent { width: 0px; padding: 0px; border-width: 0px; overflow: hidden; }
  .debug-control-row .debug-step-absent { width: 0px; padding: 0px; border-width: 0px; overflow: hidden; }
  .debug-control-value { width: 0px; flex-grow: 1; height: auto; padding: 3px 1px; border-width: 2px; text-align: center; }
  .mission-debug-air { flex-direction: column; height: 196px; gap: 3px; overflow: scroll; }
  .debug-air-row { flex-direction: row; align-items: center; height: 24px; gap: 4px; padding: 2px; border-width: 1px; }
  .debug-air-label { width: 0px; flex-grow: 1; height: auto; padding: 0px; }
  .debug-air-row button { flex-direction: row; align-items: center; width: 72px; height: 18px; padding: 1px 3px; gap: 5px; border-width: 2px; font-family: heading; text-align: center; }
  .force-card { flex-direction: row; align-items: center; width: 202px; height: 64px; padding: 5px; gap: 6px; border-width: 1px; }
  .force-card-portrait { width: 44px; height: 44px; padding: 1px; border-width: 1px; pointer-events: none; }
  .force-card-portrait.portrait-absent { width: 0px; height: 0px; padding: 0px; border-width: 0px; }
  .force-card-copy { flex-direction: column; width: 0px; flex-grow: 1; height: 58px; gap: 3px; overflow: hidden; }
  .force-card-role { height: 12px; }
  .group-command-copy { width: 100%; flex-direction: column; gap: 4px; }
  .group-command-summary { width: 100%; height: auto; white-space: normal; }
  .captain-role-summary { height: 48px; white-space: normal; }
  .force-card-title { height: auto; white-space: normal; }
  .force-card-detail { height: auto; text-align: left; white-space: normal; }
  .commitment-grid { flex-direction: column; width: 0px; flex-grow: 1; gap: 7px; }
  .commitment-grid .briefing-section { height: 78px; }
  #mission-transport-block { height: 116px; }
  .landing-craft-image { height: 48px; }
