<template props="roomTitle,roomCopy,contextLabel,candidateRows,facilityCells,selectedName,selectedSummary,verdict,costLabel,costClasses,transferLabel,transferClasses,transferAction,returnAction,hqAction,barracksAction,armoryAction,mechLabAction,boatsAction,hqClasses,barracksClasses,armoryClasses,mechLabClasses,boatsClasses">
  <div id="transfer-root" class="transfer-root">
    <marine-ops-page-nav returnAction="{returnAction}" hqAction="{hqAction}" barracksAction="{barracksAction}" armoryAction="{armoryAction}" mechLabAction="{mechLabAction}" boatsAction="{boatsAction}" hqClasses="{hqClasses}" barracksClasses="{barracksClasses}" armoryClasses="{armoryClasses}" mechLabClasses="{mechLabClasses}" boatsClasses="{boatsClasses}" contextLabel="{contextLabel}" />

    <div id="transfer-room-bar" class="panel transfer-room-bar console-header">
      <img id="ship-transfer-service-plate" class="company-service-plate" src="graphics/ui/console/service-plate.svg" />
      <div id="transfer-room-title" class="label heading tone-edge">{roomTitle}</div>
      <div id="transfer-room-copy" class="label tone-muted">{roomCopy}</div>
    </div>

    <div id="transfer-body" class="transfer-body">
      <div id="transfer-fleet-rail" class="panel fleet-rail console-section">
        <div id="transfer-fleet-heading" class="label heading tone-edge section-heading">THE FLEET</div>
        <div id="transfer-fleet-copy" class="label tone-muted rail-copy">Select a hull to see her deck.</div>
        <div id="transfer-fleet-list" class="fleet-list">
          <button each="ship in candidateRows" key="{ship.id}" id="{ship.id}" class="{ship.classes}" onclick="{ship.select}">
            <img id="{ship.imageId}" class="transfer-hull-image" src="{ship.image}" />
            <div id="{ship.copyId}" class="transfer-hull-copy">
            <div id="{ship.nameId}" class="label ship-name">{ship.name}</div>
            <div id="{ship.hullId}" class="label heading tone-accent ship-hull">{ship.hull}</div>
            <div id="{ship.detailId}" class="label tone-muted ship-detail">{ship.detail}</div>
            <div id="{ship.costId}" class="label tone-muted ship-cost">{ship.cost}</div>
            </div>
          </button>
        </div>
      </div>

      <div id="transfer-stage" class="panel transfer-stage console-section">
        <div id="transfer-selected-heading" class="selected-heading console-header">
          <div id="transfer-selected-copy" class="selected-copy">
            <div id="transfer-selected-name" class="label selected-name tone-accent">{selectedName}</div>
            <div id="transfer-selected-summary" class="label tone-muted">{selectedSummary}</div>
          </div>
          <button id="transfer-commit" class="{transferClasses}" onclick="{transferAction}">
            <div id="transfer-commit-label" class="label heading commit-label">{transferLabel}</div>
          </button>
        </div>

        <canvas id="transfer-plan" class="transfer-plan" width="1280" height="470" />

        <div id="transfer-verdict-bar" class="verdict-bar console-readout">
          <div id="transfer-verdict" class="label heading tone-accent verdict">{verdict}</div>
          <div id="transfer-cost" class="{costClasses}">{costLabel}</div>
        </div>

        <div id="transfer-facilities" class="facilities-panel console-well">
          <div id="transfer-facilities-heading" class="label heading tone-edge section-heading">WHAT WOULD BE ABOARD</div>
          <div id="transfer-facility-cells" class="facility-cells">
            <div each="cell in facilityCells" key="{cell.id}" id="{cell.id}" class="{cell.classes}">
              <div id="{cell.labelId}" class="label tone-muted facility-label">{cell.label}</div>
              <div id="{cell.valueId}" class="label tone-accent facility-value">{cell.value}</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</template>

<style>
  .transfer-root { flex-direction: column; padding: 10px; gap: 7px; border-width: 2px; overflow: hidden; }
  .label { overflow: hidden; }
  .heading { font-family: heading; }
  .section-heading { height: 19px; }
  .transfer-room-bar { flex-direction: row; height: 62px; padding: 8px 10px; gap: 12px; align-items: center; border-width: 2px; }
  #transfer-room-title { width: 282px; height: auto; white-space: normal; }
  #transfer-room-copy { width: 620px; flex-grow: 0; text-align: left; height: auto; white-space: normal; }
  .transfer-body { flex-direction: row; width: 100%; height: 0px; flex-grow: 1; gap: 7px; overflow: hidden; }
  .fleet-rail { flex-direction: column; width: 306px; padding: 10px; gap: 8px; overflow: hidden; border-width: 2px; }
  .rail-copy { height: 22px; }
  .fleet-list { flex-direction: column; height: 0px; flex-grow: 1; gap: 8px; overflow: scroll; }
  .transfer-row { flex-direction: row; width: 100%; height: 118px; padding: 9px; gap: 8px; border-width: 2px; text-align: left; background-color: #20282d; border-color: #526065; align-items: center; }
  .transfer-row.selected { background-color: #183b50; border-color: #ffd464; }
  .transfer-row.current { border-color: #4f9a68; }
  .transfer-row.unsupported { opacity: 0.55; border-color: #3a4452; }
  .ship-name { height: auto; white-space: normal; }
  .ship-hull, .ship-detail, .ship-cost { height: auto; white-space: normal; }
  .transfer-stage { flex-direction: column; width: 0px; flex-grow: 1; padding: 10px; gap: 9px; overflow: hidden; border-width: 2px; }
  .selected-heading { flex-direction: row; height: 70px; padding: 8px 10px; gap: 8px; align-items: center; border-width: 2px; }
  .selected-copy { flex-direction: column; height: 52px; width: 0px; flex-grow: 1; gap: 6px; }
  .selected-name { height: 25px; font-family: title; }
  .transfer-commit { width: 254px; height: 42px; padding: 5px; border-width: 3px; border-color: #ffd464; background-color: #343c3e; }
  .transfer-commit.current { border-color: #31485f; opacity: 0.6; }
  .transfer-commit.unaffordable { border-color: #c44b4b; opacity: 0.55; }
  .commit-label { height: auto; text-align: center; white-space: normal; }
  .transfer-plan { width: 100%; height: 0px; flex-grow: 1; border-width: 1px; }
  .verdict-bar { flex-direction: row; height: 66px; padding: 8px 9px; gap: 10px; border-width: 2px; align-items: center; }
  .verdict { width: 54%; flex-grow: 0; height: auto; white-space: normal; }
  .transfer-cost { width: 0px; height: auto; text-align: left; flex-grow: 1; white-space: normal; }
  .transfer-cost.short { color: #c44b4b; }
  .facilities-panel { flex-direction: column; height: 184px; padding: 9px; gap: 8px; border-width: 2px; }
  .facility-cells { display: grid; height: 156px; flex-grow: 0; gap: 8px; overflow: scroll; }
  .facility-cell { flex-direction: column; width: 236px; height: 58px; padding: 7px; gap: 6px; border-width: 1px; border-color: #526065; background-color: #20282d; }
  .facility-cell.absent { opacity: 0.5; border-color: #3a4452; }
  .facility-cell.better { border-color: #4f9a68; }
  .facility-cell.worse { border-color: #c44b4b; background-color: #331c1c; }
  .facility-label { height: 15px; }
  .facility-value { height: 21px; font-family: heading; }
  .company-service-plate { width: 58px; height: 30px; pointer-events: none; }
  #transfer-selected-summary { height: auto; white-space: normal; }
  .facility-label, .facility-value { height: auto; white-space: normal; }
  .transfer-hull-image { width: 68px; height: 92px; pointer-events: none; }
  .transfer-hull-copy { flex-direction: column; height: 108px; width: 0px; flex-grow: 1; gap: 5px; overflow: hidden; }
</style>
