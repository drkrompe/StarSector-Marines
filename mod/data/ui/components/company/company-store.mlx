<template props="resourceStock,roomTitle,roomCopy,contextLabel,shelfNote,categoryRows,offerRows,selectedName,selectedKind,selectedCards,dollClasses,specRows,specNotes,specClasses,partClasses,specTopStyle,selectedDetail,priceLabel,buyLabel,buyClasses,buyAction,verdict,freeRailClasses,freeKeyClasses,freeLabel,freeAction,returnAction,hqAction,barracksAction,armoryAction,mechLabAction,boatsAction,engineeringAction,shopAction,hqClasses,barracksClasses,armoryClasses,mechLabClasses,engineeringClasses,boatsClasses,shopClasses">
  <div id="store-root" class="store-root">
    <marine-ops-page-nav returnAction="{returnAction}" hqAction="{hqAction}" barracksAction="{barracksAction}" armoryAction="{armoryAction}" mechLabAction="{mechLabAction}" boatsAction="{boatsAction}" engineeringAction="{engineeringAction}" shopAction="{shopAction}" shopClasses="{shopClasses}" engineeringClasses="{engineeringClasses}" hqClasses="{hqClasses}" barracksClasses="{barracksClasses}" armoryClasses="{armoryClasses}" mechLabClasses="{mechLabClasses}" boatsClasses="{boatsClasses}" contextLabel="{contextLabel}" />
    <div id="store-room-bar" class="panel store-room-bar console-header">
      <img id="store-service-plate" class="company-service-plate" src="graphics/ui/console/service-plate.svg" />
      <div id="store-room-title" class="label heading tone-edge">{roomTitle}</div>
      <div id="store-room-copy" class="label tone-muted">{roomCopy}</div>
      <div id="store-cheat-rail" class="{freeRailClasses}">
        <button id="store-free-licenses" class="{freeKeyClasses}" onclick="{freeAction}">
          <div id="store-free-signal" class="console-command-signal" />
          <div id="store-free-legend" class="console-key-legend">{freeLabel}</div>
          <img id="store-free-grip" class="console-key-grip" src="graphics/ui/console/key-grip.svg" />
        </button>
      </div>
      <div id="store-stock-slot" class="header-stock-slot">
        <company-resource-stock stockId="store-resource-stock" rows="{resourceStock}" />
      </div>
    </div>

    <div id="store-body" class="store-body">
      <div id="store-categories" class="panel store-categories console-section">
        <div id="store-categories-heading" class="label heading tone-edge section-heading">{i18n.storeCategoriesHeading}</div>
        <div id="store-category-list" class="store-category-list">
          <button each="category in categoryRows" key="{category.id}" id="{category.id}" class="{category.classes}" onclick="{category.select}">
            <div id="{category.stripId}" class="{category.stripClasses}"></div>
            <img id="{category.iconId}" class="{category.iconClasses}" src="{category.icon}" />
            <div id="{category.labelId}" class="label store-category-label">{category.label}</div>
          </button>
        </div>
      </div>

      <div id="store-shelf" class="panel store-rail console-section">
        <div id="store-shelf-heading" class="label heading tone-edge section-heading">{i18n.storeShelfHeading}</div>
        <div id="store-shelf-copy" class="label tone-muted rail-copy">{shelfNote}</div>
        <div id="store-offer-list" class="store-offer-list">
          <button each="offer in offerRows" key="{offer.id}" id="{offer.id}" class="{offer.classes}" onclick="{offer.select}">
            <canvas id="{offer.symbolId}" class="{offer.symbolClasses}" width="80" height="58" />
            <img id="{offer.flagId}" class="{offer.flagClasses}" src="{offer.flag}" />
            <div id="{offer.copyId}" class="store-offer-copy">
              <div id="{offer.nameId}" class="label store-offer-name">{offer.name}</div>
              <div id="{offer.detailId}" class="label tone-muted store-offer-detail">{offer.detail}</div>
              <div id="{offer.priceId}" class="label heading tone-accent store-offer-price">{offer.price}</div>
            </div>
          </button>
        </div>
      </div>

      <div id="store-stage" class="panel store-stage console-section">
        <div id="store-selected-heading" class="store-selected-heading console-header">
          <div id="store-selected-copy" class="store-selected-copy">
            <div id="store-selected-name" class="label store-selected-name tone-accent">{selectedName}</div>
            <div id="store-selected-kind" class="label tone-muted">{selectedKind}</div>
          </div>
        </div>
        <div id="store-stage-body" class="store-stage-body">
          <canvas id="store-doll" class="{dollClasses}" width="500" height="566" />
          <div id="store-stage-copy" class="store-stage-copy">
            <div id="store-card-slot" class="store-card-slot">
              <armory-loadout-card each="tile in selectedCards" key="{tile.id}" tile="{tile}" />
            </div>
            <div id="store-spec" class="{specClasses}">
              <div id="store-spec-top" class="store-spec-top" style="{specTopStyle}">
                <canvas id="store-part" class="{partClasses}" width="220" height="160" />
                <div id="store-spec-stats" class="store-spec-stats">
                  <div each="row in specRows" key="{row.id}" id="{row.id}" class="{row.classes}">
                    <div id="{row.lineId}" class="store-spec-line">
                      <div id="{row.labelId}" class="label tone-muted store-spec-label">{row.label}</div>
                      <div id="{row.valueId}" class="label store-spec-value">{row.value}</div>
                    </div>
                    <div id="{row.trackId}" class="{row.trackClasses}">
                      <div id="{row.fillId}" class="store-spec-fill" style="{row.fillStyle}"></div>
                    </div>
                  </div>
                </div>
              </div>
              <div id="store-spec-notes" class="store-spec-notes">
                <div each="note in specNotes" key="{note.id}" id="{note.id}" class="{note.classes}">{note.text}</div>
              </div>
            </div>
            <div id="store-selected-detail" class="label tone-muted store-selected-detail console-well">{selectedDetail}</div>
          </div>
        </div>
        <div id="store-verdict-bar" class="store-verdict-bar console-readout">
          <div id="store-verdict-copy" class="store-verdict-copy">
            <div id="store-verdict" class="label heading tone-accent store-verdict">{verdict}</div>
            <div id="store-price" class="label tone-muted store-price">{priceLabel}</div>
          </div>
          <button id="store-buy" class="{buyClasses}" onclick="{buyAction}">{buyLabel}</button>
        </div>
      </div>
    </div>
  </div>
</template>

<style>
  .header-stock-slot { flex-direction: column; width: 640px; height: 46px; }
  .store-root { flex-direction: column; padding: 10px; gap: 7px; border-width: 2px; overflow: hidden; }
  .label { overflow: hidden; }
  .heading { font-family: heading; }
  .section-heading { height: 19px; }
  .store-room-bar { flex-direction: row; height: 54px; padding: 4px 10px; gap: 12px; align-items: center; border-width: 2px; }
  #store-room-title { width: 282px; height: auto; white-space: normal; }
  #store-room-copy { width: 0px; flex-grow: 1; text-align: left; height: auto; white-space: normal; }
  .store-body { flex-direction: row; width: 100%; height: 0px; flex-grow: 1; gap: 7px; overflow: hidden; }
  .store-categories { flex-direction: column; width: 270px; padding: 10px; gap: 8px; overflow: hidden; border-width: 2px; }
  .store-category-list { flex-direction: column; height: 0px; flex-grow: 1; gap: 4px; overflow: scroll; }
  .store-cat { flex-direction: row; width: 100%; height: 28px; gap: 8px; padding: 0px 8px 0px 0px; border-width: 1px; text-align: left; align-items: center; background-color: #20282d; border-color: #526065; }
  .store-cat.section { height: 46px; background-color: #2a3238; border-color: #6a7a80; font-family: heading; }
  .store-cat.slot { padding: 0px 8px 0px 14px; }
  .store-cat-strip { width: 5px; height: 100%; pointer-events: none; }
  .store-cat-strip.sec-MARINE { background-color: #8fcf8a; }
  .store-cat-strip.sec-MECHS { background-color: #e8b45a; }
  .store-cat-strip.sec-BOATS { background-color: #72bde8; }
  .store-cat.selected { background-color: #183b50; border-color: #ffd464; }
  .store-cat.empty { opacity: 0.5; }
  .store-category-label { width: 0px; flex-grow: 1; height: auto; white-space: nowrap; }
  .store-cat-icon { width: 48px; height: 36px; pointer-events: none; }
  .store-cat-tick { width: 22px; height: 22px; pointer-events: none; }
  .store-rail { flex-direction: column; width: 420px; padding: 10px; gap: 8px; overflow: hidden; border-width: 2px; }
  .rail-copy { height: 36px; white-space: normal; }
  .store-offer-list { flex-direction: column; height: 0px; flex-grow: 1; gap: 8px; overflow: scroll; }
  .store-row { flex-direction: row; align-items: center; width: 100%; height: 74px; padding: 8px 10px; gap: 10px; border-width: 2px; text-align: left; background-color: #20282d; border-color: #526065; }
  .store-row.selected { background-color: #183b50; border-color: #ffd464; }
  .store-row.acquired { opacity: 0.55; border-color: #4f9a68; }
  .store-offer-copy { flex-direction: column; width: 0px; flex-grow: 1; gap: 4px; }
  .store-offer-icon { width: 80px; height: 58px; pointer-events: none; }
  .store-offer-flag { width: 80px; height: 58px; pointer-events: none; }
  .store-offer-flag.none { display: none; }
  .store-stage-body { flex-direction: row; align-items: flex-start; width: 100%; height: 0px; flex-grow: 1; gap: 9px; }
  .store-stage-copy { flex-direction: column; width: 0px; flex-grow: 1; height: 100%; gap: 9px; }
  .store-doll { width: 500px; height: 566px; pointer-events: none; }
  .store-doll.none { display: none; }
  .store-card-slot { flex-direction: column; width: 100%; }
  .store-offer-icon.none { display: none; }
  .store-offer-name { height: auto; white-space: normal; }
  .store-offer-detail, .store-offer-price { height: auto; white-space: normal; }
  .store-stage { flex-direction: column; width: 0px; flex-grow: 1; padding: 10px; gap: 9px; overflow: hidden; border-width: 2px; }
  .store-selected-heading { flex-direction: row; height: 70px; padding: 8px 10px; gap: 8px; align-items: center; border-width: 2px; }
  .store-selected-copy { flex-direction: column; height: 52px; width: 0px; flex-grow: 1; gap: 6px; }
  .store-selected-name { height: 25px; font-family: title; }
  .store-buy { width: 320px; height: 46px; border-width: 2px; font-family: heading; text-align: center; }
  .store-buy.current { opacity: 0.45; }
  .store-cheat-rail { flex-direction: row; height: 32px; padding: 3px; border-width: 2px; }
  .store-cheat-rail.hidden { display: none; }
  .store-cheat-rail button { flex-direction: row; align-items: center; width: 230px; padding: 2px 5px; gap: 5px; border-width: 3px; font-family: heading; text-align: center; }
  .store-spec { flex-direction: column; width: 100%; height: 0px; flex-grow: 1; padding: 12px; gap: 12px; border-width: 2px; overflow: hidden; }
  .store-spec.none { display: none; }
  .store-spec-top { flex-direction: row; width: 100%; gap: 16px; align-items: flex-start; }
  .store-part { width: 220px; height: 160px; pointer-events: none; }
  .store-part.none { display: none; }
  .store-spec-stats { flex-direction: column; width: 460px; height: 100%; gap: 7px; }
  .store-spec-stat { flex-direction: column; height: 20px; gap: 3px; }
  .store-spec-stat.metered { height: 28px; }
  .store-spec-line { flex-direction: row; height: 20px; gap: 8px; }
  .store-spec-label { width: 0px; flex-grow: 1; white-space: nowrap; }
  .store-spec-value { width: 220px; text-align: right; white-space: nowrap; font-family: heading; }
  .store-spec-track { flex-direction: row; height: 5px; background-color: #1a2836; }
  .store-spec-track.none { display: none; }
  .store-spec-fill { height: 5px; background-color: #e2965c; }
  .store-spec-notes { flex-direction: column; width: 100%; height: 0px; flex-grow: 1; gap: 8px; overflow: scroll; }
  .store-spec-note { width: 100%; height: auto; white-space: normal; color: #b9c4cf; }
  .store-spec-note.lead { color: #e6d8b4; }
  .store-selected-detail { width: 100%; height: auto; padding: 10px 12px; border-width: 2px; white-space: normal; }
  .store-verdict-bar { flex-direction: row; height: 66px; padding: 8px 10px; gap: 16px; border-width: 2px; align-items: center; }
  .store-verdict-copy { flex-direction: column; width: 0px; flex-grow: 1; gap: 4px; }
  .store-verdict { width: 100%; height: auto; white-space: normal; }
  .store-price { width: 100%; height: auto; text-align: left; white-space: normal; }
  .company-service-plate { width: 58px; height: 30px; pointer-events: none; }
</style>
