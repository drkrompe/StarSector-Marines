<template props="purpose,returnAction,hqAction,barracksAction,armoryAction,mechLabAction,boatsAction,hqClasses,barracksClasses,armoryClasses,mechLabClasses,boatsClasses,assessmentHeader,ratingHeader,rating,ratingScore,assessment,statusHeader,statusCards,financeHeader,runway,runwayCaption,runwayClasses,financeRows,standingHeader,employers,employerEmpty,boardHeader,boardIntro,obligationsHeader,obligations,obligationEmpty,newsHeader,newsPosts,newsEmpty,shipAction,shipLabel,shipViewAction,shipView">
  <div id="company-hq-root" class="company-hq-root">
    <marine-ops-page-nav returnAction="{returnAction}" hqAction="{hqAction}" barracksAction="{barracksAction}" armoryAction="{armoryAction}" mechLabAction="{mechLabAction}" boatsAction="{boatsAction}" hqClasses="{hqClasses}" barracksClasses="{barracksClasses}" armoryClasses="{armoryClasses}" mechLabClasses="{mechLabClasses}" boatsClasses="{boatsClasses}" contextLabel="{purpose}" />

    <div id="company-hq-assessment" class="panel assessment-panel console-header">
      <div id="company-hq-rating" class="rating-block console-readout">
        <div id="company-hq-rating-header" class="label heading tone-edge">{ratingHeader}</div>
        <div id="company-hq-rating-value" class="label rating-value tone-accent">{rating}</div>
        <div id="company-hq-rating-score" class="label tone-muted">{ratingScore}</div>
      </div>
      <div id="company-hq-adjutant" class="adjutant-block">
        <div id="company-hq-assessment-header" class="label heading tone-edge">{assessmentHeader}</div>
        <div id="company-hq-assessment-copy" class="label assessment-copy">{assessment}</div>
      </div>
    </div>

    <div id="company-hq-main" class="company-hq-main">
      <div id="company-hq-sidebar" class="company-hq-sidebar">
        <div id="company-hq-force" class="panel console-section sidebar-section force-section">
          <div id="company-hq-force-header" class="label heading tone-edge section-header">{statusHeader}</div>
          <div id="company-hq-stat-grid" class="stat-grid">
            <div each="card in statusCards" key="{card.id}" id="{card.id}" class="{card.classes}">
              <div id="{card.valueId}" class="label stat-value tone-accent">{card.value}</div>
              <div id="{card.labelId}" class="label heading tone-edge">{card.label}</div>
              <div id="{card.detailId}" class="label tone-muted stat-detail">{card.detail}</div>
            </div>
          </div>
          <div id="company-hq-ship-actions" class="hq-ship-actions">
          <button id="company-hq-ship" class="hq-ship-button console-action" onclick="{shipAction}">
            <div id="company-hq-ship-label" class="label heading hq-ship-label">{shipLabel}</div>
          </button>
          <button id="company-hq-ship-view" class="{shipView.classes}" onclick="{shipViewAction}">
            <div id="company-hq-ship-view-label" class="{shipView.labelClasses}">{shipView.label}</div>
            <div id="company-hq-ship-view-track" class="{shipView.trackClasses}">
              <div id="company-hq-ship-view-fill" class="hq-ship-fill" style="{shipView.fillStyle}" />
            </div>
          </button>
        </div>
        </div>

        <div id="company-hq-finance" class="panel console-section sidebar-section finance-section">
          <div id="company-hq-finance-header" class="label heading tone-edge section-header">{financeHeader}</div>
          <div id="company-hq-runway" class="runway-block console-well">
            <div id="company-hq-runway-value" class="{runwayClasses}">{runway}</div>
            <div id="company-hq-runway-caption" class="label tone-muted">{runwayCaption}</div>
          </div>
          <div id="company-hq-finance-rows" class="info-list">
            <div each="row in financeRows" key="{row.id}" id="{row.id}" class="info-row">
              <div id="{row.labelId}" class="label tone-muted info-label">{row.label}</div>
              <div id="{row.valueId}" class="{row.valueClasses}">{row.value}</div>
            </div>
          </div>
        </div>

        <div id="company-hq-standing" class="panel console-section sidebar-section standing-section">
          <div id="company-hq-standing-header" class="label heading tone-edge section-header">{standingHeader}</div>
          <div id="company-hq-employers" class="employer-list">
            <div each="employer in employers" key="{employer.id}" id="{employer.id}" class="employer-row">
              <div id="{employer.nameId}" class="label employer-name">{employer.name}</div>
              <div id="{employer.scoreId}" class="{employer.scoreClasses}">{employer.score}</div>
              <div id="{employer.recordId}" class="label tone-muted employer-record">{employer.record}</div>
            </div>
          </div>
          <div id="company-hq-employer-empty" class="label tone-muted empty-copy">{employerEmpty}</div>
        </div>
      </div>

      <div id="company-hq-board" class="panel console-section company-hq-board">
        <div id="company-hq-board-heading" class="board-heading console-header">
          <div id="company-hq-board-title" class="label heading tone-edge">{boardHeader}</div>
          <div id="company-hq-board-intro" class="label tone-muted">{boardIntro}</div>
        </div>
        <div id="company-hq-board-columns" class="board-columns">
          <div id="company-hq-obligations" class="board-column obligations-column">
            <div id="company-hq-obligations-header" class="label heading tone-accent column-header">{obligationsHeader}</div>
            <div id="company-hq-obligation-list" class="post-list">
              <div each="post in obligations" key="{post.id}" id="{post.id}" class="{post.classes}">
                <div id="{post.bodyId}" class="post-body">
                  <div id="{post.kickerId}" class="label heading tone-danger post-kicker">{post.kicker}</div>
                  <div id="{post.headlineId}" class="label post-headline">{post.headline}</div>
                  <div id="{post.detailId}" class="label tone-muted post-detail">{post.detail}</div>
                </div>
                <button id="{post.actionId}" class="post-action console-action" disabled="{post.disabled}" onclick="{post.action}">{post.actionLabel}</button>
              </div>
            </div>
            <div id="company-hq-obligation-empty" class="label tone-muted empty-copy">{obligationEmpty}</div>
          </div>

          <div id="company-hq-news" class="board-column news-column">
            <div id="company-hq-news-header" class="label heading tone-accent column-header">{newsHeader}</div>
            <div id="company-hq-news-list" class="post-list">
              <div each="post in newsPosts" key="{post.id}" id="{post.id}" class="{post.classes}">
                <div id="{post.kickerId}" class="label heading tone-edge post-kicker">{post.kicker}</div>
                <div id="{post.headlineId}" class="label post-headline">{post.headline}</div>
                <div id="{post.detailId}" class="label tone-muted post-detail">{post.detail}</div>
              </div>
            </div>
            <div id="company-hq-news-empty" class="label tone-muted empty-copy">{newsEmpty}</div>
          </div>
        </div>
      </div>
    </div>

  </div>
</template>

<style>
  .company-hq-root { flex-direction: column; padding: 10px; gap: 8px; border-width: 2px; overflow: hidden; }
  .label { overflow: hidden; }
  .heading { font-family: heading; }
  .assessment-panel { flex-direction: row; height: 94px; padding: 8px 12px; gap: 14px; border-width: 2px; }
  .rating-block { flex-direction: column; width: 216px; padding: 7px 9px; gap: 3px; border-width: 2px; }
  .rating-value { height: 25px; font-family: title; }
  .adjutant-block { flex-direction: column; flex-grow: 1; padding: 7px 9px; gap: 6px; }
  .assessment-copy { font-family: body; height: auto; white-space: normal; }
  .company-hq-main { flex-direction: row; flex-grow: 1; gap: 8px; overflow: hidden; }
  .company-hq-sidebar { flex-direction: column; width: 406px; gap: 10px; overflow: scroll; }
  .sidebar-section { flex-direction: column; padding: 10px; gap: 8px; border-width: 2px; }
  .section-header { height: 18px; }
  .force-section { height: 254px; }
  .stat-grid { display: grid; flex-grow: 0; gap: 6px; overflow: hidden; height: 178px; }
  .stat-card { flex-direction: column; width: 166px; height: 68px; padding: 8px; gap: 4px; border-width: 1px; background-color: #20282d; border-color: #526065; }
  .stat-value { height: 22px; font-family: title; }
  .stat-detail { height: 20px; white-space: normal; }
  .finance-section { height: 230px; }
  .runway-block { flex-direction: column; height: 64px; padding: 6px 8px; gap: 2px; border-width: 2px; }
  .runway-value { height: 24px; font-family: title; overflow: hidden; }
  .info-list { flex-direction: column; flex-grow: 1; overflow: scroll; display: grid; gap: 8px; }
  .info-row { flex-direction: column; height: 42px; padding: 6px; border-width: 0px; border-color: #263b51; width: 174px; gap: 5px; }
  .info-label { flex-grow: 0; height: 18px; }
  .info-value { width: 100%; text-align: left; height: 22px; white-space: normal; }
  .standing-section { height: 222px; }
  .employer-list { flex-direction: column; flex-grow: 1; overflow: scroll; }
  .employer-row { flex-direction: row; height: 40px; padding: 6px; gap: 8px; border-width: 0px; border-color: #263b51; }
  .employer-name { width: 118px; flex-grow: 0; height: auto; white-space: normal; }
  .employer-score { width: 38px; text-align: left; }
  .employer-record { width: 0px; text-align: left; flex-grow: 1; height: auto; white-space: normal; }
  .company-hq-board { flex-direction: column; flex-grow: 1; padding: 12px; gap: 14px; border-width: 2px; overflow: hidden; }
  .board-heading { flex-direction: column; height: 76px; padding: 10px; gap: 8px; border-width: 2px; }
  .board-columns { flex-direction: row; flex-grow: 1; gap: 18px; overflow: hidden; }
  .board-column { flex-direction: column; gap: 6px; overflow: hidden; }
  .obligations-column { width: 46%; }
  .news-column { flex-grow: 1; }
  .column-header { height: 20px; padding: 2px 3px; }
  .post-list { flex-direction: column; flex-grow: 1; gap: 10px; overflow: scroll; }
  .post-card { flex-direction: row; align-items: center; height: 88px; padding: 10px; gap: 10px; border-width: 2px; background-color: #20282d; border-color: #526065; }
  .post-body { flex-direction: column; height: 88px; flex-grow: 1; gap: 7px; overflow: hidden; }
  .post-kicker { height: 16px; }
  .post-headline { height: auto; white-space: normal; }
  .post-detail { height: auto; white-space: normal; }
  .post-action { width: 104px; padding: 4px; border-width: 3px; font-family: heading; text-align: center; height: 34px; }
  .news-card { flex-direction: column; height: 80px; padding: 10px; gap: 9px; border-width: 1px; background-color: #20282d; border-color: #526065; }
  .warning-surface { background-color: #332b1c; border-color: #ffd464; }
  .rumor-surface { background-color: #172638; border-color: #6ed7ff; }
  .empty-copy { height: 22px; padding: 3px; }
  .hq-ship-button { width: 100%; height: 30px; padding: 3px; border-width: 3px; border-color: #31485f; }
  .hq-ship-waiting { border-color: #2d4250; background-color: #101a22; }
  .hq-ship-waiting-label { color: #6f8797; }
  .hq-ship-label { width: 100%; height: 18px; text-align: center; }
  .hq-ship-track-idle { width: 100%; height: 4px; flex-direction: row; }
  .hq-ship-track { width: 100%; height: 4px; flex-direction: row; background-color: #0c1620; }
  .hq-ship-fill { height: 100%; background-color: #4d7ea0; }
  .stat-card .heading { height: auto; white-space: normal; }
  #company-hq-board-intro { height: auto; white-space: normal; }
  .hq-ship-actions { flex-direction: row; height: 42px; gap: 6px; }
  .hq-ship-actions button { width: 0px; flex-grow: 1; }
  .hq-ship-label { white-space: normal; height: auto; }
</style>
