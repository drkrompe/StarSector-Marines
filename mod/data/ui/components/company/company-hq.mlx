<template props="auxiliary,handover,debugAction,debugClasses,deckSituation,deckComms,deckCastle,deckFinance,openingGuide,newsDesk,purpose,returnAction,hqAction,barracksAction,armoryAction,mechLabAction,boatsAction,engineeringAction,hqClasses,barracksClasses,armoryClasses,mechLabClasses,engineeringClasses,boatsClasses,assessmentHeader,ratingHeader,rating,ratingScore,assessment,financeHeader,runway,runwayCaption,runwayClasses,financeRows,obligationsHeader,obligations,obligationEmpty">
  <div id="company-hq-root" class="company-hq-root">
    <marine-ops-page-nav returnAction="{returnAction}" hqAction="{hqAction}" barracksAction="{barracksAction}" armoryAction="{armoryAction}" mechLabAction="{mechLabAction}" boatsAction="{boatsAction}" engineeringAction="{engineeringAction}" engineeringClasses="{engineeringClasses}" hqClasses="{hqClasses}" barracksClasses="{barracksClasses}" armoryClasses="{armoryClasses}" mechLabClasses="{mechLabClasses}" boatsClasses="{boatsClasses}" contextLabel="{purpose}" />

    <div id="company-hq-main" class="company-hq-main">
      <div id="company-hq-board" class="panel console-section company-hq-board">
        <div id="company-hq-deck" class="command-deck">
          <canvas id="company-hq-deck-canvas" class="deck-canvas" width="1486" height="300" />
          <button id="company-hq-station-situation" class="deck-station" style="background-color: transparent; background-image: none; border-width: 0px; opacity: 1;" onclick="{deckSituation}">
            <div id="company-hq-station-situation-label" class="label heading deck-station-label">{i18n.openingUiCompanyHqStationSituation}</div>
          </button>
          <button id="company-hq-station-comms" class="deck-station" style="background-color: transparent; background-image: none; border-width: 0px; opacity: 1;" onclick="{deckComms}">
            <div id="company-hq-station-comms-label" class="label heading deck-station-label">{i18n.openingUiCompanyHqStationComms}</div>
          </button>
          <button id="company-hq-station-castle" class="deck-station" style="background-color: transparent; background-image: none; border-width: 0px; opacity: 1;" onclick="{deckCastle}">
            <div id="company-hq-station-castle-label" class="label heading deck-station-label">{i18n.openingUiCompanyHqStationCastle}</div>
          </button>
          <button id="company-hq-station-finance" class="deck-station" style="background-color: transparent; background-image: none; border-width: 0px; opacity: 1;" onclick="{deckFinance}">
            <div id="company-hq-station-finance-label" class="label heading deck-station-label">{i18n.openingUiCompanyHqStationFinance}</div>
          </button>
        </div>
        <div id="company-hq-board-heading" class="board-heading console-header">
          <div id="company-hq-rating" class="rating-block">
            <div id="company-hq-rating-header" class="label heading tone-edge">{ratingHeader}</div>
            <div id="company-hq-rating-line" class="rating-line">
              <div id="company-hq-rating-value" class="label rating-value tone-accent">{rating}</div>
              <div id="company-hq-rating-score" class="label tone-muted rating-score">{ratingScore}</div>
            </div>
          </div>
          <div id="company-hq-adjutant" class="adjutant-block">
            <div id="company-hq-assessment-header" class="label heading tone-edge">{assessmentHeader}</div>
            <div id="company-hq-assessment-copy" class="label assessment-copy">{assessment}</div>
          </div>
          <button id="company-hq-debug" class="{debugClasses}" onclick="{debugAction}">{i18n.openingUiCompanyHqDebugMissions}</button>
        </div>
        <div id="company-hq-board-columns" class="board-columns">
          <div id="company-hq-finance" class="board-column finance-column">
            <div id="company-hq-finance-header" class="label heading tone-accent column-header">{financeHeader}</div>
            <div id="company-hq-runway" class="runway-block console-well">
              <div id="company-hq-runway-value" class="{runwayClasses}">{runway}</div>
              <div id="company-hq-runway-caption" class="label tone-muted">{runwayCaption}</div>
            </div>
            <div id="company-hq-finance-rows" class="info-list">
              <div each="row in financeRows" key="{row.id}" id="{row.id}" class="info-row">
                <div id="{row.labelId}" class="label tone-muted info-label">{row.label}</div>
                <div id="{row.valueId}" class="{row.valueClasses}">{row.value}</div>
              </div>
            </div>
          </div>
          <div id="company-hq-obligations" class="board-column obligations-column">
            <div id="company-hq-opening-guide" class="{openingGuide.classes}">
              <div id="company-hq-opening-heading" class="opening-heading">
                <img id="company-hq-opening-crest" class="opening-crest" src="{openingGuide.crest}" />
                <div id="company-hq-opening-label" class="label heading tone-accent opening-label">{openingGuide.heading}</div>
              </div>
              <div id="company-hq-opening-contact" class="opening-contact">
                <img id="company-hq-opening-portrait" class="opening-portrait" src="{openingGuide.portrait}" />
                <div id="company-hq-opening-identity" class="opening-identity">
                  <div id="company-hq-opening-name" class="label heading opening-copy">{openingGuide.broker}</div>
                  <div id="company-hq-opening-affiliation" class="label tone-muted opening-copy">{openingGuide.affiliation}</div>
                </div>
              </div>
              <div id="company-hq-opening-location" class="label tone-accent opening-copy">{openingGuide.location}</div>
              <div id="company-hq-opening-mission" class="label opening-mission">{openingGuide.mission}</div>
              <div id="company-hq-opening-payment" class="label tone-accent opening-copy">{openingGuide.payment}</div>
              <div id="company-hq-opening-route" class="label opening-copy">{openingGuide.route}</div>
              <div id="company-hq-opening-preparation" class="label tone-muted opening-copy">{openingGuide.preparation}</div>
              <button id="company-hq-opening-course" class="opening-course" disabled="{openingGuide.courseDisabled}" onclick="{openingGuide.courseAction}">
                <div id="company-hq-opening-course-label" class="console-key-legend">{i18n.openingUiCompanyHqPlotCourse}</div>
                <img id="company-hq-opening-course-grip" class="console-key-grip" src="graphics/ui/console/key-grip.svg" />
              </button>
            </div>
            <div id="company-hq-obligations-header" class="label heading tone-accent column-header">{obligationsHeader}</div>
            <div id="company-hq-letters" class="hq-letters">
              <button id="company-hq-auxiliary" class="{auxiliary.resumeClasses}" onclick="{auxiliary.open}">{auxiliary.resumeLabel}</button>
              <button id="company-hq-handover" class="{handover.resumeClasses}" onclick="{handover.open}">{handover.resumeLabel}</button>
            </div>
            <div id="company-hq-obligation-list" class="post-list">
              <div each="post in obligations" key="{post.id}" id="{post.id}" class="{post.classes}">
                <div id="{post.bodyId}" class="post-body">
                  <div id="{post.kickerId}" class="label heading tone-danger post-kicker">{post.kicker}</div>
                  <div id="{post.headlineId}" class="label post-headline">{post.headline}</div>
                  <div id="{post.detailId}" class="label tone-muted post-detail">{post.detail}</div>
                </div>
                <button id="{post.actionId}" class="post-action console-action" disabled="{post.disabled}" onclick="{post.action}">{post.actionLabel}</button>
              </div>
            </div>
            <div id="company-hq-obligation-empty" class="label tone-muted empty-copy">{obligationEmpty}</div>
          </div>

          <div id="company-hq-news" class="board-column news-column">
            <div id="company-hq-source-windows" class="source-windows">
              <div each="channel in newsDesk.sources" key="{channel.id}" id="{channel.id}" class="source-window console-readout">
                <div id="{channel.headerId}" class="source-heading">
                  <img id="{channel.iconId}" class="source-icon" src="{channel.icon}" />
                  <div id="{channel.copyId}" class="source-heading-copy">
                    <div id="{channel.labelId}" class="label heading tone-accent source-label">{channel.label}</div>
                    <div id="{channel.countId}" class="label tone-muted source-count">{channel.count}</div>
                  </div>
                </div>
                <div id="{channel.listId}" class="source-teasers">
                  <button each="report in channel.reports" key="{report.id}" id="{report.id}" class="{report.classes}" onclick="{report.action}">
                    <div id="{report.kickerId}" class="label heading tone-muted teaser-kicker">{report.kicker}</div>
                    <div id="{report.headlineId}" class="label teaser-headline">{report.headline}</div>
                  </button>
                </div>
                <div id="{channel.emptyId}" class="{channel.emptyClasses}">{channel.empty}</div>
              </div>
            </div>
            <div id="company-hq-editorial-desk" class="editorial-desk">
              <div id="company-hq-focus" class="{newsDesk.classes}">
                <div id="company-hq-focus-header" class="focus-header">
                  <img id="company-hq-focus-lock" class="focus-lock" src="graphics/ui/console/locking-plate.svg" />
                  <div id="company-hq-focus-slug" class="label heading tone-accent">{i18n.openingUiCompanyHqDecryptedDossierCommandAccess}</div>
                </div>
                <div id="company-hq-dossier-heading" class="dossier-heading">
                  <img id="company-hq-dossier-crest" class="{newsDesk.crestClasses}" src="{newsDesk.crest}" />
                  <div id="company-hq-dossier-copy" class="dossier-copy">
                    <div id="company-hq-focus-kicker" class="label heading focus-kicker">{newsDesk.kicker}</div>
                    <div id="company-hq-focus-headline" class="label title focus-headline">{newsDesk.headline}</div>
                    <div id="company-hq-dossier-subject" class="label tone-muted dossier-subject">{newsDesk.subject}</div>
                  </div>
                </div>
                <div id="company-hq-focus-story" class="focus-story">
                  <div id="company-hq-focus-source" class="label heading tone-muted focus-source">{newsDesk.source}</div>
                  <div id="company-hq-focus-detail" class="label focus-detail">{newsDesk.detail}</div>
                </div>
                <div id="company-hq-focus-caution" class="label tone-accent focus-caution">{newsDesk.caution}</div>
                <canvas id="company-hq-dossier-scan" class="dossier-scan" width="1180" height="190" />
              </div>
              <div id="company-hq-rundown" class="news-rundown">
                <div id="company-hq-rundown-header" class="rundown-header">
                  <div id="company-hq-rundown-heading" class="label heading tone-accent">{i18n.openingUiCompanyHqTransmissionArchive}</div>
                  <div id="company-hq-rundown-count" class="label tone-muted">{newsDesk.count}</div>
                </div>
                <div id="company-hq-channel-tabs" class="channel-tabs">
                  <button each="tab in newsDesk.tabs" key="{tab.id}" id="{tab.id}" class="{tab.classes}" onclick="{tab.action}">{tab.label}</button>
                </div>
                <div id="company-hq-news-list" class="rundown-list">
                  <button each="report in newsDesk.reports" key="{report.id}" id="{report.id}" class="{report.classes}" onclick="{report.action}">
                    <div id="{report.kickerId}" class="label heading tone-muted teaser-kicker">{report.kicker}</div>
                    <div id="{report.headlineId}" class="label teaser-headline">{report.headline}</div>
                    <div id="{report.sourceId}" class="label tone-muted rundown-source">{report.source}</div>
                  </button>
                </div>
                <div id="company-hq-news-empty" class="{newsDesk.emptyClasses}">{newsDesk.empty}</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div id="aux-modal" class="{auxiliary.classes}">
      <div id="aux-space-above" class="aux-space" />
      <div id="aux-letter" class="aux-letter console-readout">
        <div id="aux-heading" class="aux-heading">
          <img id="aux-crest" class="aux-crest" src="{auxiliary.crest}" />
          <div id="aux-heading-copy" class="aux-heading-copy">
            <div id="aux-title" class="label heading tone-edge aux-title">{auxiliary.title}</div>
            <div id="aux-from" class="label tone-muted aux-from">{auxiliary.from}</div>
          </div>
        </div>
        <div id="aux-record" class="label aux-part">{auxiliary.record}</div>
        <div id="aux-grants" class="{auxiliary.grantsClasses}">{auxiliary.grants}</div>
        <div id="aux-obligations" class="{auxiliary.partClasses}">{auxiliary.obligations}</div>
        <div id="aux-limits" class="{auxiliary.partClasses}">{auxiliary.limits}</div>
        <div id="aux-decline-note" class="{auxiliary.noteClasses}">{auxiliary.declineNote}</div>
        <div id="aux-fill" class="aux-space" />
        <div id="aux-controls" class="aux-controls">
          <button id="aux-accept" class="{auxiliary.answerClasses}" onclick="{auxiliary.accept}">{auxiliary.acceptLabel}</button>
          <button id="aux-decline" class="{auxiliary.answerClasses}" onclick="{auxiliary.decline}">{auxiliary.declineLabel}</button>
          <button id="aux-close" class="aux-action console-action" onclick="{auxiliary.close}">{auxiliary.closeLabel}</button>
        </div>
      </div>
      <div id="aux-space-below" class="aux-space" />
    </div>
    <div id="handover-modal" class="{handover.classes}">
      <div id="handover-space-above" class="aux-space" />
      <div id="handover-letter" class="handover-letter console-readout">
        <div id="handover-heading" class="aux-heading">
          <img id="handover-crest" class="aux-crest" src="{handover.crest}" />
          <div id="handover-heading-copy" class="aux-heading-copy">
            <div id="handover-title" class="label heading tone-edge aux-title">{handover.title}</div>
            <div id="handover-from" class="label tone-muted aux-from">{handover.from}</div>
          </div>
        </div>
        <div id="handover-tabs" class="{handover.tabClasses}">
          <button id="handover-custody" class="{handover.custodyTabClasses}" onclick="{handover.custody}">{handover.custodyTabLabel}</button>
          <button id="handover-compact" class="{handover.compactTabClasses}" onclick="{handover.compact}">{handover.compactTabLabel}</button>
          <button id="handover-compare" class="{handover.compareTabClasses}" onclick="{handover.compare}">{handover.compareTabLabel}</button>
        </div>
        <div id="handover-record" class="label aux-part">{handover.record}</div>
        <div id="handover-undertaking" class="{handover.termsClasses}">{handover.undertaking}</div>
        <div id="handover-benefit" class="{handover.partClasses}">{handover.benefit}</div>
        <div id="handover-cost" class="{handover.partClasses}">{handover.cost}</div>
        <div id="handover-letter-copy" class="{handover.letterClasses}">{handover.letter}</div>
        <div id="handover-fill" class="aux-space" />
        <div id="handover-controls" class="aux-controls">
          <button id="handover-primary" class="{handover.primaryClasses}" onclick="{handover.primary}">{handover.primaryLabel}</button>
          <button id="handover-secondary" class="{handover.secondaryClasses}" onclick="{handover.secondary}">{handover.secondaryLabel}</button>
          <button id="handover-close" class="aux-action console-action" onclick="{handover.close}">{handover.closeLabel}</button>
        </div>
      </div>
      <div id="handover-space-below" class="aux-space" />
    </div>
  </div>
</template>

<style>
  .aux-backdrop { position: absolute; left: 0px; top: 0px; width: 100%; height: 100%; flex-direction: column; align-items: center; background-color: #080e12d9; }
  .aux-hidden { position: absolute; width: 0px; height: 0px; opacity: 0; pointer-events: none; overflow: hidden; }
  .aux-hidden-part { width: 0px; height: 0px; padding: 0px; border-width: 0px; overflow: hidden; opacity: 0; pointer-events: none; }
  .aux-space { height: 0px; flex-grow: 1; }
  .aux-letter { width: 980px; height: 400px; padding: 20px; gap: 12px; flex-direction: column; border-width: 2px; border-color: #c9b77a; background-color: #1c2826; }
  .aux-heading { flex-direction: row; height: 64px; gap: 14px; align-items: center; }
  .aux-crest { width: 60px; height: 60px; pointer-events: none; }
  .aux-heading-copy { flex-direction: column; width: 0px; flex-grow: 1; gap: 6px; }
  .aux-title { height: 22px; }
  .aux-from { height: 18px; }
  .aux-part { height: auto; white-space: normal; }
  .aux-grants { padding: 8px; border-width: 1px; border-color: #8c815d; background-color: #26302b; }
  .aux-controls { flex-direction: row; height: 34px; gap: 12px; }
  .handover-letter { width: 1120px; height: 500px; padding: 20px; gap: 12px; flex-direction: column; border-width: 2px; border-color: #c9b77a; background-color: #1c2826; }
  .handover-tab-current { border-color: #e6d28c; background-color: #34402f; }
  .aux-action { width: 0px; flex-grow: 1; height: 26px; padding: 4px 8px; border-width: 2px; font-family: heading; text-align: center; }
  .hq-wings { height: 52px; width: 100%; flex-grow: 0; text-align: left; padding: 4px 8px; font-family: heading; white-space: normal; }
.hq-debug { width: 168px; height: 34px; text-align: center; font-family: heading; border-width: 2px; }
.hq-debug-hidden { width: 0px; height: 0px; opacity: 0; pointer-events: none; }
  .company-hq-root { flex-direction: column; padding: 10px; gap: 8px; border-width: 2px; overflow: hidden; }
  .label { overflow: hidden; }
  .heading { font-family: heading; }
  .command-deck { height: 372px; flex-grow: 0; overflow: hidden; border-width: 1px; border-color: #3a3424; background-color: #0b0c0a; }
  .deck-canvas { position: absolute; left: 0px; top: 0px; width: 100%; height: 100%; pointer-events: none; }
  .rating-block { flex-direction: column; width: 260px; flex-grow: 0; gap: 4px; }
  .rating-line { flex-direction: row; align-items: center; height: 25px; gap: 12px; }
  .rating-value { height: 25px; width: auto; font-family: title; }
  .rating-score { width: auto; }
  .adjutant-block { flex-direction: column; width: 0px; flex-grow: 1; gap: 4px; }
  .assessment-copy { font-family: body; height: auto; white-space: normal; }
  #company-hq-deck .deck-station { position: absolute; flex-direction: column; align-items: flex-start; padding: 8px; }
  #company-hq-deck .deck-station-label { height: 18px; width: auto; padding: 1px 6px; background-color: #07090ad8; color: #e6d28c; opacity: 0; }
  #company-hq-deck .deck-station:hover .deck-station-label { opacity: 1; }
  #company-hq-deck .deck-station:focus-visible .deck-station-label { opacity: 1; }
  .deck-pulse { border-color: #e6d28c; background-color: #2c2a1c; }
  .company-hq-main { flex-direction: row; flex-grow: 1; gap: 8px; overflow: hidden; }
  .section-header { height: 18px; }
  .runway-block { flex-direction: column; height: 64px; padding: 6px 8px; gap: 2px; border-width: 2px; }
  .runway-value { height: 24px; font-family: title; overflow: hidden; }
  .info-list { flex-direction: column; flex-grow: 1; overflow: scroll; display: grid; gap: 8px; }
  .info-row { flex-direction: column; height: 42px; padding: 6px; border-width: 0px; border-color: #263b51; width: 174px; gap: 5px; }
  .info-label { flex-grow: 0; height: 18px; }
  .info-value { width: 100%; text-align: left; height: 22px; white-space: normal; }
  .warrant-score { width: 70px; }
  .company-hq-board { flex-direction: column; flex-grow: 1; padding: 9px; gap: 9px; border-width: 2px; overflow: hidden; }
  .board-heading { flex-direction: row; align-items: center; height: 58px; flex-grow: 0; padding: 6px 10px; gap: 18px; border-width: 2px; }
  .board-columns { flex-direction: row; flex-grow: 1; gap: 10px; overflow: hidden; height: 0px; }
  .board-column { flex-direction: column; gap: 6px; overflow: hidden; }
  .opening-guide { flex-direction: column; padding: 9px; gap: 8px; border-width: 1px; border-color: #8c815d; height: 286px; flex-grow: 0; }
  .opening-unavailable { height: 320px; }
  .opening-guide-hidden { position: absolute; width: 0px; height: 0px; padding: 0px; gap: 0px; border-width: 0px; flex-grow: 0; overflow: hidden; opacity: 0; pointer-events: none; }
  .opening-contact { flex-direction: row; height: 64px; gap: 9px; align-items: center; }
  .opening-portrait { width: 64px; height: 64px; }
  .opening-identity { flex-direction: column; width: 0px; flex-grow: 1; gap: 5px; }
  .opening-course { flex-direction: row; align-items: center; height: 28px; padding: 2px 6px; gap: 5px; border-width: 3px; }
  .opening-heading { flex-direction: row; align-items: center; height: 32px; gap: 8px; }
  .opening-crest { width: 32px; height: 32px; }
  .opening-label { height: auto; white-space: normal; width: 0px; flex-grow: 1; }
  .opening-mission { font-family: title; height: auto; white-space: normal; }
  .opening-copy { height: auto; white-space: normal; }
  .obligations-column { width: 260px; }
  .finance-column { width: 260px; }
  .finance-column .info-row { width: 118px; }
  .finance-column .runway-block { height: auto; }
  .finance-column .runway-block .label { height: auto; white-space: normal; }
  .hq-letters { flex-direction: column; height: auto; flex-grow: 0; gap: 6px; }
  .news-column { flex-grow: 1; width: 0px; gap: 10px; }
  .column-header { height: 20px; padding: 2px 3px; }
  .post-list { flex-direction: column; flex-grow: 1; gap: 10px; overflow: scroll; }
  .post-card { flex-direction: column; align-items: stretch; height: 132px; padding: 8px; gap: 7px; border-width: 2px; background-color: #20282d; border-color: #526065; }
  .post-body { flex-direction: column; height: 84px; flex-grow: 0; gap: 7px; overflow: hidden; }
  .post-kicker { height: 16px; }
  .post-headline { height: 26px; white-space: normal; }
  .post-detail { height: 34px; white-space: normal; }
  .post-action { width: 110px; padding: 4px 8px; border-width: 2px; font-family: heading; text-align: center; height: 20px; }
  .warning-surface { background-color: #332b1c; border-color: #ffd464; }
  .rumor-surface { background-color: #172638; border-color: #6ed7ff; }
  .empty-copy { height: 22px; padding: 3px; }
  .source-windows { flex-direction: row; height: 96px; gap: 7px; }
  .source-window { flex-direction: column; width: 0px; flex-grow: 1; height: 76px; padding: 6px; gap: 3px; border-width: 2px; overflow: hidden; }
  .source-label { height: 16px; width: 0px; flex-grow: 1; }
  .source-count { height: 14px; width: 90px; font-family: compact; }
  .source-teasers { flex-direction: column; height: 40px; overflow: hidden; }
  .wire-report { flex-direction: column; height: 63px; padding: 5px 7px; gap: 4px; border-width: 1px; text-align: left; }
  .teaser-kicker { height: 15px; }
  .teaser-headline { height: 36px; white-space: normal; }
  .source-empty { height: 30px; white-space: normal; }
  .editorial-desk { flex-direction: column; height: 0px; flex-grow: 1; gap: 10px; overflow: hidden; }
  .lead-story { flex-direction: column; width: auto; flex-grow: 0; padding: 8px 10px; gap: 5px; border-width: 2px; overflow: hidden; height: 166px; }
  .focus-header { flex-direction: row; height: 20px; gap: 8px; align-items: center; }
  .focus-lock { width: 20px; height: 24px; }
  #company-hq-focus-slug { width: 0px; flex-grow: 1; height: 18px; white-space: normal; }
  .focus-kicker { height: 14px; }
  .focus-headline { height: 25px; white-space: normal; }
  .focus-source { height: 26px; padding: 5px; border-width: 1px; border-color: #697c7b; white-space: normal; width: 220px; font-family: compact; }
  .focus-detail { height: 40px; white-space: normal; width: 0px; flex-grow: 1; padding: 0px; }
