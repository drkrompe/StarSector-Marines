<template props="row">
  <div id="{row.id}" class="{row.classes}">
    <div id="{row.lineId}" class="company-resource-cost-line">
      <div id="{row.nameId}" class="label company-resource-cost-name">{row.name}</div>
      <img id="{row.iconId}" class="company-resource-cost-icon" src="{row.icon}" />
      <div id="{row.labelId}" class="label company-resource-cost-value">{row.cost}</div>
    </div>
    <div id="{row.shortId}" class="label company-resource-short">{row.shortage}</div>
  </div>
</template>
<style>
  .company-resource-cost { flex-direction: column; justify-content: center; width: 100%; height: 34px; padding: 1px 6px; border-width: 1px; border-color: #315166; background-color: #071014; }
  .company-resource-cost.short { border-color: #a05d52; }
  .company-resource-cost-line { flex-direction: row; align-items: center; width: 100%; height: 18px; gap: 5px; }
  .company-resource-cost-name { width: 0px; flex-grow: 1; height: 18px; color: #9fb4c2; }
  .company-resource-cost-icon { width: 16px; height: 16px; }
  .company-resource-cost-value { width: auto; height: 18px; text-align: right; color: #dfc588; }
  .company-resource-short { height: 0px; color: #eea296; text-align: right; }
  .company-resource-cost.short .company-resource-short { height: 14px; }
</style>
