<template props="row">
  <div id="{row.id}" class="{row.classes}">
    <div id="{row.lineId}" class="company-resource-cost-line">
      <img id="{row.iconId}" class="company-resource-cost-icon" src="{row.icon}" />
      <div id="{row.nameId}" class="label company-resource-cost-name">{row.name}</div>
      <div id="{row.labelId}" class="label company-resource-cost-value">{row.cost}</div>
    </div>
    <div id="{row.shortId}" class="label company-resource-short">{row.shortage}</div>
  </div>
</template>
<style>
  .company-resource-cost { flex-direction: column; width: 100%; height: 34px; padding: 1px 3px; border-width: 1px; border-color: #46554b; background-color: #121719; }
  .company-resource-cost.short { border-color: #a05d52; }
  .company-resource-cost-line { flex-direction: row; align-items: center; width: 100%; height: 16px; gap: 4px; }
  .company-resource-cost-icon { width: 16px; height: 16px; }
  .company-resource-cost-name { text-align: left; width: 0px; flex-grow: 1; height: 16px; }
  .company-resource-cost-value { width: 100px; height: 16px; text-align: right; color: #dfc588; }
  .company-resource-short { height: 14px; color: #eea296; text-align: right; }
</style>
