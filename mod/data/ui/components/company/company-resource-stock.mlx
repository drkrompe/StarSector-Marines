<template props="rows,stockId">
  <div id="{stockId}" class="company-resource-stock">
    <div id="company-resource-stock-rows" class="company-resource-stock-rows">
    <div each="item in rows" key="{item.id}" id="{item.id}" class="company-resource-stock-item">
      <img id="{item.iconId}" class="company-resource-icon" src="{item.icon}" />
      <div id="{item.labelId}" class="label company-resource-stock-value">{item.stock}</div>
    </div>
    </div>

  </div>
</template>
<style>
  .company-resource-stock { flex-direction: row; align-items: center; height: 46px; gap: 12px; padding: 3px 12px; background-color: #121719; border-width: 1px; border-color: #596052; }
  .company-resource-stock-rows { height: 36px; flex-direction: row; width: 0px; flex-grow: 1; gap: 28px; align-items: center; }
  .company-resource-stock-item { flex-direction: row; align-items: center; width: 150px; height: 36px; gap: 8px; }
  .company-resource-icon { width: 28px; height: 28px; }
  .company-resource-stock-value { width: 0px; flex-grow: 1; height: 18px; color: #e4e6d7; }
</style>
