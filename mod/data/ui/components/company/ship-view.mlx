<template props="equipmentAction,survey,workshop,roomTitle,roomCopy,contextLabel,returnAction,hqAction,barracksAction,armoryAction,mechLabAction,boatsAction,hqClasses,barracksClasses,armoryClasses,mechLabClasses,boatsClasses">
  <div id="ship-view-root" class="ship-view-root">
    <marine-ops-page-nav returnAction="{returnAction}" hqAction="{hqAction}" barracksAction="{barracksAction}" armoryAction="{armoryAction}" mechLabAction="{mechLabAction}" boatsAction="{boatsAction}" hqClasses="{hqClasses}" barracksClasses="{barracksClasses}" armoryClasses="{armoryClasses}" mechLabClasses="{mechLabClasses}" boatsClasses="{boatsClasses}" contextLabel="{contextLabel}" />

    <div id="ship-view-room-bar" class="panel ship-view-room-bar console-header">
      <img id="ship-view-service-plate" class="company-service-plate" src="graphics/ui/console/service-plate.svg" />
      <div id="ship-view-room-title" class="label heading tone-edge">{roomTitle}</div>
      <div id="ship-view-room-copy" class="label tone-muted">{roomCopy}</div>
      <button id="machine-shop-equipment" class="machine-shop-equipment console-action" onclick="{equipmentAction}">MACHINE SHOP / FIT SQUADS FOR FREE</button>
    </div>

    <div id="ship-view-body" class="ship-view-body">
    <div id="ship-view-stage" class="panel ship-view-stage console-well">
      <canvas id="ship-view-deck" class="ship-view-deck" width="1600" height="900" />
    </div>
    <div id="ship-condition" class="{survey.classes}">
      <div id="survey-heading" class="{survey.headingClasses}">{survey.summary}</div>
      <div id="ship-condition-rooms" class="{survey.listClasses}">
        <button each="room in survey.rooms" key="{room.id}" id="{room.id}" class="{room.classes}" onclick="{room.select}">
          <div id="{room.nameId}" class="label heading survey-name">{room.label}</div>
          <div id="{room.statusId}" class="label tone-muted survey-status">{room.status}</div>
        </button>
      </div>
      <div id="ship-condition-detail" class="{survey.detailClasses}">
        <div id="survey-officer" class="officer-row">
          <img id="survey-portrait" class="officer-portrait" src="{survey.portrait}" />
          <div id="survey-officer-name" class="label heading tone-accent officer-title">CASTLE / COMPANY OFFICER</div>
        </div>
        <div id="survey-title" class="label heading tone-accent survey-title">{survey.title}</div>
        <div id="survey-copy" class="label wrapped survey-copy">{survey.copy}</div>
        <div id="survey-benefit" class="label wrapped survey-benefit tone-edge">{survey.benefit}</div>
        <div id="survey-bill" class="label wrapped workshop-bill heading tone-accent">{survey.bill}</div>
        <div id="survey-reason" class="label wrapped survey-reason tone-muted">{survey.reason}</div>
        <div id="survey-actions" class="action-row">
        <button id="ship-condition-action" class="{survey.actionClasses}" disabled="{survey.disabled}" onclick="{survey.action}">{survey.actionLabel}</button>
        </div>
        <div id="survey-feedback" class="label wrapped workshop-feedback tone-accent">{survey.feedback}</div>
      </div>
    <div id="workshop-restoration" class="{survey.workshopClasses}">
      <div id="workshop-officer" class="officer-row">
        <img id="workshop-portrait" class="officer-portrait" src="{workshop.portrait}" />
        <div id="workshop-officer-title" class="label heading tone-accent officer-title">CASTLE / COMPANY OFFICER</div>
      </div>
      <div id="workshop-title" class="label heading tone-accent workshop-title">{workshop.title}</div>
      <img id="workshop-progress" class="workshop-progress" src="{workshop.progress}" />
      <div id="workshop-copy" class="label wrapped workshop-copy">{workshop.copy}</div>
      <div id="workshop-benefit" class="label wrapped workshop-benefit tone-edge">{workshop.benefit}</div>
      <div id="workshop-bill" class="label wrapped workshop-bill heading tone-accent">{workshop.bill}</div>
      <div id="workshop-reason" class="label wrapped workshop-reason tone-muted">{workshop.reason}</div>
      <div id="workshop-actions" class="action-row">
        <button id="workshop-action" class="{workshop.actionClasses}" disabled="{workshop.disabled}" onclick="{workshop.action}">{workshop.actionLabel}</button>
        <button id="workshop-focus" class="focus-action console-action" onclick="{workshop.inspect}">VIEW</button>
      </div>
      <div id="workshop-reclaim" class="{workshop.reclaimClasses}">
        <div id="workshop-reclaim-copy" class="label wrapped reclaim-copy heading">{workshop.reclaimCopy}</div>
        <div id="workshop-reclaim-reason" class="label wrapped reclaim-reason tone-muted">{workshop.reclaimReason}</div>
        <div id="workshop-reclaim-actions" class="action-row">
          <button id="workshop-reclaim-action" class="restoration-action console-action" disabled="{workshop.reclaimDisabled}" onclick="{workshop.reclaim}">{workshop.reclaimLabel}</button>
        </div>
      </div>
      <div id="workshop-feedback" class="label wrapped workshop-feedback tone-accent">{workshop.feedback}</div>
    </div>
    </div>
    </div>
  </div>
</template>

<style>
  .ship-view-root { flex-direction: column; padding: 10px; gap: 7px; border-width: 2px; overflow: hidden; }
  .label { overflow: hidden; }
  .heading { font-family: heading; }
  .ship-view-room-bar { flex-direction: row; height: 54px; padding: 8px 10px; gap: 12px; align-items: center; border-width: 2px; }
  #ship-view-room-title { width: 330px; height: auto; white-space: normal; }
  #ship-view-room-copy { width: 540px; flex-grow: 0; text-align: left; height: auto; white-space: normal; }
  .machine-shop-equipment { width: 390px; height: 38px; padding: 4px 10px; font-family: heading; }
  .ship-view-body { flex-direction: row; width: 100%; height: 0px; flex-grow: 1; gap: 8px; }
  .ship-view-stage { flex-direction: column; width: 0px; height: 100%; flex-grow: 1; padding: 10px; overflow: hidden; border-width: 2px; }
  .ship-view-deck { width: 100%; height: 0px; flex-grow: 1; border-width: 1px; }
  .company-service-plate { width: 58px; height: 30px; pointer-events: none; }
  .restoration-panel { flex-direction: column; width: 100%; height: 590px; padding: 10px; gap: 6px; border-width: 1px; border-color: #b99f65; background-color: #202c28; overflow: scroll; }
  .officer-row { flex-direction: row; height: 64px; gap: 8px; }
  .officer-portrait { width: 54px; height: 64px; }
  .officer-title { width: 0px; flex-grow: 1; height: 50px; white-space: normal; }
  .workshop-title { height: 22px; }
  .workshop-progress { width: 240px; height: 26px; }
  .wrapped { width: 100%; white-space: normal; }
  .workshop-copy { height: 62px; }
  .workshop-benefit { height: 62px; }
  .workshop-bill { height: 38px; }
  .workshop-reason { height: 34px; }
  .action-row { flex-direction: row; height: 32px; gap: 8px; }
  .restoration-action { width: 200px; height: 30px; }
  .focus-action { width: 70px; height: 30px; }
  .reclaim-block { flex-direction: column; height: 122px; gap: 5px; padding-top: 8px; }
  .reclaim-copy { height: 40px; }
  .reclaim-reason { height: 34px; }
  .workshop-feedback { height: 34px; }
  .condition-panel { flex-direction: column; width: 370px; height: 100%; padding: 10px; gap: 8px; border-width: 1px; border-color: #b99f65; background-color: #18221f; overflow: scroll; }
  .survey-heading { width: 100%; height: 34px; white-space: normal; }
  .survey-list { flex-direction: column; width: 100%; height: 184px; overflow: scroll; gap: 3px; }
  .survey-room { flex-direction: column; width: 100%; height: 42px; padding: 4px 6px; border-width: 1px; }
  .survey-room.selected { border-color: #d1b774; background-color: #374137; }
  .survey-name { width: 100%; height: 18px; }
  .survey-status { width: 100%; height: 16px; }
  .condition-detail { flex-direction: column; width: 100%; height: 530px; gap: 7px; }
  .survey-title { width: 100%; height: 24px; }
  .survey-copy { height: 82px; }
  .survey-benefit { height: 82px; }
  .survey-reason { height: 48px; }
  .hidden { width: 0px; height: 0px; padding: 0px; gap: 0px; border-width: 0px; overflow: hidden; opacity: 0; }
</style>
