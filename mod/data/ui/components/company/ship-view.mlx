<template props="survey,workshop,roomTitle,roomCopy,contextLabel,returnAction,hqAction,barracksAction,armoryAction,mechLabAction,boatsAction,engineeringAction,hqClasses,barracksClasses,armoryClasses,mechLabClasses,engineeringClasses,boatsClasses">
  <div id="ship-view-root" class="ship-view-root">
    <marine-ops-page-nav returnAction="{returnAction}" hqAction="{hqAction}" barracksAction="{barracksAction}" armoryAction="{armoryAction}" mechLabAction="{mechLabAction}" boatsAction="{boatsAction}" engineeringAction="{engineeringAction}" engineeringClasses="{engineeringClasses}" hqClasses="{hqClasses}" barracksClasses="{barracksClasses}" armoryClasses="{armoryClasses}" mechLabClasses="{mechLabClasses}" boatsClasses="{boatsClasses}" contextLabel="{contextLabel}" />
    <div id="ship-view-room-bar" class="panel ship-view-room-bar console-header">
      <img id="ship-view-service-plate" class="company-service-plate" src="graphics/ui/console/service-plate.svg" />
      <div id="ship-view-room-title" class="label heading tone-edge">{roomTitle}</div>
      <div id="ship-view-room-copy" class="label tone-muted">{roomCopy}</div>
      <div id="ship-view-stock-slot" class="ship-view-stock-slot">
        <company-resource-stock stockId="engineering-resource-stock" rows="{workshop.stock}" />
      </div>
    </div>

    <div id="ship-view-body" class="ship-view-body">
    <div id="ship-view-stage" class="panel ship-view-stage console-well">
      <canvas id="ship-view-deck" class="ship-view-deck" width="1600" height="900" />
      <div id="ship-systems" class="{survey.systemsClasses}">
        <div id="systems-tree" class="systems-tree">
          <div id="systems-heading-row" class="systems-heading-row">
            <div id="systems-progress" class="label tone-edge systems-progress">{survey.systemsProgress}</div>
            <button id="systems-back" class="systems-back console-action">{i18n.openingRefitSystemsBack}</button>
          </div>
          <div id="systems-branches" class="systems-branches">
          <div each="core in survey.cores" key="{core.id}" id="{core.id}" class="systems-column">
            <div id="{core.barId}" class="systems-bar">
              <div id="{core.barLeftId}" class="systems-bar-left" style="{core.barLeftStyle}"></div>
              <div id="{core.barRightId}" class="systems-bar-right" style="{core.barRightStyle}"></div>
            </div>
            <div id="{core.dropRowId}" class="systems-drop-row">
              <div id="{core.dropPadId}" class="systems-axis-pad"></div>
              <div id="{core.dropId}" class="systems-drop" style="{core.dropStyle}"></div>
            </div>
            <button id="{core.headerId}" class="systems-core-row" style="{core.headerStyle}" onclick="{core.select}">
              <div id="{core.topId}" class="systems-line">
              <img id="{core.iconId}" class="systems-core-icon" src="{core.icon}" />
              <div id="{core.textId}" class="systems-core-text">
                <div id="{core.nameId}" class="label heading systems-core-name">{core.label}</div>
                <div id="{core.stateId}" class="{core.stateClasses}">{core.state}</div>
              </div>
              </div>
              <div id="{core.bottomId}" class="systems-line">
              <div id="{core.nodesId}" class="systems-core-nodes">
                <img id="{core.node1Id}" class="{core.node1Classes}" src="{core.node1Icon}" />
                <div id="{core.link2Id}" class="{core.link2Classes}" style="{core.link2Style}"></div>
                <img id="{core.node2Id}" class="{core.node2Classes}" src="{core.node2Icon}" />
                <div id="{core.link3Id}" class="{core.link3Classes}" style="{core.link3Style}"></div>
                <img id="{core.node3Id}" class="{core.node3Classes}" src="{core.node3Icon}" />
              </div>
              <div id="{core.needsId}" class="systems-core-needs">
                <div id="{core.need1Id}" class="{core.need1Classes}" style="{core.need1Style}"><img id="{core.need1IconId}" class="systems-core-need-icon" src="{core.need1Icon}" /></div>
                <div id="{core.need2Id}" class="{core.need2Classes}" style="{core.need2Style}"><img id="{core.need2IconId}" class="systems-core-need-icon" src="{core.need2Icon}" /></div>
                <div id="{core.need3Id}" class="{core.need3Classes}" style="{core.need3Style}"><img id="{core.need3IconId}" class="systems-core-need-icon" src="{core.need3Icon}" /></div>
              </div>
              </div>
            </button>
            <div id="{core.subsId}" class="systems-subs">
              <div id="{core.spinePadId}" class="systems-axis-pad"></div>
              <div id="{core.spineId}" class="systems-spine" style="{core.spineStyle}"></div>
              <div id="{core.rowsId}" class="systems-rows">
              <div each="sub in core.subs" key="{sub.id}" id="{sub.wrapId}" class="systems-row-wrap">
                <div id="{sub.elbowId}" class="systems-elbow" style="{sub.elbowStyle}"></div>
                <button id="{sub.headerId}" class="systems-row" style="{sub.headerStyle}" onclick="{sub.select}">
                  <div id="{sub.topId}" class="systems-line">
                  <img id="{sub.iconId}" class="systems-row-icon" src="{sub.icon}" />
                  <div id="{sub.nameId}" class="label heading systems-row-name">{sub.label}</div>
                  </div>
                  <div id="{sub.bottomId}" class="systems-line">
                  <div id="{sub.nodesId}" class="systems-row-nodes">
                    <img id="{sub.node1Id}" class="{sub.node1Classes}" src="{sub.node1Icon}" />
                    <div id="{sub.link2Id}" class="{sub.link2Classes}" style="{sub.link2Style}"></div>
                    <img id="{sub.node2Id}" class="{sub.node2Classes}" src="{sub.node2Icon}" />
                    <div id="{sub.link3Id}" class="{sub.link3Classes}" style="{sub.link3Style}"></div>
                    <img id="{sub.node3Id}" class="{sub.node3Classes}" src="{sub.node3Icon}" />
                  </div>
                  <div id="{sub.needsId}" class="systems-row-needs">
                    <div id="{sub.need1Id}" class="{sub.need1Classes}" style="{sub.need1Style}"><img id="{sub.need1IconId}" class="systems-row-need-icon" src="{sub.need1Icon}" /></div>
                    <div id="{sub.need2Id}" class="{sub.need2Classes}" style="{sub.need2Style}"><img id="{sub.need2IconId}" class="systems-row-need-icon" src="{sub.need2Icon}" /></div>
                    <div id="{sub.need3Id}" class="{sub.need3Classes}" style="{sub.need3Style}"><img id="{sub.need3IconId}" class="systems-row-need-icon" src="{sub.need3Icon}" /></div>
                  </div>
                  </div>
                </button>
              </div>
              </div>
            </div>
          </div>
          </div>
        </div>
      </div>
      <button id="survey-power" class="{survey.powerClasses}" onclick="{survey.powerAction}">{survey.powerLabel}</button>
      <div id="systems-strip" class="{survey.stripClasses}">
        <div id="systems-chips" class="systems-chips">
        <button each="chip in survey.chips" key="{chip.id}" id="{chip.id}" class="systems-chip" style="{chip.style}" onclick="{chip.select}">
          <img id="{chip.iconId}" class="systems-chip-icon" src="{chip.icon}" />
        </button>
        </div>
        <div id="systems-strip-label" class="label tone-edge systems-strip-label">{survey.stripLabel}</div>
      </div>
      <div id="survey-markers" class="survey-markers">
      <button each="room in survey.rooms" key="{room.id}" id="{room.id}" class="{room.classes}" onclick="{room.select}">
        <img id="{room.nameId}" class="survey-icon" src="{room.icon}" />
      </button>
      </div>
      <div id="ship-condition" class="{survey.classes}">
        <div id="survey-card-header" class="survey-card-header">
          <div id="survey-card-hint" class="label tone-muted survey-card-hint">{i18n.openingShipInspectionTitle}</div>
          <button id="survey-close" class="survey-close console-action">{i18n.openingShipInspectionClose}</button>
        </div>
      <div id="ship-condition-detail" class="{survey.detailClasses}">
        <div id="survey-officer" class="officer-row">
          <img id="survey-portrait" class="officer-portrait" src="{survey.portrait}" />
          <div id="survey-officer-name" class="label heading tone-accent officer-title">{i18n.openingUiShipViewCastleCompanyOfficer}</div>
        </div>
        <div id="survey-title-row" class="survey-title-row">
          <img id="survey-track-icon" class="{survey.trackIconClasses}" src="{survey.trackIcon}" />
          <div id="survey-title" class="label heading tone-accent survey-title">{survey.title}</div>
        </div>
        <div id="survey-state" class="label tone-edge survey-state">{survey.status}</div>
        <div id="survey-copy" class="label wrapped survey-copy">{survey.copy}</div>
        <div id="survey-benefit" class="label wrapped survey-benefit tone-edge">{survey.benefit}</div>
        <div id="survey-needs" class="{survey.needsClasses}">
          <div id="survey-needs-heading" class="label heading tone-muted survey-needs-heading">{i18n.openingRefitNeedsHeading}</div>
          <div id="survey-needs-list" class="survey-needs-list">
          <div each="need in survey.needs" key="{need.id}" id="{need.id}" class="survey-need">
            <img id="{need.iconId}" class="survey-need-icon" src="{need.icon}" />
            <div id="{need.labelId}" class="{need.classes}">{need.label}</div>
          </div>
          </div>
        </div>
        <div id="survey-bill" class="company-credit-bill" style="{survey.billStyle}"><company-resource-cost each="row in survey.billRows" key="{row.id}" row="{row}" /></div>
        <div id="survey-reason" class="label wrapped survey-reason tone-muted">{survey.reason}</div>
        <div id="survey-actions" class="action-row">
        <button id="ship-condition-action" class="{survey.actionClasses}" disabled="{survey.disabled}" onclick="{survey.action}">{survey.actionLabel}</button>
        </div>
        <div id="survey-feedback" class="label wrapped workshop-feedback tone-accent">{survey.feedback}</div>
      </div>
    <div id="workshop-restoration" class="{survey.workshopClasses}">
      <div id="workshop-officer" class="officer-row">
        <img id="workshop-portrait" class="officer-portrait" src="{workshop.portrait}" />
        <div id="workshop-officer-title" class="label heading tone-accent officer-title">{i18n.openingUiShipViewCastleCompanyOfficer}</div>
      </div>
      <div id="workshop-title" class="label heading tone-accent workshop-title">{workshop.title}</div>
      <img id="workshop-progress" class="workshop-progress" src="{workshop.progress}" />
      <div id="workshop-copy" class="label wrapped workshop-copy">{workshop.copy}</div>
      <div id="workshop-benefit" class="label wrapped workshop-benefit tone-edge">{workshop.benefit}</div>
      <div id="workshop-bill" class="company-credit-bill"><company-resource-cost each="row in workshop.billRows" key="{row.id}" row="{row}" /></div>
      <div id="workshop-reason" class="label wrapped workshop-reason tone-muted">{workshop.reason}</div>
      <div id="workshop-actions" class="action-row">
        <button id="workshop-action" class="{workshop.actionClasses}" disabled="{workshop.disabled}" onclick="{workshop.action}">{workshop.actionLabel}</button>
        <button id="workshop-focus" class="focus-action console-action" onclick="{workshop.inspect}">{i18n.openingUiShipViewView}</button>
      </div>
      <div id="workshop-feedback" class="label wrapped workshop-feedback tone-accent">{workshop.feedback}</div>
    </div>
    </div>
      <div id="reveal-curtain" class="reveal-curtain"></div>
      <div id="reveal-frame" class="reveal-frame"></div>
      <div id="reveal-caption" class="reveal-caption">
        <div id="reveal-title" class="label heading tone-accent reveal-title"></div>
        <div id="reveal-effect" class="label wrapped reveal-effect"></div>
        <div id="reveal-hint" class="label tone-muted reveal-hint"></div>
      </div>
    </div>
    </div>
  </div>
</template>

<style>
  .company-credit-bill { height: 36px; }
  .ship-view-root { flex-direction: column; padding: 10px; gap: 7px; border-width: 2px; overflow: hidden; }
  .label { overflow: hidden; }
  .heading { font-family: heading; }
  .ship-view-room-bar { flex-direction: row; height: 54px; padding: 4px 10px; gap: 12px; align-items: center; border-width: 2px; }
  #ship-view-room-title { width: 330px; height: auto; white-space: normal; }
  .ship-view-stock-slot { flex-direction: column; width: 640px; height: 46px; }
  #ship-view-room-copy { width: 0; flex-grow: 1; text-align: left; height: auto; white-space: normal; }
  .ship-view-body { flex-direction: row; width: 100%; height: 0px; flex-grow: 1; gap: 8px; }
  .ship-view-stage { flex-direction: column; width: 0px; height: 100%; flex-grow: 1; padding: 0px; overflow: hidden; border-width: 2px; }
  .ship-view-deck { width: 100%; height: 0px; flex-grow: 1; border-width: 1px; }
  .company-service-plate { width: 58px; height: 30px; pointer-events: none; }
  .restoration-panel { flex-direction: column; width: 100%; height: auto; gap: 9px; }
  .officer-row { flex-direction: row; height: 64px; gap: 8px; }
  .officer-portrait { width: 54px; height: 64px; }
  .officer-title { width: 0px; flex-grow: 1; min-height: 50px; white-space: normal; }
  .workshop-title { height: 22px; }
  .workshop-progress { width: 240px; height: 26px; }
  .wrapped { width: 100%; white-space: normal; }
  .workshop-copy { height: auto; }
  .workshop-benefit { height: auto; }
  .workshop-bill { height: auto; }
  .workshop-reason { height: auto; }
  .action-row { flex-direction: row; height: 32px; gap: 8px; }
  .restoration-action { width: 200px; height: 30px; }
  .focus-action { width: 70px; height: 30px; }
  .workshop-feedback { height: auto; }
  .condition-panel { position: absolute; left: 0px; top: 0px; flex-direction: column; width: 370px; height: auto; padding: 16px; gap: 10px; border-width: 2px; border-color: #b99f65; background-color: #18221f; overflow: scroll; opacity: 0; pointer-events: none; }
  .survey-power { position: absolute; left: 14px; top: 12px; width: 290px; height: 32px; padding: 3px 8px; }
  .survey-room { position: absolute; left: 0px; top: 0px; width: 22px; height: 22px; padding: 0px; border-width: 0px; background-color: transparent; background-image: none; opacity: 0; pointer-events: none; }
  .survey-room.selected, .survey-room:hover, .survey-room:active, .survey-room:focus-visible { background-color: transparent; background-image: none; }
  .survey-icon { width: 100%; height: 100%; pointer-events: none; }
  .survey-markers { position: absolute; left: 0px; top: 0px; width: 0px; height: 0px; overflow: visible; }
  .survey-card-header { flex-direction: row; width: 100%; height: 26px; align-items: center; }
  .survey-card-hint { width: 0px; flex-grow: 1; height: 20px; }
  .survey-close { width: 64px; height: 26px; }
  .condition-detail { flex-direction: column; width: 100%; height: auto; gap: 7px; }
  .survey-title { width: 100%; height: 24px; }
  .survey-state { width: 100%; height: 18px; }
  .survey-copy { height: auto; }
  .survey-benefit { height: auto; }
  .survey-reason { height: auto; }
  #survey-feedback { height: auto; }
  .survey-title-row { flex-direction: row; width: 100%; height: 30px; gap: 8px; align-items: center; }
  .survey-track-icon { width: 30px; height: 30px; }
  #survey-title { width: 0px; flex-grow: 1; }
  .survey-needs { flex-direction: column; width: 100%; height: auto; gap: 3px; }
  .survey-needs-heading { width: 100%; height: 16px; }
  .survey-needs-list { flex-direction: column; width: 100%; height: auto; gap: 3px; }
  .survey-need { flex-direction: row; width: 100%; height: 22px; gap: 6px; align-items: center; }
  .survey-need-icon { width: 20px; height: 20px; }
  .survey-need-label { width: 0px; flex-grow: 1; height: 18px; }
  .systems-strip { position: absolute; left: 14px; top: 12px; flex-direction: row; width: 420px; height: 44px; gap: 10px; align-items: center; }
  .systems-chips { flex-direction: row; width: 236px; height: 44px; gap: 4px; }
  .systems-chip { width: 44px; height: 44px; padding: 5px; border-width: 2px; background-color: #18221f; background-image: none; }
  .systems-chip:hover, .systems-chip:active, .systems-chip:focus-visible { background-color: #2c3a33; background-image: none; }
  .systems-chip-icon { width: 30px; height: 30px; pointer-events: none; }
  .systems-strip-label { width: 0px; flex-grow: 1; height: 18px; }
  .systems-view { position: absolute; left: 0px; top: 0px; flex-direction: row; width: 0px; height: 0px; padding: 0px; border-width: 2px; border-color: #b99f65; background-color: #0b120fe0; opacity: 0; pointer-events: none; }
  .reveal-curtain { position: absolute; left: 0px; top: 0px; width: 0px; height: 0px; background-color: #060a08; opacity: 0; pointer-events: none; }
  .reveal-frame { position: absolute; left: 0px; top: 0px; width: 0px; height: 0px; border-width: 3px; border-color: #e6d28c; background-color: transparent; opacity: 0; pointer-events: none; }
  .reveal-caption { position: absolute; left: 0px; top: 0px; flex-direction: column; align-items: center; width: 640px; height: 112px; padding: 14px 20px; gap: 6px; border-width: 2px; border-color: #b99f65; background-color: #121a17ee; opacity: 0; pointer-events: none; }
  .reveal-title { width: 100%; height: 26px; text-align: center; }
  .reveal-effect { width: 100%; height: 36px; text-align: center; }
  .reveal-hint { width: 100%; height: 16px; text-align: center; }
  .systems-tree { flex-direction: column; width: 0px; flex-grow: 1; height: 100%; padding: 12px 16px; gap: 6px; }
  .systems-heading-row { flex-direction: row; width: 100%; height: 30px; gap: 12px; align-items: center; }
  .systems-progress { width: 0px; flex-grow: 1; height: 18px; text-align: right; }
  .systems-back { width: 150px; height: 28px; }
  .systems-branches { flex-direction: row; width: 100%; height: 0px; flex-grow: 1; gap: 8px; }
  .systems-column { flex-direction: column; width: 0px; flex-grow: 1; height: 100%; gap: 0px; }
  .systems-bar { flex-direction: row; width: 100%; height: 2px; gap: 0px; }
  .systems-bar-left { width: 20px; height: 2px; }
  .systems-bar-right { width: 0px; flex-grow: 1; height: 2px; }
  .systems-drop-row { flex-direction: row; width: 100%; height: 10px; gap: 0px; }
  .systems-axis-pad { width: 19px; height: 2px; }
  .systems-drop { height: 10px; }
  .systems-core-row { flex-direction: column; width: 100%; height: 92px; padding: 5px 8px; gap: 4px; }
  .systems-line { flex-direction: row; align-items: center; width: 100%; height: 0px; flex-grow: 1; gap: 6px; pointer-events: none; }
  .systems-core-row:hover, .systems-core-row:active, .systems-core-row:focus-visible, .systems-row:hover, .systems-row:active, .systems-row:focus-visible { background-color: #24302a; background-image: none; }
  .systems-core-icon { width: 30px; height: 30px; pointer-events: none; }
  .systems-core-text { flex-direction: column; width: 0px; flex-grow: 1; height: 38px; gap: 2px; pointer-events: none; }
  .systems-core-name { width: 100%; height: 18px; text-align: start; pointer-events: none; }
  .systems-core-state { width: 100%; height: 16px; text-align: start; pointer-events: none; }
  .systems-core-nodes { flex-direction: row; align-items: center; width: 0px; flex-grow: 1; height: 38px; gap: 0px; pointer-events: none; }
  .systems-core-node { width: 36px; height: 36px; pointer-events: none; }
  .systems-core-link { width: 12px; pointer-events: none; }
  .systems-core-needs { flex-direction: row; align-items: center; width: 62px; height: 38px; gap: 3px; pointer-events: none; }
  .systems-core-need { width: 18px; height: 18px; padding: 0px; border-width: 1px; background-color: #121a17; pointer-events: none; }
  .systems-core-need-icon { width: 16px; height: 16px; pointer-events: none; }
  .systems-subs { flex-direction: row; align-items: flex-start; width: 100%; height: 0px; flex-grow: 1; gap: 0px; }
  .systems-spine { width: 2px; }
  .systems-rows { flex-direction: column; width: 0px; flex-grow: 1; height: 100%; padding-top: 8px; gap: 8px; }
  .systems-row-wrap { flex-direction: row; align-items: center; width: 100%; height: 64px; gap: 0px; }
  .systems-elbow { width: 8px; }
  .systems-row { flex-direction: column; width: 0px; flex-grow: 1; height: 64px; padding: 4px 6px; gap: 2px; }
  .systems-row-icon { width: 22px; height: 22px; pointer-events: none; }
  .systems-row-name { width: 0px; flex-grow: 1; height: 18px; text-align: start; pointer-events: none; }
  .systems-row-nodes { flex-direction: row; align-items: center; width: 0px; flex-grow: 1; height: 32px; gap: 0px; pointer-events: none; }
  .systems-row-node { width: 32px; height: 32px; pointer-events: none; }
  .systems-row-link { width: 10px; pointer-events: none; }
  .systems-row-needs { flex-direction: row; align-items: center; width: 56px; height: 32px; gap: 3px; pointer-events: none; }
  .systems-row-need { width: 16px; height: 16px; padding: 0px; border-width: 1px; background-color: #121a17; pointer-events: none; }
  .systems-row-need-icon { width: 14px; height: 14px; pointer-events: none; }
  .reveal-curtain { position: absolute; left: 0px; top: 0px; width: 0px; height: 0px; background-color: #060a08; opacity: 0; pointer-events: none; }
  .reveal-frame { position: absolute; left: 0px; top: 0px; width: 0px; height: 0px; border-width: 3px; border-color: #e6d28c; background-color: transparent; opacity: 0; pointer-events: none; }
  .reveal-caption { position: absolute; left: 0px; top: 0px; flex-direction: column; align-items: center; width: 640px; height: 112px; padding: 14px 20px; gap: 6px; border-width: 2px; border-color: #b99f65; background-color: #121a17ee; opacity: 0; pointer-events: none; }
  .reveal-title { width: 100%; height: 26px; text-align: center; }
  .reveal-effect { width: 100%; height: 36px; text-align: center; }
  .reveal-hint { width: 100%; height: 16px; text-align: center; }
  .systems-tree { flex-direction: column; align-items: center; width: 0px; flex-grow: 1; height: 100%; padding: 12px 16px; gap: 0px; }
  .systems-heading-row { flex-direction: row; width: 100%; height: 30px; gap: 12px; align-items: center; }
  .systems-heading { width: 0px; flex-grow: 1; height: 24px; }
  .systems-progress { width: 180px; height: 18px; text-align: right; }
  .systems-back { width: 150px; height: 28px; }
  .systems-guide { width: 100%; height: 22px; }
  .systems-root { width: 56px; height: 56px; }
  .systems-trunk { width: 3px; height: 14px; background-color: #dec58a; }
  .systems-branches { flex-direction: row; width: 100%; height: 0px; flex-grow: 1; gap: 0px; }
  .systems-column { flex-direction: column; align-items: center; width: 0px; flex-grow: 1; height: 100%; gap: 0px; }
  .systems-bar { flex-direction: row; width: 100%; height: 2px; gap: 0px; }
  .systems-bar-half { width: 0px; flex-grow: 1; height: 2px; }
  .systems-core-drop { height: 14px; }
  .systems-sub-drop { height: 16px; }
  .systems-header { flex-direction: column; align-items: center; padding: 4px; gap: 2px; border-width: 1px; border-color: transparent; background-color: transparent; background-image: none; }
  .systems-header:hover, .systems-header:active, .systems-header:focus-visible { background-color: #24302a; background-image: none; }
  .systems-header.systems-current { border-color: #e6d28c; background-color: #3a3524; background-image: none; }
  .systems-core-header { width: 150px; height: 82px; }
