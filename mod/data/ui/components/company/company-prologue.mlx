<template props="title,narrative,dialogue,portrait,image,page,manifest,reserve,destination,nextLabel,backDisabled,next,back,skip">
  <div id="prologue-root" class="prologue-root">
    <div id="prologue-header" class="prologue-header console-header">
      <div id="prologue-heading" class="label title">SECOND WIND / PROLOGUE</div>
      <div id="prologue-page" class="label tone-muted">{page}</div>
    </div>
    <div id="prologue-body" class="prologue-body">
      <div id="prologue-left" class="prologue-left">
        <img id="prologue-art" class="prologue-art" src="{image}" />
        <div id="prologue-caption" class="label tone-muted prologue-caption">THE SECOND WIND / FLIGHT DECK</div>
        <div id="prologue-manifest" class="label prologue-copy">{manifest}</div>
        <div id="prologue-reserve" class="label prologue-copy tone-muted">{reserve}</div>
        <div id="prologue-objective" class="label tone-accent prologue-copy">{destination}</div>
      </div>
      <div id="prologue-story" class="prologue-story panel">
        <div id="prologue-title" class="label heading tone-accent prologue-title">{title}</div>
        <div id="prologue-reading" class="prologue-reading">
          <div id="prologue-narrative" class="label prologue-copy">{narrative}</div>
          <div id="prologue-contact" class="prologue-contact">
            <img id="prologue-portrait" class="prologue-portrait" src="{portrait}" />
            <div id="prologue-identity" class="prologue-identity"><div id="prologue-speaker" class="label heading">CASTLE</div><div id="prologue-role" class="label tone-muted prologue-copy">Shipboard operations</div></div>
          </div>
          <div id="prologue-dialogue" class="label prologue-copy prologue-dialogue">{dialogue}</div>
        </div>
        <div id="prologue-controls" class="prologue-controls console-rail">
          <button id="prologue-back" class="prologue-back" disabled="{backDisabled}" onclick="{back}">Back</button>
          <button id="prologue-next" class="prologue-next" onclick="{next}">{nextLabel}</button>
        </div>
      </div>
    </div>
    <div id="prologue-footer" class="prologue-footer"><div id="prologue-note" class="label tone-muted prologue-note">At port: Marine operations / Mercenary Company Conversion. Directions remain in your Intel log.</div><button id="prologue-skip" class="prologue-skip" onclick="{skip}">Skip introduction</button></div>
  </div>
</template>
<style>
.prologue-root { flex-direction: column; padding: 24px; gap: 18px; background-color: #101315; overflow: hidden; }
.prologue-header { flex-direction: row; height: 62px; align-items: center; padding: 12px; gap: 20px; border-width: 2px; }
#prologue-heading { flex-grow: 1; }
.prologue-body { flex-direction: row; flex-grow: 1; gap: 24px; overflow: hidden; }
.prologue-left { width: 57%; flex-direction: column; gap: 16px; overflow: hidden; }
.prologue-art { width: 100%; height: 0px; flex-grow: 1; }
.prologue-caption { height: 22px; }
.prologue-copy { white-space: normal; }
#prologue-narrative, #prologue-dialogue { font-family: prose; }
.prologue-left .prologue-copy { height: 32px; }
.prologue-story { width: 0px; flex-grow: 1; flex-direction: column; padding: 24px; gap: 22px; border-width: 1px; }
.prologue-title { white-space: normal; height: 60px; }
.prologue-reading { flex-direction: column; height: 0px; flex-grow: 1; gap: 24px; overflow: scroll; }
.prologue-contact { flex-direction: row; height: 104px; gap: 20px; align-items: center; }
.prologue-portrait { width: 104px; height: 104px; }
.prologue-identity { flex-direction: column; width: 0px; flex-grow: 1; gap: 10px; }
.prologue-dialogue { color: #eee5d5; }
.prologue-controls { flex-direction: row; height: 52px; padding: 4px; gap: 12px; }
.prologue-back { width: 88px; border-width: 2px; text-align: center; }
.prologue-next { width: 0px; flex-grow: 1; border-width: 2px; text-align: center; white-space: normal; }
.prologue-footer { flex-direction: row; height: 42px; align-items: center; gap: 16px; }
.prologue-note { flex-grow: 1; white-space: normal; }
.prologue-skip { width: 200px; height: 38px; text-align: center; border-width: 1px; }
</style>
