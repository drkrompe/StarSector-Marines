<template props="missionsAction,missionsClasses,settingsAction,settingsClasses,command,contextLabel,returnAction,hqAction,barracksAction,armoryAction,mechLabAction,boatsAction,engineeringAction,hqClasses,barracksClasses,armoryClasses,mechLabClasses,engineeringClasses,boatsClasses,shopAction,shopClasses">
  <div id="barracks-surface" class="barracks-surface">
  <div id="barracks-root" class="barracks-root">
    <div id="barracks-room-bar" class="panel barracks-room-bar console-header">
      <img id="shipboard-barracks-service-plate" class="company-service-plate" src="graphics/ui/console/service-plate.svg" />
      <div id="barracks-room-title" class="label heading tone-edge">{i18n.openingUiShipboardBarracksBarracksPersonnelCommand}</div>
      <div id="barracks-room-copy" class="label tone-muted">{command.summary}</div>
      <div id="barracks-stock-slot" class="header-stock-slot">
        <company-resource-stock stockId="barracks-issue-stock" rows="{command.issueCargoStock}" />
      </div>
    </div>

    <div id="barracks-flow-actions" class="board-tools">
      <button id="barracks-equipment" class="{command.equipmentClasses}" onclick="{command.equipmentWorkspace}">{command.equipmentLabel}</button>
      <button id="barracks-guide-help" class="flow-button console-action" disabled="{command.guideHelpDisabled}" onclick="{command.guideHelp}">{command.guideHelpLabel}</button>
      <button id="barracks-missions" class="{command.missionClasses}" style="{command.missionStyle}" onclick="{command.missions}">{command.missionLabel}</button>
    </div>
    <div id="barracks-command-board" class="command-board">
      <div id="barracks-command-rail" class="command-rail panel console-section">
        <div id="barracks-section-heading" class="label heading section-heading">{i18n.openingUiShipboardBarracksOfficerCommands}</div>
        <div id="barracks-rail-note" class="label muted wrap rail-note">{i18n.openingUiShipboardBarracksNamedOfficersCoordinateTheirSquadsIndependentSquads}</div>
        <div id="barracks-command-list" class="command-list">
          <div each="group in command.commands" key="{group.id}" id="{group.cardId}" class="command-entry" style="{group.cardStyle}">
          <button id="{group.id}" class="{group.classes}" onclick="{group.select}">
            <div id="{group.commanderbadgeId}" class="commander-badge">
              <div id="{group.portraitframeId}" class="commander-portrait-frame">
                <img id="{group.commanderportraitId}" class="commander-portrait" src="{group.portrait}" />
                <img id="{group.pointId}" class="{group.pointClasses}" src="graphics/ui/officers/training-point.svg" />
              </div>
              <div id="{group.levelId}" class="{group.levelClasses}">{group.level}</div>
              <div id="{group.xpTrackId}" class="{group.xpTrackClasses}"><div id="{group.xpFillId}" class="xp-fill" style="{group.xpStyle}" /></div>
            </div>
            <div id="{group.commandercopyId}" class="commander-copy">
              <div id="{group.commandnameId}" class="label heading wrap command-name">{group.name}</div>
              <div id="{group.commandsummaryId}" class="label warm wrap command-summary">{group.summary}</div>
              <div id="{group.commandcapacityId}" class="label muted wrap dense command-capacity">{group.capacity}</div>
            </div>
          </button>
          <button id="{group.assignId}" class="{group.assignClasses}" disabled="{group.assignDisabled}" onclick="{group.assign}">{group.assignLabel}</button>
          <div id="{group.reasonId}" class="{group.reasonClasses}">{group.reason}</div>
          </div>
        </div>
      </div>
      <div id="officer-dossier" class="{command.dossierClasses}">
        <div id="officer-header" class="officer-header">
          <div id="officer-portrait-frame" class="officer-portrait-frame">
            <img id="officer-portrait" class="officer-portrait" src="{command.officerPortrait}" />
            <img id="officer-training-point" class="{command.officerPointClasses}" src="graphics/ui/officers/training-point.svg" />
          </div>
          <div id="officer-identity" class="officer-identity">
            <div id="officer-name" class="label heading warm wrap officer-line">{command.officerName}</div>
            <div id="officer-status" class="label muted wrap officer-line">{command.officerStatus}</div>
            <div id="officer-progress-row" class="officer-progress-row">
              <div id="officer-level" class="label heading warm officer-level">{command.officerLevel}</div>
              <div id="officer-progress" class="label heading warm officer-progress">{command.officerProgress}</div>
            </div>
            <div id="officer-xp" class="xp-track officer-xp"><div id="officer-xp-fill" class="xp-fill" style="{command.officerXpStyle}" /></div>
            <div id="officer-service" class="label officer-line">{command.officerService}</div>
          </div>
        </div>
        <div id="officer-dossier-scroll" class="officer-scroll">
          <div id="officer-biography" class="label wrap officer-copy">{command.officerBiography}</div>
          <div id="officer-scope" class="label muted wrap officer-copy">{i18n.openingUiShipboardBarracksSpecialtiesFollowTheSquadsThisOfficerLeads}</div>
          <div id="officer-training" class="label heading warm wrap officer-copy">{command.officerTraining}</div>
          <div id="officer-specialty-list" class="specialty-tree console-readout">
          <img id="specialty-root" class="specialty-root" src="graphics/ui/officers/specialty-root.svg" />
          <div id="specialty-trunk" class="specialty-trunk"></div>
          <div id="specialty-branches" class="specialty-branches">
          <div each="specialty in command.officerSpecialties" key="{specialty.id}" id="{specialty.id}" class="specialty-path">
            <div id="{specialty.barId}" class="specialty-bar">
              <div id="{specialty.barLeftId}" class="specialty-bar-half" style="{specialty.barLeftStyle}"></div>
              <div id="{specialty.barRightId}" class="specialty-bar-half" style="{specialty.barRightStyle}"></div>
            </div>
            <div id="{specialty.dropId}" class="specialty-drop" style="{specialty.dropStyle}"></div>
            <div id="{specialty.headerId}" class="specialty-path-header">
              <img id="{specialty.iconId}" class="specialty-emblem" src="{specialty.icon}" />
              <div id="{specialty.titleId}" class="label heading warm specialty-path-title">{specialty.title}</div>
            </div>
            <button id="{specialty.node1Id}" class="specialty-node" style="background-color: transparent; background-image: none; border-width: 0px; opacity: 1;" disabled="{specialty.node1Disabled}" onclick="{specialty.node1Train}">
              <img id="{specialty.node1ImageId}" class="specialty-node-image" src="{specialty.node1Icon}" />
            </button>
            <img id="{specialty.linkId}" class="specialty-link" src="{specialty.link}" />
            <button id="{specialty.node2Id}" class="specialty-node" style="background-color: transparent; background-image: none; border-width: 0px; opacity: 1;" disabled="{specialty.node2Disabled}" onclick="{specialty.node2Train}">
              <img id="{specialty.node2ImageId}" class="specialty-node-image" src="{specialty.node2Icon}" />
            </button>
            <img id="{specialty.link2Id}" class="specialty-link" src="{specialty.link2}" />
            <button id="{specialty.node3Id}" class="specialty-node" style="background-color: transparent; background-image: none; border-width: 0px; opacity: 1;" disabled="{specialty.node3Disabled}" onclick="{specialty.node3Train}">
              <img id="{specialty.node3ImageId}" class="specialty-node-image" src="{specialty.node3Icon}" />
            </button>
          </div>
          </div>
          </div>
          <div id="officer-traits" class="label muted wrap officer-copy">{command.officerTraits}</div>
          <div id="officer-history-heading" class="label heading warm officer-line">{i18n.openingUiShipboardBarracksServiceRecordLatestEntries}</div>
          <div id="officer-history-list" class="officer-list" style="{command.officerHistoryStyle}">
            <div each="note in command.officerHistory" key="{note.id}" id="{note.id}" class="label wrap officer-history-note">{note.text}</div>
          </div>
        </div>
      </div>
      <div id="barracks-formation-board" class="{command.formationClasses}">
        <div id="barracks-board-title" class="label heading board-title">{command.title}</div>
        <div id="barracks-selection-tools" class="selection-tools">
          <div id="barracks-scope-count" class="label muted scope-count">{command.scopeSummary}</div>
          <button id="barracks-select-all" class="select-all console-action" onclick="{command.toggleSelection}">{command.selectionToggleLabel}</button>
          <button id="barracks-fill-selected" class="fill-button fill-selected console-action" disabled="{command.fillSelectedDisabled}" onclick="{command.reinforce}">
            <img id="barracks-fill-selected-icon" class="fill-icon" src="graphics/ui/company/condition-repair.svg" />
            <div id="barracks-fill-selected-count" class="label heading fill-count">{command.fillSelectedCount}</div>
          </button>
        </div>
        <div id="barracks-empty" class="label muted wrap empty-message">{command.empty}</div>
        <div id="barracks-formation-list" class="formation-list">
          <div each="squad in command.squads" key="{squad.id}" id="{squad.id}" class="{squad.classes}">
            <button id="{squad.markId}" class="{squad.selectClasses}" disabled="{squad.disabled}" onclick="{squad.toggle}">
              <div id="{squad.headerId}" class="formation-header">
                <div id="{squad.checkId}" class="label card-check">{squad.mark}</div>
                <div id="{squad.formationnameId}" class="label heading formation-name">{squad.name}</div>
                <div id="{squad.strengthId}" class="label heading card-strength">{squad.strength}</div>
              </div>
              <div id="{squad.cardsId}" class="card-faces">
                <armory-card-chip chip="{squad.weaponCard}" />
                <armory-card-chip chip="{squad.armorCard}" />
              </div>
              <div id="{squad.formationstatusId}" class="{squad.personnelClasses}">{squad.personnel}</div>
              <canvas id="{squad.musterId}" class="formation-muster" width="260" height="78" />
            </button>
            <div id="{squad.footerId}" class="{squad.footerClasses}">
              <button id="{squad.fillId}" class="{squad.fillClasses}" disabled="{squad.fillDisabled}" onclick="{squad.fill}">
                <img id="{squad.fillIconId}" class="fill-icon" src="graphics/ui/company/condition-repair.svg" />
                <div id="{squad.fillCountId}" class="label heading fill-count">{squad.fillCount}</div>
              </button>
              <div id="{squad.footerSpacerId}" class="card-footer-spacer"></div>
              <button id="{squad.loadoutId}" class="loadout-button spec-action" onclick="{squad.loadout}">{i18n.openingUiShipboardBarracksLoadout}</button>
            </div>
            <button id="{squad.founderId}" class="{squad.founderClasses}" style="background-color: transparent; background-image: none; border-width: 0px; opacity: 1;" disabled="{squad.founderDisabled}" onclick="{squad.raise}">
              <div id="{squad.founderHeadingId}" class="raise-squad-heading">
                <div id="{squad.founderTitleId}" class="label heading warm raise-squad-title">{i18n.openingUiShipboardBarracksRaiseSquad}</div>
              </div>
              <div id="{squad.founderMiddleId}" class="raise-squad-middle">
                <div id="{squad.founderEmblemId}" class="raise-squad-emblem">
                  <img id="{squad.founderEmblemIconId}" class="raise-squad-emblem-icon" src="graphics/ui/company/raise-squad.svg" />
                </div>
                <div id="{squad.founderDestinationId}" class="label muted wrap raise-squad-copy">{squad.founderDestination}</div>
              </div>
              <div id="{squad.founderCostsId}" class="raise-squad-costs">
                <div each="cost in squad.founderCosts" key="{cost.id}" id="{cost.id}" class="{cost.classes}">
                  <img id="{cost.iconId}" class="raise-cost-icon" src="{cost.icon}" />
                  <div id="{cost.labelId}" class="label raise-cost-count">{cost.label}</div>
                </div>
              </div>
            </button>
          </div>
        </div>
        <div id="barracks-page-tools" class="page-tools">
          <button id="barracks-page-previous" class="tool-button console-action" disabled="{command.previousDisabled}" onclick="{command.previous}">{i18n.openingUiShipboardBarracksPrevious}</button>
          <div id="barracks-page-label" class="label heading page-label">{command.pageLabel}</div>
          <button id="barracks-page-next" class="tool-button console-action" disabled="{command.nextDisabled}" onclick="{command.next}">{i18n.openingUiShipboardBarracksNext}</button>
        </div>
      </div>
    </div>
    <div id="barracks-feedback" class="label command-feedback">{command.feedback}</div>
    <marine-ops-page-nav settingsAction="{settingsAction}" settingsClasses="{settingsClasses}" returnAction="{returnAction}" hqAction="{hqAction}" missionsAction="{missionsAction}" missionsClasses="{missionsClasses}" barracksAction="{barracksAction}" armoryAction="{armoryAction}" mechLabAction="{mechLabAction}" boatsAction="{boatsAction}" engineeringAction="{engineeringAction}" shopAction="{shopAction}" shopClasses="{shopClasses}" engineeringClasses="{engineeringClasses}" hqClasses="{hqClasses}" barracksClasses="{barracksClasses}" armoryClasses="{armoryClasses}" mechLabClasses="{mechLabClasses}" boatsClasses="{boatsClasses}" contextLabel="{contextLabel}" />
  </div>
  </div>
</template>

<style>
  .header-stock-slot { flex-direction: column; width: 640px; height: 46px; }
  .doc-narrow .header-stock-slot { width: 220px; }
  .barracks-root { flex-direction: column; padding: 10px; gap: 7px; border-width: 2px; }
  .label { overflow: hidden; }
  .heading { font-family: heading; }
  .section-heading { height: 19px; }
  .barracks-room-bar { flex-direction: row; height: 54px; padding: 4px 10px; gap: 12px; align-items: center; border-width: 2px; }
  .issue-stock-strip { flex-direction: row; align-items: center; height: 30px; padding: 3px 7px; gap: 8px; border-width: 1px; }
  #barracks-issue-stock-title { width: 92px; height: 18px; }
  .issue-stock-rows { flex-direction: row; align-items: center; width: 0px; flex-grow: 1; height: 22px; gap: 8px; }
  .issue-stock-row { flex-direction: row; align-items: center; width: 0px; flex-grow: 1; height: 22px; padding: 2px 4px; gap: 5px; background-color: #071014; border-width: 1px; border-color: #274050; }
  .issue-stock-icon { width: 16px; height: 16px; }
  .issue-stock-label { width: 0px; flex-grow: 1; height: 15px; font-family: heading; }
  #barracks-room-title { width: 420px; height: auto; white-space: normal; }
  #barracks-room-copy { width: 340px; flex-grow: 1; text-align: left; height: auto; white-space: normal; }
  .doc-narrow #barracks-room-title { width: 290px; }
  .doc-narrow #barracks-room-copy { width: 240px; }
  .company-service-plate { width: 58px; height: 30px; pointer-events: none; }
  .command-board { flex-direction: row; height: 0px; flex-grow: 1; gap: 8px; overflow: hidden; }
  .command-rail { flex-direction: column; width: 294px; padding: 8px; gap: 6px; border-width: 1px; }
  .muted { color: #9ba8b5; } .warm { color: #dfc588; } .wrap { white-space: normal; }
  .rail-note { height: 62px; }
  .command-list { flex-direction: column; height: 0px; flex-grow: 1; gap: 6px; overflow: scroll; }
  .command-entry { flex-direction: column; width: 100%; gap: 3px; }
  .command-assign { width: 100%; height: 28px; font-family: heading; text-align: center; }
  .command-assign-ready { color: #fff0c2; background-color: #183645; border-color: #dfc588; border-width: 1px; }
  .command-reason { width: 100%; height: 38px; }
  .command-card { flex-direction: row; width: 100%; height: 108px; gap: 8px; padding: 8px; border-width: 1px; text-align: left; background-color: #0d1d25; border-color: #3e6680; }
  .command-card.selected, .formation.selected { background-color: #122934; border-color: #dfc588; }
  .command-card:hover { border-color: #dfc588; }
  .commander-badge { flex-direction: column; align-items: center; width: 62px; height: 92px; gap: 4px; pointer-events: none; }
  .commander-portrait-frame { width: 62px; height: 62px; }
  .commander-portrait { position: absolute; left: 0px; top: 4px; width: 58px; height: 58px; }
  /* An unspent training point: a gold diamond pinned to the portrait's corner. */
  .training-point { position: absolute; left: 38px; top: 0px; width: 24px; height: 24px; pointer-events: none; }
  .commander-level { width: 62px; height: 16px; text-align: center; font-family: compact; }
  .xp-track { flex-direction: row; height: 6px; border-width: 1px; border-color: #3a5f77; background-color: #060e12; }
  .xp-fill { height: 100%; background-color: #dfc588; }
  .commander-xp { width: 58px; }
  .commander-copy { flex-direction: column; width: 0px; height: 92px; flex-grow: 1; gap: 4px; }
  .command-name { height: 34px; } .command-summary { height: 30px; } .command-capacity { height: 30px; }
  .formation-board { flex-direction: column; width: 0px; flex-grow: 1; padding: 10px; gap: 7px; border-width: 1px; overflow: hidden; }
  .board-title { height: 26px; color: #dfc588; }
  .board-tools, .selection-tools, .page-tools { flex-direction: row; align-items: center; height: 40px; gap: 6px; }
  .tool-button { white-space: normal; width: 126px; min-height: 36px; padding: 0px 4px; text-align: center; font-family: heading; }
  .scope-count { width: 0px; flex-grow: 1; height: 20px; }
  .select-all { width: 174px; height: 26px; padding: 0px 4px; text-align: center; font-family: heading; }
  .formation-list { display: grid; height: 0px; flex-grow: 1; gap: 10px; overflow: scroll; }
  .formation { flex-direction: column; width: 260px; height: 258px; gap: 6px; padding: 8px; border-width: 2px; border-color: #3a5f77; background-color: #0c1b23; }
  .formation.selected { border-color: #dfc588; background-color: #122935; }
  .formation-select { flex-direction: column; width: 100%; height: 208px; gap: 6px; padding: 0px; border-width: 0px; text-align: left; background-color: #0c1b23; }
  .formation-select:hover { background-color: #112732; }
  .formation.selected .formation-select { background-color: #122935; }
  .formation.stationed .formation-select { opacity: 1; }
  .formation-header { flex-direction: row; align-items: center; height: 24px; gap: 6px; }
  .card-check { width: 20px; height: 20px; text-align: center; border-width: 1px; border-color: #4b7b9b; color: #a9b8c5; }
  .formation.selected .card-check { background-color: #dfc588; color: #202325; border-color: #dfc588; }
  .formation-name { width: 0px; flex-grow: 1; height: 20px; }
  .card-strength { width: 66px; height: 20px; text-align: right; }
  .card-personnel { height: 16px; font-family: body; }
  /* The squad's two issued cards, stacked, as compact chips (armory-card-chip): the same
     token the Loadout screen opens its squad view on. */
  .card-faces { flex-direction: column; height: 72px; gap: 4px; }
  .card-faces .card-chip { width: 242px; }
  .fill-button { flex-direction: row; align-items: center; width: 56px; height: 28px; padding: 0px 6px; gap: 4px; }
  .fill-button.hidden { display: none; }
  .fill-icon { width: 18px; height: 18px; }
  .fill-count { width: 0px; flex-grow: 1; height: 18px; text-align: center; }
  .card-footer-spacer { width: 0px; flex-grow: 1; height: 1px; }
  .good { color: #a9b8c5; }
  .formation-muster { width: 260px; height: 78px; pointer-events: none; }
  .raise-tile { border-color: #2b4658; background-color: #081217; }
  .raise-tile:hover { border-color: #dfc588; background-color: #0c1b23; }
  .raise-squad { flex-direction: column; align-items: center; width: 100%; height: 100%; gap: 6px; padding: 0px; border-width: 0px; text-align: left; }
  .raise-squad-heading { flex-direction: row; align-items: center; width: 100%; height: 24px; gap: 6px; }
  .raise-squad-title { width: 0px; flex-grow: 1; height: 20px; }
  .raise-squad-middle { flex-direction: column; align-items: center; justify-content: center; width: 100%; height: 0px; flex-grow: 1; gap: 6px; }
  .raise-squad-emblem { flex-direction: row; align-items: center; justify-content: center; width: 60px; height: 60px; padding: 0px; border-width: 2px; border-color: #3a5f77; background-color: #0b181f; }
  .raise-squad-emblem-icon { width: 32px; height: 32px; }
  .raise-squad:hover .raise-squad-emblem { border-color: #dfc588; }
  .raise-squad-copy { width: 100%; height: 34px; text-align: center; }
  .raise-squad-costs { flex-direction: row; align-items: center; width: 100%; height: 28px; padding: 0px 6px; gap: 6px; border-width: 1px; border-color: #315166; background-color: #060e12; overflow: hidden; }
  .raise-cost { flex-direction: row; align-items: center; width: 0px; flex-grow: 1; height: 24px; gap: 4px; }
  .raise-cost-icon { width: 22px; height: 22px; pointer-events: none; }
  .raise-cost-count { width: 0px; flex-grow: 1; height: 18px; color: #dfc588; }
  .raise-cost.short .raise-cost-count { color: #eea296; }
  .card-footer { flex-direction: row; align-items: center; height: 28px; gap: 6px; }
  .loadout-button { width: 96px; height: 28px; padding: 2px 4px; }
  .empty-message { height: auto; }
  .page-label { width: 0px; flex-grow: 1; text-align: center; }
  .barracks-surface { flex-direction: column; width: 100%; height: 100%; overflow: hidden; }
  .barracks-root { height: 0px; flex-grow: 1; }
  .equipment-new { border-color: #cfaa69; color: #ffd464; }
  .mission-call { width: 190px; }
  .flow-button { white-space: normal; width: 190px; min-height: 38px; font-family: heading; text-align: center; }
  .assignment-reason { height: 35px; }
  .recruit-stock { flex-direction: row; align-items: center; width: 290px; height: 36px; gap: 8px; padding: 0px 8px; }
  .recruit-draw { flex-direction: row; align-items: center; height: 30px; gap: 8px; }
  .recruit-icon { width: 32px; height: 28px; pointer-events: none; }
  .recruit-count { width: 54px; height: 20px; pointer-events: none; }
  .recruit-label { width: 172px; height: 20px; pointer-events: none; }
  .command-feedback { height: 30px; padding: 6px 9px; color: #b3c3d1; background-color: #071014; }
  .officer-dossier { flex-direction: column; width: 0px; flex-grow: 1; padding: 14px; gap: 12px; border-width: 1px; overflow: hidden; }
  .officer-header { flex-direction: row; align-items: start; height: 124px; gap: 16px; }
  .officer-portrait-frame { width: 110px; height: 108px; }
  .officer-portrait { position: absolute; left: 0px; top: 8px; width: 100px; height: 100px; }
  .officer-point { left: 80px; top: 0px; width: 30px; height: 30px; }
  .officer-progress-row { flex-direction: row; align-items: center; height: 23px; gap: 10px; }
  .officer-level { width: 56px; height: 23px; }
  .officer-progress { width: 0px; flex-grow: 1; height: 23px; }
  .officer-xp { width: 420px; height: 8px; }
  .officer-identity { flex-direction: column; width: 0px; flex-grow: 1; gap: 5px; }
  .officer-line { height: 23px; }
  .officer-scroll { flex-direction: column; height: 0px; flex-grow: 1; gap: 12px; overflow: scroll; }
  .officer-list { flex-direction: column; height: auto; gap: 12px; }
  .officer-history-note { height: 40px; }
  .officer-copy { height: auto; }
  .specialty-tree { flex-direction: column; align-items: center; height: 482px; padding: 10px 10px 4px 10px; gap: 0px; border-width: 1px; }
  .specialty-root { width: 56px; height: 56px; }
  .specialty-trunk { width: 2px; height: 16px; background-color: #dec58a; }
  .specialty-branches { flex-direction: row; width: 100%; height: 396px; gap: 0px; }
  .specialty-path { flex-direction: column; align-items: center; width: 0px; flex-grow: 1; height: 396px; gap: 4px; }
  .specialty-bar { flex-direction: row; width: 100%; height: 2px; gap: 0px; }
  .specialty-bar-half { width: 0px; flex-grow: 1; height: 2px; }
  .specialty-drop { width: 2px; height: 16px; }
  .specialty-path-header { flex-direction: column; align-items: center; width: 100%; height: 90px; gap: 6px; }
