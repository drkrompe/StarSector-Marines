<template props="command,contextLabel,returnAction,hqAction,barracksAction,armoryAction,mechLabAction,boatsAction,engineeringAction,hqClasses,barracksClasses,armoryClasses,mechLabClasses,engineeringClasses,boatsClasses">
  <div id="barracks-surface" class="barracks-surface">
  <div id="barracks-root" class="barracks-root">
    <marine-ops-page-nav returnAction="{returnAction}" hqAction="{hqAction}" barracksAction="{barracksAction}" armoryAction="{armoryAction}" mechLabAction="{mechLabAction}" boatsAction="{boatsAction}" engineeringAction="{engineeringAction}" engineeringClasses="{engineeringClasses}" hqClasses="{hqClasses}" barracksClasses="{barracksClasses}" armoryClasses="{armoryClasses}" mechLabClasses="{mechLabClasses}" boatsClasses="{boatsClasses}" contextLabel="{contextLabel}" />
    <company-resource-stock stockId="barracks-issue-stock" rows="{command.issueCargoStock}" />

    <div id="barracks-room-bar" class="panel barracks-room-bar console-header">
      <img id="shipboard-barracks-service-plate" class="company-service-plate" src="graphics/ui/console/service-plate.svg" />
      <div id="barracks-room-title" class="label heading tone-edge">{i18n.openingUiShipboardBarracksBarracksPersonnelCommand}</div>
      <div id="barracks-room-copy" class="label tone-muted">{command.summary}</div>

    </div>

    <div id="barracks-flow-actions" class="board-tools">
      <button id="barracks-equipment" class="{command.equipmentClasses}" onclick="{command.equipmentWorkspace}">{command.equipmentLabel}</button>
      <button id="barracks-officer-dossier" class="{command.dossierButtonClasses}" onclick="{command.openDossier}">{i18n.openingUiShipboardBarracksOfficerDossier}</button>
      <button id="barracks-guide-help" class="flow-button console-action" disabled="{command.guideHelpDisabled}" onclick="{command.guideHelp}">{command.guideHelpLabel}</button>
      <button id="barracks-missions" class="{command.missionClasses}" onclick="{command.missions}">{command.missionLabel}</button>
    </div>
    <div id="barracks-command-board" class="command-board">
      <div id="barracks-command-rail" class="command-rail panel console-section">
        <div id="barracks-section-heading" class="label heading section-heading">{i18n.openingUiShipboardBarracksOfficerCommands}</div>
        <div id="barracks-rail-note" class="label muted wrap rail-note">{i18n.openingUiShipboardBarracksNamedOfficersCoordinateTheirSquadsIndependentSquads}</div>
        <div id="barracks-command-list" class="command-list">
          <div each="group in command.commands" key="{group.id}" id="{group.cardId}" class="command-entry" style="{group.cardStyle}">
          <button id="{group.id}" class="{group.classes}" onclick="{group.select}">
            <img id="{group.commanderportraitId}" class="commander-portrait" src="{group.portrait}" />
            <div id="{group.commandercopyId}" class="commander-copy">
              <div id="{group.commandnameId}" class="label heading wrap command-name">{group.name}</div>
              <div id="{group.commandsummaryId}" class="label warm wrap command-summary">{group.summary}</div>
              <div id="{group.commandcapacityId}" class="label muted wrap command-capacity">{group.capacity}</div>
            </div>
          </button>
          <button id="{group.assignId}" class="{group.assignClasses}" disabled="{group.assignDisabled}" onclick="{group.assign}">{group.assignLabel}</button>
          <div id="{group.reasonId}" class="{group.reasonClasses}">{group.reason}</div>
          </div>
        </div>
      </div>
      <div id="officer-dossier" class="{command.dossierClasses}">
        <div id="officer-header" class="officer-header">
          <img id="officer-portrait" class="officer-portrait" src="{command.officerPortrait}" />
          <div id="officer-identity" class="officer-identity">
            <div id="officer-name" class="label heading warm wrap officer-line">{command.officerName}</div>
            <div id="officer-status" class="label muted wrap officer-line">{command.officerStatus}</div>
            <div id="officer-progress" class="label heading warm officer-line">{command.officerProgress}</div>
            <div id="officer-service" class="label officer-line">{command.officerService}</div>
          </div>
          <button id="officer-formations" class="flow-button console-action" onclick="{command.closeDossier}">{i18n.openingUiShipboardBarracksViewFormations}</button>
        </div>
        <div id="officer-dossier-scroll" class="officer-scroll">
          <div id="officer-biography" class="label wrap officer-copy">{command.officerBiography}</div>
          <div id="officer-squads" class="label wrap officer-copy">{command.officerSquads}</div>
          <div id="officer-scope" class="label muted wrap officer-copy">{i18n.openingUiShipboardBarracksSpecialtiesFollowTheSquadsThisOfficerLeads}</div>
          <div id="officer-training" class="label heading warm wrap officer-copy">{command.officerTraining}</div>
          <div id="officer-specialty-list" class="officer-list">
          <div each="specialty in command.officerSpecialties" key="{specialty.id}" id="{specialty.id}" class="officer-specialty console-readout">
            <div id="{specialty.headerId}" class="officer-specialty-header">
              <img id="{specialty.iconId}" class="officer-specialty-icon" src="{specialty.icon}" />
              <div id="{specialty.titleId}" class="label heading warm officer-specialty-title">{specialty.title}</div>
            </div>
            <div id="{specialty.effectId}" class="label wrap officer-copy">{specialty.effect}</div>
            <div id="{specialty.nextId}" class="label muted wrap officer-copy">{specialty.next}</div>
            <div id="{specialty.footerId}" class="officer-specialty-footer">
              <img id="{specialty.progressId}" class="officer-rank-track" src="{specialty.progress}" />
              <div id="{specialty.levelId}" class="label muted officer-rank-label">{specialty.level}</div>
              <button id="{specialty.trainId}" class="officer-train console-action" disabled="{specialty.disabled}" onclick="{specialty.train}">{specialty.button}</button>
              <div id="{specialty.costId}" class="label warm officer-point-cost">{specialty.cost}</div>
            </div>
          </div>
          </div>
          <div id="officer-traits" class="label muted wrap officer-copy">{command.officerTraits}</div>
          <div id="officer-history-heading" class="label heading warm officer-line">{i18n.openingUiShipboardBarracksServiceRecordLatestEntries}</div>
          <div id="officer-history-list" class="officer-list" style="{command.officerHistoryStyle}">
            <div each="note in command.officerHistory" key="{note.id}" id="{note.id}" class="label wrap officer-history-note">{note.text}</div>
          </div>
        </div>
      </div>
      <div id="barracks-formation-board" class="{command.formationClasses}">
        <div id="barracks-board-title" class="label heading board-title">{command.title}</div>
        <div id="barracks-board-tools" class="board-tools">
          <div id="barracks-search-label" class="label search-label">{i18n.openingUiShipboardBarracksSearch}</div>
          <input id="barracks-search" class="roster-search" value="{command.search}" maxlength="64" oninput="{command.editSearch}" />
          <button id="barracks-attention" class="tool-button console-action" onclick="{command.attention}">{command.attentionLabel}</button>
          <button id="barracks-profile-filter" class="profile-filter console-action" onclick="{command.filter}">{command.filterLabel}</button>
        </div>
        <div id="barracks-selection-tools" class="selection-tools">
          <div id="barracks-scope-count" class="label muted scope-count">{command.scopeSummary}</div>
          <button id="barracks-select-all" class="select-all console-action" onclick="{command.selectAll}">{i18n.openingUiShipboardBarracksSelectAllInView}</button>
          <button id="barracks-clear" class="clear-selection console-action" onclick="{command.clear}">{i18n.openingUiShipboardBarracksClear}</button>
        </div>
        <div id="barracks-column-key" class="label muted column-key">{command.selectionMode}</div>
        <div id="barracks-empty" class="label muted wrap empty-message">{command.empty}</div>
        <div id="barracks-formation-list" class="formation-list">
          <div each="squad in command.squads" key="{squad.id}" id="{squad.id}" class="{squad.classes}">
            <button id="{squad.markId}" class="{squad.selectClasses}" disabled="{squad.disabled}" onclick="{squad.toggle}">
              <div id="{squad.headerId}" class="formation-header">
                <div id="{squad.checkId}" class="label card-check">{squad.mark}</div>
                <div id="{squad.formationnameId}" class="label heading formation-name">{squad.name}</div>
                <div id="{squad.strengthId}" class="label heading card-strength">{squad.strength}</div>
              </div>
              <div id="{squad.profileRowId}" class="card-profile-row">
                <img id="{squad.armorIconId}" class="card-armor-icon" src="{squad.armorIcon}" />
                <div id="{squad.formationidentityId}" class="formation-identity">
                  <div id="{squad.formationprofileId}" class="label warm formation-profile">{squad.profile}</div>
                  <div id="{squad.formationstatusId}" class="{squad.personnelClasses}">{squad.personnel}</div>
                </div>
              </div>
              <div id="{squad.commanderId}" class="squad-commander">
                <img id="{squad.commanderImageId}" class="squad-commander-portrait" src="{squad.commanderImage}" />
                <div id="{squad.commanderNameId}" class="label muted squad-commander-name">{squad.commanderName}</div>
              </div>
              <canvas id="{squad.musterId}" class="formation-muster" width="260" height="78" />
            </button>
            <div id="{squad.footerId}" class="{squad.footerClasses}">
              <div id="{squad.kitId}" class="{squad.kitClasses}">{squad.kit}</div>
              <button id="{squad.loadoutId}" class="loadout-button console-action" onclick="{squad.loadout}">{i18n.openingUiShipboardBarracksLoadout}</button>
            </div>
            <button id="{squad.founderId}" class="{squad.founderClasses}" disabled="{squad.founderDisabled}" onclick="{squad.raise}">
              <div id="{squad.founderHeadingId}" class="raise-squad-heading">
                <div id="{squad.founderPlusId}" class="label heading card-check raise-squad-plus">+</div>
                <div id="{squad.founderTitleId}" class="label heading warm raise-squad-title">{i18n.openingUiShipboardBarracksRaiseSquad}</div>
              </div>
              <div id="{squad.founderDestinationId}" class="label muted wrap raise-squad-copy">{squad.founderDestination}</div>
              <div id="{squad.founderCostsId}" class="raise-squad-costs">
                <div each="cost in squad.founderCosts" key="{cost.id}" id="{cost.id}" class="{cost.classes}">{cost.label}</div>
              </div>
            </button>
          </div>
        </div>
        <div id="barracks-page-tools" class="page-tools">
          <button id="barracks-page-previous" class="tool-button console-action" disabled="{command.previousDisabled}" onclick="{command.previous}">{i18n.openingUiShipboardBarracksPrevious}</button>
          <div id="barracks-page-label" class="label heading page-label">{command.pageLabel}</div>
          <button id="barracks-page-next" class="tool-button console-action" disabled="{command.nextDisabled}" onclick="{command.next}">{i18n.openingUiShipboardBarracksNext}</button>
        </div>
      </div>
      <div id="barracks-orders" class="{command.ordersPanelClasses}">
        <div id="barracks-order-heading" class="label heading order-heading">{command.selection}</div>
        <div id="barracks-order-tabs" class="board-tools">
          <button id="barracks-preparation" class="tab-button console-action" onclick="{command.preparation}">{i18n.openingUiShipboardBarracksPreparation}</button>
          <button id="barracks-organization" class="tab-button console-action" onclick="{command.organization}">{i18n.openingUiShipboardBarracksProfiles}</button>
        </div>
        <div id="barracks-preparation-body" class="{command.preparationClasses}">
          <div id="transfer-heading" class="label heading warm order-caption">{i18n.openingUiShipboardBarracksConsolidateSurvivors}</div>
          <div id="transfer-summary" class="label wrap preparation-copy">{command.transferSummary}</div>
          <div id="barracks-choose-donors-action" class="order-action-row">
            <button id="barracks-choose-donors" class="order-button console-action" onclick="{command.chooseDonors}">{command.donorLabel}</button>
          </div>
          <div id="barracks-review-transfers-action" class="order-action-row">
            <button id="barracks-review-transfers" class="order-button console-action" disabled="{command.transferDisabled}" onclick="{command.reviewTransfers}">{i18n.openingUiShipboardBarracksReviewTransfers}</button>
          </div>
          <div id="barracks-transfer-rows" class="{command.transferRowsClasses}">
            <div each="row in command.transferRows" key="{row.id}" id="{row.id}" class="label wrap transfer-row">{row.text}</div>
          </div>
          <div id="barracks-transfer-reason" class="label wrap preparation-copy">{command.transferReason}</div>
          <div id="barracks-transfer-actions" class="board-tools">
            <button id="barracks-apply-transfers" class="tab-button console-action" disabled="{command.applyTransfersDisabled}" onclick="{command.applyTransfers}">{i18n.openingUiShipboardBarracksApplyTransfers}</button>
            <button id="barracks-cancel-transfers" class="tab-button console-action" onclick="{command.cancelTransfers}">{i18n.openingUiShipboardBarracksCancelTransfers}</button>
          </div>
          <div id="barracks-order-caption-82" class="label heading warm order-caption">{i18n.openingUiShipboardBarracksFillVacancies}</div>
          <div id="barracks-recruitment" class="label wrap recruitment">{command.recruitment}</div>
          <div id="barracks-recruit-draw" class="company-recruit-bill"><company-resource-cost each="row in command.recruitBill" key="{row.id}" row="{row}" /></div>
          <div id="barracks-reinforce-action" class="order-action-row">
            <button id="barracks-reinforce" class="order-button console-action" disabled="{command.reinforceDisabled}" onclick="{command.reinforce}">{i18n.openingUiShipboardBarracksFillVacancies2}</button>
          </div>
          <div id="barracks-order-caption-85" class="label heading warm order-caption">{i18n.openingUiShipboardBarracksRestoreEquipment}</div>
          <div id="barracks-issue-summary" class="label issue-summary">{command.issueSummary}</div>

          <div id="barracks-issue-reason" class="label muted wrap issue-reason">{command.issueReason}</div>
          <div id="barracks-issue-action" class="order-action-row">
            <button id="barracks-issue" class="order-button console-action" disabled="{command.issueDisabled}" onclick="{command.issue}">{i18n.openingUiShipboardBarracksIssueAssignedEquipment}</button>
          </div>
        </div>
        <div id="barracks-orders-body" class="{command.ordersClasses}">
          <div id="barracks-profile-heading" class="profile-heading">
            <div id="barracks-order-caption-71" class="label heading warm order-caption">{i18n.openingUiShipboardBarracksSquadProfiles}</div>
            <button id="barracks-new-profile" class="new-profile console-action" onclick="{command.newProfile}">{i18n.openingUiShipboardBarracksNew}</button>
          </div>
          <div id="barracks-profile-list" class="profile-list">
            <button each="profile in command.profiles" key="{profile.id}" id="{profile.id}" class="{profile.classes}" onclick="{profile.select}">
              <div id="{profile.profilenameId}" class="label heading profile-name">{profile.name}</div>
              <div id="{profile.profiledetailId}" class="label muted wrap profile-detail">{profile.detail}</div>
            </button>
          </div>
          <div id="barracks-profiles-empty" class="label muted wrap empty-message">{command.profilesEmpty}</div>
          <div id="barracks-assign-profile-action" class="order-action-row">
            <button id="barracks-assign-profile" class="order-button console-action" disabled="{command.profileDisabled}" onclick="{command.assignProfile}">{i18n.openingUiShipboardBarracksAssignProfile}</button>
          </div>
          <div id="barracks-profile-note" class="label muted wrap profile-note">{i18n.openingUiShipboardBarracksProfilesNameTheIntendedLoadoutAndTactic}</div>

        </div>
        <div id="barracks-profile-editor" class="{command.editorClasses}">
          <div id="barracks-order-caption-92" class="label heading warm order-caption">{i18n.openingUiShipboardBarracksSaveSquadProfile}</div>
          <div id="barracks-editor-copy" class="label muted wrap editor-copy">{i18n.openingUiShipboardBarracksPairAKnownWeaponLoadoutWithAn}</div>
          <div id="barracks-order-caption-94" class="label muted order-caption">{i18n.openingUiShipboardBarracksProfileName}</div>
          <input id="barracks-profile-name" class="profile-name-input" value="{command.draftName}" maxlength="48" oninput="{command.editName}" />
          <div id="barracks-order-caption-96" class="label heading warm order-caption">{i18n.openingUiShipboardBarracksWeaponLoadout}</div>
          <div id="barracks-selector-97" class="selector">
            <button id="barracks-weapon-previous" class="step console-action" onclick="{command.weaponPrevious}">&lt;</button>
            <div id="barracks-selector-value-99" class="label wrap selector-value">{command.draftWeapon}</div>
            <button id="barracks-weapon-next" class="step console-action" onclick="{command.weaponNext}">&gt;</button>
          </div>
          <div id="barracks-order-caption-102" class="label heading warm order-caption">{i18n.openingUiShipboardBarracksArmourTacticSheet}</div>
          <div id="barracks-selector-103" class="selector">
            <button id="barracks-armor-previous" class="step console-action" onclick="{command.armorPrevious}">&lt;</button>
            <div id="barracks-selector-value-105" class="label wrap selector-value">{command.draftArmor}</div>
            <button id="barracks-armor-next" class="step console-action" onclick="{command.armorNext}">&gt;</button>
          </div>
          <div id="barracks-editor-copy-108" class="label muted wrap editor-copy">{i18n.openingUiShipboardBarracksSavingCreatesAReusableProfileExistingProfiles}</div>
          <div id="barracks-save-profile-action" class="order-action-row">
            <button id="barracks-save-profile" class="order-button console-action" disabled="{command.saveDisabled}" onclick="{command.saveProfile}">{i18n.openingUiShipboardBarracksSaveProfile}</button>
          </div>
          <div id="barracks-cancel-profile-action" class="order-action-row">
            <button id="barracks-cancel-profile" class="order-button console-action" onclick="{command.cancelProfile}">{i18n.openingUiShipboardBarracksBackToOrders}</button>
          </div>
        </div>
      </div>
    </div>
    <div id="barracks-feedback" class="label command-feedback">{command.feedback}</div>
  </div>
  <div id="guide-spotlight" class="guide-spotlight"></div>
  <div id="guide-target" class="guide-target"></div>
  <div id="barracks-guide" class="{command.guideClasses}">
      <div id="guide-heading" class="label heading warm guide-heading">{command.guideTitle}</div>
      <div id="guide-dialogue" class="guide-dialogue">
        <img id="guide-portrait" class="guide-portrait" src="{command.guidePortrait}" />
        <div id="guide-text" class="label wrap guide-text">{command.guideText}</div>
      </div>
      <div id="guide-status" class="label wrap warm">{command.guideStatus}</div>
      <div id="guide-controls" class="board-tools">
        <img id="guide-progress" class="{command.guideProgressClasses}" src="{command.guideProgressImage}" />
        <button id="guide-previous" class="{command.guidePreviousClasses}" disabled="{command.guidePreviousDisabled}" onclick="{command.guidePrevious}">{i18n.openingUiShipboardBarracksPrevious}</button>
        <button id="guide-next" class="tool-button console-action" disabled="{command.guideNextDisabled}" onclick="{command.guideNext}">{command.guideNextLabel}</button>
        <button id="guide-dismiss" class="{command.guideDismissClasses}" disabled="{command.guideDismissDisabled}" onclick="{command.guideDismiss}">{command.guideDismissLabel}</button>
        <div id="guide-close-hint" class="label muted guide-close-hint">{command.guideCloseHint}</div>
      </div>
  </div>
  </div>
</template>

<style>
  .company-recruit-bill { height: 36px; }
  .barracks-root { flex-direction: column; padding: 10px; gap: 7px; border-width: 2px; overflow: hidden; }
  .label { overflow: hidden; }
  .heading { font-family: heading; }
  .section-heading { height: 19px; }
  .barracks-room-bar { flex-direction: row; height: 54px; padding: 8px 10px; gap: 12px; align-items: center; border-width: 2px; }
  .issue-stock-strip { flex-direction: row; align-items: center; height: 30px; padding: 3px 7px; gap: 8px; border-width: 1px; }
  #barracks-issue-stock-title { width: 92px; height: 18px; }
  .issue-stock-rows { flex-direction: row; align-items: center; width: 0px; flex-grow: 1; height: 22px; gap: 8px; }
  .issue-stock-row { flex-direction: row; align-items: center; width: 0px; flex-grow: 1; height: 22px; padding: 2px 4px; gap: 5px; background-color: #121719; border-width: 1px; border-color: #39423a; }
  .issue-stock-icon { width: 16px; height: 16px; }
  .issue-stock-label { width: 0px; flex-grow: 1; height: 15px; font-family: heading; }
  #barracks-room-title { width: 326px; height: auto; white-space: normal; }
  #barracks-room-copy { width: 480px; flex-grow: 0; text-align: left; height: auto; white-space: normal; }
  .company-service-plate { width: 58px; height: 30px; pointer-events: none; }
  .command-board { flex-direction: row; height: 0px; flex-grow: 1; gap: 8px; overflow: hidden; }
  .command-rail { flex-direction: column; width: 294px; padding: 8px; gap: 6px; border-width: 1px; }
  .muted { color: #a5b0a9; } .warm { color: #dfc588; } .wrap { white-space: normal; }
  .rail-note { height: 46px; }
  .command-list { flex-direction: column; height: 0px; flex-grow: 1; gap: 6px; overflow: scroll; }
  .command-entry { flex-direction: column; width: 100%; gap: 3px; }
  .command-assign { width: 100%; height: 28px; font-family: heading; text-align: center; }
  .command-assign-ready { color: #fff0c2; background-color: #42533d; border-color: #dfc588; border-width: 1px; }
  .command-reason { width: 100%; height: 38px; }
  .squad-commander { flex-direction: row; width: 100%; height: 24px; gap: 6px; align-items: center; }
  .squad-commander-portrait { width: 24px; height: 24px; }
  .squad-commander-name { width: 0px; flex-grow: 1; height: 22px; }
  .command-card { flex-direction: row; width: 100%; height: 108px; gap: 8px; padding: 8px; border-width: 1px; text-align: left; background-color: #242b28; border-color: #60685c; }
  .command-card.selected, .profile-card.selected, .formation.selected { background-color: #393b2e; border-color: #dfc588; }
  .command-card:hover, .profile-card:hover { border-color: #dfc588; }
  .commander-portrait { width: 58px; height: 58px; }
  .commander-copy { flex-direction: column; width: 0px; height: 92px; flex-grow: 1; gap: 4px; }
  .command-name { height: 34px; } .command-summary { height: 30px; } .command-capacity { height: 30px; }
  .formation-board { flex-direction: column; width: 0px; flex-grow: 1; padding: 10px; gap: 7px; border-width: 1px; overflow: hidden; }
  .board-title { height: 26px; color: #dfc588; }
  .board-tools, .selection-tools, .page-tools { flex-direction: row; align-items: center; height: 40px; gap: 6px; }
  .search-label { width: 65px; height: 20px; color: #a5b0a9; }
  .roster-search { width: 0px; flex-grow: 1; height: 24px; padding: 3px 6px; border-width: 1px; background-color: #111814; }
  .tool-button { white-space: normal; width: 126px; height: 36px; padding: 0px 4px; text-align: center; font-family: heading; }
  .profile-filter { width: 192px; height: 26px; padding: 0px 4px; text-align: center; }
  .scope-count { width: 0px; flex-grow: 1; height: 20px; }
  .select-all { width: 174px; height: 26px; padding: 0px 4px; text-align: center; font-family: heading; }
  .clear-selection { width: 66px; height: 26px; padding: 0px 4px; text-align: center; }
  .column-key { height: 17px; }
  .formation-list { display: grid; height: 0px; flex-grow: 1; gap: 10px; overflow: scroll; }
  .formation { flex-direction: column; width: 260px; height: 220px; gap: 6px; padding: 8px; border-width: 2px; border-color: #586154; background-color: #202922; }
  .formation.selected { border-color: #dfc588; background-color: #383c2d; }
  .formation-select { flex-direction: column; width: 100%; height: 180px; gap: 6px; padding: 0px; border-width: 0px; text-align: left; background-color: #202922; }
  .formation-select:hover { background-color: #303b30; }
  .formation.selected .formation-select { background-color: #383c2d; }
  .formation.stationed .formation-select { opacity: 1; }
  .formation-header { flex-direction: row; align-items: center; height: 24px; gap: 6px; }
