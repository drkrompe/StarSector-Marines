<template props="lesson,backToSquads,returnAction,hqAction,barracksAction,armoryAction,mechLabAction,boatsAction,hqClasses,barracksClasses,armoryClasses,mechLabClasses,boatsClasses">
  <div id="first-refit-root" class="refit-root">
    <marine-ops-page-nav returnAction="{returnAction}" hqAction="{hqAction}" barracksAction="{barracksAction}" armoryAction="{armoryAction}" mechLabAction="{mechLabAction}" boatsAction="{boatsAction}" hqClasses="{hqClasses}" barracksClasses="{barracksClasses}" armoryClasses="{armoryClasses}" mechLabClasses="{mechLabClasses}" boatsClasses="{boatsClasses}" contextLabel="FLAGSHIP / ARMORY / A PROPER ISSUE" />
    <div id="refit-conversation" class="refit-conversation panel">
      <img id="refit-portrait" class="refit-portrait" src="graphics/portraits/castle.png" />
      <div id="refit-dialogue" class="refit-dialogue">
        <div id="refit-title" class="refit-heading tone-accent">{lesson.title}</div>
        <div id="refit-progress" class="refit-progress tone-edge">{lesson.progress}</div>
        <div id="refit-copy" class="refit-copy">{lesson.copy}</div>
      </div>
    </div>
    <div id="refit-showcase" class="{lesson.showcaseClasses}">
      <div id="refit-line-example" class="refit-example panel">
        <canvas id="refit-line-preview" class="refit-example-art" width="250" height="250" />
        <div id="refit-line-example-title" class="refit-example-title tone-accent">STEADY LINE / HOLD GROUND</div>
        <div id="refit-line-example-copy" class="refit-example-copy">Milspec Stalwart automatics anchor a line-heavy squad. Sound line suits protect most of the formation; one scout and two support carriers round it out.</div>
      </div>
      <div id="refit-scout-example" class="refit-example panel">
        <canvas id="refit-scout-preview" class="refit-example-art" width="250" height="250" />
        <div id="refit-scout-example-title" class="refit-example-title tone-accent">FORWARD SCREEN / SCOUT AHEAD</div>
        <div id="refit-scout-example-copy" class="refit-example-copy">Milspec Lancer pulse rifles and five scout billets. Janus suits bring mobility and sensor sweeps; line armor and support rigs protect the rest.</div>
      </div>
    </div>
    <button id="refit-claim" class="{lesson.claimClasses}" onclick="{lesson.claim}">ACCEPT EQUIPMENT PATTERNS / No material charge</button>
    <div id="refit-work" class="{lesson.workClasses}">
      <div id="refit-hint" class="refit-hint tone-muted">{lesson.squadHint}</div>
      <div id="refit-squads" class="refit-squads">
        <button each="squad in lesson.squads" key="{squad.id}" id="{squad.id}" class="{squad.classes}" onclick="{squad.select}">{squad.label}</button>
      </div>
      <div id="refit-paths" class="refit-paths">
        <button each="path in lesson.paths" key="{path.id}" id="{path.id}" class="{path.classes}" onclick="{path.select}">
          <div id="{path.headingId}" class="refit-heading tone-accent">{path.label}</div>
          <div id="{path.copyId}" class="refit-path-copy">{path.copy}</div>
        </button>
      </div>
      <div id="refit-table-heading" class="refit-table-heading panel">
        <div id="refit-name-heading" class="refit-name tone-edge">SOLDIER / FIRE TEAM</div>
        <div id="refit-current-heading" class="refit-kit tone-muted">CURRENT ISSUE</div>
        <div id="refit-next-heading" class="refit-kit tone-accent">PROPOSED ISSUE</div>
      </div>
      <div id="refit-billets" class="refit-billets panel">
        <div each="billet in lesson.billets" key="{billet.id}" id="{billet.id}" class="refit-billet">
          <div id="{billet.nameId}" class="refit-name">{billet.name}</div>
          <div id="{billet.currentId}" class="refit-kit tone-muted">{billet.current}</div>
          <div id="{billet.nextId}" class="refit-kit tone-edge">{billet.next}</div>
        </div>
      </div>
      <div id="refit-bill" class="refit-bill panel">
        <div id="refit-cost" class="refit-cost">
          <div id="refit-bill-heading" class="refit-bill-heading">{lesson.billHeading}</div>
          <div id="refit-materials" class="refit-materials">
            <div each="cost in lesson.costs" key="{cost.id}" id="{cost.id}" class="refit-material">
              <img id="{cost.iconId}" class="refit-material-icon" src="{cost.icon}" />
              <div id="{cost.labelId}" class="refit-material-label">{cost.label}</div>
            </div>
          </div>
        </div>
        <div id="refit-shortfall" class="refit-shortfall tone-warning">{lesson.shortfall}</div>
      </div>
      <div id="refit-status" class="refit-status tone-edge">{lesson.status}</div>
      <button id="refit-issue" class="refit-action console-action" disabled="{lesson.disabled}" onclick="{lesson.issue}">ISSUE TO SQUAD</button>
    </div>
    <button id="refit-inspect" class="{lesson.doneClasses}" onclick="{lesson.inspect}">INSPECT ISSUED SQUAD / Alpha, Bravo, Charlie</button>
    <button id="refit-later" class="refit-later" onclick="{backToSquads}">{lesson.laterLabel}</button>
  </div>
</template>
<style>
  .refit-root { flex-direction: column; padding: 12px; gap: 9px; overflow: hidden; }
  .refit-conversation { flex-direction: row; height: 112px; padding: 12px; gap: 16px; border-width: 1px; }
  .refit-portrait { width: 104px; height: 104px; }
  .refit-dialogue { flex-direction: column; width: 0px; flex-grow: 1; gap: 6px; }
  .refit-heading { font-family: heading; height: 22px; }
  .refit-progress { height: 18px; }
  .refit-copy { height: 60px; white-space: normal; }
  .refit-showcase { flex-direction: row; height: 0px; flex-grow: 1; gap: 16px; }
  .refit-example { flex-direction: column; width: 0px; flex-grow: 1; padding: 24px; gap: 16px; align-items: center; }
  .refit-example-art { width: 250px; height: 250px; }
  .refit-example-title { height: 24px; font-family: heading; }
  .refit-example-copy { width: 560px; height: 74px; white-space: normal; }
  .refit-work { flex-direction: column; height: 0px; flex-grow: 1; gap: 7px; }
  .refit-hint { height: 18px; }
  .refit-squads { flex-direction: row; height: 36px; gap: 6px; overflow: scroll; }
  .refit-squad { width: 180px; height: 24px; padding: 4px; border-width: 1px; }
  .refit-paths { flex-direction: row; height: 86px; gap: 12px; }
  .refit-path { flex-direction: column; width: 0px; flex-grow: 1; padding: 10px; gap: 5px; border-width: 2px; text-align: left; }
  .refit-path-copy { height: 40px; white-space: normal; font-family: body; }
  .refit-selected { border-color: #73cfc9; background-color: #163a40; }
  .refit-table-heading { flex-direction: row; height: 20px; gap: 12px; padding: 4px 8px; }
  .refit-billets { flex-direction: column; height: 0px; flex-grow: 1; overflow: scroll; padding: 4px 8px; gap: 2px; }
  .refit-billet { flex-direction: row; height: 33px; gap: 12px; border-width: 1px; border-color: #263d49; }
  .refit-name { width: 255px; white-space: normal; }
  .refit-kit { width: 0px; flex-grow: 1; white-space: normal; }
  .refit-bill { flex-direction: row; height: 53px; gap: 10px; padding: 6px 8px; }
  .refit-cost { flex-direction: column; gap: 3px; width: 0px; flex-grow: 2; white-space: normal; }
  .refit-bill-heading { height: 18px; }
  .refit-materials { flex-direction: row; gap: 18px; height: 30px; }
  .refit-material { flex-direction: row; gap: 5px; width: 300px; height: 30px; align-items: center; }
  .refit-material-icon { width: 30px; height: 30px; }
  .refit-material-label { width: 260px; height: 24px; white-space: normal; }
  .refit-shortfall { width: 0px; flex-grow: 1; white-space: normal; }
  .refit-status { height: 28px; white-space: normal; }
  .refit-action { height: 26px; padding: 6px 12px; border-width: 1px; font-family: heading; }
  .refit-later { height: 22px; padding: 4px 12px; border-width: 1px; }
  .refit-hidden { width: 0px; height: 0px; flex-grow: 0; padding: 0px; gap: 0px; border-width: 0px; overflow: hidden; opacity: 0; }
</style>
