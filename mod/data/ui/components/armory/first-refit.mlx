<template props="lesson,backToSquads,returnAction,hqAction,barracksAction,armoryAction,mechLabAction,boatsAction,engineeringAction,hqClasses,barracksClasses,armoryClasses,mechLabClasses,engineeringClasses,boatsClasses">
  <div id="first-refit-root" class="refit-root">
    <marine-ops-page-nav returnAction="{returnAction}" hqAction="{hqAction}" barracksAction="{barracksAction}" armoryAction="{armoryAction}" mechLabAction="{mechLabAction}" boatsAction="{boatsAction}" engineeringAction="{engineeringAction}" engineeringClasses="{engineeringClasses}" hqClasses="{hqClasses}" barracksClasses="{barracksClasses}" armoryClasses="{armoryClasses}" mechLabClasses="{mechLabClasses}" boatsClasses="{boatsClasses}" contextLabel="BARRACKS / EQUIPMENT / A PROPER ISSUE" />
    <div id="refit-conversation" class="refit-conversation panel">
      <img id="refit-portrait" class="refit-portrait" src="graphics/portraits/castle.png" />
      <div id="refit-dialogue" class="refit-dialogue">
        <div id="refit-title" class="refit-heading tone-accent">{lesson.title}</div>
        <div id="refit-progress" class="refit-progress tone-edge">{lesson.progress}</div>
        <div id="refit-copy" class="refit-copy">{lesson.copy}</div>
      </div>
    </div>
    <div id="refit-work" class="{lesson.workClasses}">
      <div id="refit-hint" class="refit-hint tone-muted">{lesson.squadHint}</div>
      <div id="refit-squads" class="refit-squads">
        <button each="squad in lesson.squads" key="{squad.id}" id="{squad.id}" class="{squad.classes}" onclick="{squad.select}">{squad.label}</button>
      </div>
      <div id="refit-paths" class="refit-paths">
        <armory-weapon-tech-card each="tile in lesson.paths" key="{tile.id}" tile="{tile}" />
      </div>
      <div id="refit-empty" class="{lesson.emptyClasses}">Select a squad and one of the two plans above. Compare equipment before choosing your one free technology transfer.</div>
      <div id="refit-comparison" class="{lesson.comparisonClasses}">
        <div id="refit-roll" class="refit-roll panel">
          <div id="refit-roll-heading" class="refit-roll-heading tone-edge">CURRENT KIT / Select a square</div>
          <div id="refit-billets" class="refit-billets">
            <div each="team in lesson.fireTeams" key="{team.id}" id="{team.id}" class="refit-team">
              <div id="{team.headingId}" class="refit-team-heading tone-edge">{team.label}</div>
              <div id="{team.membersId}" class="refit-team-members">
                <button each="billet in team.billets" key="{billet.id}" id="{billet.id}" class="{billet.classes}" onclick="{billet.select}">
                  <div id="{billet.nameId}" class="refit-name">{billet.gridName}</div>
                  <div id="{billet.kitId}" class="refit-billet-kit">
                    <img id="{billet.armorIconId}" class="refit-billet-icon" src="{billet.armorIcon}" />
                    <img id="{billet.primaryIconId}" class="refit-billet-icon" src="{billet.primaryIcon}" />
                  </div>
                  <div id="{billet.detailId}" class="refit-detail tone-muted">{billet.detail}</div>
                </button>
              </div>
            </div>
          </div>
        </div>
        <div id="refit-inspection" class="refit-inspection">
          <div id="refit-selected-name" class="refit-selected-name tone-accent">{lesson.selectedName}</div>
          <div id="refit-equipment-columns" class="refit-equipment-columns">
            <div id="refit-current-equipment" class="refit-equipment-column">
              <div id="refit-current-heading" class="refit-column-heading panel">CURRENT ISSUE</div>
            <div id="refit-current-items" class="refit-items">
            <div each="item in lesson.currentItems" key="{item.id}" id="{item.id}" class="{item.classes}">
              <img id="{item.iconId}" class="refit-equipment-art" src="{item.icon}" />
              <div id="{item.textId}" class="refit-equipment-text">
                <div id="{item.kindId}" class="refit-item-kind tone-edge">{item.kind}</div>
                <div id="{item.titleId}" class="refit-item-title tone-accent">{item.title}</div>
                <div id="{item.subtitleId}" class="refit-item-subtitle tone-muted">{item.subtitle}</div>
                <div id="{item.statsId}" class="refit-item-stats">{item.stats}</div>
                <div id="{item.systemId}" class="refit-item-system tone-edge">{item.system}</div>
              </div>
            </div>
            </div>
            </div>
            <div id="refit-proposed-equipment" class="refit-equipment-column">
              <div id="refit-proposed-heading" class="refit-column-heading panel tone-accent">PROPOSED ISSUE / Hover equipment for full specs</div>
            <div id="refit-proposed-items" class="refit-items">
            <div each="item in lesson.proposedItems" key="{item.id}" id="{item.id}" class="{item.classes}">
              <img id="{item.iconId}" class="refit-equipment-art" src="{item.icon}" />
              <div id="{item.textId}" class="refit-equipment-text">
                <div id="{item.kindId}" class="refit-item-kind tone-edge">{item.kind}</div>
                <div id="{item.titleId}" class="refit-item-title tone-accent">{item.title}</div>
                <div id="{item.subtitleId}" class="refit-item-subtitle tone-muted">{item.subtitle}</div>
                <div id="{item.statsId}" class="refit-item-stats">{item.stats}</div>
                <div id="{item.systemId}" class="refit-item-system tone-edge">{item.system}</div>
              </div>
            </div>
            </div>
            </div>
          </div>
        </div>
      </div>
      <div id="refit-status" class="refit-status tone-edge">{lesson.status}</div>
      <div id="refit-actions" class="refit-actions">
      <button id="refit-claim" class="{lesson.claimClasses}" disabled="{lesson.claimDisabled}" onclick="{lesson.claim}">{lesson.claimLabel}</button>
      <button id="refit-issue" class="{lesson.issueClasses}" disabled="{lesson.disabled}" onclick="{lesson.issue}">FIT SQUAD / FREE</button>
      </div>
    </div>
    <div id="refit-footer" class="refit-actions">
    <button id="refit-inspect" class="{lesson.doneClasses}" onclick="{lesson.inspect}">INSPECT SQUAD</button>
    </div>
  </div>
</template>
<style>
  .refit-root { flex-direction: column; padding: 12px; gap: 9px; overflow: hidden; }
  .refit-conversation { flex-direction: row; height: 86px; padding: 10px; gap: 16px; border-width: 1px; }
  .refit-portrait { width: 82px; height: 82px; }
  .refit-dialogue { flex-direction: column; width: 0px; flex-grow: 1; gap: 6px; }
  .refit-heading { font-family: heading; height: 22px; }
  .refit-progress { height: 18px; }
  .refit-copy { height: 42px; white-space: normal; }
  .refit-work { flex-direction: column; height: 0px; flex-grow: 1; gap: 7px; }
  .refit-hint { height: 18px; }
  .refit-squads { flex-direction: row; height: 32px; gap: 6px; overflow: scroll; }
  .refit-squad { width: 180px; height: 24px; padding: 4px; border-width: 1px; }
  .refit-paths { flex-direction: row; height: 190px; gap: 12px; }
  .refit-squad.refit-selected, .refit-billet.refit-selected { border-color: #73cfc9; background-color: #163a40; }
  .refit-empty { height: 0px; flex-grow: 1; padding: 20px; }
  .refit-comparison { flex-direction: row; height: 0px; flex-grow: 1; gap: 12px; }
  .refit-roll { flex-direction: column; width: 348px; padding: 6px; gap: 4px; }
  .refit-roll-heading { height: 22px; }
  .refit-billets { flex-direction: row; height: 0px; flex-grow: 1; overflow: scroll; gap: 6px; }
  .refit-team { flex-direction: column; width: 0px; flex-grow: 1; gap: 6px; }
  .refit-team-heading { height: 18px; text-align: center; font-family: heading; }
  .refit-team-members { flex-direction: column; gap: 6px; }
  .refit-billet { flex-direction: column; height: 88px; padding: 4px; gap: 4px; border-width: 1px; text-align: left; }
  .refit-name { height: 18px; overflow: hidden; }
  .refit-billet-kit { flex-direction: row; height: 34px; gap: 6px; align-items: center; }
  .refit-billet-icon { width: 34px; height: 34px; pointer-events: none; }
  .refit-detail { height: 28px; white-space: normal; font-family: body; }
  .refit-inspection { flex-direction: column; width: 0px; flex-grow: 1; gap: 6px; }
  .refit-selected-name { height: 22px; }
  .refit-equipment-columns { flex-direction: row; height: 0px; flex-grow: 1; gap: 12px; overflow: scroll; }
  .refit-equipment-column { flex-direction: column; width: 0px; flex-grow: 1; gap: 8px; }
  .refit-items { flex-direction: column; gap: 8px; }
  .refit-column-heading { height: 20px; padding: 6px 10px; }
  .refit-item { flex-direction: row; height: 102px; padding: 10px; gap: 14px; border-width: 1px; }
  .refit-armor-item { height: 132px; }
  .refit-special-item { height: 88px; }
  .refit-equipment-art { width: 98px; height: 98px;  }
  .refit-equipment-text { flex-direction: column; width: 0px; flex-grow: 1; gap: 5px; }
  .refit-item-kind { height: 16px; font-family: body; }
  .refit-item-title { height: 20px; font-family: heading; }
  .refit-item-subtitle { height: 30px; white-space: normal; }
  .refit-item-stats { height: 20px; }
  .refit-item-system { height: 38px; white-space: normal; }
  .refit-status { height: 28px; white-space: normal; }
  .refit-actions { flex-direction: row; height: 40px; gap: 12px; }
  .refit-action { width: 260px; height: 26px; padding: 6px 12px; border-width: 1px; font-family: heading; }
  .refit-hidden { width: 0px; height: 0px; flex-grow: 0; padding: 0px; gap: 0px; border-width: 0px; overflow: hidden; opacity: 0; }
</style>
