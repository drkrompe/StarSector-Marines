<template props="lesson,returnAction,hqAction,barracksAction,armoryAction,mechLabAction,boatsAction,engineeringAction,hqClasses,barracksClasses,armoryClasses,mechLabClasses,engineeringClasses,boatsClasses">
  <div id="first-refit-root" class="refit-root">
    <!-- The reward is a choice the player must make, so the screen carries no page
         navigation: the way out is through the choice. -->
    <div id="refit-work" class="refit-work">
      <div id="refit-hint" class="{lesson.hintClasses}">{lesson.squadHint}</div>
      <div id="refit-squads" class="{lesson.squadsClasses}">
        <button each="squad in lesson.squads" key="{squad.id}" id="{squad.id}" class="{squad.classes}" onclick="{squad.select}">{squad.label}</button>
      </div>
      <!-- The choices on the left, as the Loadout screen's stores are; the squad they
           would fit on the right, in the same squad view the Loadout screen shows. -->
      <div id="refit-body" class="refit-body">
        <div id="refit-choices" class="refit-choices">
          <div id="refit-paths" class="refit-paths">
            <!-- Each choice carries its letter on a tab, so the player reads "A or B" before
                 reading either licence; the learn button names the same letter. -->
            <div each="option in lesson.options" key="{option.id}" id="{option.id}" class="refit-option" style="{option.rowStyle}">
              <button id="{option.tabId}" class="{option.tabClasses}" style="{option.tabStyle}" onclick="{option.select}">
                <div id="{option.captionId}" class="refit-option-caption label">{i18n.openingFirstRefitOption}</div>
                <div id="{option.letterId}" class="refit-option-letter">{option.letter}</div>
              </button>
              <armory-loadout-card tile="{option.tile}" />
            </div>
          </div>
        </div>
        <div id="refit-squad" class="refit-squad-column">
          <div id="refit-empty" class="{lesson.emptyClasses}">{i18n.openingUiFirstRefitSelectASquadAndOneOfThe}</div>
          <div id="refit-comparison" class="{lesson.comparisonClasses}">
            <armory-squad-view inspection="{lesson.inspection}" layout="loadout-billets" />
          </div>
        </div>
      </div>
      <div id="refit-status" class="refit-status tone-edge">{lesson.status}</div>
      <div id="refit-actions" class="refit-actions">
      <button id="refit-choose" class="refit-action spec-action" disabled="{lesson.chooseDisabled}" onclick="{lesson.choose}">{lesson.chooseLabel}</button>
      </div>
    </div>
  </div>
</template>
<style>
  .refit-root { flex-direction: column; padding: 12px; gap: 9px; overflow: hidden; }
  .refit-work { flex-direction: column; height: 0px; flex-grow: 1; gap: 7px; }
  .refit-hint { height: 18px; }
  .refit-squads { flex-direction: row; height: 32px; gap: 6px; overflow: scroll; }
  .refit-squad { width: 180px; height: 26px; padding: 5px 4px; }
  .refit-body { flex-direction: row; height: 0px; flex-grow: 1; gap: 12px; }
  /* Two compact cards high, and as wide as Castle's callout, which settles in the
     free space beneath them rather than over the squad. */
  .refit-choices { flex-direction: column; width: 600px; }
  .refit-option { flex-direction: row; gap: 6px; }
  .refit-option-tab { flex-direction: column; align-items: center; width: 60px; padding: 0px; gap: 4px; }
  .refit-option-caption { width: 58px; height: 14px; padding: 12px 0px 0px 0px; color: #8995a0; text-align: center; }
  .refit-option-letter { width: 58px; height: 32px; font-family: display; color: #c7d8e8; text-align: center; }
  .refit-option-tab.selected .refit-option-letter { color: #f2cf68; }
  .refit-paths { flex-direction: column; height: 546px; gap: 12px; }
  .refit-squad-column { flex-direction: column; width: 0px; flex-grow: 1; }
  .refit-empty { height: 0px; flex-grow: 1; padding: 20px; }
  .refit-comparison { flex-direction: column; height: 0px; flex-grow: 1; }
  .refit-status { min-height: 28px; white-space: normal; }
  .refit-actions { flex-direction: row; height: 40px; gap: 12px; }
  .refit-action { width: 260px; height: 30px; padding: 7px 12px; }
  .refit-hidden { display: none; }
</style>
