<template props="squadCards">
  <div id="squad-card-list" class="squad-card-list panel">
    <button each="squad in squadCards" key="{squad.id}" id="{squad.id}" class="{squad.classes}" onclick="{squad.open}">
      <div id="{squad.nameId}" class="squad-name label tone-edge">{squad.name}</div>
      <div id="{squad.statusId}" class="{squad.statusClasses}">{squad.status}</div>
      <div id="{squad.strengthId}" class="squad-stat label">{squad.strength}</div>
      <div id="{squad.teamsId}" class="squad-stat label">{squad.teams}</div>
      <div id="{squad.commandId}" class="squad-command label surface-dark">{squad.command}</div>
      <div id="{squad.locationId}" class="squad-location label tone-muted">{squad.location}</div>
      <div id="{squad.openId}" class="squad-open label tone-edge">{squad.openLabel}</div>
    </button>
  </div>
</template>

<style>
  .squad-card-list {
    display: grid;
    flex-grow: 1;
    gap: 10px;
    padding: 10px;
    overflow: scroll;
  }

  .label { overflow: hidden; }

  .squad-card {
    flex-direction: column;
    width: 134px;
    height: 446px;
    padding: 10px;
    gap: 7px;
    border-width: 1px;
    overflow: hidden;
    font-family: body;
    text-align: left;
  }

  .squad-name { height: 40px; }
  .squad-card-status { height: 30px; padding: 5px; border-width: 1px; text-align: center; }
  .squad-stat { height: 36px; padding: 6px; border-width: 1px; }
  .squad-command { height: 52px; padding: 7px 6px; border-width: 1px; }
  .squad-location { height: 42px; flex-grow: 1; padding: 6px; }
  .squad-open { height: 30px; padding: 5px 6px; border-width: 1px; text-align: center; }
</style>
