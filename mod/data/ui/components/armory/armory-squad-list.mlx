<template props="squadGalleryCards">
  <div id="squad-card-list" class="squad-card-list panel">
    <div each="card in squadGalleryCards" key="{card.id}" id="{card.id}" class="{card.classes}" style="{card.style}">
      <button id="{card.squad.openId}" class="{card.openClasses}" style="{card.openStyle}" disabled="{card.openDisabled}" onclick="{card.squad.open}">
        <div id="{card.squad.stripeId}" class="squad-dossier-stripe" />
        <div id="{card.organizationNoticeId}" class="{card.organizationNoticeClasses}">{card.organizationNotice}</div>
        <div id="{card.squad.nameId}" class="squad-name label heading tone-edge">{card.squad.name}</div>
        <div id="{card.squad.statusLineId}" class="squad-status-line">
          <div id="{card.squad.statusId}" class="{card.squad.statusClasses}">{card.squad.status}</div>
          <div id="{card.squad.strengthId}" class="squad-strength label">{card.squad.strength}</div>
        </div>
        <canvas id="{card.squad.musterId}" class="squad-muster" width="216" height="96" />
        <div id="{card.squad.legendId}" class="squad-muster-legend">
          <div id="{card.squad.readyCountId}" class="squad-count label tone-good">{card.squad.readyCount}</div>
          <div id="{card.squad.woundedCountId}" class="squad-count label tone-accent">{card.squad.woundedCount}</div>
          <div id="{card.squad.vacantCountId}" class="squad-count label tone-muted">{card.squad.vacantCount}</div>
        </div>
        <div id="{card.squad.casualtiesId}" class="{card.squad.casualtyClasses}">{card.squad.casualties}</div>
        <div id="{card.squad.commandBlockId}" class="squad-command-block surface-dark">
          <div id="{card.squad.commandHeadingId}" class="squad-command-heading label tone-muted">HOME COMMAND</div>
          <div id="{card.squad.commandId}" class="squad-command label">{card.command}</div>
        </div>
        <div id="{card.squad.locationId}" class="squad-location label tone-muted">{card.squad.location}</div>
        <div id="{card.squad.recoveryId}" class="squad-recovery label tone-accent">{card.squad.recovery}</div>
        <div id="{card.squad.teamsId}" class="squad-stat label tone-muted">{card.squad.teams}</div>
      </button>
      <button id="{card.squad.reinforceId}" class="{card.reinforceClasses}" disabled="{card.reinforceDisabled}" onclick="{card.squad.reinforce}">
        <img id="{card.squad.reinforceIconId}" class="squad-reinforce-icon" src="{card.squad.reinforceIcon}" />
        <div id="{card.squad.reinforceLabelId}" class="squad-reinforce-label label">{card.squad.reinforceLabel}</div>
      </button>
      <button id="{card.founderId}" class="{card.founderClasses}" disabled="{card.foundingDisabled}" onclick="{card.foundSquad}">
        <img id="{card.plusId}" class="found-squad-cta-icon" src="graphics/ui/armory/found-squad.png" />
        <div id="{card.founderHeadingId}" class="found-squad-heading label heading tone-accent">FOUND LINE SQUAD</div>
        <div id="{card.founderCopyId}" class="found-squad-copy label tone-muted">Create the next full formation from fleet cargo.</div>
        <div id="{card.founderCostsId}" class="squad-founder-costs">
          <div each="cost in card.foundingCargoRows" key="{cost.id}" id="{cost.id}" class="{cost.classes}">
            <img id="{cost.iconId}" class="cargo-cost-icon" src="{cost.icon}" />
            <div id="{cost.labelId}" class="cargo-cost-label label">{cost.label}</div>
          </div>
        </div>
        <div id="{card.founderFeedbackId}" class="{card.foundingFeedbackClasses}">{card.foundingFeedbackText}</div>
      </button>
    </div>
  </div>
</template>

<style>
  .squad-card-list {
    display: grid;
    flex-grow: 1;
    gap: 10px;
    padding: 10px;
    overflow: scroll;
  }

  .label { overflow: hidden; }

  .squad-card {
    flex-direction: column;
    width: 216px;
    height: 342px;
    padding: 6px;
    gap: 4px;
    border-width: 2px;
    background-color: #0c1620;
    overflow: hidden;
    font-family: body;
    text-align: left;
    transition: background-color 140ms ease-out, border-color 140ms ease-out;
  }

  .squad-open {
    flex-direction: column;
    flex-grow: 1;
    width: 100%;
    padding: 0px;
    gap: 3px;
    border-width: 0px;
    overflow: hidden;
    font-family: body;
    text-align: left;
  }

  .squad-card.organizing { height: 244px; gap: 0px; }
  .squad-card.locked .squad-open { opacity: 1; }
  .squad-dossier-stripe { height: 3px; background-color: #51758c; }
  .squad-card.company-card-ready .squad-dossier-stripe { background-color: #78d494; }
  .squad-card.company-card-operational .squad-dossier-stripe { background-color: #ffd464; }
  .squad-card.company-card-unready .squad-dossier-stripe { background-color: #e98b83; }
  .squad-card.selected .squad-dossier-stripe { background-color: #ffd464; }
  .squad-organization-notice { height: 18px; padding: 0px 4px; font-family: compact; }
  .squad-name { height: 24px; padding: 1px 4px; white-space: normal; }
  .squad-status-line { flex-direction: row; height: 20px; gap: 4px; }
  .squad-card-status { width: 124px; height: 18px; padding: 1px 3px; border-width: 1px; font-family: compact; text-align: left; background-color: #0e1924; }
  .squad-strength { width: 0px; flex-grow: 1; height: 20px; padding: 3px 3px; text-align: right; }
  .squad-muster { width: 216px; height: 96px; }
  .squad-muster-legend { flex-direction: row; height: 18px; gap: 3px; padding: 0px 2px; }
  .squad-count { width: 0px; flex-grow: 1; height: 18px; text-align: center; }
  .squad-casualties { height: 16px; padding: 0px 4px; text-align: center; }
  .squad-command-block { flex-direction: column; height: 43px; padding: 2px 4px; gap: 1px; border-width: 1px; border-color: #3e6075; }
  .squad-command-heading { height: 10px; font-family: compact; }
  .squad-command { height: 32px; white-space: normal; }
  .squad-location { height: 16px; padding: 0px 4px; }
  .squad-recovery { height: 16px; padding: 0px 4px; }
  .squad-stat { height: 18px; padding: 1px 4px; }
  .squad-card.organizing .squad-open { gap: 0px; }
  .squad-card.organizing .squad-organization-notice { height: 14px; }
  .squad-card.organizing .squad-muster-legend { height: 16px; }
  .squad-card.organizing .squad-count { height: 16px; }
  .squad-card.organizing .squad-command-block { height: 39px; }
  .squad-card.organizing .squad-command { height: 28px; }
  .squad-card.organizing .squad-stat,
  .squad-card.organizing .squad-recovery,
  .squad-card.organizing .squad-casualties { width: 0px; height: 0px; padding: 0px; overflow: hidden; opacity: 0; }
  .squad-reinforce {
    flex-direction: row;
    height: 20px;
    padding: 3px 5px;
    border-width: 1px;
    overflow: hidden;
    font-family: body;
    text-align: center;
  }
  .squad-reinforce-icon { width: 18px; height: 18px; }
  .squad-reinforce-label { width: 0px; height: 16px; flex-grow: 1; padding: 2px 0px; text-align: center; }

  .squad-founder-slot {
    width: 232px;
    height: 358px;
    overflow: hidden;
  }
  .squad-founder-card {
    flex-direction: column;
    width: 216px;
    height: 342px;
    padding: 6px;
    gap: 6px;
    border-width: 1px;
    overflow: hidden;
    font-family: body;
    text-align: center;
    background-color: #0c1620;
  }
  .squad-founder-card:hover { background-color: #132c3d; border-color: #ffd464; }
  .found-squad-cta-icon { width: 80px; height: 80px; }
  .found-squad-heading { height: 30px; white-space: normal; text-align: center; }
  .found-squad-copy { height: 32px; white-space: normal; text-align: center; }
  .squad-founder-costs {
    flex-direction: column;
    width: 100%;
    height: 96px;
    gap: 2px;
    overflow: hidden;
  }
  .cargo-cost {
    flex-direction: row;
    width: 100%;
    height: 18px;
    padding: 1px 3px;
    gap: 4px;
    border-width: 1px;
    text-align: left;
  }
  .cargo-cost.short { background-color: #321818; border-color: #9f4545; }
  .cargo-cost-icon { width: 16px; height: 16px; }
  .cargo-cost-label { width: 0px; height: 16px; flex-grow: 1; padding: 1px 0px; }
  .squad-founder-feedback {
    width: 100%;
    height: 54px;
    padding: 4px;
    white-space: normal;
    text-align: center;
  }
  .hidden { width: 0px; height: 0px; flex-grow: 0; padding: 0px; gap: 0px; border-width: 0px; overflow: hidden; opacity: 0; }
</style>
