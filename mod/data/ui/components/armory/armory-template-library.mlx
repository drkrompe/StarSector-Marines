<template props="templateRows">
  <div id="template-library" class="panel template-library">
    <div id="library-heading" class="label heading tone-edge">TEMPLATE LIBRARY</div>
    <div id="library-explainer" class="label tone-muted">Plans are reusable. Finite equipment gates assignment, not design.</div>
    <div id="template-list" class="selection-list">
      <button each="row in templateRows" key="{row.id}" id="{row.id}" class="{row.classes}" disabled="{row.disabled}" onclick="{row.select}">{row.label}</button>
    </div>
  </div>
</template>

<style>
  .template-library {
    flex-direction: column;
    width: 360px;
    padding: 10px;
    gap: 7px;
    overflow: hidden;
  }

  .label { overflow: hidden; }
  .heading { font-family: heading; }
  #library-heading { height: 30px; }
  #library-explainer { height: 52px; }

  .selection-list {
    flex-direction: column;
    flex-grow: 1;
    gap: 7px;
    padding: 2px;
    overflow: scroll;
  }

  .selection-row {
    height: 42px;
    padding: 6px 10px;
    border-width: 1px;
    overflow: hidden;
    font-family: body;
    text-align: left;
  }
</style>
