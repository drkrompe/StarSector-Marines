<template props="templateTiles">
  <div id="template-library" class="panel template-library">
    <div id="library-heading" class="label heading tone-edge">CHANGE LOADOUT</div>
    <div id="library-explainer" class="label tone-muted">Preview a reusable template below; the team changes only when equipped.</div>
    <div id="template-list" class="template-gallery">
      <button each="tile in templateTiles" key="{tile.id}" id="{tile.id}" class="{tile.classes}" onclick="{tile.select}">
        <div id="{tile.nameId}" class="template-name label heading tone-edge">{tile.name}</div>
        <canvas id="{tile.canvasId}" class="template-preview" width="480" height="156" />
        <div id="{tile.availabilityId}" class="template-availability label tone-muted">{tile.availability}</div>
      </button>
    </div>
  </div>
</template>

<style>
  .template-library {
    flex-direction: column;
    height: 174px;
    padding: 6px;
    gap: 4px;
    overflow: hidden;
  }

  .label { overflow: hidden; }
  .heading { font-family: heading; }
  #library-heading { height: 18px; }
  #library-explainer { height: 18px; }

  .template-gallery {
    flex-direction: row;
    flex-grow: 1;
    gap: 6px;
    padding: 1px;
    overflow: scroll;
  }

  .template-tile {
    flex-direction: column;
    width: 218px;
    height: 116px;
    padding: 5px;
    gap: 3px;
    border-width: 1px;
    overflow: hidden;
    font-family: body;
    text-align: left;
  }

  .template-name { height: 17px; }
  .template-preview { width: 0px; height: 0px; flex-grow: 1; border-width: 1px; overflow: hidden; }
  .template-availability { height: 17px; text-align: right; }
</style>
