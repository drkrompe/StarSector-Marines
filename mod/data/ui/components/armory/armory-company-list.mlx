<template props="companyCards">
  <div id="company-list" class="company-list panel">
    <button each="company in companyCards" key="{company.id}" id="{company.id}" class="{company.classes}" onclick="{company.open}">
      <div id="{company.designationId}" class="company-designation label heading tone-accent">{company.designation}</div>
      <div id="{company.nameId}" class="company-name label heading tone-edge">{company.name}</div>
      <div id="{company.statusId}" class="{company.statusClasses}">{company.status}</div>
      <div id="{company.marineSquadsId}" class="company-stat label">{company.marineSquads}</div>
      <div id="{company.mechSquadsId}" class="company-stat label">{company.mechSquads}</div>
      <div id="{company.readinessId}" class="company-readiness label surface-dark">{company.readiness}</div>
      <div id="{company.stationingId}" class="company-stationing label tone-muted">{company.stationing}</div>
      <div id="{company.openId}" class="company-open label tone-edge">{company.openLabel}</div>
    </button>
  </div>
</template>

<style>
  .company-list {
    display: grid;
    flex-grow: 1;
    gap: 14px;
    padding: 14px;
    overflow: scroll;
  }

  .label { overflow: hidden; }
  .heading { font-family: heading; }

  .company-card {
    flex-direction: column;
    width: 182px;
    height: 602px;
    padding: 12px;
    gap: 10px;
    border-width: 2px;
    overflow: hidden;
    font-family: body;
    text-align: left;
  }

  .company-designation { height: 24px; }
  .company-name { height: 66px; }

  .company-status {
    height: 48px;
    padding: 9px;
    border-width: 1px;
    text-align: center;
  }

  .company-stat {
    height: 54px;
    padding: 10px 8px;
    border-width: 1px;
  }

  .company-readiness {
    height: 62px;
    padding: 12px 8px;
    border-width: 1px;
  }

  .company-stationing {
    height: 50px;
    flex-grow: 1;
    padding: 9px 8px;
  }

  .company-open {
    height: 42px;
    padding: 9px 8px;
    border-width: 1px;
    text-align: center;
  }
</style>
