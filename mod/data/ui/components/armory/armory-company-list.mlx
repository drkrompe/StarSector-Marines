<template props="companyCards">
  <div id="company-list" class="company-list panel">
    <button each="company in companyCards" key="{company.id}" id="{company.id}" class="{company.classes}" onclick="{company.open}">
      <div id="{company.designationId}" class="company-designation label heading tone-accent">{company.designation}</div>
      <div id="{company.nameId}" class="company-name label tone-edge">{company.name}</div>
      <div id="{company.statusId}" class="{company.statusClasses}">{company.status}</div>
      <div id="{company.marineSquadsId}" class="company-stat label">{company.marineSquads}</div>
      <div id="{company.mechSquadsId}" class="company-stat label">{company.mechSquads}</div>
      <div id="{company.readinessId}" class="company-readiness label surface-dark">{company.readiness}</div>
      <div id="{company.recoveryId}" class="company-recovery label tone-accent">{company.recovery}</div>
      <div id="{company.stationingId}" class="company-stationing label tone-muted">{company.stationing}</div>
      <div id="{company.openId}" class="company-open label tone-edge">{company.openLabel}</div>
    </button>
  </div>
</template>

<style>
  .company-list {
    display: grid;
    flex-grow: 1;
    gap: 10px;
    padding: 10px;
    overflow: scroll;
  }

  .label { overflow: hidden; }
  .heading { font-family: heading; }

  .company-card {
    flex-direction: column;
    width: 232px;
    height: 300px;
    padding: 8px;
    gap: 4px;
    border-width: 1px;
    overflow: hidden;
    font-family: body;
    text-align: left;
  }

  .company-designation { height: 18px; }
  .company-name { height: 28px; font-family: title; }

  .company-status {
    height: 22px;
    padding: 3px;
    border-width: 1px;
    text-align: center;
  }

  .company-stat {
    height: 18px;
    padding: 2px 1px;
    border-width: 0px;
  }

  .company-readiness {
    height: 24px;
    padding: 4px 6px;
    border-width: 1px;
  }

  .company-recovery { height: 18px; padding: 2px 1px; }

  .company-stationing {
    height: 20px;
    padding: 2px;
  }

  .company-open {
    height: 22px;
    padding: 3px 6px;
    border-width: 1px;
    text-align: center;
  }
</style>
