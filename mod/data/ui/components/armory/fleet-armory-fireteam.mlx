<template props="companySummary,selectedSquadName,inspection,weaponDoctrineSummary,armorDoctrineSummary,weaponDoctrineTiles,armorDoctrineTiles,weaponPickerTabClasses,armorPickerTabClasses,weaponPickerPanelClasses,armorPickerPanelClasses,showWeaponPicker,showArmorPicker,loadoutFilters,loadoutBrowserSummary,showArmorComparison,transactionSummary,transactionClasses,issueCargoRows,issueCargoClasses,applyDisabled,applyLabel,apply,feedbackText,feedbackClasses,backToSquads,back,returnAction,hqAction,barracksAction,armoryAction,mechLabAction,boatsAction,engineeringAction,hqClasses,barracksClasses,armoryClasses,mechLabClasses,engineeringClasses,boatsClasses">
  <div id="fleet-armory-fireteam-root" class="fleet-armory-root">
    <marine-ops-page-nav returnAction="{returnAction}" hqAction="{hqAction}" barracksAction="{barracksAction}" armoryAction="{armoryAction}" mechLabAction="{mechLabAction}" boatsAction="{boatsAction}" engineeringAction="{engineeringAction}" engineeringClasses="{engineeringClasses}" hqClasses="{hqClasses}" barracksClasses="{barracksClasses}" armoryClasses="{armoryClasses}" mechLabClasses="{mechLabClasses}" boatsClasses="{boatsClasses}" contextLabel="BARRACKS / EQUIPMENT / SQUAD ISSUE" />

    <div id="fireteam-breadcrumb" class="panel console-command-rail">
      <button id="fireteam-breadcrumb-companies" onclick="{back}">Back</button>
      <div id="fireteam-breadcrumb-separator-company" class="breadcrumb-separator label tone-muted">/</div>
      <button id="back-to-squads" onclick="{backToSquads}">Equipment</button>
      <div id="fireteam-breadcrumb-separator-squad" class="breadcrumb-separator label tone-muted">/</div>
      <div id="fireteam-squad-name" class="breadcrumb-current label tone-edge">{selectedSquadName}</div>
      <div id="fireteam-breadcrumb-separator-teams" class="breadcrumb-separator label tone-muted">/</div>
      <div id="fireteam-breadcrumb-current" class="breadcrumb-current label tone-accent">Loadout</div>
    </div>

    <div id="fireteam-body">
      <armory-refit-transaction inspection="{inspection}" feedbackText="{feedbackText}" feedbackClasses="{feedbackClasses}" />
      <armory-squad-doctrine weaponDoctrineSummary="{weaponDoctrineSummary}" armorDoctrineSummary="{armorDoctrineSummary}" weaponDoctrineTiles="{weaponDoctrineTiles}" armorDoctrineTiles="{armorDoctrineTiles}" weaponPickerTabClasses="{weaponPickerTabClasses}" armorPickerTabClasses="{armorPickerTabClasses}" weaponPickerPanelClasses="{weaponPickerPanelClasses}" armorPickerPanelClasses="{armorPickerPanelClasses}" showWeaponPicker="{showWeaponPicker}" showArmorPicker="{showArmorPicker}" loadoutFilters="{loadoutFilters}" loadoutBrowserSummary="{loadoutBrowserSummary}" showArmorComparison="{showArmorComparison}" transactionSummary="{transactionSummary}" transactionClasses="{transactionClasses}" issueCargoRows="{issueCargoRows}" issueCargoClasses="{issueCargoClasses}" applyDisabled="{applyDisabled}" applyLabel="{applyLabel}" apply="{apply}" />
    </div>

  </div>
</template>

<style>
  .fleet-armory-root {
    flex-direction: column;
    padding: 10px;
    gap: 8px;
    border-width: 2px;
    overflow: hidden;
  }

  .label { overflow: hidden; }
  #fireteam-breadcrumb {
    flex-direction: row;
    height: 28px;
    padding: 3px 4px;
    gap: 5px;
  }

  #fireteam-breadcrumb button { padding: 2px 7px; border-width: 1px; font-family: body; }
  .breadcrumb-separator { width: 10px; text-align: center; }
  .breadcrumb-current { padding: 3px 4px; }

  #fireteam-body { flex-direction: row; height: 0px; flex-grow: 1; gap: 8px; overflow: hidden; }

</style>
