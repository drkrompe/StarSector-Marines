<template props="companySummary,selectedSquadName,fireTeamOverviews,templateTiles,targetSummary,candidateSummary,selectedSquadReadiness,reinforceLabel,reinforceDisabled,reinforceSquad,marineCards,pickerClasses,pickerToggleLabel,togglePicker,transactionSummary,transactionClasses,applyDisabled,applyClasses,applyLabel,apply,feedbackText,feedbackClasses,backToSquads,back,returnAction,hqAction,armoryAction,mechLabAction,hqClasses,armoryClasses,mechLabClasses">
  <div id="fleet-armory-fireteam-root" class="fleet-armory-root">
    <marine-ops-page-nav returnAction="{returnAction}" hqAction="{hqAction}" armoryAction="{armoryAction}" mechLabAction="{mechLabAction}" hqClasses="{hqClasses}" armoryClasses="{armoryClasses}" mechLabClasses="{mechLabClasses}" contextLabel="FLAGSHIP / ARMORY / EQUIPMENT ISSUE" />

    <div id="fireteam-breadcrumb" class="panel">
      <button id="fireteam-breadcrumb-companies" onclick="{back}">Companies</button>
      <div id="fireteam-breadcrumb-separator-company" class="breadcrumb-separator label tone-muted">/</div>
      <button id="back-to-squads" onclick="{backToSquads}">Fleet Marine Company</button>
      <div id="fireteam-breadcrumb-separator-squad" class="breadcrumb-separator label tone-muted">/</div>
      <div id="fireteam-squad-name" class="breadcrumb-current label tone-edge">{selectedSquadName}</div>
      <div id="fireteam-breadcrumb-separator-teams" class="breadcrumb-separator label tone-muted">/</div>
      <div id="fireteam-breadcrumb-current" class="breadcrumb-current label tone-accent">Fire Teams</div>
    </div>

    <div id="fireteam-body">
      <armory-fireteam-list fireTeamOverviews="{fireTeamOverviews}" />
      <armory-refit-transaction targetSummary="{targetSummary}" candidateSummary="{candidateSummary}" selectedSquadReadiness="{selectedSquadReadiness}" reinforceLabel="{reinforceLabel}" reinforceDisabled="{reinforceDisabled}" reinforceSquad="{reinforceSquad}" marineCards="{marineCards}" templateTiles="{templateTiles}" pickerClasses="{pickerClasses}" pickerToggleLabel="{pickerToggleLabel}" togglePicker="{togglePicker}" transactionSummary="{transactionSummary}" transactionClasses="{transactionClasses}" applyDisabled="{applyDisabled}" applyClasses="{applyClasses}" applyLabel="{applyLabel}" apply="{apply}" feedbackText="{feedbackText}" feedbackClasses="{feedbackClasses}" />
    </div>

  </div>
</template>

<style>
  .fleet-armory-root {
    flex-direction: column;
    padding: 10px;
    gap: 8px;
    border-width: 2px;
    overflow: hidden;
  }

  .label { overflow: hidden; }
  #fireteam-breadcrumb {
    flex-direction: row;
    height: 28px;
    padding: 3px 4px;
    gap: 5px;
  }

  #fireteam-breadcrumb button { padding: 2px 7px; border-width: 1px; font-family: body; }
  .breadcrumb-separator { width: 10px; text-align: center; }
  .breadcrumb-current { padding: 3px 4px; }

  #fireteam-body { flex-direction: row; height: 0px; flex-grow: 1; gap: 8px; overflow: hidden; }

</style>
