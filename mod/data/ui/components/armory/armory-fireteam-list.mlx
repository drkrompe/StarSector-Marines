<template props="fireTeamOverviews">
  <div id="fireteam-rail" class="panel fireteam-rail">
    <div id="fireteam-list-intro" class="fireteam-list-intro">
      <div id="fireteam-list-heading" class="label heading tone-edge">TEAMS</div>
    </div>
    <div id="fireteam-list" class="fireteam-list">
      <button each="team in fireTeamOverviews" key="{team.id}" id="{team.id}" class="{team.classes}" onclick="{team.select}">
        <div id="{team.headingRowId}" class="fire-team-heading-row">
          <div id="{team.nameId}" class="fire-team-name label tone-edge">{team.name}</div>
          <div id="{team.strengthId}" class="fire-team-strength label">{team.strength}</div>
          <div id="{team.statusId}" class="{team.statusClasses}">{team.status}</div>
          <div id="{team.recoveryId}" class="fire-team-recovery label tone-accent">{team.recovery}</div>
          <div id="{team.templateId}" class="fire-team-template label tone-muted">{team.template}</div>
        </div>
      </button>
    </div>
  </div>
</template>

<style>
  .fireteam-rail { flex-direction: row; height: 42px; padding: 5px; gap: 6px; overflow: hidden; }
  .label { overflow: hidden; }
  .heading { font-family: heading; }
  .fireteam-list-intro { flex-direction: column; width: 72px; }
  #fireteam-list-heading { height: 28px; padding: 5px 1px; }
  .fireteam-list { flex-direction: row; width: 0px; height: 30px; flex-grow: 1; gap: 6px; overflow: hidden; }

  .fire-team-overview {
    flex-direction: row;
    width: 0px;
    height: 30px;
    flex-grow: 1;
    padding: 4px 7px;
    gap: 7px;
    border-width: 1px;
    overflow: hidden;
    font-family: body;
    text-align: left;
  }

  .fire-team-heading-row { flex-direction: row; width: 100%; height: 20px; gap: 7px; }
  .fire-team-name { width: 58px; }
  .fire-team-strength { width: 78px; }
  .fire-team-status { width: 96px; overflow: hidden; }
  .fire-team-recovery { width: 0px; flex-grow: 1; }
  .fire-team-template { width: 132px; text-align: right; }
</style>
