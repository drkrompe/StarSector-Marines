<template props="fireTeamOverviews">
  <div id="fireteam-rail" class="panel fireteam-rail">
    <div id="fireteam-list-intro" class="fireteam-list-intro">
      <div id="fireteam-list-heading" class="label heading tone-edge">FIRE TEAMS</div>
      <div id="fireteam-list-copy" class="label tone-muted">Choose four billets to inspect.</div>
    </div>
    <div id="fireteam-list" class="fireteam-list">
      <button each="team in fireTeamOverviews" key="{team.id}" id="{team.id}" class="{team.classes}" onclick="{team.select}">
        <div id="{team.headingRowId}" class="fire-team-heading-row">
          <div id="{team.nameId}" class="fire-team-name label tone-edge">{team.name}</div>
          <div id="{team.statusId}" class="{team.statusClasses}">{team.status}</div>
        </div>
        <div id="{team.detailRowId}" class="fire-team-detail-row">
          <div id="{team.strengthId}" class="fire-team-strength label">{team.strength}</div>
          <div id="{team.recoveryId}" class="fire-team-recovery label tone-accent">{team.recovery}</div>
        </div>
        <div id="{team.templateId}" class="fire-team-template label surface-dark">{team.template}</div>
      </button>
    </div>
  </div>
</template>

<style>
  .fireteam-rail { flex-direction: row; height: 82px; padding: 7px; gap: 8px; overflow: hidden; }
  .label { overflow: hidden; }
  .heading { font-family: heading; }
  .fireteam-list-intro { flex-direction: column; width: 190px; gap: 3px; }
  #fireteam-list-heading { height: 20px; }
  #fireteam-list-copy { height: 36px; white-space: normal; }
  .fireteam-list { flex-direction: row; width: 0px; flex-grow: 1; gap: 7px; padding: 1px; overflow: hidden; }

  .fire-team-overview {
    flex-direction: column;
    width: 0px;
    height: 66px;
    flex-grow: 1;
    padding: 5px 7px;
    gap: 2px;
    border-width: 1px;
    overflow: hidden;
    font-family: body;
    text-align: left;
  }

  .fire-team-heading-row, .fire-team-detail-row { flex-direction: row; height: 17px; gap: 6px; }
  .fire-team-name, .fire-team-strength { width: 0px; flex-grow: 1; }
  .fire-team-status { width: 76px; text-align: right; }
  .fire-team-recovery { width: 166px; text-align: right; }
  .fire-team-template { height: 20px; padding: 2px 5px; border-width: 1px; }
</style>
