<template props="weaponDoctrineSummary,armorDoctrineSummary,weaponDoctrineTiles,armorDoctrineTiles,weaponPickerTabClasses,armorPickerTabClasses,weaponPickerPanelClasses,armorPickerPanelClasses,showWeaponPicker,showArmorPicker,loadoutFilters,loadoutBrowserSummary,showArmorComparison,transactionSummary,transactionClasses,issueCargoRows,issueCargoClasses">
  <div id="squad-doctrine-strip" class="panel squad-doctrine-strip">
    <div id="equipment-picker-tabs">
      <div id="equipment-picker-heading" class="label heading tone-edge">{i18n.openingUiArmorySquadDoctrineLoadouts}</div>
      <button id="show-weapon-picker" class="{weaponPickerTabClasses}" onclick="{showWeaponPicker}">{i18n.openingUiArmorySquadDoctrineWeaponLoadouts}</button>
      <button id="show-armor-picker" class="{armorPickerTabClasses}" onclick="{showArmorPicker}">{i18n.openingUiArmorySquadDoctrineTacticSheets}</button>
    </div>

    <div id="loadout-browser-tools">
      <div id="loadout-browser-summary" class="label tone-edge">{loadoutBrowserSummary}</div>
      <div id="loadout-browser-order" class="label tone-muted">{i18n.openingUiLoadoutCatalogRelativeFirepowerProtection}</div>
    </div>

    <div id="loadout-filter-list">
      <button each="filter in loadoutFilters" key="{filter.id}" id="{filter.id}" class="{filter.classes}" onclick="{filter.select}">{filter.label}</button>
    </div>

    <div id="weapon-doctrine-slot" class="{weaponPickerPanelClasses}">
      <div id="weapon-doctrine-summary" class="label surface-dark tone-edge">{weaponDoctrineSummary}</div>
      <div id="weapon-doctrine-list" class="doctrine-list">
        <armory-loadout-card each="tile in weaponDoctrineTiles" key="{tile.id}" tile="{tile}" />
      </div>
    </div>

    <div id="armor-doctrine-slot" class="{armorPickerPanelClasses}">
      <div id="armor-doctrine-summary-row">
        <div id="armor-doctrine-summary" class="label surface-dark tone-edge">{armorDoctrineSummary}</div>
        <button id="compare-armor-patterns" class="spec-tab" onclick="{showArmorComparison}">{i18n.openingUiArmorySquadDoctrineComparePatterns}</button>
      </div>
      <div id="armor-doctrine-list" class="doctrine-list">
        <armory-loadout-card each="tile in armorDoctrineTiles" key="{tile.id}" tile="{tile}" />
      </div>
    </div>

    <div id="issue-cargo-costs" class="{issueCargoClasses}">
      <company-resource-cost each="cargo in issueCargoRows" key="{cargo.id}" row="{cargo}" />
    </div>

    <div id="squad-equip-row">
      <div id="transaction-result" class="{transactionClasses}">{transactionSummary}</div>
    </div>
  </div>
</template>

<style>
  .squad-doctrine-strip { flex-direction: column; width: 584px; height: 100%; padding: 7px; gap: 5px; overflow: hidden; }
  .label { overflow: hidden; }
  .heading { font-family: heading; }
  #equipment-picker-tabs { flex-direction: row; height: 30px; gap: 6px; }
  #equipment-picker-heading { width: 94px; padding: 5px 2px; }
  .equipment-picker-tab { width: 190px; height: 30px; padding: 7px 8px; }

  #loadout-browser-tools { flex-direction: row; height: 26px; gap: 5px; }
  #loadout-browser-summary { width: 84px; padding: 4px 2px; }
  #loadout-browser-order { width: 0px; flex-grow: 1; padding: 4px 2px; }
  #loadout-filter-list { flex-direction: row; height: 28px; gap: 3px; }
  .loadout-filter { width: 0px; height: 26px; flex-grow: 1; padding: 5px 3px; }
  .supply-filter { width: 132px; height: 26px; padding: 4px 3px; border-width: 1px; font-family: body; text-align: center; }
  .supply-filter.selected { background-color: #35433f; border-color: #a5c6bc; color: #d5deea; }

  .doctrine-slot { flex-direction: column; height: 0px; flex-grow: 1; padding: 0px; gap: 5px; border-width: 0px; overflow: hidden; }
  .picker-hidden { width: 0px; height: 0px; flex-grow: 0; padding: 0px; gap: 0px; border-width: 0px; opacity: 0; overflow: hidden; }
  #weapon-doctrine-summary { height: 20px; padding: 2px 5px; }
  #armor-doctrine-summary-row { flex-direction: row; height: 20px; gap: 5px; }
  #armor-doctrine-summary { width: 0px; flex-grow: 1; height: 20px; padding: 2px 5px; }
  #compare-armor-patterns { width: 130px; height: 20px; padding: 2px 4px; }
  /* The catalogue is stores, as the Mech Lab keeps them: a black pit sunk into the panel, its lip
     in shadow at the top and left and lit at the bottom and right, the floor darkening under the
     top lip, and the cards standing proud of it with black showing on every side. */
  .doctrine-list { display: grid; height: 0px; flex-grow: 1; gap: 10px; padding: 10px 24px; border-width: 3px; border-style: inset; border-color: #3e4a48; background-color: #06090b; background-image: linear-gradient(to bottom, #000000c0 0%, #00000000 6%); overflow: scroll; }

  .cargo-costs { display: grid; height: 54px; gap: 4px; overflow: hidden; }
  .cargo-costs.empty { height: 0px; gap: 0px; }
  .cargo-cost { width: 236px; height: 25px; flex-direction: row; padding: 2px 4px; gap: 4px; border-width: 1px; border-color: #50677e; background-color: #101a25; }
  .cargo-cost.short { border-color: #a95252; background-color: #261616; color: #f09a9a; }
  .cargo-cost-icon { width: 19px; height: 19px; }
  .cargo-cost-label { width: 0px; height: 19px; flex-grow: 1; padding: 2px 0px; color: #b8c6d6; }
  .cargo-cost.short .cargo-cost-label { color: #f09a9a; }
  #squad-equip-row { flex-direction: row; gap: 7px; }
  .transaction-result-empty { width: 0px; flex-grow: 1; height: 0px; }
  .transaction-result { width: 0px; flex-grow: 1; padding: 4px 7px; border-width: 1px; overflow: hidden; }
</style>
