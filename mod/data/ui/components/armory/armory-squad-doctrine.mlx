<template props="weaponDoctrineSummary,armorDoctrineSummary,weaponDoctrineTiles,armorDoctrineTiles,weaponPickerTabClasses,armorPickerTabClasses,weaponPickerPanelClasses,armorPickerPanelClasses,showWeaponPicker,showArmorPicker,loadoutFilters,issuableFilter,loadoutBrowserSummary,showArmorComparison,transactionSummary,transactionClasses,issueCargoRows,issueCargoClasses,applyDisabled,applyLabel,apply">
  <div id="squad-doctrine-strip" class="panel squad-doctrine-strip">
    <div id="equipment-picker-tabs">
      <div id="equipment-picker-heading" class="label heading tone-edge">LOADOUTS</div>
      <button id="show-weapon-picker" class="{weaponPickerTabClasses}" onclick="{showWeaponPicker}">Weapon Loadouts</button>
      <button id="show-armor-picker" class="{armorPickerTabClasses}" onclick="{showArmorPicker}">Tactic Sheets</button>
    </div>

    <div id="loadout-browser-tools">
      <div id="loadout-browser-summary" class="label tone-edge">{loadoutBrowserSummary}</div>
      <div id="loadout-browser-order" class="label tone-muted">Strongest first</div>
      <button id="{issuableFilter.id}" class="{issuableFilter.classes}" onclick="{issuableFilter.select}">{issuableFilter.label}</button>
    </div>

    <div id="loadout-filter-list">
      <button each="filter in loadoutFilters" key="{filter.id}" id="{filter.id}" class="{filter.classes}" onclick="{filter.select}">{filter.label}</button>
    </div>

    <div id="weapon-doctrine-slot" class="{weaponPickerPanelClasses}">
      <div id="weapon-doctrine-summary" class="label surface-dark tone-edge">{weaponDoctrineSummary}</div>
      <div id="weapon-doctrine-list" class="doctrine-list">
        <button each="tile in weaponDoctrineTiles" key="{tile.id}" id="{tile.id}" class="{tile.classes}" onclick="{tile.select}">
          <div id="{tile.headerId}" class="doctrine-header">
            <div id="{tile.nameId}" class="doctrine-name label tone-edge">{tile.name}</div>
            <div id="{tile.ratingId}" class="{tile.ratingClasses}">{tile.ratingLabel}</div>
            <div id="{tile.rarityId}" class="{tile.rarityClasses}">{tile.rarity}</div>
          </div>
          <div id="{tile.metadataRowId}" class="doctrine-metadata-row">
            <img id="{tile.factionLogoId}" class="{tile.factionLogoClasses}" src="{tile.factionLogo}" />
            <div id="{tile.metadataId}" class="doctrine-metadata label tone-accent">{tile.metadata}</div>
          </div>
          <div id="{tile.descriptionId}" class="doctrine-lore label tone-muted">{tile.description}</div>
          <div id="{tile.distributionId}" class="{tile.distributionClasses}">{tile.distribution}</div>
          <div id="{tile.distributionRowId}" class="{tile.distributionRowClasses}">
            <div id="{tile.distributionGridId}" class="doctrine-span-grid">
              <div each="span in tile.distributionSpans" key="{span.id}" id="{span.id}" class="doctrine-span doctrine-issue-span label">{span.label}</div>
            </div>
          </div>
        </button>
      </div>
    </div>

    <div id="armor-doctrine-slot" class="{armorPickerPanelClasses}">
      <div id="armor-doctrine-summary-row">
        <div id="armor-doctrine-summary" class="label surface-dark tone-edge">{armorDoctrineSummary}</div>
        <button id="compare-armor-patterns" onclick="{showArmorComparison}">Compare Patterns</button>
      </div>
      <div id="armor-doctrine-list" class="doctrine-list">
        <button each="tile in armorDoctrineTiles" key="{tile.id}" id="{tile.id}" class="{tile.classes}" onclick="{tile.select}">
          <div id="{tile.headerId}" class="doctrine-header">
            <div id="{tile.nameId}" class="doctrine-name label tone-edge">{tile.name}</div>
            <div id="{tile.ratingId}" class="{tile.ratingClasses}">{tile.ratingLabel}</div>
            <div id="{tile.rarityId}" class="{tile.rarityClasses}">{tile.rarity}</div>
          </div>
          <div id="{tile.metadataRowId}" class="doctrine-metadata-row">
            <img id="{tile.factionLogoId}" class="{tile.factionLogoClasses}" src="{tile.factionLogo}" />
            <div id="{tile.metadataId}" class="doctrine-metadata label tone-accent">{tile.metadata}</div>
          </div>
          <div id="{tile.descriptionId}" class="doctrine-lore label tone-muted">{tile.description}</div>
          <div id="{tile.compositionId}" class="doctrine-composition label">SECTION  ·  {tile.composition}</div>
          <div id="{tile.distributionId}" class="{tile.distributionClasses}">ISSUED  ·  {tile.distribution}</div>
          <div id="{tile.distributionRowId}" class="{tile.distributionRowClasses}">
            <div id="{tile.distributionTagId}" class="doctrine-line-tag label">ISSUED</div>
            <div id="{tile.distributionGridId}" class="doctrine-span-grid">
              <div each="span in tile.distributionSpans" key="{span.id}" id="{span.id}" class="doctrine-span doctrine-issue-span label">{span.label}</div>
            </div>
          </div>
          <div id="{tile.carriesId}" class="{tile.carriesClasses}">CARRIES  ·  {tile.carries}</div>
          <div id="{tile.carriesRowId}" class="{tile.carriesRowClasses}">
            <div id="{tile.carriesTagId}" class="doctrine-line-tag label">CARRIES</div>
            <div id="{tile.carriesGridId}" class="doctrine-span-grid">
              <div each="span in tile.carriesSpans" key="{span.id}" id="{span.id}" class="doctrine-span doctrine-carries-span label">{span.label}</div>
            </div>
          </div>
        </button>
      </div>
    </div>

    <div id="issue-cargo-costs" class="{issueCargoClasses}">
      <div each="cargo in issueCargoRows" key="{cargo.id}" id="{cargo.id}" class="{cargo.classes}">
        <img id="{cargo.iconId}" class="cargo-cost-icon" src="{cargo.icon}" />
        <div id="{cargo.labelId}" class="cargo-cost-label label">{cargo.label}</div>
      </div>
    </div>

    <div id="squad-equip-row">
      <div id="transaction-result" class="{transactionClasses}">{transactionSummary}</div>
      <button id="apply-squad-equipment" class="apply-button" disabled="{applyDisabled}" onclick="{apply}">{applyLabel}</button>
    </div>
  </div>
</template>

<style>
  .squad-doctrine-strip { flex-direction: column; width: 520px; height: 100%; padding: 7px; gap: 5px; overflow: hidden; }
  .label { overflow: hidden; }
  .heading { font-family: heading; }
  #equipment-picker-tabs { flex-direction: row; height: 30px; gap: 6px; }
  #equipment-picker-heading { width: 94px; padding: 5px 2px; }
  .equipment-picker-tab { width: 190px; padding: 4px 8px; border-width: 1px; font-family: body; text-align: center; }
  .equipment-picker-tab.selected { background-color: #345a7c; border-color: #53c6e8; color: #d5deea; }

  #loadout-browser-tools { flex-direction: row; height: 26px; gap: 5px; }
  #loadout-browser-summary { width: 84px; padding: 4px 2px; }
  #loadout-browser-order { width: 0px; flex-grow: 1; padding: 4px 2px; }
  #loadout-filter-list { flex-direction: row; height: 28px; gap: 3px; }
  .loadout-filter { width: 0px; height: 26px; flex-grow: 1; padding: 4px 3px; border-width: 1px; font-family: body; text-align: center; }
  .supply-filter { width: 132px; height: 26px; padding: 4px 3px; border-width: 1px; font-family: body; text-align: center; }
  .supply-filter.selected { background-color: #345a7c; border-color: #53c6e8; color: #d5deea; }
  .loadout-filter.selected { background-color: #345a7c; border-color: #53c6e8; color: #d5deea; }

  .doctrine-slot { flex-direction: column; height: 0px; flex-grow: 1; padding: 4px; gap: 3px; border-width: 1px; overflow: hidden; }
  .picker-hidden { width: 0px; height: 0px; flex-grow: 0; padding: 0px; gap: 0px; border-width: 0px; opacity: 0; overflow: hidden; }
  #weapon-doctrine-summary { height: 20px; padding: 2px 5px; }
  #armor-doctrine-summary-row { flex-direction: row; height: 20px; gap: 5px; }
  #armor-doctrine-summary { width: 0px; flex-grow: 1; height: 20px; padding: 2px 5px; }
  #compare-armor-patterns { width: 130px; height: 20px; padding: 2px 4px; border-width: 1px; font-family: body; text-align: center; }
  .doctrine-list { display: grid; height: 0px; flex-grow: 1; gap: 6px; padding: 1px; overflow: scroll; }
  .doctrine-tile { flex-direction: column; width: 476px; height: 214px; padding: 6px; gap: 2px; border-width: 1px; font-family: body; text-align: left; overflow: hidden; background-color: #0e1621; }
  .doctrine-tile.rarity-common { border-color: #607188; }
  .doctrine-tile.rarity-uncommon { border-color: #53c6e8; background-color: #10202c; }
  .doctrine-tile.rarity-rare { border-color: #dfb84d; background-color: #211d13; }
  .doctrine-tile.rarity-exotic { border-color: #c77dff; background-color: #21162c; }
  .doctrine-tile.selected { background-color: #345a7c; border-color: #f2cf68; }
  .doctrine-header { flex-direction: row; height: 18px; gap: 5px; }
  .doctrine-metadata-row { flex-direction: row; height: 26px; gap: 7px; }
  .doctrine-name, .doctrine-metadata { width: 0px; flex-grow: 1; }
  .doctrine-metadata { padding: 5px 0px; }
  .doctrine-faction-logo { width: 48px; height: 24px; border-width: 1px; border-color: #607188; background-color: #0a1018; }
  .doctrine-faction-logo.faction-logo-hidden { width: 0px; height: 0px; border-width: 0px; opacity: 0; }
  .doctrine-rating { width: 78px; padding: 1px 4px; border-width: 1px; text-align: center; }
  .doctrine-rating.rating-low { color: #b4c0ce; border-color: #607188; }
  .doctrine-rating.rating-mid { color: #7fb2d8; border-color: #4c7fa6; }
  .doctrine-rating.rating-high { color: #8fd6a6; border-color: #4f9c6b; }
  .doctrine-rarity { width: 74px; padding: 1px 4px; border-width: 1px; text-align: center; }
  .doctrine-rarity.rarity-common { color: #b4c0ce; border-color: #607188; }
  .doctrine-rarity.rarity-uncommon { color: #70d9f4; border-color: #53c6e8; }
  .doctrine-rarity.rarity-rare { color: #f2cf68; border-color: #dfb84d; }
  .doctrine-rarity.rarity-exotic { color: #dda8ff; border-color: #c77dff; }
  .doctrine-lore { height: 64px; white-space: normal; }
  .doctrine-composition { height: 18px; color: #7fb2d8; }
  .doctrine-distribution { height: 34px; color: #d8bd67; white-space: normal; }
  .doctrine-carries { height: 18px; color: #8fd6a6; }

  /* An issue line is drawn as one span per entry so a reader can point at a
     name; the grid is what wraps it, since a flow row does not. The plain
     label above stays as the fallback for a line with nothing to list, and
     exactly one of the two is ever laid out. */
  .doctrine-span-row { flex-direction: row; gap: 6px; overflow: hidden; }
  .doctrine-distribution-row { height: 40px; }
  .doctrine-carries-row { height: 18px; }
  .doctrine-line-tag { width: 58px; padding: 1px 0px; color: #7d8ea1; }
  .doctrine-span-grid { display: grid; width: 0px; flex-grow: 1; gap: 3px; overflow: hidden; }
  .doctrine-span { height: 17px; padding: 1px 2px; }
  .doctrine-issue-span { color: #d8bd67; }
  .doctrine-carries-span { color: #8fd6a6; }
  .doctrine-line-hidden { width: 0px; height: 0px; padding: 0px; gap: 0px; border-width: 0px; flex-grow: 0; opacity: 0; overflow: hidden; }
  .cargo-costs { display: grid; height: 54px; gap: 4px; overflow: hidden; }
  .cargo-costs.empty { height: 0px; gap: 0px; }
  .cargo-cost { width: 236px; height: 25px; flex-direction: row; padding: 2px 4px; gap: 4px; border-width: 1px; border-color: #50677e; background-color: #101a25; }
  .cargo-cost.short { border-color: #a95252; background-color: #261616; color: #f09a9a; }
  .cargo-cost-icon { width: 19px; height: 19px; }
  .cargo-cost-label { width: 0px; height: 19px; flex-grow: 1; padding: 2px 0px; color: #b8c6d6; }
  .cargo-cost.short .cargo-cost-label { color: #f09a9a; }
  #squad-equip-row { flex-direction: row; height: 30px; gap: 7px; }
  .transaction-result { width: 0px; flex-grow: 1; padding: 4px 7px; border-width: 1px; overflow: hidden; }
  .apply-button { padding: 4px 9px; border-width: 1px; font-family: body; text-align: center; }
</style>
