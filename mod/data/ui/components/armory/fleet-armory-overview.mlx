<template props="fleetSummary,companyCards,returnAction,hqAction,armoryAction,hqClasses,hqDisabled,armoryClasses,armoryDisabled">
  <div id="fleet-armory-overview-root" class="fleet-armory-overview-root">
    <marine-ops-page-nav returnAction="{returnAction}" hqAction="{hqAction}" armoryAction="{armoryAction}" hqClasses="{hqClasses}" hqDisabled="{hqDisabled}" armoryClasses="{armoryClasses}" armoryDisabled="{armoryDisabled}" contextLabel="FLAGSHIP / ARMORY / COMPANY ROSTER" />

    <div id="company-overview-intro" class="panel">
      <div id="company-overview-heading" class="label heading tone-edge">SELECT A COMPANY</div>
      <div id="company-overview-copy" class="label tone-muted">Choose a company to inspect its squads, fire teams, templates, and finite equipment.</div>
      <div id="company-overview-summary" class="label surface-dark">{fleetSummary}</div>
    </div>

    <armory-company-list companyCards="{companyCards}" />

  </div>
</template>

<style>
  .fleet-armory-overview-root {
    flex-direction: column;
    padding: 10px;
    gap: 8px;
    border-width: 2px;
    overflow: hidden;
  }

  .label { overflow: hidden; }
  .heading { font-family: heading; }

  #company-overview-intro {
    flex-direction: column;
    height: 72px;
    padding: 7px 8px;
    gap: 3px;
  }

  #company-overview-heading { height: 18px; }
  #company-overview-copy { height: 17px; }
  #company-overview-summary { height: 19px; padding: 2px 6px; }

</style>
