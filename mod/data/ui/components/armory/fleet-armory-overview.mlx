<template props="fleetSummary,templateCollectionSummary,accessStatusSummary,accessNextSummary,companyCards,returnAction,hqAction,barracksAction,armoryAction,mechLabAction,boatsAction,engineeringAction,hqClasses,barracksClasses,armoryClasses,mechLabClasses,engineeringClasses,boatsClasses">
  <div id="fleet-armory-overview-root" class="fleet-armory-overview-root">
    <marine-ops-page-nav returnAction="{returnAction}" hqAction="{hqAction}" barracksAction="{barracksAction}" armoryAction="{armoryAction}" mechLabAction="{mechLabAction}" boatsAction="{boatsAction}" engineeringAction="{engineeringAction}" engineeringClasses="{engineeringClasses}" hqClasses="{hqClasses}" barracksClasses="{barracksClasses}" armoryClasses="{armoryClasses}" mechLabClasses="{mechLabClasses}" boatsClasses="{boatsClasses}" contextLabel="BARRACKS / EQUIPMENT / COMPANY ROSTER" />

    <div id="company-overview-intro" class="panel">
      <div id="company-overview-heading-row" class="armory-heading-row">
        <img id="company-overview-service-plate" class="armory-service-plate" src="graphics/ui/console/service-plate.svg" />
        <div id="company-overview-heading" class="label heading tone-edge">FLEET ARMORY / COMPANIES</div>
      </div>
      <div id="company-overview-copy" class="label tone-muted">Choose a company to inspect its squads, marines, readiness, and finite equipment.</div>
      <div id="company-overview-summary" class="label surface-dark">{fleetSummary}</div>
      <div id="template-collection-summary" class="label surface-dark tone-edge">{templateCollectionSummary}</div>
      <div id="equipment-access-status" class="label tone-muted">{accessStatusSummary}</div>
      <div id="equipment-access-next" class="label tone-accent">{accessNextSummary}</div>
    </div>

    <armory-company-list companyCards="{companyCards}" />

  </div>
</template>

<style>
  .fleet-armory-overview-root {
    flex-direction: column;
    padding: 10px;
    gap: 8px;
    border-width: 2px;
    overflow: hidden;
  }

  .label { overflow: hidden; }
  .heading { font-family: heading; }

  #company-overview-intro {
    flex-direction: column;
    height: 144px;
    padding: 7px 8px;
    gap: 3px;
  }

  #company-overview-heading { height: 18px; }
  #company-overview-copy { height: 17px; }
  #company-overview-summary { height: 19px; padding: 2px 6px; }
  #template-collection-summary { height: 19px; padding: 2px 6px; }
  #equipment-access-status { height: 17px; }
  #equipment-access-next { height: 17px; }
  .armory-heading-row { flex-direction: row; height: 26px; gap: 10px; align-items: center; }
  .armory-service-plate { width: 46px; height: 24px; pointer-events: none; }
  #company-overview-intro { border-width: 0px; background-color: transparent; }

</style>
