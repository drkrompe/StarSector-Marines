<template props="companySummary,squadGalleryCards,organization,back,returnAction,hqAction,barracksAction,armoryAction,mechLabAction,boatsAction,hqClasses,barracksClasses,armoryClasses,mechLabClasses,boatsClasses">
  <div id="fleet-armory-root" class="fleet-armory-root">
    <marine-ops-page-nav returnAction="{returnAction}" hqAction="{hqAction}" barracksAction="{barracksAction}" armoryAction="{armoryAction}" mechLabAction="{mechLabAction}" boatsAction="{boatsAction}" hqClasses="{hqClasses}" barracksClasses="{barracksClasses}" armoryClasses="{armoryClasses}" mechLabClasses="{mechLabClasses}" boatsClasses="{boatsClasses}" contextLabel="FLAGSHIP / ARMORY / FLEET MARINE COMPANY" />

    <div id="squad-breadcrumb" class="panel">
      <button id="squad-breadcrumb-companies" onclick="{back}">Companies</button>
      <div id="squad-breadcrumb-separator-company" class="breadcrumb-separator label tone-muted">/</div>
      <div id="squad-breadcrumb-company" class="breadcrumb-current label tone-edge">Fleet Marine Company</div>
      <div id="squad-breadcrumb-separator-squads" class="breadcrumb-separator label tone-muted">/</div>
      <div id="squad-breadcrumb-current" class="breadcrumb-current label tone-accent">Squads</div>
    </div>

    <div id="squad-overview-intro" class="panel">
      <div id="squad-overview-heading" class="label heading tone-edge">PRIMARY FORMATION</div>
      <div id="squad-overview-summary" class="label surface-dark">{companySummary}</div>
      <div id="squad-overview-copy" class="label tone-muted">{organization.galleryCopy}</div>
    </div>

    <div id="organization-toolbar" class="organization-toolbar panel">
      <button id="begin-squad-organization" class="{organization.startClasses}" disabled="{organization.active}" onclick="{organization.startAction}">Organize squads</button>
      <button id="cancel-squad-organization" class="{organization.cancelClasses}" disabled="{organization.inactive}" onclick="{organization.cancelAction}">Cancel organization</button>
      <div id="organization-toolbar-copy" class="{organization.toolbarCopyClasses}">{organization.toolbarCopy}</div>
    </div>

    <div id="squad-organization-panel" class="{organization.panelClasses}">
      <div id="organization-heading" class="organization-heading">
        <div id="organization-selected-count" class="organization-selected-count label heading tone-accent">{organization.selectedCount}</div>
        <div id="organization-target-heading" class="organization-target-heading label tone-edge">HOME OFFICER</div>
      </div>
      <div id="organization-target-list" class="organization-target-list">
        <button each="target in organization.targetRows" key="{target.id}" id="{target.id}" class="{target.classes}" style="{target.style}" disabled="{organization.inactive}" onclick="{target.select}">
          <div id="{target.identityId}" class="organization-target-identity">
            <img id="{target.portraitId}" class="{target.portraitClasses}" src="{target.portrait}" />
            <div id="{target.fallbackId}" class="{target.fallbackClasses}">OP</div>
            <div id="{target.dossierId}" class="organization-target-dossier">
              <div id="{target.rankRowId}" class="organization-target-rank-row">
                <canvas id="{target.rankId}" class="{target.rankClasses}" width="24" height="24" />
                <div id="{target.rankLabelId}" class="organization-target-rank-label label tone-muted">{target.rankLabel}</div>
              </div>
              <div id="{target.nameId}" class="organization-target-name label heading tone-edge">{target.name}</div>
              <div id="{target.stateId}" class="{target.stateClasses}">{target.state}</div>
            </div>
          </div>
          <canvas id="{target.capacityId}" class="{target.capacityClasses}" width="216" height="34" />
          <div id="{target.fallbackCopyId}" class="{target.fallbackCopyClasses}">{target.fallbackCopy}</div>
          <div id="{target.detailId}" class="organization-target-detail label tone-muted">{target.detail}</div>
        </button>
      </div>
      <div id="organization-commit-row" class="organization-commit-row">
        <div id="organization-summary" class="{organization.summaryClasses}">{organization.summary}</div>
        <button id="apply-squad-organization" class="organization-apply" disabled="{organization.applyDisabled}" onclick="{organization.applyAction}">{organization.applyLabel}</button>
      </div>
    </div>

    <armory-squad-list squadGalleryCards="{squadGalleryCards}" />

  </div>
</template>

<style>
  .fleet-armory-root {
    flex-direction: column;
    padding: 10px;
    gap: 8px;
    border-width: 2px;
    overflow: hidden;
  }

  .label { overflow: hidden; }
  .heading { font-family: heading; }

  #squad-breadcrumb { flex-direction: row; height: 22px; padding: 3px 4px; gap: 5px; }
  #squad-breadcrumb button { padding: 2px 7px; border-width: 1px; font-family: body; }
  .breadcrumb-separator { width: 10px; text-align: center; }
  .breadcrumb-current { padding: 3px 4px; }

  #squad-overview-intro {
    flex-direction: column;
    height: 52px;
    padding: 5px 8px;
    gap: 2px;
  }

  #squad-overview-heading { height: 14px; }
  #squad-overview-summary { height: 15px; padding: 1px 6px; }
  #squad-overview-copy { height: 17px; }

  .organization-toolbar { flex-direction: row; height: 28px; padding: 4px; gap: 8px; border-width: 1px; overflow: hidden; }
  .organization-start, .organization-cancel { width: 168px; height: 18px; padding: 3px 7px; border-width: 1px; font-family: body; text-align: center; }
  .organization-toolbar-copy { width: 0px; flex-grow: 1; padding: 2px 3px; white-space: normal; }
  .organization-panel { flex-direction: column; height: 180px; padding: 6px; gap: 4px; border-width: 1px; overflow: hidden; }
  .organization-heading { flex-direction: row; height: 16px; gap: 8px; }
  .organization-selected-count { width: 0px; flex-grow: 1; height: 16px; }
  .organization-target-heading { width: 130px; height: 16px; text-align: right; }
  .organization-target-list { display: grid; height: 124px; gap: 6px; padding: 1px; overflow: scroll; }
  .organization-target { flex-direction: column; width: 216px; height: 104px; padding: 5px; gap: 2px; border-width: 2px; font-family: body; text-align: left; overflow: hidden; }
  .organization-target-identity { flex-direction: row; height: 56px; gap: 6px; }
  .organization-target-portrait { width: 56px; height: 56px; border-width: 1px; border-color: #51758b; background-color: #0c1620; }
  .organization-target-fallback { width: 54px; height: 54px; padding: 1px; border-width: 1px; border-color: #51758b; background-color: #0c1620; font-family: title; text-align: center; }
  .organization-target-dossier { flex-direction: column; width: 0px; flex-grow: 1; height: 56px; }
  .organization-target-rank-row { flex-direction: row; height: 16px; gap: 4px; }
  .organization-target-rank { width: 16px; height: 16px; }
  .organization-target-rank-label { width: 0px; flex-grow: 1; height: 16px; padding: 3px 0px; font-family: compact; }
  .organization-target-name { height: 24px; white-space: normal; }
  .organization-target-state { height: 16px; }
  .organization-target-capacity { width: 216px; height: 24px; }
  .organization-fallback-copy { height: 24px; white-space: normal; }
  .organization-target-detail { height: 16px; }
  .organization-commit-row { flex-direction: row; height: 30px; gap: 8px; }
  .organization-summary { width: 0px; flex-grow: 1; height: 28px; padding: 1px 2px; white-space: normal; }
  .organization-apply { width: 150px; height: 20px; padding: 4px 7px; border-width: 1px; font-family: body; text-align: center; }
  .hidden { width: 0px; height: 0px; flex-grow: 0; padding: 0px; gap: 0px; border-width: 0px; overflow: hidden; opacity: 0; }

</style>
