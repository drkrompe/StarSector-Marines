<template props="fireTeamOverviews,targetSummary,candidateSummary,marineCards,feedbackText,feedbackClasses">
  <div id="refit-transaction" class="panel fireteam-viewer">
    <div id="viewer-context">
      <div id="viewer-heading" class="label heading tone-edge">FIRE TEAM</div>
      <div id="fireteam-tabs">
        <button each="team in fireTeamOverviews" key="{team.id}" id="{team.id}" class="{team.classes}" onclick="{team.select}">{team.name}</button>
      </div>
      <div id="target-summary" class="label surface-dark tone-edge">{targetSummary}</div>
      <div id="candidate-summary" class="label surface-dark tone-accent">{candidateSummary}</div>
    </div>

    <div id="marine-card-grid" class="marine-card-grid">
      <div each="marine in marineCards" key="{marine.id}" id="{marine.id}" class="{marine.classes}">
        <div id="{marine.contentId}" class="marine-card-content">
          <div id="{marine.headerId}" class="marine-header">
            <div id="{marine.nameId}" class="marine-name label tone-edge">{marine.name}</div>
            <div id="{marine.badgesId}" class="marine-badges">
              <div id="{marine.classBadgeId}" class="marine-badge class-badge label tone-edge">{marine.unitClass}</div>
              <div id="{marine.weaponBadgeId}" class="marine-badge weapon-badge label tone-edge">{marine.weaponBadge}</div>
              <div id="{marine.armorBadgeId}" class="marine-badge armor-badge label tone-accent">{marine.armorBadge}</div>
            </div>
          </div>
          <div id="{marine.heroId}" class="marine-hero">
            <div id="{marine.identityId}" class="marine-identity">
              <div id="{marine.roleId}" class="marine-role label tone-muted">{marine.role}</div>
              <div id="{marine.statusId}" class="{marine.statusClasses}">{marine.status}</div>
              <div id="{marine.serviceId}" class="marine-service label">{marine.service}</div>
              <div id="{marine.personnelId}" class="marine-personnel label tone-muted">{marine.personnel}</div>
            </div>
            <canvas id="{marine.canvasId}" class="marine-canvas" width="320" height="240" />
          </div>

          <div id="{marine.equipmentId}" class="marine-equipment-columns">
            <div id="{marine.weaponColumnId}" class="marine-equipment-column">
              <div id="{marine.primaryId}" class="marine-equipment-title equipment-note-target label surface-dark tone-edge">{marine.primary}</div>
              <div id="{marine.weaponDetailId}" class="marine-equipment-detail">
                <div id="{marine.weaponStatsId}" class="marine-stat-group weapon-stat-group">
                  <div each="stat in marine.weaponStats" key="{stat.id}" id="{stat.id}" class="marine-stat-row">
                    <div id="{stat.labelId}" class="marine-stat-label label tone-muted">{stat.label}</div>
                    <div id="{stat.trackId}" class="marine-stat-track">
                      <div id="{stat.fillId}" class="marine-stat-fill weapon-stat-fill" style="{stat.fillStyle}" />
                    </div>
                    <div id="{stat.valueId}" class="marine-stat-value label tone-edge">{stat.value}</div>
                  </div>
                </div>
              </div>
              <div id="{marine.weaponDeltaId}" class="{marine.deltaClasses}">{marine.weaponDelta}</div>
              <div id="{marine.specialId}" class="marine-equipment-title equipment-note-target label surface-dark tone-accent">{marine.special}</div>
            </div>
            <div id="{marine.armorColumnId}" class="marine-equipment-column">
              <div id="{marine.armorId}" class="marine-equipment-title equipment-note-target label surface-dark">{marine.armor}</div>
              <div id="{marine.armorDetailId}" class="marine-equipment-detail">
                <div id="{marine.armorStatsId}" class="marine-stat-group armor-stat-group">
                  <div each="stat in marine.armorStats" key="{stat.id}" id="{stat.id}" class="marine-stat-row">
                    <div id="{stat.labelId}" class="marine-stat-label label tone-muted">{stat.label}</div>
                    <div id="{stat.trackId}" class="marine-stat-track">
                      <div id="{stat.fillId}" class="marine-stat-fill armor-stat-fill" style="{stat.fillStyle}" />
                    </div>
                    <div id="{stat.valueId}" class="marine-stat-value label tone-edge">{stat.value}</div>
                  </div>
                </div>
              </div>
              <div id="{marine.armorDeltaId}" class="{marine.deltaClasses}">{marine.armorDelta}</div>
              <div id="{marine.systemId}" class="{marine.systemClasses}">{marine.system}</div>
              <div id="{marine.careerId}" class="marine-career label surface-dark tone-muted">{marine.career}</div>
            </div>
          </div>
        </div>

        <div id="{marine.primaryDescriptionId}" class="marine-equipment-tooltip label tooltip-hidden">{marine.primary}  //  {marine.primaryDescription}</div>
        <div id="{marine.armorDescriptionId}" class="marine-equipment-tooltip armor-equipment-tooltip label tooltip-hidden">{marine.armor}  //  {marine.armorDescription}</div>
        <div id="{marine.specialDescriptionId}" class="marine-equipment-tooltip special-equipment-tooltip label tooltip-hidden">{marine.special}  //  {marine.specialDescription}</div>
        <div id="{marine.systemDescriptionId}" class="marine-equipment-tooltip system-equipment-tooltip label tooltip-hidden">{marine.system}  //  {marine.systemDescription}</div>
      </div>
    </div>

    <div id="transaction-feedback" class="{feedbackClasses}">{feedbackText}</div>
  </div>
</template>

<style>
  .fireteam-viewer { flex-direction: column; width: 0px; height: 100%; flex-grow: 1; padding: 8px; gap: 6px; overflow: hidden; }
  .label { overflow: hidden; }
  .heading { font-family: heading; }
  #viewer-heading { width: 90px; padding: 5px 1px; }

  #viewer-context { flex-direction: row; height: 30px; gap: 6px; }
  #fireteam-tabs { flex-direction: row; width: 296px; height: 28px; gap: 4px; }
  .fire-team-tab { width: 80px; height: 28px; padding: 4px 7px; border-width: 1px; font-family: body; text-align: center; }
  .fire-team-tab.selected { background-color: #345a7c; border-color: #53c6e8; color: #d5deea; }
  #target-summary { width: 240px; padding: 5px 7px; }
  #candidate-summary { width: 0px; flex-grow: 1; padding: 5px 7px; }

  .marine-card-grid {
    display: grid;
    height: 0px;
    flex-grow: 1;
    gap: 8px;
    padding: 1px;
    overflow: scroll;
  }

  .marine-viewer-card {
    width: 620px;
    height: 400px;
    border-width: 1px;
    overflow: hidden;
    background-color: #0e1621;
    border-color: #405a78;
  }

  .marine-card-content { flex-direction: column; width: 100%; height: 100%; padding: 8px; gap: 3px; overflow: hidden; }

  .marine-viewer-card.status-ready { border-color: #4ccf7a; }
  .marine-viewer-card.status-wia { border-color: #dfb84d; }
  .marine-viewer-card.status-missing, .marine-viewer-card.status-killed { border-color: #e06b64; }
  .marine-viewer-card.status-vacant { border-color: #607188; opacity: 0.55; }
  .marine-header { flex-direction: row; height: 24px; gap: 5px; }
  .marine-name { width: 0px; height: 24px; flex-grow: 1; padding: 3px 1px; font-family: body; }
  .marine-badges { flex-direction: row; width: 158px; height: 24px; gap: 3px; }
  .marine-badge { height: 22px; padding: 3px 5px; border-width: 1px; text-align: center; }
  .class-badge { width: 52px; background-color: #172b3b; border-color: #53c6e8; }
  .weapon-badge { width: 32px; background-color: #102633; border-color: #53c6e8; }
  .armor-badge { width: 32px; background-color: #2b2718; border-color: #dfb84d; }
  .marine-hero { flex-direction: row; height: 100px; gap: 7px; overflow: hidden; }
  .marine-identity { flex-direction: column; width: 0px; height: 100px; flex-grow: 1; gap: 2px; }
  .marine-role { height: 18px; }
  .marine-status { height: 18px; }
  .marine-service { height: 18px; }
  .marine-personnel { height: 40px; white-space: normal; }
  .marine-canvas { width: 100px; height: 100px; border-width: 1px; overflow: hidden; }

  .marine-equipment-columns { flex-direction: row; height: 0px; flex-grow: 1; gap: 7px; overflow: hidden; }
  .marine-equipment-column { flex-direction: column; width: 0px; height: 100%; flex-grow: 1; gap: 3px; overflow: hidden; }
  .marine-equipment-title { height: 22px; padding: 3px 5px; border-width: 1px; }
  .equipment-note-target:hover { background-color: #173044; border-color: #6ed7ff; color: #e8f5ff; }
  .marine-equipment-detail { flex-direction: row; height: 62px; overflow: hidden; }
  .marine-stat-group { flex-direction: column; gap: 2px; }
  .weapon-stat-group, .armor-stat-group { width: 100%; height: 58px; }
  .marine-stat-row { flex-direction: row; height: 13px; gap: 4px; }
  .marine-stat-label { width: 44px; }
  .marine-stat-track {
    flex-direction: row;
    width: 0px;
    height: 9px;
    flex-grow: 1;
    border-width: 1px;
    overflow: hidden;
    background-color: #101a25;
    border-color: #405a78;
  }
  .marine-stat-fill { height: 100%; }
  .weapon-stat-fill { background-color: #53c6e8; }
  .armor-stat-fill { background-color: #dfb84d; }
  .marine-stat-value { width: 34px; text-align: right; }
  .marine-delta { height: 18px; }
  .picker-closed-line { height: 0px; opacity: 0; }
  .marine-career { height: 22px; padding: 3px 5px; border-width: 1px; }

  .marine-equipment-tooltip {
    width: 360px;
    height: 142px;
    padding: 12px;
    border-width: 2px;
    overflow: hidden;
    white-space: normal;
    background-color: #09131d;
    border-color: #53c6e8;
    color: #d5deea;
  }
  .armor-equipment-tooltip { border-color: #dfb84d; }
  .special-equipment-tooltip { border-color: #71d6c1; }
  .system-equipment-tooltip { border-color: #c79ce8; }
  .marine-equipment-tooltip.tooltip-hidden {
    width: 0px;
    height: 0px;
    padding: 0px;
    border-width: 0px;
    opacity: 0;
  }

  .feedback { height: 22px; padding: 3px 6px; overflow: hidden; }
</style>
