<template props="targetSummary,candidateSummary,selectedSquadReadiness,reinforceLabel,reinforceDisabled,reinforceSquad,marineCards,templateTiles,pickerClasses,pickerToggleLabel,togglePicker,transactionSummary,transactionClasses,applyDisabled,applyClasses,applyLabel,apply,feedbackText,feedbackClasses">
  <div id="refit-transaction" class="panel fireteam-viewer">
    <div id="viewer-heading" class="label heading tone-edge">FIRE TEAM</div>
    <div id="squad-readiness-row">
      <div id="selected-squad-readiness" class="label surface-dark tone-edge">{selectedSquadReadiness}</div>
      <button id="reinforce-selected-squad" disabled="{reinforceDisabled}" onclick="{reinforceSquad}">{reinforceLabel}</button>
    </div>
    <div id="viewer-context">
      <div id="target-summary" class="label surface-dark tone-edge">{targetSummary}</div>
      <div id="candidate-summary" class="label surface-dark tone-accent">{candidateSummary}</div>
    </div>

    <div id="marine-card-grid" class="marine-card-grid">
      <div each="marine in marineCards" key="{marine.id}" id="{marine.id}" class="{marine.classes}">
        <div id="{marine.nameId}" class="marine-name label tone-edge">{marine.name}</div>
        <div id="{marine.roleId}" class="marine-role label tone-muted">{marine.role}</div>
        <div id="{marine.statusId}" class="{marine.statusClasses}">{marine.status}</div>
        <div id="{marine.canvasRowId}" class="marine-canvas-row">
          <div id="{marine.canvasLeadId}" class="marine-canvas-spacer" />
          <canvas id="{marine.canvasId}" class="marine-canvas" width="320" height="240" />
          <div id="{marine.canvasTrailId}" class="marine-canvas-spacer" />
        </div>
        <div id="{marine.serviceId}" class="marine-service label">{marine.service}</div>
        <div id="{marine.primaryId}" class="marine-primary label surface-dark tone-edge">{marine.primary}</div>
        <div id="{marine.weaponStatsId}" class="marine-stat-group weapon-stat-group">
          <div each="stat in marine.weaponStats" key="{stat.id}" id="{stat.id}" class="marine-stat-row">
            <div id="{stat.labelId}" class="marine-stat-label label tone-muted">{stat.label}</div>
            <div id="{stat.trackId}" class="marine-stat-track">
              <div id="{stat.fillId}" class="marine-stat-fill weapon-stat-fill" style="{stat.fillStyle}" />
            </div>
            <div id="{stat.valueId}" class="marine-stat-value label tone-edge">{stat.value}</div>
          </div>
        </div>
        <div id="{marine.weaponDeltaId}" class="{marine.deltaClasses}">{marine.weaponDelta}</div>
        <div id="{marine.armorId}" class="marine-armor label surface-dark">{marine.armor}</div>
        <div id="{marine.armorStatsId}" class="marine-stat-group armor-stat-group">
          <div each="stat in marine.armorStats" key="{stat.id}" id="{stat.id}" class="marine-stat-row">
            <div id="{stat.labelId}" class="marine-stat-label label tone-muted">{stat.label}</div>
            <div id="{stat.trackId}" class="marine-stat-track">
              <div id="{stat.fillId}" class="marine-stat-fill armor-stat-fill" style="{stat.fillStyle}" />
            </div>
            <div id="{stat.valueId}" class="marine-stat-value label tone-edge">{stat.value}</div>
          </div>
        </div>
        <div id="{marine.armorDeltaId}" class="{marine.deltaClasses}">{marine.armorDelta}</div>
        <div id="{marine.specialId}" class="marine-special label tone-accent">{marine.special}</div>
        <div id="{marine.careerId}" class="marine-career label tone-muted">{marine.career}</div>
      </div>
    </div>

    <armory-template-library templateTiles="{templateTiles}" pickerClasses="{pickerClasses}" />

    <div id="equip-row">
      <div id="transaction-result" class="{transactionClasses}">{transactionSummary}</div>
      <button id="toggle-loadout-picker" class="picker-toggle" onclick="{togglePicker}">{pickerToggleLabel}</button>
      <button id="apply-template" class="{applyClasses}" disabled="{applyDisabled}" onclick="{apply}">{applyLabel}</button>
    </div>
    <div id="transaction-feedback" class="{feedbackClasses}">{feedbackText}</div>
  </div>
</template>

<style>
  .fireteam-viewer { flex-direction: column; flex-grow: 1; padding: 8px; gap: 6px; overflow: hidden; }
  .label { overflow: hidden; }
  .heading { font-family: heading; }
  #viewer-heading { height: 20px; }

  #squad-readiness-row { flex-direction: row; height: 30px; gap: 6px; }
  #selected-squad-readiness { width: 0px; flex-grow: 1; padding: 5px 7px; }
  #reinforce-selected-squad {
    padding: 4px 8px;
    border-width: 1px;
    overflow: hidden;
    font-family: body;
    text-align: center;
  }

  #viewer-context { flex-direction: row; height: 26px; gap: 6px; }
  #target-summary, #candidate-summary { width: 0px; flex-grow: 1; padding: 4px 7px; }

  .marine-card-grid {
    display: grid;
    height: 0px;
    flex-grow: 1;
    gap: 8px;
    padding: 1px;
    overflow: scroll;
  }

  .marine-viewer-card {
    flex-direction: column;
    width: 330px;
    height: 378px;
    padding: 7px;
    gap: 3px;
    border-width: 1px;
    overflow: hidden;
    background-color: #0e1621;
    border-color: #405a78;
  }

  .marine-viewer-card.vacant { opacity: 0.55; }
  .marine-viewer-card.viewer-only { height: 552px; }
  .marine-viewer-card.previewing { height: 390px; gap: 2px; }
  .marine-name { height: 22px; font-family: body; }
  .marine-role { height: 18px; }
  .marine-status { height: 18px; }
  .marine-canvas-row {
    flex-direction: row;
    width: 0px;
    height: 140px;
    flex-grow: 1;
    overflow: hidden;
  }
  .marine-canvas { width: 0px; height: 100%; flex-grow: 1; border-width: 1px; overflow: hidden; }
  .marine-canvas-spacer { width: 0px; height: 0px; }
  .marine-viewer-card.previewing .marine-canvas-row { height: 72px; }
  .marine-viewer-card.previewing .marine-canvas { width: 96px; flex-grow: 0; }
  .marine-viewer-card.previewing .marine-canvas-spacer { flex-grow: 1; }
  .marine-viewer-card.previewing .marine-career { height: 0px; opacity: 0; }
  .marine-service { height: 18px; }
  .marine-primary, .marine-armor { height: 22px; padding: 3px 5px; border-width: 1px; }
  .marine-stat-group { flex-direction: column; gap: 2px; }
  .weapon-stat-group { height: 58px; }
  .armor-stat-group { height: 43px; }
  .marine-stat-row { flex-direction: row; height: 13px; gap: 4px; }
  .marine-stat-label { width: 45px; }
  .marine-stat-track {
    flex-direction: row;
    width: 0px;
    height: 9px;
    flex-grow: 1;
    border-width: 1px;
    overflow: hidden;
    background-color: #101a25;
    border-color: #405a78;
  }
  .marine-stat-fill { height: 100%; }
  .weapon-stat-fill { background-color: #53c6e8; }
  .armor-stat-fill { background-color: #dfb84d; }
  .marine-stat-value { width: 42px; text-align: right; }
  .marine-delta { height: 18px; }
  .picker-closed-line { height: 0px; opacity: 0; }
  .marine-special { height: 18px; }
  .marine-career { height: 18px; }

  #equip-row { flex-direction: row; height: 34px; gap: 7px; }
  .transaction-result { width: 0px; flex-grow: 1; padding: 5px 7px; border-width: 1px; overflow: hidden; }
  .picker-toggle { width: 150px; padding: 5px 9px; border-width: 1px; overflow: hidden; font-family: body; text-align: center; }
  .apply-button { width: 280px; padding: 5px 9px; border-width: 1px; overflow: hidden; font-family: body; text-align: center; }
  .picker-confirm-closed { width: 0px; padding: 0px; border-width: 0px; opacity: 0; }
  .feedback { height: 22px; padding: 3px 6px; overflow: hidden; }
</style>
