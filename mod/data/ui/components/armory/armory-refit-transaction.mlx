<template props="targetSummary,candidateSummary,billetMannequins,gearRows,transactionSummary,transactionClasses,applyDisabled,apply,feedbackText,feedbackClasses">
  <div id="refit-transaction" class="panel refit-transaction">
    <div id="transaction-heading" class="label heading tone-edge">TEMPLATE FIRE-TEAM BREAKDOWN</div>
    <div id="candidate-summary" class="label surface-dark tone-accent">{candidateSummary}</div>

    <div id="mannequin-grid" class="mannequin-grid">
      <div each="billet in billetMannequins" key="{billet.id}" id="{billet.id}" class="billet-mannequin surface-dark">
        <div id="{billet.roleId}" class="mannequin-role label heading tone-edge">{billet.role}</div>
        <canvas id="{billet.canvasId}" class="mannequin-canvas" width="280" height="360" />
        <div id="{billet.primaryId}" class="mannequin-primary label">{billet.primary}</div>
        <div id="{billet.armorId}" class="mannequin-armor label tone-muted">{billet.armor}</div>
        <div id="{billet.specialId}" class="mannequin-special label tone-accent">{billet.special}</div>
      </div>
    </div>

    <div id="issue-heading" class="label heading tone-muted">FREE STOCK  ·  RETURNS  ·  REQUIRED ISSUE</div>
    <div id="gear-list" class="detail-list">
      <div each="row in gearRows" key="{row.id}" id="{row.id}" class="{row.classes}">{row.label}</div>
    </div>

    <div id="transaction-result" class="{transactionClasses}">{transactionSummary}</div>
    <div id="apply-row">
      <button id="apply-template" class="apply-button" disabled="{applyDisabled}" onclick="{apply}">Issue Template to Fire Team</button>
      <div id="transaction-feedback" class="{feedbackClasses}">{feedbackText}</div>
    </div>
  </div>
</template>

<style>
  .refit-transaction { flex-direction: column; flex-grow: 1; padding: 8px; gap: 5px; overflow: hidden; }
  .label { overflow: hidden; }
  .heading { font-family: heading; }
  #transaction-heading { height: 20px; }
  #candidate-summary { height: 20px; padding: 3px 6px; }

  .mannequin-grid {
    display: grid;
    height: 360px;
    gap: 6px;
    padding: 1px;
    overflow: scroll;
  }

  .billet-mannequin {
    flex-direction: column;
    width: 230px;
    height: 334px;
    padding: 6px;
    gap: 3px;
    border-width: 1px;
    overflow: hidden;
  }

  .mannequin-role { height: 18px; }
  .mannequin-canvas { width: 0px; height: 0px; flex-grow: 1; border-width: 1px; overflow: hidden; }
  .mannequin-primary, .mannequin-armor, .mannequin-special { height: 17px; }

  .detail-list { flex-direction: column; gap: 4px; padding: 1px; overflow: scroll; }
  #issue-heading { height: 18px; }
  #gear-list { height: 100px; }
  .detail-row { height: 22px; padding: 3px 6px; border-width: 1px; overflow: hidden; background-color: #0e1621; border-color: #405a78; }
  .transaction-result { height: 22px; padding: 4px 6px; border-width: 1px; overflow: hidden; }
  #apply-row { flex-direction: row; height: 34px; gap: 6px; }
  .apply-button { width: 220px; padding: 4px 8px; border-width: 1px; overflow: hidden; font-family: body; text-align: center; }
  .feedback { width: 0px; flex-grow: 1; padding: 4px 6px; overflow: hidden; }
</style>
