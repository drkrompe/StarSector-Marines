<template props="commandPoints,commandPointFillStyle,supplies,suppliesIcon,powerCards,targetingClasses,targetingLabel,targetingHint,pickerClasses,pickerChips">
  <div id="battle-power-overlay" class="battle-power-overlay hud-glass">
    <div id="battle-power-targeting" class="{targetingClasses}">
      <div id="battle-power-targeting-label" class="label heading targeting-label">{targetingLabel}</div>
      <div id="battle-power-targeting-hint" class="label targeting-hint">{targetingHint}</div>
    </div>
    <div id="battle-power-picker" class="{pickerClasses}">
      <button each="chip in pickerChips" key="{chip.id}" id="{chip.id}" class="{chip.classes}" disabled="{chip.disabled}" onclick="{chip.action}">
        <div id="{chip.nameId}" class="label pick-name">{chip.name}</div>
        <div id="{chip.callsignId}" class="label pick-callsign">{chip.callsign}</div>
        <div id="{chip.weightId}" class="label pick-weight">{chip.weight}</div>
        <div id="{chip.stateId}" class="label pick-state">{chip.state}</div>
      </button>
    </div>
    <div id="battle-power-deck" class="power-deck">
      <div id="battle-power-resources" class="power-resources">
        <div id="battle-power-resource-title" class="label heading resource-title">{i18n.battlePowerCommand}</div>
        <div id="battle-power-cp" class="label heading resource-cp">{commandPoints}</div>
        <div id="battle-power-cp-track" class="resource-track">
          <div id="battle-power-cp-fill" class="resource-fill" style="{commandPointFillStyle}" />
        </div>
        <div id="battle-power-supplies" class="resource-supplies">
          <img id="battle-power-supplies-icon" class="resource-supplies-icon" src="{suppliesIcon}" />
          <div id="battle-power-supplies-label" class="label resource-supplies-label">{supplies}</div>
        </div>
      </div>
      <div id="battle-power-cards" class="power-cards">
        <button each="power in powerCards" key="{power.id}" id="{power.id}" class="{power.classes}" style="{power.style}" disabled="{power.disabled}" onclick="{power.action}">
          <div id="{power.headerId}" class="power-heading">
            <img id="{power.iconId}" class="power-symbol" src="{power.icon}" />
            <div id="{power.nameId}" class="label power-name">{power.name}</div>
          </div>
          <div id="{power.metaId}" class="power-meta">
            <div id="{power.costId}" class="label power-cost">{power.cost}</div>
            <div id="{power.statusId}" class="label heading power-status">{power.status}</div>
          </div>
        </button>
      </div>
    </div>
  </div>
</template>

<style>
  .battle-power-overlay {
    width: 100%;
    height: 100%;
    flex-direction: column;
    background-color: transparent;
    overflow: hidden;
  }

  .label { overflow: hidden; white-space: nowrap; }
  .heading { font-family: heading; }

  .power-targeting {
    width: 100%;
    height: 14px;
    flex-direction: row;
    padding: 4px 7px;
    border-width: 1px; border-color: transparent;
    background-color: transparent;
    background-image: linear-gradient(to right, #ffd46433 0%, #ffd46414 60%, #ffd46400 100%);
  }

  .power-targeting-hidden {
    display: none;
  }

  .power-picker {
    width: 100%;
    height: 53px;
    flex-direction: row;
    padding: 3px 7px;
    gap: 4px;
    border-width: 1px; border-color: transparent;
    background-color: transparent;
    overflow: hidden;
  }

  .power-picker-hidden {
    display: none;
  }

  .pick-chip {
    width: 116px;
    height: 45px;
    flex-direction: column;
    padding: 3px 5px;
    gap: 1px;
    border-width: 1px;
    border-color: #56675c;
    background-color: #303a32f2;
    text-align: left;
    overflow: hidden;
  }

  .pick-chip:hover { background-color: #46524a; border-color: #ffd464; }
  .pick-chip:active { background-color: #222b24; }
  .pick-selected { background-color: #3a3018; border-color: #ffd464; }
  .pick-refused { background-color: #1c251fdd; border-color: #445447; }
  .pick-refused:hover { background-color: #1c251fdd; border-color: #445447; }
  .pick-name { width: 100%; height: 10px; font-family: compact; color: #c1cbc3; }
  .pick-callsign { width: 100%; height: 10px; font-family: compact; color: #a0ada8; }
  .pick-weight { width: 100%; height: 10px; font-family: compact; color: #8c9a90; }
  .pick-state { width: 100%; height: 12px; font-family: compact; color: #78d494; }
  .pick-selected .pick-name { color: #ffd464; }
  .pick-selected .pick-state { color: #ffd464; }
  .pick-refused .pick-name { color: #829083; }
  .pick-refused .pick-callsign { color: #6d7a70; }
  .pick-refused .pick-weight { color: #6d7a70; }
  .pick-refused .pick-state { color: #d48a6a; }

  .targeting-label { height: 14px; flex-grow: 1; color: #ffd464; }
  .targeting-hint { width: 190px; height: 14px; text-align: right; color: #bcae82; }

  .power-deck {
    width: 100%;
    height: 52px;
    flex-direction: row;
    padding: 5px;
    gap: 5px;
    border-width: 1px; border-color: transparent;
    background-color: transparent;
  }

  .power-resources {
    width: 88px;
    height: 48px;
    flex-direction: column;
    padding: 2px 4px;
    gap: 2px;
    overflow: hidden;
  }

  .resource-title { width: 100%; height: 12px; color: #a0ada8; }
  .resource-cp { width: 100%; height: 12px; color: #c5d6cb; }
  .resource-track { width: 100%; height: 3px; background-color: #0000008c; }
  .resource-fill { height: 100%; background-color: #a7ccc4; }
  .resource-supplies { width: 100%; height: 14px; flex-direction: row; gap: 4px; color: #a0ada8; }
  .resource-supplies-icon { width: 14px; height: 14px; }
  .resource-supplies-label { width: 0px; height: 14px; flex-grow: 1; color: #a0ada8; }

  .power-cards {
    height: 52px;
    flex-grow: 1;
    flex-direction: row;
    gap: 5px;
    overflow: hidden;
  }

  .power-card {
    width: 130px;
    height: 38px;
    flex-direction: column;
    padding: 6px 7px;
    gap: 5px;
    border-width: 1px;
    border-color: #56675c;
    background-color: #303a32f2;
    color: #c1cbc3;
    text-align: left;
    overflow: hidden;
  }

  .power-card:hover { background-color: #46524a; border-color: #a7ccc4; }
  .power-card:active { background-color: #222b24; }
  .power-ready { border-color: #727b79; }
  .power-disabled { background-color: #1c251fdd; border-color: #445447; }
  .power-armed { background-color: #3a3018; border-color: #ffd464; color: #ffd464; }
  .power-heading { flex-direction: row; align-items: center; width: 100%; height: 19px; gap: 5px; }
  .power-symbol { width: 20px; height: 19px; pointer-events: none; }
  .power-name { width: 0px; flex-grow: 1; height: auto; white-space: normal; font-family: compact; color: #c1cbc3; }
  .power-meta { width: 100%; height: 14px; flex-direction: row; }
  .power-cost { height: 14px; flex-grow: 1; color: #b7c8b9; }
  .power-status { width: 46px; height: 14px; text-align: right; color: #78d494; }
  .power-disabled .power-cost { color: #728074; }
  .power-disabled .power-name { color: #829083; }
  .power-disabled .power-status { color: #929e95; }
  .power-armed .power-name { color: #ffd464; }
  .power-armed .power-cost { color: #bcae82; }
  .power-armed .power-status { color: #ffd464; }
</style>
