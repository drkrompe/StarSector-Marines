<template props="exitRowClasses,actionClasses,actionLabel,action,retryClasses,retryLabel,retryDisabled,retryAction,confirmClasses,confirmPrompt,confirmDetail,restartClasses,restartLabel,restartDisabled,restartAction,cancelLabel,cancelAction,confirmLabel,confirmAction">
