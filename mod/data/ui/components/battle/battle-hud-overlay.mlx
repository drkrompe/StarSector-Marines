<template props="timeLabel,pauseLabel,normalLabel,doubleLabel,quadLabel,pauseClasses,normalClasses,doubleClasses,quadClasses,pauseStyle,normalStyle,doubleStyle,quadStyle,pauseAction,normalAction,doubleAction,quadAction,objectivePanelClasses,objectiveScore,objectiveTally,objectiveChips,objectiveFocusClasses,objectiveFocus,objectiveProgressStyle,commandPanelClasses,commandPhase,commandForce,conquestLanes">
  <div id="battle-hud-overlay" class="battle-hud-overlay">
    <div id="battle-conquest-command" class="{commandPanelClasses}">
      <div id="battle-conquest-command-header" class="conquest-command-header">
        <div id="battle-conquest-command-title" class="label heading conquest-command-title">COMMANDER</div>
        <div id="battle-conquest-command-phase" class="label heading conquest-command-phase">{commandPhase}</div>
      </div>
      <div id="battle-conquest-command-force" class="label conquest-command-force">{commandForce}</div>
      <div id="battle-conquest-lanes" class="conquest-lanes">
        <div each="lane in conquestLanes" key="{lane.id}" id="{lane.id}" class="{lane.classes}">
          <div id="{lane.nameId}" class="label heading conquest-lane-name">{lane.label}</div>
          <div id="{lane.forceId}" class="label conquest-lane-force">{lane.force}</div>
          <div id="{lane.intentId}" class="label heading conquest-lane-intent">{lane.intent}</div>
          <div id="{lane.statusId}" class="label conquest-lane-status">{lane.status}</div>
        </div>
      </div>
    </div>

    <div id="battle-hud-spacer" class="battle-hud-spacer" />

    <div id="battle-command-rail" class="battle-command-rail">
      <div id="battle-time-control" class="battle-time-control">
        <div id="battle-time-label" class="label heading time-label">{timeLabel}</div>
        <div id="battle-time-options" class="time-options">
          <button id="battle-time-pause" class="{pauseClasses}" style="{pauseStyle}" onclick="{pauseAction}">{pauseLabel}</button>
          <button id="battle-time-normal" class="{normalClasses}" style="{normalStyle}" onclick="{normalAction}">{normalLabel}</button>
          <button id="battle-time-double" class="{doubleClasses}" style="{doubleStyle}" onclick="{doubleAction}">{doubleLabel}</button>
          <button id="battle-time-quad" class="{quadClasses}" style="{quadStyle}" onclick="{quadAction}">{quadLabel}</button>
        </div>
      </div>

      <div id="battle-objectives" class="{objectivePanelClasses}">
        <div id="battle-objective-header" class="objective-header">
          <div id="battle-objective-title" class="label heading objective-title">CAPTURE</div>
          <div id="battle-objective-score" class="label heading objective-score">{objectiveScore}</div>
        </div>
        <div id="battle-objective-chips" class="objective-chips">
          <div each="chip in objectiveChips" key="{chip.id}" id="{chip.id}" class="{chip.classes}">{chip.label}</div>
        </div>
        <div id="battle-objective-tally" class="label objective-tally">{objectiveTally}</div>
        <div id="battle-objective-focus" class="{objectiveFocusClasses}">
          <div id="battle-objective-focus-label" class="label heading objective-focus-label">{objectiveFocus}</div>
          <div id="battle-objective-progress" class="objective-progress-track">
            <div id="battle-objective-progress-fill" class="objective-progress-fill" style="{objectiveProgressStyle}" />
          </div>
        </div>
      </div>
    </div>
  </div>
</template>

<style>
  .battle-hud-overlay {
    width: 100%;
    height: 100%;
    flex-direction: row;
    background-color: transparent;
    overflow: hidden;
  }

  .label { overflow: hidden; white-space: nowrap; }
  .heading { font-family: heading; }

  .battle-hud-spacer { flex-grow: 1; height: 1px; }

  .battle-command-rail {
    width: 360px;
    height: 100%;
    flex-direction: column;
    gap: 6px;
    background-color: transparent;
  }

  .battle-time-control {
    width: 100%;
    height: 42px;
    flex-direction: row;
    padding: 5px;
    gap: 5px;
    border-width: 1px;
    border-color: #4f6d8e;
    background-color: #0b111bd9;
  }

  .time-label {
    width: 56px;
    height: 30px;
    padding: 8px 5px;
    color: #8b9aaf;
  }

  .time-options {
    height: 30px;
    flex-direction: row;
    flex-grow: 1;
    gap: 3px;
  }

  .time-button {
    height: 30px;
    flex-grow: 1;
    padding: 7px 3px;
    border-width: 1px;
    border-color: #31485f;
    background-color: #142131e8;
    font-family: heading;
    text-align: center;
    color: #aebdce;
  }

  .time-button:hover { background-color: #243d56; border-color: #6ed7ff; }
  .time-button:active { background-color: #315070; }
  .time-selected {
    background-color: #3a3018;
    border-color: #ffd464;
    color: #ffd464;
  }

  .objective-panel {
    width: 100%;
    height: 116px;
    flex-direction: column;
    padding: 7px;
    gap: 5px;
    border-width: 1px;
    border-color: #4f6d8e;
    background-color: #0b111bd9;
    overflow: hidden;
  }

  .objective-panel-hidden {
    height: 0px;
    padding: 0px;
    gap: 0px;
    border-width: 0px;
    opacity: 0;
  }

  .objective-header { width: 100%; height: 17px; flex-direction: row; }
  .objective-title { flex-grow: 1; color: #8b9aaf; }
  .objective-score { width: 68px; text-align: right; color: #ffd464; }

  .objective-chips {
    width: 100%;
    height: 23px;
    flex-direction: row;
    gap: 4px;
    overflow: hidden;
  }

  .objective-chip {
    width: 23px;
    height: 23px;
    padding: 5px 2px;
    border-width: 1px;
    font-family: heading;
    text-align: center;
  }

  .objective-hostile { background-color: #351d22; border-color: #e98b83; color: #e98b83; }
  .objective-contested { background-color: #3a3018; border-color: #ffd464; color: #ffd464; }
  .objective-secured { background-color: #132b22; border-color: #78d494; color: #78d494; }

  .objective-tally { width: 100%; height: 15px; color: #a8b6c6; }

  .objective-focus { width: 100%; height: 27px; flex-direction: column; gap: 4px; }
  .objective-focus-hidden { height: 0px; gap: 0px; opacity: 0; overflow: hidden; }
  .objective-focus-label { width: 100%; height: 15px; color: #ffd464; }
  .objective-progress-track { width: 100%; height: 4px; background-color: #172231; }
  .objective-progress-fill { height: 100%; background-color: #ffd464; }

  .conquest-command-panel {
    width: 360px;
    height: 150px;
    flex-direction: column;
    padding: 7px;
    gap: 4px;
    border-width: 1px;
    border-color: #4f6d8e;
    background-color: #0b111bd9;
    overflow: hidden;
  }

  .conquest-command-panel-hidden {
    width: 0px;
    height: 0px;
    padding: 0px;
    gap: 0px;
    border-width: 0px;
    opacity: 0;
  }

  .conquest-command-header {
    width: 100%;
    height: 17px;
    flex-direction: row;
  }

  .conquest-command-title {
    width: 96px;
    color: #8b9aaf;
  }

  .conquest-command-phase {
    flex-grow: 1;
    text-align: right;
    color: #6ed7ff;
  }

  .conquest-command-force {
    width: 100%;
    height: 15px;
    color: #a8b6c6;
  }

  .conquest-lanes {
    width: 100%;
    height: 96px;
    flex-direction: column;
    gap: 3px;
    overflow: hidden;
  }

  .conquest-lane {
    width: 100%;
    height: 22px;
    flex-direction: row;
    gap: 4px;
    padding: 3px 4px;
    border-width: 1px;
    border-color: #31485f;
    background-color: #111b28;
    color: #aebdce;
  }

  .conquest-lane-name {
    width: 84px;
    height: 14px;
    color: #6ed7ff;
  }

  .conquest-lane-force {
    width: 62px;
    height: 14px;
    color: #c5d1df;
  }

  .conquest-lane-intent {
    width: 0px;
    height: 14px;
    flex-grow: 1;
    color: #ffd464;
  }

  .conquest-lane-status {
    width: 78px;
    height: 14px;
    text-align: right;
    color: #8b9aaf;
  }

  .conquest-lane-contact {
    border-color: #a85b54;
    background-color: #26171c;
  }
  .conquest-lane-contact .conquest-lane-status { color: #e98b83; }
  .conquest-lane-objective { border-color: #806b35; }
  .conquest-lane-objective .conquest-lane-status { color: #ffd464; }
  .conquest-lane-empty { opacity: 0.66; }
</style>
