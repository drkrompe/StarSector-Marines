<template props="missionClasses,missionSquadClasses,missionSquadStyle,missionCards,missionSquads,missionSquadSummary,missionPanelStyle,missionListStyle,missionScore,timeLabel,pauseLabel,normalLabel,doubleLabel,quadLabel,pauseClasses,normalClasses,doubleClasses,quadClasses,pauseStyle,normalStyle,doubleStyle,quadStyle,pauseAction,normalAction,doubleAction,quadAction,objectivePanelClasses,objectiveTitle,objectiveScore,objectiveTally,objectiveChips,objectiveFocusClasses,objectiveFocus,objectiveProgressStyle,objectiveLocateClasses,objectiveLocateDisabled,objectiveLocateAction,commandPanelClasses,commandPhase,commandForce,commandTitle,conquestLanes,conquestLaneClasses,conquestGroupClasses,conquestGroups">
  <div id="battle-hud-overlay" class="battle-hud-overlay" style="background-color: transparent">
    <div id="battle-conquest-command" class="{commandPanelClasses}">
      <div id="battle-conquest-command-header" class="conquest-command-header">
        <div id="battle-conquest-command-title" class="label heading conquest-command-title">{commandTitle}</div>
        <div id="battle-conquest-command-phase" class="label heading conquest-command-phase">{commandPhase}</div>
      </div>
      <div id="battle-conquest-command-force" class="label conquest-command-force">{commandForce}</div>
      <div id="battle-conquest-lanes" class="{conquestLaneClasses}">
        <div each="lane in conquestLanes" key="{lane.id}" id="{lane.id}" class="{lane.classes}">
          <div id="{lane.nameId}" class="label heading conquest-lane-name">{lane.label}</div>
          <div id="{lane.forceId}" class="label conquest-lane-force">{lane.force}</div>
          <div id="{lane.intentId}" class="label heading conquest-lane-intent">{lane.intent}</div>
          <div id="{lane.statusId}" class="label conquest-lane-status">{lane.status}</div>
        </div>
      </div>
      <div id="battle-conquest-groups" class="{conquestGroupClasses}">
        <div each="group in conquestGroups" key="{group.id}" id="{group.id}" class="{group.classes}">
          <div id="{group.identityLineId}" class="conquest-group-line">
            <div id="{group.nameId}" class="label heading conquest-group-name">{group.label}</div>
            <div id="{group.forceId}" class="label conquest-group-force">{group.force}</div>
          </div>
          <div id="{group.taskLineId}" class="conquest-group-line">
            <div id="{group.intentId}" class="label conquest-group-intent">{group.intent}</div>
            <div id="{group.targetId}" class="label conquest-group-target">{group.target}</div>
          </div>
        </div>
      </div>
    </div>

    <div id="battle-mission-squads" class="{missionSquadClasses}" style="{missionSquadStyle}">
      <div id="mission-squads-heading" class="label heading mission-heading">SQUAD ACTIVITY</div>
      <div id="mission-squads-summary" class="label mission-secondary">{missionSquadSummary}</div>
      <div id="battle-mission-squad-list" class="mission-squad-list">
        <div each="squad in missionSquads" key="{squad.id}" id="{squad.id}" class="mission-squad">
          <div id="{squad.headerId}" class="mission-squad-header">
            <div id="{squad.nameId}" class="label heading mission-squad-name">{squad.name}</div>
            <div id="{squad.statusId}" class="label mission-squad-status">{squad.status}</div>
          </div>
          <div id="{squad.taskId}" class="label mission-squad-task">{squad.task}</div>
        </div>
      </div>
    </div>

    <div id="battle-hud-spacer" class="battle-hud-spacer" />

    <div id="battle-command-rail" class="battle-command-rail">
      <div id="battle-time-control" class="battle-time-control">
        <div id="battle-time-label" class="label heading time-label">{timeLabel}</div>
        <div id="battle-time-options" class="time-options">
          <button id="battle-time-pause" class="{pauseClasses}" style="{pauseStyle}" onclick="{pauseAction}">{pauseLabel}</button>
          <button id="battle-time-normal" class="{normalClasses}" style="{normalStyle}" onclick="{normalAction}">{normalLabel}</button>
          <button id="battle-time-double" class="{doubleClasses}" style="{doubleStyle}" onclick="{doubleAction}">{doubleLabel}</button>
          <button id="battle-time-quad" class="{quadClasses}" style="{quadStyle}" onclick="{quadAction}">{quadLabel}</button>
        </div>
      </div>

      <div id="battle-mission-objectives" class="{missionClasses}" style="{missionPanelStyle}">
        <div id="mission-heading-row" class="objective-header">
          <div id="mission-heading" class="label heading objective-title">MISSION OBJECTIVES</div>
          <div id="mission-score" class="label heading objective-score">{missionScore}</div>
        </div>
        <div id="battle-mission-list" class="mission-list" style="{missionListStyle}">
          <div each="card in missionCards" key="{card.id}" id="{card.id}" class="{card.classes}">
            <div id="{card.headerId}" class="mission-card-header">
              <div id="{card.nameId}" class="label heading mission-name">{card.name}</div>
              <button id="{card.locateId}" class="objective-locate" disabled="{card.disabled}" onclick="{card.locate}">LOCATE</button>
            </div>
            <div id="{card.phaseId}" class="label heading mission-phase">{card.phase}</div>
            <div id="{card.stepsId}" class="label mission-steps">{card.steps}</div>
            <div id="{card.instructionId}" class="mission-instruction">{card.instruction}</div>
            <div id="{card.progressTextId}" class="label mission-secondary">{card.progressText}</div>
            <div id="{card.trackId}" class="objective-progress-track" style="{card.trackStyle}"><div id="{card.progressId}" class="objective-progress-fill" style="{card.progressStyle}" /></div>
            <div id="{card.blockerId}" class="mission-blocker">{card.blocker}</div>
          </div>
        </div>
      </div>

      <div id="battle-objectives" class="{objectivePanelClasses}">
        <div id="battle-objective-header" class="objective-header">
          <div id="battle-objective-title" class="label heading objective-title">{objectiveTitle}</div>
          <button id="battle-objective-locate" class="{objectiveLocateClasses}" disabled="{objectiveLocateDisabled}" onclick="{objectiveLocateAction}">LOCATE</button>
          <div id="battle-objective-score" class="label heading objective-score">{objectiveScore}</div>
        </div>
        <div id="battle-objective-chips" class="objective-chips">
          <div each="chip in objectiveChips" key="{chip.id}" id="{chip.id}" class="{chip.classes}">{chip.label}</div>
        </div>
        <div id="battle-objective-tally" class="label objective-tally">{objectiveTally}</div>
        <div id="battle-objective-focus" class="{objectiveFocusClasses}">
          <div id="battle-objective-focus-label" class="label heading objective-focus-label">{objectiveFocus}</div>
          <div id="battle-objective-progress" class="objective-progress-track">
            <div id="battle-objective-progress-fill" class="objective-progress-fill" style="{objectiveProgressStyle}" />
          </div>
        </div>
      </div>
    </div>
  </div>
</template>

<style>
  .mission-panel { width: 100%; flex-direction: column; gap: 6px; padding: 7px; border-width: 1px; border-color: #727b79; background-color: #141e19ee; }
  .mission-card .objective-progress-track { flex-direction: row; }
  .mission-list { width: 100%; flex-direction: column; gap: 6px; overflow: scroll; }
  .mission-card { width: 100%; height: 156px; flex-direction: column; gap: 4px; padding: 5px; border-width: 1px; border-color: #806b35; background-color: #15231fee; }
  .mission-card-header { width: 100%; height: 18px; flex-direction: row; gap: 4px; }
  .mission-name { width: 0px; flex-grow: 1; height: 18px; color: #e6e7da; }
  .mission-phase { width: 100%; height: 15px; color: #ffd464; }
  .mission-steps { width: 100%; height: 15px; color: #a7ccc4; }
  .mission-instruction { white-space: normal; overflow: hidden; width: 100%; height: 30px; color: #d4ddd5; }
  .mission-secondary { width: 100%; height: 15px; color: #a8b6c6; }
  .mission-blocker { white-space: normal; overflow: hidden; width: 100%; height: 30px; color: #efb283; }
  .mission-complete { border-color: #78d494; }
  .mission-complete .mission-phase { color: #78d494; }
  .mission-failed { border-color: #e98b83; }
  .mission-failed .mission-phase { color: #e98b83; }
  .mission-squads-panel { overflow: hidden; width: 360px; height: 256px; flex-direction: column; gap: 6px; padding: 7px; border-width: 1px; border-color: #727b79; background-color: #141e19ee; }
  .mission-heading { width: 100%; height: 17px; color: #a0ada8; }
  .mission-squad-list { width: 100%; height: 208px; flex-direction: column; gap: 5px; overflow: scroll; }
  .mission-squad { width: 100%; height: 34px; flex-direction: column; gap: 3px; padding: 4px; border-width: 1px; border-color: #56675c; background-color: #15231fee; }
  .mission-squad-header { width: 100%; height: 15px; flex-direction: row; gap: 4px; }
  .mission-squad-name { width: 0px; flex-grow: 1; color: #a7ccc4; }
  .mission-squad-status { width: 152px; text-align: right; color: #a8b6c6; }
  .mission-squad-task { width: 100%; height: 15px; color: #ffd464; }
  .mission-hidden { width: 0px; height: 0px; padding: 0px; gap: 0px; border-width: 0px; opacity: 0; overflow: hidden; }

  .battle-hud-overlay {
    width: 100%;
    height: 100%;
    flex-direction: row;
    overflow: hidden;
  }

  .label { overflow: hidden; white-space: nowrap; }
  .heading { font-family: heading; }

  .battle-hud-spacer { flex-grow: 1; height: 1px; }

  .battle-command-rail {
    width: 360px;
    height: 100%;
    flex-direction: column;
    gap: 6px;
    background-color: transparent;
  }

  .battle-time-control {
    width: 100%;
    height: 42px;
    flex-direction: row;
    padding: 5px;
    gap: 5px;
    border-width: 1px;
    border-color: #727b79;
    background-color: #141e19ee;
  }

  .time-label {
    width: 56px;
    height: 30px;
    padding: 8px 5px;
    color: #a0ada8;
  }

  .time-options {
    height: 30px;
    flex-direction: row;
    flex-grow: 1;
    gap: 3px;
  }

  .time-button {
    height: 30px;
    flex-grow: 1;
    padding: 7px 3px;
    border-width: 1px;
    border-color: #56675c;
    background-color: #303a32f2;
    font-family: heading;
    text-align: center;
    color: #c1cbc3;
  }

  .time-button:hover { background-color: #46524a; border-color: #a7ccc4; }
  .time-button:active { background-color: #222b24; }
  .time-selected {
    background-color: #3a3018;
    border-color: #ffd464;
    color: #ffd464;
  }

  .objective-panel {
    width: 100%;
    height: 116px;
    flex-direction: column;
    padding: 7px;
    gap: 5px;
    border-width: 1px;
    border-color: #727b79;
    background-color: #141e19ee;
    overflow: hidden;
  }

  .objective-panel-hidden {
    height: 0px;
    padding: 0px;
    gap: 0px;
    border-width: 0px;
    opacity: 0;
  }

  .objective-header { width: 100%; height: 17px; flex-direction: row; }
  .objective-title { flex-grow: 1; color: #a0ada8; }
  .objective-score { width: 68px; text-align: right; color: #ffd464; }

  .objective-chips {
    width: 100%;
    height: 23px;
    flex-direction: row;
    gap: 4px;
    overflow: hidden;
  }

  .objective-chip {
    width: 23px;
    height: 23px;
    padding: 5px 2px;
    border-width: 1px;
    font-family: heading;
    text-align: center;
  }

  .objective-cargo { width: 92px; }
  .objective-raid { width: 166px; }
  .objective-pending { border-color: #56675c; color: #a8b6c6; }
  .objective-locate { width: 60px; height: 17px; font-family: heading; text-align: center; color: #ffd464; background-color: #3a3018; }
  .objective-locate-hidden { width: 0px; height: 0px; padding: 0px; border-width: 0px; opacity: 0; overflow: hidden; }

  .objective-hostile { background-color: #351d22; border-color: #e98b83; color: #e98b83; }
  .objective-contested { background-color: #3a3018; border-color: #ffd464; color: #ffd464; }
  .objective-secured { background-color: #132b22; border-color: #78d494; color: #78d494; }

  .objective-tally { width: 100%; height: 15px; color: #a8b6c6; }

  .objective-focus { width: 100%; height: 27px; flex-direction: column; gap: 4px; }
  .objective-focus-hidden { height: 0px; gap: 0px; opacity: 0; overflow: hidden; }
  .objective-focus-label { width: 100%; height: 15px; color: #ffd464; }
  .objective-progress-track { width: 100%; height: 4px; background-color: #101713; }
  .objective-progress-fill { height: 100%; background-color: #ffd464; }

  .conquest-command-panel {
    width: 360px;
    height: 150px;
    flex-direction: column;
    padding: 7px;
    gap: 4px;
    border-width: 1px;
    border-color: #727b79;
    background-color: #141e19ee;
    overflow: hidden;
  }

  .conquest-command-panel-hidden {
    width: 0px;
    height: 0px;
    padding: 0px;
    gap: 0px;
    border-width: 0px;
    opacity: 0;
  }

  .conquest-command-header {
    width: 100%;
    height: 17px;
    flex-direction: row;
  }

  .conquest-command-title {
    width: 152px;
    color: #a0ada8;
  }

  .conquest-command-phase {
    flex-grow: 1;
    text-align: right;
    color: #a7ccc4;
  }

  .conquest-command-force {
    width: 100%;
    height: 15px;
    color: #a8b6c6;
  }

  .conquest-lanes {
    width: 100%;
    height: 96px;
    flex-direction: column;
    gap: 3px;
    overflow: hidden;
  }

  .conquest-lane {
    width: 100%;
    height: 22px;
    flex-direction: row;
    gap: 4px;
    padding: 3px 4px;
    border-width: 1px;
    border-color: #56675c;
    background-color: #111b28;
    color: #c1cbc3;
  }

  .conquest-lane-name {
    width: 84px;
    height: 14px;
    color: #a7ccc4;
  }

  .conquest-lane-force {
    width: 62px;
    height: 14px;
    color: #c5d1df;
  }

  .conquest-lane-intent {
    width: 0px;
    height: 14px;
    flex-grow: 1;
    color: #ffd464;
  }

  .conquest-lane-status {
    width: 78px;
    height: 14px;
    text-align: right;
    color: #a0ada8;
  }

  .conquest-lane-contact {
    border-color: #a85b54;
    background-color: #26171c;
  }
  .conquest-lane-contact .conquest-lane-status { color: #e98b83; }
  .conquest-lane-objective { border-color: #806b35; }
  .conquest-lane-objective .conquest-lane-status { color: #ffd464; }
  .conquest-lane-empty { opacity: 0.66; }

  .conquest-groups {
    width: 100%;
    height: 104px;
    flex-direction: column;
    gap: 3px;
    overflow: hidden;
  }
  .conquest-groups-hidden, .conquest-lanes-hidden {
    height: 0px;
    gap: 0px;
    opacity: 0;
    overflow: hidden;
  }
  .conquest-group {
    width: 100%;
    height: 28px;
    flex-direction: column;
    padding: 1px 4px;
    border-width: 1px;
    border-color: #56675c;
    background-color: #111b28;
  }
  .conquest-group-line { width: 100%; height: 12px; flex-direction: row; }
  .conquest-group-name { width: 0px; flex-grow: 1; height: 12px; color: #a7ccc4; }
  .conquest-group-force { width: 112px; height: 12px; text-align: right; color: #c5d1df; }
  .conquest-group-intent { width: 0px; flex-grow: 1; height: 12px; color: #ffd464; }
  .conquest-group-target { width: 112px; height: 12px; text-align: right; color: #a0ada8; }
  .conquest-group-rally { border-color: #806b35; }
  .conquest-group-rally .conquest-group-target { color: #ffd464; }
  .conquest-group-summary .conquest-group-name { color: #a8b6c6; }
</style>
