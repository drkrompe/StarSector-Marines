<template props="missionClasses,missionCards,missionPanelStyle,missionListStyle,missionScore,timeLabel,pauseLabel,normalLabel,doubleLabel,quadLabel,pauseClasses,normalClasses,doubleClasses,quadClasses,pauseStyle,normalStyle,doubleStyle,quadStyle,pauseAction,normalAction,doubleAction,quadAction,objectivePanelClasses,objectiveTitle,objectiveScore,objectiveTally,objectiveChips,objectiveFocusClasses,objectiveFocus,objectiveProgressStyle,objectiveLocateClasses,objectiveLocateDisabled,objectiveLocateAction,liftClasses,liftStyle,liftSummary,liftRows">
  <div id="battle-hud-overlay" class="battle-hud-overlay hud-glass">
    <div id="battle-lift-queue" class="{liftClasses}" style="{liftStyle}">
      <div id="battle-lift-queue-header" class="lift-header">
        <div id="battle-lift-queue-title" class="label heading lift-title">{i18n.battleLiftQueueTitle}</div>
        <div id="battle-lift-queue-summary" class="label heading lift-summary">{liftSummary}</div>
      </div>
      <div id="battle-lift-queue-rows" class="lift-rows">
        <div each="row in liftRows" key="{row.id}" id="{row.id}" class="{row.classes}">
          <div id="{row.kindId}" class="label heading lift-kind">{row.kind}</div>
          <div id="{row.nameId}" class="label lift-name">{row.name}</div>
          <div id="{row.etaId}" class="label heading lift-eta">{row.eta}</div>
          <button id="{row.cancelId}" class="{row.cancelClasses}" disabled="{row.cancelDisabled}" onclick="{row.cancel}">{i18n.battleLiftCancel}</button>
        </div>
      </div>
    </div>

    <div id="battle-hud-spacer" class="battle-hud-spacer" />

    <div id="battle-command-rail" class="battle-command-rail">
      <div id="battle-time-control" class="battle-time-control">
        <div id="battle-time-label" class="label heading time-label">{timeLabel}</div>
        <div id="battle-time-options" class="time-options">
          <button id="battle-time-pause" class="{pauseClasses}" style="{pauseStyle}" onclick="{pauseAction}">{pauseLabel}</button>
          <button id="battle-time-normal" class="{normalClasses}" style="{normalStyle}" onclick="{normalAction}">{normalLabel}</button>
          <button id="battle-time-double" class="{doubleClasses}" style="{doubleStyle}" onclick="{doubleAction}">{doubleLabel}</button>
          <button id="battle-time-quad" class="{quadClasses}" style="{quadStyle}" onclick="{quadAction}">{quadLabel}</button>
        </div>
      </div>

      <div id="battle-mission-objectives" class="{missionClasses}" style="{missionPanelStyle}">
        <div id="mission-heading-row" class="objective-header">
          <div id="mission-heading" class="label heading objective-title">{i18n.battleHudMissionObjectives}</div>
          <div id="mission-score" class="label heading objective-score">{missionScore}</div>
        </div>
        <div id="battle-mission-list" class="mission-list" style="{missionListStyle}">
          <div each="card in missionCards" key="{card.id}" id="{card.id}" class="{card.classes}">
            <div id="{card.headerId}" class="mission-card-header">
              <div id="{card.nameId}" class="label heading mission-name">{card.name}</div>
              <button id="{card.locateId}" class="objective-locate" disabled="{card.disabled}" onclick="{card.locate}">{i18n.battleHudLocate}</button>
            </div>
            <div id="{card.phaseId}" class="label heading mission-phase">{card.phase}</div>
            <div id="{card.stepsId}" class="label mission-steps">{card.steps}</div>
            <div id="{card.instructionId}" class="mission-instruction">{card.instruction}</div>
            <div id="{card.progressTextId}" class="label mission-secondary">{card.progressText}</div>
            <div id="{card.trackId}" class="objective-progress-track" style="{card.trackStyle}"><div id="{card.progressId}" class="objective-progress-fill" style="{card.progressStyle}" /></div>
            <div id="{card.blockerId}" class="mission-blocker">{card.blocker}</div>
          </div>
        </div>
      </div>

      <div id="battle-objectives" class="{objectivePanelClasses}">
        <div id="battle-objective-header" class="objective-header">
          <div id="battle-objective-title" class="label heading objective-title">{objectiveTitle}</div>
          <button id="battle-objective-locate" class="{objectiveLocateClasses}" disabled="{objectiveLocateDisabled}" onclick="{objectiveLocateAction}">{i18n.battleHudLocate}</button>
          <div id="battle-objective-score" class="label heading objective-score">{objectiveScore}</div>
        </div>
        <div id="battle-objective-chips" class="objective-chips">
          <div each="chip in objectiveChips" key="{chip.id}" id="{chip.id}" class="{chip.classes}">{chip.label}</div>
        </div>
        <div id="battle-objective-tally" class="label objective-tally">{objectiveTally}</div>
        <div id="battle-objective-focus" class="{objectiveFocusClasses}">
          <div id="battle-objective-focus-label" class="label heading objective-focus-label">{objectiveFocus}</div>
          <div id="battle-objective-progress" class="objective-progress-track">
            <div id="battle-objective-progress-fill" class="objective-progress-fill" style="{objectiveProgressStyle}" />
          </div>
        </div>
      </div>
    </div>
  </div>
</template>

<style>
  .mission-panel { width: 100%; flex-direction: column; gap: 6px; padding: 7px; border-width: 1px; border-color: transparent; background-color: transparent; }
  .mission-card .objective-progress-track { flex-direction: row; }
  .mission-list { width: 100%; flex-direction: column; gap: 6px; overflow: scroll; }
  .mission-card { width: 100%; height: 156px; flex-direction: column; gap: 4px; padding: 5px; border-width: 1px; border-color: #d6c27a4d; background-color: transparent; background-image: linear-gradient(to right, #c3cec91c 0%, #c3cec90a 60%, #c3cec900 100%); }
  .mission-card-header { width: 100%; height: 18px; flex-direction: row; gap: 4px; }
  .mission-name { width: 0px; flex-grow: 1; height: 18px; color: #e6e7da; }
  .mission-phase { width: 100%; height: 15px; color: #ffd464; }
  .mission-steps { width: 100%; height: 15px; color: #a7ccc4; }
  .mission-instruction { white-space: normal; overflow: hidden; width: 100%; min-height: 30px; color: #d4ddd5; }
  .mission-secondary { width: 100%; height: 15px; color: #a8b6c6; }
  .mission-blocker { white-space: normal; overflow: hidden; width: 100%; min-height: 30px; color: #efb283; }
  .mission-complete { border-color: #78d49480; }
  .mission-complete .mission-phase { color: #78d494; }
  .mission-failed { border-color: #e98b8380; }
  .mission-failed .mission-phase { color: #e98b83; }
  .mission-hidden { display: none; }

  .battle-hud-overlay {
    width: 100%;
    height: 100%;
    flex-direction: row;
    overflow: hidden;
  }

  .label { overflow: hidden; white-space: nowrap; }
  .heading { font-family: heading; }

  .battle-hud-spacer { flex-grow: 1; height: 1px; }

  .battle-command-rail {
    width: 360px;
    height: 100%;
    flex-direction: column;
    gap: 6px;
    background-color: transparent;
  }

  .battle-time-control {
    width: 100%;
    height: 42px;
    flex-direction: row;
    padding: 5px;
    gap: 5px;
    border-width: 1px; border-color: transparent;
    background-color: transparent;
  }

  .time-label {
    width: 56px;
    height: 30px;
    padding: 8px 5px;
    color: #a0ada8;
  }

  .time-options {
    height: 30px;
    flex-direction: row;
    flex-grow: 1;
    gap: 3px;
  }

  .time-button {
    height: 30px;
    flex-grow: 1;
    padding: 7px 3px;
    border-width: 1px;
    border-color: #56675c;
    background-color: #303a32f2;
    font-family: heading;
    text-align: center;
    color: #c1cbc3;
  }

  .time-button:hover { background-color: #46524a; border-color: #a7ccc4; }
  .time-button:active { background-color: #222b24; }
  .time-selected {
    background-color: #3a3018;
    border-color: #ffd464;
    color: #ffd464;
  }

  .objective-panel {
    width: 100%;
    height: 116px;
    flex-direction: column;
    padding: 7px;
    gap: 5px;
    border-width: 1px; border-color: transparent;
    background-color: transparent;
    overflow: hidden;
  }

  .objective-panel-hidden {
    display: none;
  }

  .objective-header { width: 100%; height: 17px; flex-direction: row; }
  .objective-title { flex-grow: 1; color: #a0ada8; }
  .objective-score { width: 68px; text-align: right; color: #ffd464; }

  .objective-chips {
    width: 100%;
    height: 23px;
    flex-direction: row;
    gap: 4px;
    overflow: hidden;
  }

  .objective-chip {
    width: 23px;
    height: 23px;
    padding: 5px 2px;
    border-width: 1px;
    font-family: heading;
    text-align: center;
  }

  .objective-cargo { width: 92px; }
  .objective-raid { width: 166px; }
  .objective-pending { border-color: #c3cec933; color: #a8b6c6; }
  .objective-locate { width: 60px; height: 17px; font-family: heading; text-align: center; color: #ffd464; background-color: #3a3018; }
  .objective-locate-hidden { display: none; }

  .objective-hostile { background-color: #e98b8326; border-color: #e98b83aa; color: #e98b83; }
  .objective-contested { background-color: #ffd46426; border-color: #ffd464aa; color: #ffd464; }
  .objective-secured { background-color: #78d49426; border-color: #78d494aa; color: #78d494; }

  .objective-tally { width: 100%; height: 15px; color: #a8b6c6; }

  .objective-focus { width: 100%; height: 27px; flex-direction: column; gap: 4px; }
  .objective-focus-hidden { display: none; }
  .objective-focus-label { width: 100%; height: 15px; color: #ffd464; }
  .objective-progress-track { width: 100%; height: 4px; background-color: #0000008c; }
  .objective-progress-fill { height: 100%; background-color: #ffd464; }

  .lift-queue-panel {
    width: 344px;
    flex-direction: column;
    padding: 7px;
    gap: 4px;
    border-width: 1px; border-color: transparent;
    background-color: transparent;
    overflow: hidden;
  }
  .lift-queue-hidden { display: none; }
  .lift-header { width: 100%; height: 17px; flex-direction: row; }
  .lift-title { width: 152px; color: #a0ada8; }
  .lift-summary { flex-grow: 1; text-align: right; color: #a7ccc4; }
  .lift-rows { width: 100%; flex-direction: column; gap: 3px; overflow: hidden; }
  .lift-row {
    width: 334px;
    height: 14px;
    flex-direction: row;
    gap: 4px;
    padding: 2px 4px;
    border-width: 1px; border-color: transparent;
    background-color: transparent;
    background-image: linear-gradient(to right, #c3cec91c 0%, #c3cec90a 60%, #c3cec900 100%);
  }
  .lift-kind { width: 48px; height: 14px; color: #a0ada8; }
  .lift-name { width: 0px; flex-grow: 1; height: 14px; color: #c5d1df; }
  .lift-eta { width: 64px; height: 14px; text-align: right; color: #ffd464; }
  .lift-air .lift-kind { color: #78d494; }
  .lift-air .lift-eta { color: #78d494; }
  .lift-drop .lift-kind { color: #ffd464; }
  .lift-more .lift-name { color: #a8b6c6; }
  .lift-cancel {
    width: 16px;
    height: 12px;
    padding: 0px;
    border-width: 1px;
    border-color: #e98b8399;
    background-color: #3a1e1cf2;
    font-family: heading;
    text-align: center;
    color: #e98b83;
  }
  .lift-cancel:hover { background-color: #5a2a26; border-color: #e98b83; }
  .lift-cancel-hidden { display: none; }
</style>
