<template props="padClasses,kitClasses,kit0Classes,kit0Name,kit0Count,kit0Rounds,kit0RoundsStyle,kit1Classes,kit1Name,kit1Count,kit1Rounds,kit1RoundsStyle,kit2Classes,kit2Name,kit2Count,kit2Rounds,kit2RoundsStyle,kit3Classes,kit3Name,kit3Count,kit3Rounds,kit3RoundsStyle,arm,armClasses,leg,legClasses">
  <div id="marine-doll" class="marine-doll" style="background-color: transparent; background-image: none; border-width: 0px;">
    <div id="marine-doll-body" class="doll-body">
      <div id="marine-doll-pad-left" class="{padClasses}"></div>
      <canvas id="marine-doll-canvas" class="doll-canvas" width="52" height="118" />
      <div id="marine-doll-pad-right" class="{padClasses}"></div>
      <div id="marine-doll-kit" class="{kitClasses}">
        <div id="marine-doll-kit-spacer" class="kit-spacer"></div>
        <div id="marine-doll-kit-0" class="{kit0Classes}">
          <div id="marine-doll-kit-0-name" class="kit-name">{kit0Name}</div>
          <div id="marine-doll-kit-0-count" class="kit-count">{kit0Count}</div>
          <div id="marine-doll-kit-0-rounds" class="kit-rounds" style="{kit0RoundsStyle}">
            <img each="round in kit0Rounds" key="{round.id}" id="{round.id}" class="{round.classes}" src="{round.src}" />
          </div>
        </div>
        <div id="marine-doll-kit-1" class="{kit1Classes}">
          <div id="marine-doll-kit-1-name" class="kit-name">{kit1Name}</div>
          <div id="marine-doll-kit-1-count" class="kit-count">{kit1Count}</div>
          <div id="marine-doll-kit-1-rounds" class="kit-rounds" style="{kit1RoundsStyle}">
            <img each="round in kit1Rounds" key="{round.id}" id="{round.id}" class="{round.classes}" src="{round.src}" />
          </div>
        </div>
        <div id="marine-doll-kit-2" class="{kit2Classes}">
          <div id="marine-doll-kit-2-name" class="kit-name">{kit2Name}</div>
          <div id="marine-doll-kit-2-count" class="kit-count">{kit2Count}</div>
          <div id="marine-doll-kit-2-rounds" class="kit-rounds" style="{kit2RoundsStyle}">
            <img each="round in kit2Rounds" key="{round.id}" id="{round.id}" class="{round.classes}" src="{round.src}" />
          </div>
        </div>
        <div id="marine-doll-kit-3" class="{kit3Classes}">
          <div id="marine-doll-kit-3-name" class="kit-name">{kit3Name}</div>
          <div id="marine-doll-kit-3-count" class="kit-count">{kit3Count}</div>
          <div id="marine-doll-kit-3-rounds" class="kit-rounds" style="{kit3RoundsStyle}">
            <img each="round in kit3Rounds" key="{round.id}" id="{round.id}" class="{round.classes}" src="{round.src}" />
          </div>
        </div>
      </div>
    </div>
    <div id="marine-doll-flags" class="doll-flags">
      <div id="marine-doll-leg" class="{legClasses}">{leg}</div>
      <div id="marine-doll-arm" class="{armClasses}">{arm}</div>
    </div>
  </div>
</template>

<style>
  div.marine-doll {
    text-shadow: #000000d9;
    width: 100%;
    height: 100%;
    flex-direction: column;
    padding: 4px 6px;
    gap: 3px;
    border-width: 0px;
    background-color: transparent;
    background-image: none;
    overflow: hidden;
  }
  .doll-body { width: 100%; height: 118px; flex-direction: row; gap: 6px; }
  .doll-canvas { width: 52px; height: 118px; }
  .pad { width: 0px; flex-grow: 1; }
  .pad-hidden { position: absolute; width: 0px; height: 0px; overflow: hidden; }
  .kit { width: 0px; flex-grow: 1; height: 100%; flex-direction: column; gap: 3px; }
  .kit-hidden { position: absolute; width: 0px; height: 0px; overflow: hidden; }
  .kit-spacer { height: 0px; flex-grow: 1; }
  .kit-row { height: 26px; flex-direction: row; gap: 3px; padding: 1px 4px; border-width: 1px; border-color: #6fd08a66; background-color: #0000004d; }
  .kit-row-spent { border-color: #2c3732; }
  .kit-row-hidden { position: absolute; width: 0px; height: 0px; overflow: hidden; }
  .kit-name { width: 0px; flex-grow: 1; min-height: 22px; font-family: compact; color: #c3cec9; white-space: normal; overflow: hidden; }
  .kit-rounds { height: 22px; flex-direction: row; gap: 2px; align-items: center; }
  .kit-round-missile { width: 6px; height: 22px; }
  .kit-round-rifle { width: 8px; height: 19px; }
  .kit-round-grenade { width: 12px; height: 20px; }
  .kit-round-smoke { width: 10px; height: 20px; }
  .kit-round-shield { width: 16px; height: 20px; }
  .kit-count { height: 12px; font-family: compact; color: #ecf3fb; text-align: right; white-space: nowrap; }
  .doll-flags { width: 100%; height: 16px; flex-direction: row; gap: 4px; }
  .flag {
    width: 0px;
    flex-grow: 1;
    height: 12px;
    padding: 2px 0px;
    border-width: 1px;
    font-family: compact;
    text-align: center;
    white-space: nowrap;
    overflow: hidden;
  }
  .flag-off { color: #4f5c55; border-color: #2c3732; }
  .flag-on { color: #ffe1d8; border-color: #f06a5e; background-color: #6a221c; }
</style>
