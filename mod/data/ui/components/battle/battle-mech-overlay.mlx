<template props="mechTitle,mechIdentity,deployedDoctrine,effectiveDoctrine,doctrineState,doctrineStateClasses,attachmentState,attachmentClasses,detachDisabled,detachAction,doctrineCards,backAction,defaultAction">
  <div id="battle-mech-overlay" class="battle-mech-overlay hud-glass">
    <div id="battle-mech-panel" class="mech-panel">
      <div id="battle-mech-header" class="mech-header">
        <button id="battle-mech-back" class="mech-back console-action" onclick="{backAction}">{i18n.battleBack}</button>
        <div id="battle-mech-title" class="label heading mech-title">{mechTitle}</div>
        <div id="battle-mech-state" class="{doctrineStateClasses}">{doctrineState}</div>
      </div>

      <div id="battle-mech-summary" class="mech-summary">
        <div id="battle-mech-identity" class="label mech-identity">{mechIdentity}</div>
        <div id="battle-mech-doctrine-summary" class="mech-doctrine-summary">
          <div id="battle-mech-deployed" class="label doctrine-summary-line doctrine-deployed">{deployedDoctrine}</div>
          <div id="battle-mech-effective" class="label heading doctrine-summary-line doctrine-effective">{effectiveDoctrine}</div>
        </div>
      </div>

      <div id="battle-mech-attachment-heading-row" class="section-heading-row">
        <div id="battle-mech-attachment-heading" class="label heading section-heading">{i18n.battleMechAttachment}</div>
        <div id="battle-mech-attachment-scope" class="label section-scope">{i18n.battleMechAttachmentScope}</div>
      </div>
      <div id="battle-mech-attachment-row" class="attachment-row">
        <div id="battle-mech-attachment-state" class="{attachmentClasses}">{attachmentState}</div>
        <button id="battle-mech-detach" class="attachment-detach console-action" disabled="{detachDisabled}" onclick="{detachAction}">{i18n.battleMechDetach}</button>
      </div>


      <div id="battle-mech-doctrine-heading-row" class="section-heading-row">
        <div id="battle-mech-doctrine-heading" class="label heading section-heading">{i18n.battleMechFieldDoctrine}</div>
        <div id="battle-mech-doctrine-scope" class="label section-scope">{i18n.battleMechSelected}</div>
      </div>
      <div id="battle-mech-doctrine-cards" class="doctrine-cards">
        <button each="doctrine in doctrineCards" key="{doctrine.id}" id="{doctrine.id}" class="{doctrine.classes}" disabled="{doctrine.disabled}" onclick="{doctrine.action}">
          <div id="{doctrine.nameId}" class="label heading doctrine-name">{doctrine.name}</div>
          <div id="{doctrine.metaId}" class="label doctrine-meta">{doctrine.meta}</div>
        </button>
      </div>

      <div id="battle-mech-footer" class="mech-footer">
        <div id="battle-mech-hint" class="label mech-hint">{i18n.battleMechHint}</div>
        <button id="battle-mech-default" class="mech-default console-action" onclick="{defaultAction}">{i18n.battleMechResetDoctrine}</button>
      </div>
    </div>
  </div>
</template>

<style>
  .battle-mech-overlay {
    width: 100%;
    height: 100%;
    background-color: transparent;
    overflow: hidden;
  }

  .label { overflow: hidden; white-space: nowrap; }
  .heading { font-family: heading; }

  .mech-panel {
    width: 414px;
    height: 236px;
    flex-direction: column;
    padding: 7px;
    gap: 6px;
    border-width: 1px; border-color: transparent;
    background-color: transparent;
    overflow: hidden;
  }

  .mech-header {
    width: 100%;
    height: 30px;
    flex-direction: row;
    gap: 6px;
  }

  .mech-back {
    width: 58px;
    height: 18px;
    padding: 5px;
    border-width: 1px;
    font-family: heading;
    text-align: center;
  }

  .mech-title {
    width: 0px;
    height: 18px;
    flex-grow: 1;
    padding: 6px 0px;
    color: #c5d6cb;
  }

  .doctrine-state {
    width: 164px;
    height: 16px;
    padding: 5px 2px;
    border-width: 1px;
    font-family: heading;
    text-align: center;
  }

  .doctrine-state-default {
    color: #78d494;
    border-color: #78d49466;
    background-color: #78d4941a;
  }

  .doctrine-state-overridden {
    color: #ffd464;
    border-color: #d6c27a99;
    background-color: #d6c27a24;
  }

  .mech-summary {
    width: 100%;
    height: 31px;
    flex-direction: row;
    padding: 4px 5px;
    gap: 8px;
    border-width: 1px; border-color: transparent;
    background-color: transparent;
    background-image: linear-gradient(to right, #c3cec91c 0%, #c3cec90a 60%, #c3cec900 100%);
  }

  .mech-identity {
    width: 0px;
    height: 15px;
    flex-grow: 1;
    padding: 8px 0px;
    color: #a0ada8;
  }

  .mech-doctrine-summary {
    width: 250px;
    height: 31px;
    flex-direction: column;
    gap: 3px;
  }

  .doctrine-summary-line { width: 100%; height: 14px; text-align: right; }
  .doctrine-deployed { color: #a0ada8; }
  .doctrine-effective { color: #a7ccc4; }

  .section-heading-row {
    width: 100%;
    height: 13px;
    flex-direction: row;
  }

  .section-heading {
    width: 0px;
    height: 13px;
    flex-grow: 1;
    color: #a0ada8;
  }

  .section-scope {
    width: 120px;
    height: 13px;
    text-align: right;
    color: #829083;
  }

  .attachment-row {
    width: 100%;
    height: 32px;
    flex-direction: row;
    gap: 5px;
    overflow: hidden;
  }

  .attachment-state {
    width: 0px;
    height: 18px;
    flex-grow: 1;
    padding: 6px;
    border-width: 1px;
    font-family: heading;
    overflow: hidden;
    white-space: nowrap;
  }

  .attachment-state-free {
    color: #a0ada8;
    border-color: #56675c;
    background-color: #303a32f2;
  }

  .attachment-state-attached {
    color: #a7ccc4;
    border-color: #a7ccc4;
    background-color: #173548;
  }

  .attachment-detach {
    width: 92px;
    height: 18px;
    padding: 6px;
    border-width: 1px;
    border-color: #727b79;
    font-family: heading;
    text-align: center;
    color: #c1cbc3;
  }

  .attachment-detach:hover { border-color: #a7ccc4; color: #c5d6cb; }

  .doctrine-cards {
    width: 100%;
    height: 46px;
    flex-direction: row;
    gap: 5px;
    overflow: hidden;
  }

  .doctrine-card {
    width: 0px;
    height: 32px;
    flex-grow: 1;
    flex-direction: column;
    padding: 5px;
    gap: 3px;
    border-width: 1px;
    border-color: #56675c;
    background-color: #303a32f2;
    color: #c1cbc3;
    text-align: left;
    overflow: hidden;
  }

  .doctrine-card:hover { background-color: #46524a; border-color: #a7ccc4; }
  .doctrine-card:active { background-color: #222b24; }
  .doctrine-card-deployed { border-color: #3f7354; }
  .doctrine-card-long-range { padding: 5px 0px; flex-grow: 1.12; }
  .doctrine-card-active {
    border-color: #ffd464;
    background-color: #3a3018;
    color: #ffd464;
  }

  .doctrine-name { width: 100%; height: 16px; color: #c5d6cb; }
  .doctrine-meta { width: 100%; height: 13px; color: #a0ada8; }
  .doctrine-card-active .doctrine-name { color: #ffd464; }
  .doctrine-card-active .doctrine-meta { color: #bcae82; }

  .mech-footer {
    width: 100%;
    height: 24px;
    flex-direction: row;
    gap: 6px;
  }

  .mech-hint {
    width: 0px;
    height: 14px;
    flex-grow: 1;
    padding: 5px 0px;
    color: #829083;
  }

  .mech-default {
    width: 142px;
    height: 14px;
    padding: 5px 6px;
    border-width: 1px;
    border-color: #727b79;
    font-family: heading;
    text-align: center;
    color: #c1cbc3;
  }

  .mech-default:hover { border-color: #a7ccc4; color: #c5d6cb; }
</style>
