<template props="title,crippled,crippledClasses,sensors,sensorsClasses">
  <div id="mech-sections" class="mech-sections" style="background-color: transparent; background-image: none; border-width: 0px;">
    <div id="mech-sections-title" class="sections-title">{title}</div>
    <canvas id="mech-sections-doll" class="sections-doll" width="150" height="124" />
    <div id="mech-sections-flags" class="sections-flags">
      <div id="mech-sections-crippled" class="{crippledClasses}">{crippled}</div>
      <div id="mech-sections-sensors" class="{sensorsClasses}">{sensors}</div>
    </div>
  </div>
</template>

<style>
  div.mech-sections {
    text-shadow: #000000d9;
    width: 100%;
    height: 100%;
    flex-direction: column;
    padding: 6px;
    gap: 4px;
    border-width: 0px;
    background-color: transparent;
    background-image: none;
    overflow: hidden;
  }
  .sections-title { width: 100%; height: 13px; font-family: heading; color: #a0ada8; white-space: nowrap; }
  .sections-doll { width: 150px; height: 124px; }
  .sections-flags { width: 100%; height: 16px; flex-direction: row; gap: 4px; }
  .flag {
    width: 0px;
    flex-grow: 1;
    height: 12px;
    padding: 2px 0px;
    border-width: 1px;
    font-family: compact;
    text-align: center;
    white-space: nowrap;
    overflow: hidden;
  }
  .flag-off { color: #4f5c55; border-color: #2c3732; }
  .flag-on { color: #ffe1d8; border-color: #f06a5e; background-color: #6a221c; }
  .flag-sensors { flex-grow: 1.5; }
</style>
