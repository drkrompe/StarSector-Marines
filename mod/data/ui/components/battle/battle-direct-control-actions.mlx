<template props="exitLabel,exitAction,pauseLabel,pauseAction">
  <div id="direct-actions" class="action-controls" style="background-color: #00000000;">
    <button id="direct-actions-exit" class="exit" onclick="{exitAction}">{exitLabel}</button>
    <button id="direct-actions-pause" class="pause" onclick="{pauseAction}">{pauseLabel}</button>
  </div>
</template>

<style>
  .action-controls { width: 100%; height: 100%; flex-direction: row; gap: 6px; }
  .exit, .pause { height: 24px; padding: 0px; text-align: center; border-width: 1px; border-color: #4f6d8e; background-color: #243d56; color: #d7f3ff; }
  .exit { width: 100px; font-family: compact; }
  .pause { width: 44px; }
</style>
