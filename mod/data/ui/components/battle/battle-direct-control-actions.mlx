<template props="exitKey,exitLabel,exitAction,pauseKey,pauseLabel,pauseClasses,pauseAction">
  <div id="direct-actions" class="action-controls" style="background-color: transparent; background-image: none; border-width: 0px;">
    <button id="direct-actions-exit" class="action action-exit" style="background-color: transparent; background-image: none; border-width: 0px;" onclick="{exitAction}">
      <div id="direct-actions-exit-key" class="keycap keycap-tab">{exitKey}</div>
      <div id="direct-actions-exit-label" class="action-label">{exitLabel}</div>
    </button>
    <button id="direct-actions-pause" class="{pauseClasses}" style="background-color: transparent; background-image: none; border-width: 0px;" onclick="{pauseAction}">
      <div id="direct-actions-pause-key" class="keycap keycap-space">{pauseKey}</div>
      <div id="direct-actions-pause-label" class="action-label">{pauseLabel}</div>
    </button>
  </div>
</template>

<style>
  .action-controls { width: 100%; height: 100%; flex-direction: row; gap: 14px; align-items: center; justify-content: end; text-shadow: #000000d9; }
  .action { height: 22px; padding: 0px 2px; flex-direction: row; gap: 6px; align-items: center; }
  .keycap { height: 18px; padding: 0px 5px; text-align: center; font-family: heading; color: #e9efe9; border-width: 1px; border-color: #b4c0bab3; background-color: #00000080; }
  .action-exit { width: 136px; }
  .action-pause { width: 140px; }
  .keycap-tab { width: 40px; }
  .keycap-space { width: 58px; }
  .action-label { font-family: heading; color: #c3cec9; white-space: nowrap; }
  .action:hover .action-label { color: #ffffff; }
  .action:hover .keycap { border-color: #ffffff; }
  .action-paused .keycap { color: #ffd464; border-color: #ffd464; background-color: #3b301080; }
  .action-paused .action-label { color: #ffd464; }
</style>
