<template props="ships,actions,title,hint,heroStyle,actionStyle">
  <div id="ship-action-shell" class="ship-shell action-shell" style="{actionStyle}">
    <div id="ship-selected-title" class="ship-heading">{title}</div>
    <div id="ship-actions" class="ship-row">
      <button each="command in actions" key="{command.id}" id="{command.id}" class="{command.classes}" disabled="{command.disabled}" onclick="{command.action}">
        <img id="{command.imageId}" class="action-image" src="{command.icon}" />
        <div id="{command.labelId}" class="ship-name">{command.label}</div>
        <div id="{command.statusId}" class="ship-status">{command.status}</div>
      </button>
    </div>
    <div id="ship-command-hint" class="ship-hint">{hint}</div>
  </div>
</template>
<style>
.ship-shell { width: 100%; flex-direction: column; padding: 5px; gap: 3px; border-width: 1px; border-color: #727b79; background-color: #141e19f2; overflow: hidden; }
.hero-shell { height: 84px; }
.action-shell { height: 106px; }
#ship-heroes { height: 68px; }
#ship-actions { height: 60px; }
.ship-heading { height: 12px; width: 100%; font-family: heading; color: #baa976; overflow: hidden; white-space: nowrap; }
.ship-row { width: 100%; flex-direction: row; gap: 4px; overflow: hidden; }
.ship-hero { width: 96px; height: 60px; padding: 3px 5px; flex-direction: column; gap: 1px; border-width: 1px; border-color: #56675c; background-color: #303a32f2; overflow: hidden; }
.ship-action { width: 70px; height: 52px; padding: 3px 5px; flex-direction: column; gap: 2px; border-width: 1px; border-color: #56675c; background-color: #303a32f2; overflow: hidden; }
.ship-hero:hover, .ship-action:hover { background-color: #46524a; border-color: #baa976; }
.ship-hero:active, .ship-action:active { background-color: #222b24; }
.ship-disabled { opacity: 0.45; }
.ship-selected { background-color: #3a3018; border-color: #d5bc76; }
.hero-image { width: 100%; height: 20px; pointer-events: none; }
.action-image { width: 100%; height: 26px; pointer-events: none; }
.ship-name { width: 100%; height: 12px; font-family: compact; text-align: center; color: #c1cbc3; overflow: hidden; white-space: nowrap; }
.ship-status { width: 100%; height: 10px; font-family: compact; text-align: center; color: #a0ada8; overflow: hidden; white-space: nowrap; }
.ship-track { width: 100%; height: 2px; background-color: #101713; }
.ship-fill { height: 100%; background-color: #a7ccc4; }
.ship-hint { width: 100%; height: 24px; color: #bcae82; font-family: compact; overflow: hidden; white-space: normal; }
</style>
