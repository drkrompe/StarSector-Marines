<template props="label,disabled,toggle">
  <div id="battle-direct-control" class="direct-control">
    <button id="battle-direct-control-toggle" class="direct-toggle console-action" disabled="{disabled}" onclick="{toggle}">{label}</button>
  </div>
</template>

<style>
  .direct-control {
    width: 100%;
    height: 100%;
    padding: 0px;
    background-color: transparent;
    overflow: hidden;
  }
  .direct-toggle {
    width: 100%;
    height: 24px;
    padding: 0px 7px;
    font-family: heading;
    text-align: center;
    color: #c9c8b9;
    background-color: #252721ed;
    border-width: 1px;
    border-color: #6c6c5f;
  }
  .direct-toggle:hover { color: #f0dfaa; background-color: #393a2f; border-color: #aaa077; }
  .direct-toggle:disabled { color: #858779; border-color: #53574c; }
</style>
