<template props="label,hint,disabled,toggle,pauseLabel,pauseClasses,pauseDisabled,togglePause">
  <div id="battle-direct-control" class="direct-control">
    <div id="battle-direct-control-actions" class="direct-actions">
      <button id="battle-direct-control-toggle" class="direct-toggle" disabled="{disabled}" onclick="{toggle}">{label}</button>
      <button id="battle-direct-control-pause" class="{pauseClasses}" disabled="{pauseDisabled}" onclick="{togglePause}">{pauseLabel}</button>
    </div>
    <div id="battle-direct-control-hint" class="direct-hint">{hint}</div>
  </div>
</template>

<style>
  .direct-control {
    width: 100%;
    height: 100%;
    padding: 0px;
    gap: 3px;
    border-width: 0px;
    border-color: #4f6d8e;
    background-color: #0b111be8;
    overflow: hidden;
  }
  .direct-actions { width: 100%; height: 28px; flex-direction: row; gap: 4px; }
  .direct-toggle { flex-grow: 1; }
  .direct-pause { width: 66px; }
  .direct-toggle, .direct-pause {
    height: 26px;
    font-family: heading;
    text-align: center;
    color: #d7f3ff;
    background-color: #243d56;
    border-width: 1px;
    border-color: #6ed7ff;
  }
  .direct-toggle:hover { background-color: #315070; }
  .direct-pause:hover { background-color: #315070; }
  .direct-toggle:disabled { color: #8b98a6; border-color: #45596f; background-color: #142131; }
  .direct-pause-hidden { width: 0px; height: 0px; padding: 0px; border-width: 0px; opacity: 0; overflow: hidden; }
  .direct-hint {
    height: 20px;
    text-align: center;
    white-space: nowrap;
    overflow: hidden;
    color: #aebdce;
  }
</style>
