<template props="label,disabled,toggle">
  <div id="battle-direct-control" class="direct-control hud-glass">
    <button id="battle-direct-control-toggle" class="direct-toggle console-action" disabled="{disabled}" onclick="{toggle}">{label}</button>
  </div>
</template>

<style>
  .direct-control {
    width: 100%;
    height: 100%;
    padding: 0px;
    background-color: transparent;
    overflow: hidden;
  }
  .direct-toggle {
    width: 100%;
    height: 24px;
    padding: 0px 7px;
    font-family: heading;
    text-align: center;
    color: #9bff00;
    background-color: #252721ed;
    border-width: 1px;
    border-color: #68b210;
  }
  .direct-toggle:hover { color: #cdff6e; background-color: #393a2f; border-color: #68b210; }
  .direct-toggle:disabled { color: #9bff00; border-color: #68b210; }
</style>
