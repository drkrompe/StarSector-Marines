<template props="speaker,portrait,subtitle">
  <div id="story-subtitle" class="panel">
    <img id="story-portrait" src="{portrait}" />
    <div id="story-copy">
      <div id="story-speaker" class="label heading tone-accent">{speaker}</div>
      <div id="story-dialogue" class="label tone-edge">{subtitle}</div>
    </div>
  </div>
</template>

<style>
  #story-subtitle { width: 100%; height: 100%; padding: 12px 16px; gap: 12px; border-width: 1px; flex-direction: row; pointer-events: none; }
  #story-portrait { width: 88px; height: 88px; border-width: 1px; border-color: #647569; background-color: #121719; }
  #story-copy { width: 0px; flex-grow: 1; height: 100%; flex-direction: column; gap: 8px; }
  #story-speaker { height: 18px; }
  #story-dialogue { height: 66px; white-space: normal; }
</style>
