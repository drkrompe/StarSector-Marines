<template props="healthStyle,healthClasses,armorStyle,weapons,weaponsClasses,allLabel,allClasses,allDisabled,allAction">
  <div id="direct-hud" class="direct-hud" style="background-color: #00000000;">
    <div id="direct-hud-armor-meter" class="meter"><div id="direct-hud-armor-fill" class="armor-fill" style="{armorStyle}"></div></div>
    <div id="direct-hud-health-meter" class="meter"><div id="direct-hud-health-fill" class="{healthClasses}" style="{healthStyle}"></div></div>
    <div id="direct-hud-weapons" class="{weaponsClasses}">
      <button id="direct-hud-all" class="{allClasses}" disabled="{allDisabled}" onclick="{allAction}">{allLabel}</button>
      <div id="direct-hud-mounts" class="mounts">
        <button each="weapon in weapons" key="{weapon.id}" id="{weapon.id}" class="{weapon.classes}" style="{weapon.style}" disabled="{weapon.disabled}" onclick="{weapon.action}">
          <div id="{weapon.topId}" class="weapon-top"><div id="{weapon.nameId}" class="weapon-name">{weapon.name}</div><div id="{weapon.stateId}" class="{weapon.stateClasses}">{weapon.state}</div></div>
          <div id="{weapon.dataId}" class="weapon-data"><div id="{weapon.behaviorId}" class="weapon-detail">{weapon.behavior}</div><div id="{weapon.ammoId}" class="weapon-ammo">{weapon.ammo}</div></div>
          <div id="{weapon.cycleId}" class="weapon-cycle"><div id="{weapon.fillId}" class="cycle-fill" style="{weapon.cycleStyle}"></div></div>
        </button>
      </div>
    </div>
  </div>
</template>

<style>
  .direct-hud { width: 100%; height: 100%; gap: 2px; overflow: hidden; }
  .meter { height: 3px; width: 100%; flex-direction: row; background-color: #253344; }
  .health-fill { height: 100%; background-color: #7cd89c; }
  .armor-fill { height: 100%; background-color: #6ed7ff; }
  .capacity-low { background-color: #f07c72; }
  .weapons { height: 42px; flex-direction: row; gap: 5px; }
  .weapons-single { gap: 0px; }
  .mounts { width: 0px; flex-grow: 1; flex-direction: row; gap: 5px; }
  .all { width: 44px; height: 38px; padding: 1px; text-align: center; font-family: compact; border-width: 1px; }
  .all-hidden { position: absolute; width: 0px; height: 0px; padding: 0px; border-width: 0px; overflow: hidden; }
  .weapon { width: 0px; flex-grow: 1; padding: 3px; gap: 2px; border-width: 1px; border-color: #45596f; background-color: #142131; overflow: hidden; }
  .ability { width: 128px; flex-grow: 0; }
  .sprint { border-color: #b58b43; }
  .weapon-top { height: 14px; flex-direction: row; gap: 4px; }
  .weapon-name { flex-grow: 1; font-family: heading; color: #ecf3fb; overflow: hidden; white-space: nowrap; }
  .weapon-state { color: #7cd89c; font-family: compact; }
  .weapon-busy { color: #ffd464; }
  .weapon-empty { color: #f07c72; }
  .weapon-data { height: 13px; flex-direction: row; gap: 4px; }
  .weapon-detail { flex-grow: 1; color: #aebdce; font-family: compact; overflow: hidden; white-space: nowrap; }
  .weapon-ammo { color: #d7f3ff; font-family: compact; white-space: nowrap; }
  .weapon-cycle { width: 100%; height: 2px; flex-direction: row; background-color: #253344; }
  .cycle-fill { height: 100%; background-color: #6ed7ff; }
</style>
