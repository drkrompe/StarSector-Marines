<template props="speaker,subtitle">
  <div id="company-subtitle" class="panel">
    <div class="label heading tone-accent" id="company-speaker">{speaker}</div>
    <div class="label tone-edge" id="company-dialogue">{subtitle}</div>
  </div>
</template>

<style>
  #company-subtitle { width: 100%; height: 100%; padding: 12px 16px; gap: 8px; border-width: 1px; flex-direction: column; pointer-events: none; }
  #company-speaker { height: 18px; }
  #company-dialogue { height: 66px; white-space: normal; }
</style>
