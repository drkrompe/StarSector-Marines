<template props="labSummary,squadRows,mechRows,gantryRows,activeGantryLabel,garageTitle,selectedMechName,selectedMechIdentity,selectedMechDoctrine,performanceMeters,leftSlotRows,rightSlotRows,slotRows,selectedSlotTitle,selectedSlotCopy,selectedSlotRule,catalogRows,pickerClasses,workspaceClasses,fittingHeaderClasses,performanceClasses,catalogClasses,slotRackClasses,overviewRailClasses,openAssetPicker,closeAssetPicker,previousGantry,nextGantry,feedbackText,feedbackClasses,returnAction,hqAction,barracksAction,armoryAction,mechLabAction,hqClasses,barracksClasses,armoryClasses,mechLabClasses">
  <div id="mech-lab-root" class="mech-lab-root">
    <marine-ops-page-nav returnAction="{returnAction}" hqAction="{hqAction}" barracksAction="{barracksAction}" armoryAction="{armoryAction}" mechLabAction="{mechLabAction}" hqClasses="{hqClasses}" barracksClasses="{barracksClasses}" armoryClasses="{armoryClasses}" mechLabClasses="{mechLabClasses}" contextLabel="FLAGSHIP / MECH BAY / FABRICATION GANTRY" />

    <div id="mech-lab-room-bar" class="panel room-bar">
      <div id="mech-lab-room-name" class="label heading tone-edge">MECH LAB  //  FABRICATION GANTRY</div>
      <div id="mech-lab-summary" class="label tone-muted room-summary">{labSummary}</div>
    </div>

    <div id="mech-lab-body" class="lab-body">
      <div id="mech-asset-picker" class="{pickerClasses}">
        <div id="mech-picker-heading" class="picker-heading edge-surface">
          <div id="mech-picker-title-copy" class="picker-title-copy">
            <div id="mech-picker-title" class="label title-copy tone-accent">SELECT HEAVY ASSET</div>
            <div id="mech-picker-copy" class="label tone-muted">Choose a support lance and assigned chassis to open its gantry.</div>
          </div>
          <button id="mech-picker-close" class="compact-action" onclick="{closeAssetPicker}">BACK TO GANTRY</button>
        </div>
        <div id="mech-picker-body" class="picker-body">
          <div id="mech-picker-lances" class="picker-lances surface-dark">
            <div id="mech-squad-heading" class="section-title label heading tone-edge">SUPPORT LANCES</div>
            <div id="mech-squad-list" class="squad-list">
              <button each="squad in squadRows" key="{squad.id}" id="{squad.id}" class="{squad.classes}" onclick="{squad.select}">
                <div id="{squad.nameId}" class="label heading row-name">{squad.name}</div>
                <div id="{squad.statusId}" class="label tone-accent row-small">{squad.status}</div>
                <div id="{squad.strengthId}" class="label tone-muted row-small">{squad.strength}</div>
              </button>
            </div>
          </div>
          <div id="mech-picker-assets" class="picker-assets">
            <div id="mech-assets-heading" class="section-title label heading tone-edge">ASSIGNED HEAVY ASSETS</div>
            <div id="mech-list" class="mech-list">
              <button each="mech in mechRows" key="{mech.id}" id="{mech.id}" class="{mech.classes}" onclick="{mech.select}">
                <div id="{mech.nameId}" class="label heading mech-card-name tone-accent">{mech.name}</div>
                <div id="{mech.chassisId}" class="label tone-muted mech-card-line">{mech.chassis}</div>
                <div id="{mech.subsystemId}" class="label tone-edge mech-card-line">{mech.subsystem}</div>
                <div id="{mech.actionId}" class="label heading mech-card-action">OPEN GANTRY</div>
              </button>
            </div>
          </div>
        </div>
      </div>

      <div id="mech-fitting-workspace" class="{workspaceClasses}">
        <div id="mech-asset-strip" class="{fittingHeaderClasses}">
          <div id="mech-asset-strip-copy" class="asset-strip-copy">
            <div id="selected-mech-name" class="label asset-name tone-accent">{selectedMechName}</div>
            <div id="selected-mech-identity" class="label tone-muted asset-identity">{selectedMechIdentity}</div>
          </div>
          <div id="mech-gantry-navigator" class="gantry-navigator">
            <button id="mech-previous-gantry" class="gantry-step" onclick="{previousGantry}">‹ PREV</button>
            <div id="mech-active-gantry" class="label heading tone-accent gantry-position">{activeGantryLabel}</div>
            <button id="mech-next-gantry" class="gantry-step" onclick="{nextGantry}">NEXT ›</button>
          </div>
          <div id="selected-mech-doctrine" class="label heading tone-edge doctrine">{selectedMechDoctrine}</div>
          <button id="mech-change-asset" class="compact-action" onclick="{openAssetPicker}">BROWSE LANCE</button>
        </div>

        <div id="mech-performance-grid" class="{performanceClasses}">
          <div each="meter in performanceMeters" key="{meter.id}" id="{meter.id}" class="performance-meter surface-dark">
            <div id="{meter.labelId}" class="label heading tone-muted meter-label">{meter.label}</div>
            <div id="{meter.valueId}" class="label heading tone-edge meter-value">{meter.value}</div>
            <div id="{meter.trackId}" class="meter-track">
              <div id="{meter.fillId}" class="meter-fill" style="{meter.fillStyle}" />
            </div>
          </div>
        </div>

        <div id="mech-fitting-body" class="fitting-body">
          <div id="mech-component-catalog" class="{catalogClasses}">
            <div id="mech-catalog-kicker" class="section-title label heading tone-edge">EQUIPMENT / SELECTED SOCKET</div>
            <div id="mech-catalog-heading" class="label catalog-heading tone-accent">{selectedSlotTitle}</div>
            <div id="mech-catalog-copy" class="label tone-muted catalog-copy">{selectedSlotCopy}</div>
            <div id="mech-catalog-rule" class="label heading surface-dark catalog-rule">{selectedSlotRule}</div>
            <div id="mech-catalog-list" class="catalog-list">
              <div each="item in catalogRows" key="{item.id}" id="{item.id}" class="{item.classes}">
                <div id="{item.copyId}" class="catalog-item-copy">
                  <div id="{item.nameId}" class="label heading catalog-name">{item.name}</div>
                  <div id="{item.stockId}" class="label tone-edge catalog-stock">{item.stock}</div>
                  <div id="{item.detailId}" class="label tone-muted catalog-detail">{item.detail}</div>
                </div>
                <button id="{item.actionId}" class="catalog-action" disabled="{item.actionDisabled}" onclick="{item.action}">{item.actionLabel}</button>
              </div>
            </div>
            <div id="mech-drag-drop-note" class="surface-dark drag-drop-note">
              <div id="mech-drag-drop-title" class="label heading tone-edge">PLANNED: DRAG + SIZED SLOTS</div>
              <div id="mech-drag-drop-types" class="label heading tone-muted">BALLISTIC  ·  ENERGY  ·  MISSILE  ·  OMNI</div>
            </div>
          </div>

          <div id="mech-garage-stage" class="garage-stage">
            <div id="mech-garage-heading" class="garage-heading">
              <div id="mech-garage-title" class="label heading tone-edge">{garageTitle}</div>
              <div id="mech-garage-status" class="label heading tone-muted garage-status">CREW ACTIVE  ·  FABRICATORS STANDBY</div>
            </div>
            <canvas id="mech-doll-canvas" class="mech-doll-canvas" width="900" height="520" />
            <div id="mech-overview-rail" class="{overviewRailClasses}">
              <div id="mech-overview-gantries" class="overview-gantry-list">
                <button each="gantry in gantryRows" key="{gantry.id}" id="{gantry.id}" class="{gantry.classes}" disabled="{gantry.disabled}" onclick="{gantry.select}">
                  <div id="{gantry.stationId}" class="label heading tone-edge overview-station">{gantry.station}</div>
                  <div id="{gantry.nameId}" class="label heading overview-name">{gantry.name}</div>
                  <div id="{gantry.detailId}" class="label tone-muted overview-detail">{gantry.detail}</div>
                </button>
              </div>
              <button id="mech-overview-browse" class="overview-browse" onclick="{openAssetPicker}">BROWSE LANCES</button>
            </div>
          </div>

          <div id="mech-slot-rack" class="{slotRackClasses}">
            <div id="mech-slot-heading" class="section-title label heading tone-edge">FITTING LOCATIONS</div>
            <div id="mech-slot-copy" class="label tone-muted slot-copy">Select a socket to filter hardware.</div>
            <div id="mech-slot-list" class="slot-list">
              <button each="slot in slotRows" key="{slot.id}" id="{slot.id}" class="{slot.classes}" onclick="{slot.select}">
                <div id="{slot.nameId}" class="label heading tone-edge slot-name">{slot.name}</div>
                <div id="{slot.componentId}" class="label slot-component">{slot.component}</div>
                <div id="{slot.typeId}" class="label heading tone-muted slot-type">{slot.type}</div>
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div id="mech-lab-feedback" class="{feedbackClasses}">{feedbackText}</div>
  </div>
</template>

<style>
  .mech-lab-root { flex-direction: column; padding: 10px; gap: 7px; border-width: 2px; overflow: hidden; }
  .label { overflow: hidden; }
  .heading { font-family: heading; }
  .section-title { height: 19px; padding: 1px 3px; }
  .compact-action { width: 132px; height: 28px; text-align: center; }

  .room-bar { flex-direction: row; height: 34px; padding: 6px 8px; gap: 10px; }
  #mech-lab-room-name { width: 300px; }
  .room-summary { width: 0px; flex-grow: 1; text-align: right; }
  .lab-body { flex-direction: column; width: 100%; height: 0px; flex-grow: 1; overflow: hidden; }

  .asset-picker { flex-direction: column; width: 100%; height: 100%; padding: 8px; gap: 8px; overflow: hidden; }
  .picker-heading { flex-direction: row; height: 64px; padding: 8px; gap: 10px; }
  .picker-title-copy { flex-direction: column; width: 0px; flex-grow: 1; gap: 3px; }
  .title-copy { height: 27px; font-family: title; }
  .picker-body { flex-direction: row; width: 100%; height: 0px; flex-grow: 1; gap: 8px; overflow: hidden; }
  .picker-lances { flex-direction: column; width: 270px; padding: 8px; gap: 5px; }
  .squad-list { flex-direction: column; height: 0px; flex-grow: 1; gap: 5px; overflow: scroll; }
  .mech-squad-row { flex-direction: column; width: 100%; height: 66px; padding: 7px; gap: 2px; border-width: 1px; text-align: left; }
  .picker-assets { flex-direction: column; width: 0px; flex-grow: 1; padding: 8px; gap: 5px; overflow: hidden; }
  .mech-list { flex-direction: row; width: 100%; height: 0px; flex-grow: 1; gap: 8px; overflow: scroll; }
  .mech-row { flex-direction: column; width: 250px; height: 190px; padding: 10px; gap: 5px; border-width: 1px; text-align: left; }
  .mech-squad-row.selected, .mech-row.selected, .doll-slot.selected, .catalog-row.selected { background-color: #183b50; border-color: #ffd464; }
  .row-name { height: 18px; }
  .row-small { height: 16px; }
  .mech-card-name { height: 28px; font-family: title; }
  .mech-card-line { height: 20px; }
  .mech-card-action { height: 24px; padding-top: 3px; text-align: right; }

  .fitting-workspace { flex-direction: column; width: 100%; height: 100%; gap: 6px; overflow: hidden; }
  .asset-strip { flex-direction: row; height: 52px; padding: 6px 8px; gap: 8px; }
  .asset-strip-copy { flex-direction: row; width: 0px; flex-grow: 1; gap: 10px; }
  .asset-name { width: 210px; height: 27px; font-family: title; }
  .asset-identity { width: 0px; flex-grow: 1; padding-top: 5px; }
  .gantry-navigator { flex-direction: row; width: 380px; height: 38px; gap: 4px; }
  .gantry-step { width: 74px; height: 38px; padding: 6px; }
  .gantry-position { width: 0px; flex-grow: 1; height: 38px; padding: 8px 5px; text-align: center; background-color: #0c1620; border-width: 1px; }
  .doctrine { width: 145px; padding-top: 5px; text-align: right; }
  .performance-grid { flex-direction: row; height: 50px; gap: 5px; }
  .performance-meter { flex-direction: row; width: 0px; flex-grow: 1; padding: 5px; gap: 5px; border-width: 1px; }
  .meter-label { width: 90px; padding-top: 3px; }
  .meter-value { width: 96px; padding-top: 3px; text-align: right; }
  .meter-track { width: 0px; flex-grow: 1; height: 9px; padding-top: 4px; background-color: #0c1620; border-width: 1px; }
  .meter-fill { height: 100%; background-color: #76b9d4; }

  .fitting-body { flex-direction: row; width: 100%; height: 0px; flex-grow: 1; gap: 7px; overflow: hidden; }
  .catalog-panel { flex-direction: column; width: 305px; padding: 7px; gap: 5px; overflow: hidden; }
  .catalog-heading { height: 25px; font-family: title; }
  .catalog-copy { height: 34px; }
  .catalog-rule { height: 36px; padding: 5px; }
  .catalog-list { flex-direction: column; height: 0px; flex-grow: 1; gap: 5px; overflow: scroll; }
  .catalog-row { flex-direction: column; width: 100%; height: 108px; padding: 7px; gap: 3px; border-width: 1px; }
  .catalog-item-copy { flex-direction: column; width: 100%; height: 61px; gap: 2px; }
  .catalog-name { height: 19px; }
  .catalog-stock, .catalog-detail { height: 17px; }
  .catalog-action { width: 100%; height: 26px; text-align: center; }
  .drag-drop-note { flex-direction: column; height: 45px; padding: 5px; gap: 1px; }
  #mech-drag-drop-title, #mech-drag-drop-types { height: 17px; }

  .garage-stage { flex-direction: column; width: 0px; flex-grow: 1; padding: 5px; gap: 3px; border-width: 1px; overflow: hidden; }
  .garage-heading { flex-direction: row; width: 100%; height: 19px; padding: 0px 3px; }
  #mech-garage-title { width: 300px; }
  .garage-status { width: 0px; flex-grow: 1; text-align: right; }
  .mech-doll-canvas { width: 100%; height: 0px; flex-grow: 1; }
  .overview-rail { flex-direction: row; width: 100%; height: 76px; gap: 5px; }
  .overview-gantry-list { flex-direction: row; width: 0px; height: 76px; flex-grow: 1; gap: 5px; }
  .overview-gantry { flex-direction: column; width: 0px; height: 76px; flex-grow: 1; padding: 6px; gap: 1px; border-width: 1px; text-align: left; }
  .overview-gantry.occupied { background-color: #132c3d; border-color: #4c93b5; }
  .overview-gantry.occupied:hover { background-color: #1b435a; border-color: #ffd464; }
  .overview-gantry.vacant { background-color: #0c1620; border-color: #243849; opacity: 0.72; }
  .overview-station, .overview-name, .overview-detail { height: 18px; }
  .overview-browse { width: 142px; height: 76px; padding: 7px; text-align: center; }

  .slot-panel { flex-direction: column; width: 245px; padding: 7px; gap: 5px; overflow: hidden; }
  .slot-copy { height: 34px; }
  .slot-list { flex-direction: column; height: 0px; flex-grow: 1; gap: 4px; overflow: scroll; }
  .doll-slot { flex-direction: column; width: 100%; height: 61px; padding: 5px; gap: 1px; border-width: 1px; text-align: left; }
  .slot-name, .slot-type { height: 16px; }
  .slot-component { height: 17px; }
  .mech-lab-feedback { height: 29px; padding: 6px 9px; border-width: 1px; overflow: hidden; }
  .hidden { width: 0px; height: 0px; padding: 0px; gap: 0px; border-width: 0px; overflow: hidden; opacity: 0; }
</style>
