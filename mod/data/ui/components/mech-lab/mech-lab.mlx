<template props="repair,lessonClasses,lessonTitle,lessonCopy,lessonActionLabel,lessonAction,lessonPause,lessonResumeClasses,lessonResume,contextLabel,activeBayLabel,bayNavigatorClasses,previousBay,nextBay,labSummary,squadRows,mechRows,gantryRows,garageTitle,garageStatus,dragNoteTitle,dragNoteCopy,scrapLabel,scrapClasses,scrapAction,buildPanelClasses,buildName,buildKind,buildLore,buildCredit,buildCrest,buildCrestClasses,buildStats,buildMaterials,buildLabel,buildDisabled,buildAction,performanceMeters,budgetText,budgetClasses,shipRefitText,platingText,platingClasses,selectPlating,leftSlotRows,rightSlotRows,slotRows,selectedSlotTitle,selectedSlotCopy,selectedSlotRule,catalogRows,pickerClasses,workspaceClasses,fittingHeaderClasses,backToLance,performanceClasses,catalogClasses,slotRackClasses,overviewRailClasses,openAssetPicker,closeAssetPicker,materialStock,categoryFilterPills,categoryFilterClasses,allPartsClasses,showAllParts,returnAction,hqAction,barracksAction,armoryAction,mechLabAction,boatsAction,engineeringAction,hqClasses,barracksClasses,armoryClasses,mechLabClasses,engineeringClasses,boatsClasses">
  <div id="mech-lab-root" class="mech-lab-root">
    <marine-ops-page-nav returnAction="{returnAction}" hqAction="{hqAction}" barracksAction="{barracksAction}" armoryAction="{armoryAction}" mechLabAction="{mechLabAction}" boatsAction="{boatsAction}" engineeringAction="{engineeringAction}" engineeringClasses="{engineeringClasses}" hqClasses="{hqClasses}" barracksClasses="{barracksClasses}" armoryClasses="{armoryClasses}" mechLabClasses="{mechLabClasses}" boatsClasses="{boatsClasses}" contextLabel="{contextLabel}" />
    <div id="mech-lab-room-bar" class="panel room-bar">
      <img id="mech-lab-service-plate" class="workshop-service-plate" src="graphics/ui/console/service-plate.svg" />
      <div id="mech-lab-room-name" class="label heading tone-edge">{i18n.openingUiMechLabMechLabFabricationGantry}</div>
      <div id="mech-bay-navigator" class="{bayNavigatorClasses}">
        <button id="mech-previous-bay" class="bay-step console-action" onclick="{previousBay}">‹</button>
        <div id="mech-active-bay" class="label heading tone-accent bay-position">{activeBayLabel}</div>
        <button id="mech-next-bay" class="bay-step console-action" onclick="{nextBay}">›</button>
      </div>

      <button id="castle-lesson-resume" class="{lessonResumeClasses}" onclick="{lessonResume}">{i18n.openingUiMechLabCastleSGuide}</button>
      <div id="mech-lab-summary" class="label tone-muted room-summary">{labSummary}</div>
      <div id="mech-lab-stock-slot" class="header-stock-slot">
        <company-resource-stock stockId="mech-material-stock" rows="{materialStock}" />
      </div>
    </div>

    <div id="mech-lab-body" class="lab-body">
      <div id="mech-asset-picker" class="{pickerClasses}">
        <div id="mech-picker-heading" class="picker-heading surface-dark">
          <div id="mech-picker-title-copy" class="picker-title-copy">
            <div id="mech-picker-title" class="label title-copy tone-accent">{i18n.openingUiMechLabSelectHeavyAsset}</div>
            <div id="mech-picker-copy" class="label tone-muted">{i18n.openingUiMechLabChooseASupportLanceAndAssignedChassis}</div>
          </div>
          <button id="mech-picker-close" class="compact-action console-action" onclick="{closeAssetPicker}">{i18n.openingUiMechLabBackToGantry}</button>
        </div>
        <div id="mech-picker-body" class="picker-body">
          <div id="mech-picker-lances" class="picker-lances surface-dark">
            <div id="mech-squad-heading" class="section-title label heading tone-edge">{i18n.openingUiMechLabSupportLances}</div>
            <div id="mech-squad-list" class="squad-list">
              <button each="squad in squadRows" key="{squad.id}" id="{squad.id}" class="{squad.classes}" onclick="{squad.select}">
                <div id="{squad.nameId}" class="label heading row-name">{squad.name}</div>
                <div id="{squad.statusId}" class="label tone-accent row-small">{squad.status}</div>
                <div id="{squad.strengthId}" class="label tone-muted row-small">{squad.strength}</div>
                <div id="{squad.slotsId}" class="squad-slots">
                  <canvas each="slot in squad.slots" key="{slot.id}" id="{slot.id}" class="squad-slot" width="112" height="112" />
                </div>
              </button>
            </div>
          </div>
          <div id="mech-picker-assets" class="picker-assets">
            <div id="mech-assets-heading" class="section-title label heading tone-edge">{i18n.openingUiMechLabAssignedHeavyAssets}</div>
            <div id="mech-list" class="mech-list">
              <button each="mech in mechRows" key="{mech.id}" id="{mech.id}" class="{mech.classes}" onclick="{mech.select}">
                <canvas id="{mech.previewId}" class="mech-card-preview" width="180" height="200" />
                <div id="{mech.copyId}" class="mech-card-copy">
                  <div id="{mech.padId}" class="label heading tone-edge mech-card-pad">{mech.pad}</div>
                  <div id="{mech.nameId}" class="label heading mech-card-name tone-accent">{mech.name}</div>
                  <div id="{mech.chassisId}" class="label tone-muted mech-card-line">{mech.chassis}</div>
                  <div id="{mech.subsystemId}" class="label tone-edge mech-card-line">{mech.subsystem}</div>
                  <div id="{mech.actionId}" class="{mech.statusClasses}">{mech.status}</div>
                </div>
              </button>
            </div>
          </div>
        </div>
      </div>

      <div id="mech-fitting-workspace" class="{workspaceClasses}">
          <div id="mech-fitting-body" class="fitting-body">
            <div id="mech-component-catalog" class="{catalogClasses}">
              <div id="mech-catalog-kicker-row" class="catalog-kicker-row">
                <div id="mech-catalog-kicker" class="section-title label heading tone-edge catalog-kicker">{i18n.openingUiMechLabStoresSelectedMount}</div>
                <button id="mech-catalog-all-parts" class="{allPartsClasses}" onclick="{showAllParts}">{i18n.openingMechLabAllPartsButton}</button>
              </div>
              <div id="mech-catalog-heading" class="label catalog-heading tone-accent">{selectedSlotTitle}</div>
              <div id="mech-catalog-copy" class="label tone-muted catalog-copy">{selectedSlotCopy}</div>
              <div id="mech-catalog-rule" class="label heading surface-dark catalog-rule">{selectedSlotRule}</div>
              <div id="mech-category-filters" class="{categoryFilterClasses}">
                <button each="pill in categoryFilterPills" key="{pill.id}" id="{pill.id}" class="{pill.classes}" onclick="{pill.select}">
                  <div id="{pill.chipId}" class="{pill.chipClasses}" style="{pill.chipStyle}">
                    <img id="{pill.iconId}" class="{pill.iconClasses}" src="{pill.icon}" />
                  </div>
                  <div id="{pill.textId}" class="{pill.textClasses}">{pill.text}</div>
                </button>
              </div>
              <div id="mech-catalog-list" class="catalog-list">
                <div each="item in catalogRows" key="{item.id}" id="{item.id}" class="{item.classes}" style="{item.cardStyle}">
                  <div id="{item.bodyId}" class="catalog-card-body">
                    <canvas id="{item.previewId}" class="{item.previewClasses}" width="220" height="280" />
                    <div id="{item.copyId}" class="catalog-item-copy">
                      <div id="{item.headerId}" class="catalog-card-header">
                        <div id="{item.nameId}" class="label heading catalog-name">{item.name}</div>
                        <div id="{item.badgeId}" class="{item.badgeClasses}">{item.badge}</div>
                      </div>
                      <div id="{item.stockId}" class="label tone-edge catalog-stock">{item.stock}</div>
                      <div id="{item.telemetryId}" class="label heading tone-muted catalog-telemetry">{item.telemetry}</div>
                      <div id="{item.deltaId}" class="{item.deltaClasses}">{item.delta}</div>
                      <div id="{item.detailId}" class="label tone-muted catalog-detail">{item.detail}</div>
                    </div>
                  </div>
                  <!-- The build strip: what a spare costs, and a wide BUY (or FIT) beside it, so
                       the part's own lines keep the whole width of the card. -->
                  <div id="{item.footerId}" class="{item.footerClasses}">
                    <div id="{item.materialsId}" class="{item.materialsClasses}">
                      <div each="material in item.materials" key="{material.id}" id="{material.id}" class="{material.chipClasses}">
                        <img id="{material.iconId}" class="material-chip-icon" src="{material.icon}" />
                        <div id="{material.labelId}" class="label material-chip-value">{material.required}</div>
                      </div>
                    </div>
                    <button id="{item.actionId}" class="{item.actionClasses}" disabled="{item.actionDisabled}" onclick="{item.action}">
                      <img id="{item.actionIconId}" class="{item.actionIconClasses}" src="graphics/ui/mech-hardware/fab.svg" />
                      <div id="{item.actionTextId}" class="label heading catalog-fab-text">{item.actionText}</div>
                    </button>
                  </div>
                </div>
              </div>
              <div id="mech-drag-drop-note" class="surface-dark drag-drop-note">
                <div id="mech-drag-drop-title" class="label heading tone-edge">{dragNoteTitle}</div>
                <div id="mech-drag-drop-types" class="label tone-muted">{dragNoteCopy}</div>
              </div>
            </div>

            <div id="mech-garage-stage" class="garage-stage">
              <div id="mech-garage-heading" class="garage-heading">
                <button id="mech-back-to-lance" class="{fittingHeaderClasses}" onclick="{backToLance}">{i18n.openingUiMechLabBackToLance}</button>
                <div id="mech-garage-title" class="label heading tone-edge">{garageTitle}</div>
                <div id="mech-garage-status" class="label heading tone-muted garage-status">{garageStatus}</div>
                <button id="mech-scrap" class="{scrapClasses}" onclick="{scrapAction}">{scrapLabel}</button>
              </div>
              <canvas id="mech-doll-canvas" class="mech-doll-canvas" width="1060" height="790" />
              <div id="mech-overview-rail" class="{overviewRailClasses}">
                <div id="mech-overview-gantries" class="overview-gantry-list">
                  <button each="gantry in gantryRows" key="{gantry.id}" id="{gantry.id}" class="{gantry.classes}" disabled="{gantry.disabled}" onclick="{gantry.select}">
                    <div id="{gantry.stationId}" class="label heading tone-edge overview-station">{gantry.station}</div>
                    <div id="{gantry.nameId}" class="label heading overview-name">{gantry.name}</div>
                    <div id="{gantry.detailId}" class="{gantry.detailClasses}">{gantry.detail}</div>
                  </button>
                </div>
                <button id="mech-overview-browse" class="overview-browse console-action" onclick="{openAssetPicker}">{i18n.openingUiMechLabBrowseLances}</button>
              </div>
            </div>

            <div id="mech-build-panel" class="{buildPanelClasses}">
              <div id="mech-build-card" class="surface-dark build-card">
                <div id="mech-build-kicker" class="section-title label heading tone-edge">{i18n.openingMechLabPatternTitle}</div>
                <div id="mech-build-header" class="build-header">
                  <img id="mech-build-crest" class="{buildCrestClasses}" src="{buildCrest}" />
                  <div id="mech-build-title" class="build-title">
                    <div id="mech-build-name" class="label catalog-heading tone-accent">{buildName}</div>
                    <div id="mech-build-credit" class="label tone-edge build-credit">{buildCredit}</div>
                  </div>
                </div>
                <div id="mech-build-kind" class="label heading tone-edge build-kind">{buildKind}</div>
                <div id="mech-build-stats" class="label heading tone-accent build-kind">{buildStats}</div>
                <div id="mech-build-lore" class="label build-lore">{buildLore}</div>
              </div>
              <div id="mech-build-materials" class="material-costs build-materials">
                <div each="material in buildMaterials" key="{material.id}" id="{material.id}" class="{material.chipClasses}">
                  <img id="{material.iconId}" class="material-chip-icon" src="{material.icon}" />
                  <div id="{material.labelId}" class="label material-chip-value">{material.required}</div>
                </div>
              </div>
              <button id="mech-build-action" class="build-action console-action" disabled="{buildDisabled}" onclick="{buildAction}">{buildLabel}</button>
            </div>

            <div id="mech-slot-rack" class="{slotRackClasses}">
              <div id="mech-performance-card" class="performance-card surface-dark">
                <div id="mech-specs-header" class="specs-header">
                  <div id="mech-specs-title" class="section-title label heading tone-edge">{i18n.openingUiMechLabSpecifications}</div>
                  <div id="mech-specs-doctrine" class="label heading tone-edge specs-doctrine">{shipRefitText}</div>
                </div>
                <div id="mech-budget" class="{budgetClasses}">{budgetText}</div>
                <div id="mech-performance-grid" class="{performanceClasses}">
                  <div each="meter in performanceMeters" key="{meter.id}" id="{meter.id}" class="performance-meter">
                    <div id="{meter.labelId}" class="label heading tone-muted meter-label">{meter.label}</div>
                    <div id="{meter.trackId}" class="meter-track">
                      <div id="{meter.fillId}" class="meter-fill" style="{meter.fillStyle}" />
                      <div id="{meter.gainId}" class="{meter.gainClasses}" style="{meter.gainStyle}" />
                      <div id="{meter.deficitId}" class="{meter.deficitClasses}" style="{meter.deficitStyle}" />
                      <div id="{meter.stockId}" class="{meter.stockClasses}" style="{meter.stockStyle}" />
                      <div id="{meter.ghostId}" class="{meter.ghostClasses}" style="{meter.ghostStyle}" />
                    </div>
                    <div id="{meter.valueId}" class="label heading tone-edge meter-value">{meter.value}</div>
                  </div>
                </div>
                <button id="mech-plating-select" class="{platingClasses}" onclick="{selectPlating}">{platingText}</button>
              </div>
              <div id="mech-repair-card" class="{repair.classes}" style="{repair.style}">
                <div id="mech-repair-status" class="{repair.statusClasses}">{repair.status}</div>
                <div id="mech-repair-order" class="{repair.orderClasses}">
                  <div id="mech-repair-title" class="label heading tone-edge mech-repair-title">{i18n.mechLabRepairTitle}</div>
                  <div id="mech-repair-sections" class="label tone-muted mech-repair-sections">{repair.sections}</div>
                  <div id="mech-repair-days" class="label tone-edge mech-repair-days">{repair.order}</div>
                  <div id="mech-repair-costs" class="mech-repair-costs">
                    <company-resource-cost each="material in repair.materials" key="{material.id}" row="{material}" />
                  </div>
                  <button id="mech-repair-action" class="mech-repair-action console-action" onclick="{repair.action}">{i18n.mechLabRepairAction}</button>
                </div>
              </div>
              <div id="mech-slot-heading" class="section-title label heading tone-edge">{i18n.openingUiMechLabFittingLocations}</div>
              <div id="mech-slot-copy" class="label tone-muted slot-copy">{i18n.openingUiMechLabSelectASocketToFilterHardware}</div>
              <div id="mech-slot-list" class="slot-list">
                <div each="slot in slotRows" key="{slot.id}" id="{slot.id}" class="{slot.classes}">
                  <div id="{slot.contentId}" class="slot-row-content">
                    <button id="{slot.buttonId}" class="slot-select-button" onclick="{slot.select}">
                      <div id="{slot.copyId}" class="slot-row-copy">
                        <div id="{slot.headerId}" class="slot-row-header">
                          <div id="{slot.nameId}" class="label heading tone-edge slot-name">{slot.name}</div>
                        </div>
                        <div id="{slot.componentId}" class="label slot-component">{slot.component}</div>
                        <div id="{slot.telemetryId}" class="label heading tone-muted slot-telemetry">{slot.telemetry}</div>
                        <div id="{slot.typeId}" class="label heading tone-muted slot-type">{slot.type}</div>
                      </div>
                      <div id="{slot.hardwareId}" class="slot-hardware">
                        <div id="{slot.badgeId}" class="{slot.badgeClasses}">{slot.badge}</div>
                        <canvas id="{slot.gridId}" class="slot-grid" width="180" height="112" />
                      </div>
                    </button>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <canvas id="mech-drag-ghost" class="mech-drag-ghost" width="1920" height="1080" />

    </div>
</template>

<style>
  .header-stock-slot { flex-direction: column; width: 640px; height: 46px; }
  .mech-lab-root { flex-direction: column; padding: 10px; gap: 7px; border-width: 2px; overflow: hidden; }
  .label { overflow: hidden; }
  .heading { font-family: heading; }
  .section-title { height: 16px; padding: 2px 0px; }
  .compact-action { width: 132px; height: 28px; padding: 0px 5px; font-family: heading; text-align: center; }

  .lesson-backdrop { position: absolute; left: 0px; top: 0px; width: 100%; height: 100%; flex-direction: column; align-items: center; background-color: #080e12c9; overflow: scroll; }
  .lesson-backdrop-hidden { position: absolute; width: 0px; height: 0px; overflow: hidden; opacity: 0; pointer-events: none; }
  .lesson-space { height: 0px; flex-grow: 1; }
  .castle-dialog { flex-direction: column; width: 820px; height: 290px; padding: 18px; gap: 10px; border-width: 2px; border-color: #dfc588; background-color: #202d28; }
  .castle-lesson-title { height: 24px; }
  .castle-dialogue { flex-direction: row; height: 176px; gap: 18px; }
  .castle-portrait { width: 176px; height: 176px; border-width: 2px; border-color: #8a967f; pointer-events: none; }
  .castle-lesson-text { width: 0px; flex-grow: 1; height: 176px; white-space: normal; overflow: scroll; }
  .castle-controls { flex-direction: row; align-items: center; height: 30px; gap: 10px; }
  .lesson-action { width: 148px; height: 28px; font-family: heading; text-align: center; }
  .lesson-key-hint { width: 0px; flex-grow: 1; height: 30px; white-space: normal; }
  .room-bar { flex-direction: row; align-items: center; height: 54px; padding: 4px 8px; gap: 10px; }
  #mech-lab-room-name { width: 300px; height: 16px; }
  .bay-navigator { flex-direction: row; align-items: center; width: 205px; height: 24px; gap: 3px; }
  .bay-step { width: 32px; height: 24px; padding: 2px; }
  .bay-position { width: 0px; height: 24px; flex-grow: 1; padding: 4px; text-align: center; border-width: 1px; }
  .room-summary { height: 16px; width: 0px; flex-grow: 1; text-align: right; }
  .lab-body { flex-direction: column; width: 100%; height: 0px; flex-grow: 1; overflow: hidden; }

  .asset-picker { flex-direction: column; width: 100%; height: 100%; padding: 8px; gap: 8px; overflow: hidden; }
  .picker-heading { flex-direction: row; align-items: center; height: 64px; padding: 8px; gap: 10px; }
  .picker-title-copy { flex-direction: column; height: 48px; width: 0px; flex-grow: 1; gap: 3px; }
  .title-copy { height: 27px; font-family: title; }
  .picker-body { flex-direction: row; width: 100%; height: 0px; flex-grow: 1; gap: 8px; overflow: hidden; }
  .picker-lances { flex-direction: column; width: 270px; padding: 8px; gap: 5px; }
  .squad-list { flex-direction: column; height: 0px; flex-grow: 1; gap: 5px; overflow: scroll; }
  .mech-squad-row { flex-direction: column; width: 100%; height: 124px; padding: 7px; gap: 2px; border-width: 1px; text-align: left; }
  .squad-slots { flex-direction: row; width: 100%; height: 56px; gap: 4px; padding-top: 2px; }
  .squad-slot { width: 56px; height: 56px; border-width: 1px; border-color: #3a4442; }
  .picker-assets { flex-direction: column; width: 0px; flex-grow: 1; padding: 8px; gap: 5px; overflow: hidden; }
  .mech-list { flex-direction: row; align-items: start; width: 100%; height: 0px; flex-grow: 1; gap: 8px; overflow: scroll; }
  .mech-row { flex-direction: row; width: 360px; height: 120px; padding: 8px; gap: 10px; border-width: 1px; text-align: left; }
  .mech-row.vacant { border-color: #6a5a30; }
  .mech-card-preview { width: 90px; height: 100px; border-width: 1px; border-color: #3a4442; }
  .mech-card-copy { flex-direction: column; width: 0px; flex-grow: 1; gap: 3px; }
  .mech-card-pad { height: 16px; }
  .mech-squad-row.selected, .mech-row.selected, .doll-slot.selected, .catalog-row.selected { background-color: #2a3632; border-color: #dfc588; }
  .row-name { height: 18px; }
  .row-small { height: 16px; }
  .mech-card-name { height: 22px; white-space: normal; font-family: title; }
  .mech-card-line { height: 20px; }
  .mech-card-action { height: 20px; padding-top: 0px; text-align: right; }

  .fitting-workspace { flex-direction: column; width: 100%; height: 100%; gap: 6px; overflow: hidden; }
  .performance-card { flex-direction: column; width: 100%; height: 232px; padding: 5px 6px; gap: 3px; border-width: 1px; }
  .specs-header { flex-direction: row; align-items: center; width: 100%; height: 16px; }
  .specs-doctrine { width: 0px; flex-grow: 1; height: 16px; text-align: right; }
  .mech-budget { width: 100%; height: 16px; padding: 1px 2px; }
  .performance-grid { flex-direction: column; width: 100%; height: 156px; gap: 1px; }
  .performance-meter { flex-direction: row; align-items: center; width: 100%; height: 25px; padding: 0px 2px; gap: 4px; }
  .meter-label { width: 94px; height: 16px; }
  .meter-value { width: 120px; height: 16px; text-align: right; }
  .plating-select { width: 100%; height: 24px; padding: 2px 6px; font-family: heading; text-align: left; border-width: 1px; }
  .plating-select.selected { background-color: #2a3632; border-color: #dfc588; }
  .meter-track { flex-direction: row; width: 0px; flex-grow: 1; height: 10px; padding: 0px; background-color: #121719; border-width: 1px; }
  .meter-fill { position: absolute; top: 0px; height: 100%; background-color: #acae96; }
  .meter-gain { position: absolute; top: 0px; height: 100%; }
  .meter-deficit { position: absolute; top: 0px; height: 100%; background-color: #5a2424; }
  .meter-stock { position: absolute; top: 0px; width: 2px; height: 100%; background-color: #e8e4cc; }
  .meter-ghost { position: absolute; top: 0px; height: 100%; }
  .meter-ghost.gain { background-color: #f2f0dc; opacity: 0.55; }
  .meter-ghost.loss { background-color: #ff5a4a; opacity: 0.75; }

  .fitting-body { flex-direction: row; width: 100%; height: 0px; flex-grow: 1; gap: 7px; overflow: hidden; }
  .catalog-panel { flex-direction: column; width: 410px; padding: 7px; gap: 5px; border-width: 1px; overflow: hidden; }
  .catalog-heading { height: 25px; font-family: title; }
  .catalog-copy { height: 32px; white-space: normal; }
  .catalog-rule { height: 16px; padding: 7px 5px; }
  .category-filters { flex-direction: row; align-items: center; width: 100%; height: 34px; gap: 3px; }
  .catalog-filter-pill { flex-direction: column; align-items: center; width: 0px; flex-grow: 1; height: 32px; padding: 2px 2px; font-family: heading; text-align: center; background-color: #121719; border-width: 1px; border-color: #596052; }
  .catalog-filter-chip { flex-direction: column; align-items: center; width: 40px; height: 26px; padding: 1px 0px; opacity: 0.55; pointer-events: none; }
  .catalog-filter-pill:hover .catalog-filter-chip { opacity: 0.8; }
  .catalog-filter-pill.selected .catalog-filter-chip { opacity: 1; }
  .catalog-filter-icon { width: 24px; height: 24px; pointer-events: none; }
  .catalog-filter-text { width: 100%; height: 16px; text-align: center; pointer-events: none; }
  .catalog-kicker-row { flex-direction: row; align-items: center; width: 100%; height: 20px; gap: 6px; }
  .catalog-kicker { width: 0px; flex-grow: 1; }
  .catalog-all-parts { width: 96px; height: 20px; padding: 2px 6px; font-family: heading; text-align: center; }
  .catalog-filter-pill.selected { background-color: #343a30; border-color: #d3d0c5; color: #d3d0c5; }
  .catalog-filter-pill:hover { background-color: #34382e; border-color: #dfc588; }
  /* The parts list is a well sunk into the gunmetal column, as dark as the doll panel, and
     its cards sit just proud of it, so the stores read as depth rather than one flat plate. */
  .catalog-list { flex-direction: column; height: 0px; flex-grow: 1; gap: 4px; padding: 4px; overflow: scroll; background-color: #0d1214; border-width: 1px; border-color: #050809; }
  .catalog-row { flex-direction: column; align-items: start; width: 100%; height: 128px; padding: 5px; gap: 3px; border-width: 1px; }
  .catalog-card-body { flex-direction: row; align-items: center; width: 100%; height: 90px; gap: 6px; }
  .catalog-item-copy { flex-direction: column; width: 0px; height: 90px; flex-grow: 1; gap: 2px; }
  .catalog-card-header { flex-direction: row; align-items: center; width: 100%; height: 18px; gap: 4px; }
  .catalog-name { width: 0px; flex-grow: 1; height: 16px; }
  .catalog-badge { width: 84px; height: 14px; padding: 2px 3px; text-align: center; border-width: 1px; }
  .catalog-badge.in-cargo { background-color: #102d20; border-color: #52ba7c; color: #78d494; }
  .catalog-badge.fabrication { background-color: #241e12; border-color: #8c6a28; color: #dfc588; }
  .catalog-badge.unavailable { background-color: #20241f; border-color: #596052; color: #979c90; }
  .catalog-badge.chassis { background-color: #292e27; border-color: #818574; color: #d3d0c5; }
  .catalog-preview { width: 76px; height: 90px; border-width: 1px; }
  .catalog-stock, .catalog-detail { height: 16px; }
  .catalog-telemetry { height: 16px; }
  .catalog-delta { height: 16px; }
  .catalog-delta.positive { color: #78d494; }
  .catalog-delta.negative { color: #e98b83; }
  .catalog-delta.neutral { color: #979c90; }
  .catalog-card-footer { flex-direction: row; align-items: center; width: 100%; height: 24px; gap: 4px; }
  .material-costs { flex-direction: row; align-items: center; width: 0px; flex-grow: 1; height: 24px; gap: 3px; overflow: hidden; }
  .material-chip { flex-direction: row; align-items: center; width: 0px; flex-grow: 1; height: 22px; padding: 1px 4px; gap: 4px; border-width: 1px; border-color: #46554b; background-color: #121719; }
  .material-chip.short { border-color: #a05d52; background-color: #251419; }
  .material-chip-icon { width: 16px; height: 16px; }
  .material-chip-value { width: 0px; flex-grow: 1; height: 16px; text-align: right; color: #dfc588; }
  .material-chip.short .material-chip-value { color: #eea296; }
  .catalog-row.requires-fabrication, .catalog-row.chassis-pattern { height: 140px; }
  .catalog-row { background-color: #172023; border-color: #2a3437; }
  .catalog-row.selected { background-color: #2a3632; border-color: #dfc588; }
  /* No spare in stores (a pattern to build): the card and its picture fade into the well, the words do not. */
  .catalog-row.requires-fabrication { background-color: #17202366; border-color: #2a343770; }
  .catalog-row.requires-fabrication .catalog-preview { opacity: 0.45; }
  .material-cost { flex-direction: row; align-items: center; width: 0px; flex-grow: 1; height: 20px; padding: 1px 4px; gap: 5px; background-color: #121719; border-width: 1px; }
  .material-stock-strip { flex-direction: row; align-items: center; width: 380px; height: 24px; gap: 6px; }
