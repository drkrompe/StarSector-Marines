<template props="slot">
  <div id="{slot.id}" class="{slot.classes}">
    <div id="{slot.contentId}" class="slot-row-content">
      <button id="{slot.buttonId}" class="slot-select-button" onclick="{slot.select}">
        <div id="{slot.copyId}" class="slot-row-copy">
          <div id="{slot.headerId}" class="slot-row-header">
            <div id="{slot.nameId}" class="label heading tone-edge slot-name">{slot.name}</div>
          </div>
          <div id="{slot.componentId}" class="label slot-component">{slot.component}</div>
          <div id="{slot.telemetryId}" class="label heading tone-muted slot-telemetry">{slot.telemetry}</div>
          <div id="{slot.typeId}" class="label heading tone-muted slot-type">{slot.type}</div>
        </div>
        <div id="{slot.hardwareId}" class="slot-hardware">
          <div id="{slot.badgeId}" class="{slot.badgeClasses}">{slot.badge}</div>
          <canvas id="{slot.gridId}" class="slot-grid" width="180" height="112" />
        </div>
      </button>
    </div>
  </div>
</template>
<style>
  .doll-slot { flex-direction: row; width: 100%; height: 86px; padding: 3px; gap: 3px; border-width: 1px; text-align: left; }
  .doll-slot.selected { background-color: #2a3632; border-color: #dfc588; }
  .slot-row-content { flex-direction: row; align-items: center; width: 100%; height: 100%; gap: 3px; }
  .slot-select-button { flex-direction: row; align-items: center; width: 0px; flex-grow: 1; height: 100%; padding: 2px; gap: 4px; border-width: 0px; background-color: transparent; text-align: left; }
  .slot-row-copy { flex-direction: column; width: 0px; height: 70px; flex-grow: 1; gap: 2px; }
  .slot-row-header { flex-direction: row; align-items: center; width: 100%; height: 16px; gap: 3px; }
  .slot-name { width: 0px; flex-grow: 1; height: 16px; }
  .slot-badge { width: 54px; height: 14px; padding: 1px 2px; text-align: center; border-width: 1px; }
  .slot-badge.armed { background-color: #292e27; border-color: #818574; color: #d3d0c5; }
  .slot-badge.empty { background-color: #2c2014; border-color: #946830; color: #dfc588; }
  .slot-badge.locked { background-color: #20241f; border-color: #4b5446; color: #8d9687; }
  .slot-badge.required { width: 70px; background-color: #3a1212; border-color: #e98b83; color: #ffb3aa; }
  .slot-telemetry { font-family: body; height: 15px; }
  .slot-component { height: 16px; }
  .slot-type { height: 15px; }
  .slot-hardware { flex-direction: column; align-items: center; width: 62px; height: 66px; gap: 4px; }
  .slot-grid { width: 58px; height: 44px; border-width: 1px; }
  /* A page's own rules do not reach inside a component, so each carries the utilities it uses. */
  .label { overflow: hidden; }
  .heading { font-family: heading; }
  .hidden { width: 0px; height: 0px; padding: 0px; gap: 0px; border-width: 0px; overflow: hidden; opacity: 0; }
</style>
