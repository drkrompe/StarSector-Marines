<template props="pill">
  <button id="{pill.id}" class="{pill.classes}" onclick="{pill.select}">
    <div id="{pill.chipId}" class="{pill.chipClasses}" style="{pill.chipStyle}">
      <img id="{pill.iconId}" class="{pill.iconClasses}" src="{pill.icon}" />
    </div>
    <div id="{pill.textId}" class="{pill.textClasses}">{pill.text}</div>
  </button>
</template>
<style>
  .catalog-filter-pill { flex-direction: column; align-items: center; width: 0px; flex-grow: 1; height: 32px; padding: 2px 2px; font-family: heading; text-align: center; background-color: #121719; border-width: 1px; border-color: #596052; }
  .catalog-filter-chip { flex-direction: column; align-items: center; width: 40px; height: 26px; padding: 1px 0px; opacity: 0.55; pointer-events: none; }
  .catalog-filter-pill:hover .catalog-filter-chip { opacity: 0.8; }
  .catalog-filter-pill.selected .catalog-filter-chip { opacity: 1; }
  .catalog-filter-icon { width: 24px; height: 24px; pointer-events: none; }
  .catalog-filter-text { width: 100%; height: 16px; text-align: center; pointer-events: none; }
  .catalog-filter-pill.selected { background-color: #343a30; border-color: #d3d0c5; color: #d3d0c5; }
  /* A tier pill's chip is the same chip a loadout card wears (armory-loadout-card), at full colour and
     true proportion, so the two read as one symbol; the pill's frame says which tier is chosen. */
  .tier-pill .catalog-filter-chip { opacity: 1; }
  .tier-pill .catalog-filter-icon { width: 36px; height: 24px; }
  .catalog-filter-pill:hover { background-color: #34382e; border-color: #dfc588; }
  /* A page's own rules do not reach inside a component, so each carries the utilities it uses. */
  .label { overflow: hidden; }
  .heading { font-family: heading; }
  .hidden { width: 0px; height: 0px; padding: 0px; gap: 0px; border-width: 0px; overflow: hidden; opacity: 0; }
</style>
