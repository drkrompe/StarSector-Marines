<template props="filterPills,filterClasses,backClasses,catalogClasses,stageTitle,stageStatus,recovery,fabricationActionLabel,bayNoteClasses,contextLabel,activeBayLabel,bayNavigatorClasses,previousBay,nextBay,deckSummary,materialStock,boatRows,selectedBoatName,selectedBoatIdentity,performanceMeters,readinessRows,selectedSlotTitle,selectedSlotCopy,catalogRows,overviewClasses,fittingClasses,fabricationClasses,fabricationBerthLabel,fabricationPatternName,fabricationCopy,fabricationMaterials,fabricationActionClasses,fabricationBlocked,fabricationReason,fabricate,backToDeck,feedbackText,feedbackClasses,scrapLabel,scrapClasses,scrapAction,storeLabel,storeClasses,storeAction,reserveClasses,reserveTitle,reserveRows,returnAction,hqAction,barracksAction,armoryAction,mechLabAction,boatsAction,engineeringAction,hqClasses,barracksClasses,armoryClasses,mechLabClasses,engineeringClasses,boatsClasses,shopAction,shopClasses">
  <div id="boat-deck-root" class="boat-deck-root">
    <marine-ops-page-nav returnAction="{returnAction}" hqAction="{hqAction}" barracksAction="{barracksAction}" armoryAction="{armoryAction}" mechLabAction="{mechLabAction}" boatsAction="{boatsAction}" engineeringAction="{engineeringAction}" shopAction="{shopAction}" shopClasses="{shopClasses}" engineeringClasses="{engineeringClasses}" hqClasses="{hqClasses}" barracksClasses="{barracksClasses}" armoryClasses="{armoryClasses}" mechLabClasses="{mechLabClasses}" boatsClasses="{boatsClasses}" contextLabel="{contextLabel}" />
    <div id="boat-deck-room-bar" class="panel room-bar">
      <img id="boat-deck-service-plate" class="workshop-service-plate" src="graphics/ui/console/service-plate.svg" />
      <div id="boat-deck-room-name" class="label heading tone-edge">{i18n.openingUiBoatDeckBoatDeckHangar}</div>
      <div id="boat-bay-navigator" class="{bayNavigatorClasses}">
        <button id="boat-previous-bay" class="bay-step console-action" onclick="{previousBay}">‹</button>
        <div id="boat-active-bay" class="label heading tone-accent bay-position">{activeBayLabel}</div>
        <button id="boat-next-bay" class="bay-step console-action" onclick="{nextBay}">›</button>
      </div>

      <div id="boat-deck-summary" class="label tone-muted room-summary">{deckSummary}</div>
      <div id="boat-deck-stock-slot" class="header-stock-slot">
        <company-resource-stock stockId="boat-material-stock" rows="{materialStock}" />
      </div>
    </div>

    <div id="boat-deck-body" class="deck-body">
      <!-- The stores, as the Mech Lab's: every part the yard can put on her, filtered by the
           kind of socket, each a card that is dragged onto a socket on the board. -->
      <div id="boat-catalog" class="{catalogClasses}">
        <div id="boat-catalog-kicker-row" class="catalog-kicker-row">
          <div id="boat-catalog-kicker" class="section-title label heading tone-edge catalog-kicker">{i18n.openingUiMechLabStoresSelectedMount}</div>
        </div>
        <div id="boat-catalog-heading" class="label catalog-heading tone-accent">{selectedSlotTitle}</div>
        <div id="boat-catalog-copy" class="label tone-muted catalog-copy">{selectedSlotCopy}</div>
        <div id="boat-category-filters" class="{filterClasses}">
          <fitting-filter-pill each="pill in filterPills" key="{pill.id}" pill="{pill}" />
        </div>
        <div id="boat-catalog-list" class="catalog-list">
          <fitting-card each="item in catalogRows" key="{item.id}" card="{item}" />
        </div>
        <div id="boat-drag-drop-note" class="surface-dark drag-drop-note">
          <div id="boat-drag-drop-title" class="label heading tone-edge">{i18n.boatDeckDragNoteTitle}</div>
          <div id="boat-drag-drop-copy" class="label tone-muted">{i18n.boatDeckDragNoteCopy}</div>
        </div>
      </div>

      <div id="boat-deck-stage" class="bay-stage">
        <div id="boat-deck-stage-heading" class="stage-heading">
          <button id="boat-back-to-deck" class="{backClasses}" onclick="{backToDeck}">{i18n.openingUiMechLabBackToLance}</button>
          <div id="boat-deck-stage-title" class="label heading tone-edge">{stageTitle}</div>
          <div id="boat-deck-stage-status" class="label heading tone-muted stage-status">{stageStatus}</div>
          <button id="boat-store" class="{storeClasses}" onclick="{storeAction}">{storeLabel}</button>
          <button id="boat-scrap" class="{scrapClasses}" onclick="{scrapAction}">{scrapLabel}</button>
        </div>
        <canvas id="boat-deck-canvas" class="bay-canvas" width="900" height="520" />
      </div>

      <div id="boat-overview" class="{overviewClasses}">
        <div id="boat-overview-heading" class="section-title label heading tone-edge">{i18n.openingUiBoatDeckBoatsAboard}</div>
        <div id="boat-list" class="boat-list">
          <button each="boat in boatRows" key="{boat.id}" id="{boat.id}" class="{boat.classes}" onclick="{boat.select}">
            <div id="{boat.berthId}" class="label heading tone-edge boat-card-berth">{boat.berth}</div>
            <div id="{boat.nameId}" class="label heading tone-accent boat-card-name">{boat.name}</div>
            <div id="{boat.patternId}" class="label tone-muted boat-card-line">{boat.pattern}</div>
            <div id="{boat.platingId}" class="label boat-card-line">{boat.plating}</div>
            <div id="{boat.driveId}" class="label boat-card-line">{boat.drive}</div>
          </button>
        </div>
        <div id="bay-sealed-note" class="{bayNoteClasses}">{i18n.openingUiBoatDeckSecondBaySealedNote}</div>
        <div id="boat-reserve" class="{reserveClasses}">
          <div id="boat-reserve-title" class="section-title label heading tone-edge reserve-title">{reserveTitle}</div>
          <div id="boat-reserve-list" class="reserve-list">
            <div each="stored in reserveRows" key="{stored.id}" id="{stored.id}" class="reserve-row">
              <div id="{stored.nameId}" class="label heading tone-accent reserve-name">{stored.name}</div>
              <div id="{stored.lineId}" class="label tone-muted reserve-line">{stored.line}</div>
              <button id="{stored.recallId}" class="{stored.recallClasses}" disabled="{stored.recallDisabled}" onclick="{stored.recall}">{i18n.reserveRecall}</button>
            </div>
          </div>
        </div>
      </div>

      <div id="boat-fabrication" class="{fabricationClasses}">
        <div id="boat-fabrication-header" class="panel boat-strip">
          <div id="boat-fabrication-berth" class="label boat-name tone-accent">{fabricationBerthLabel}</div>
          <div id="boat-fabrication-pattern" class="label tone-muted boat-identity">{fabricationPatternName}</div>
          <button id="boat-fabrication-back" class="compact-action console-action" onclick="{backToDeck}">{i18n.openingUiBoatDeckBackToDeck}</button>
        </div>

        <div id="boat-fabrication-yard" class="panel fabrication-yard">
          <div id="boat-fabrication-kicker" class="section-title label heading tone-edge">{i18n.openingUiBoatDeckYardWorkAirframe}</div>
          <div id="boat-fabrication-copy" class="label tone-muted fabrication-copy">{fabricationCopy}</div>
          <div id="boat-fabrication-materials" class="fabrication-costs">
            <company-resource-cost each="material in fabricationMaterials" key="{material.id}" row="{material}" />
          </div>
          <div id="boat-fabrication-reason" class="label heading tone-muted catalog-reason">{fabricationReason}</div>
          <div id="boat-fabrication-actions" class="boat-fabrication-actions">
            <button id="boat-fabricate" class="{fabricationActionClasses}" disabled="{fabricationBlocked}" onclick="{fabricate}">{fabricationActionLabel}</button>
          </div>
        </div>
      </div>

      <!-- The specifications column, as the Mech Lab's: her figures against her pattern's,
           her condition, and her readiness: why she can or cannot fly, each line opening its socket. -->
      <div id="boat-fitting" class="{fittingClasses}">
        <div id="boat-slot-rack" class="panel slot-panel">
          <div id="boat-performance-card" class="performance-card surface-dark">
            <div id="boat-specs-header" class="specs-header">
              <div id="boat-specs-title" class="section-title label heading tone-edge">{i18n.openingUiMechLabSpecifications}</div>
              <div id="selected-boat-identity" class="label heading tone-edge specs-doctrine">{selectedBoatIdentity}</div>
            </div>
            <div id="selected-boat-name" class="label boat-spec-name tone-accent">{selectedBoatName}</div>
            <div id="boat-performance-grid" class="performance-grid">
              <fitting-meter each="meter in performanceMeters" key="{meter.id}" meter="{meter}" />
            </div>
          </div>

          <div id="boat-recovery" class="{recovery.classes}" style="{recovery.style}">
            <div id="boat-recovery-status" class="label recovery-status tone-accent">{recovery.status}</div>
            <div id="boat-recovery-track" class="recovery-track"><div id="boat-recovery-fill" class="recovery-fill" style="{recovery.fillStyle}" /></div>
            <div id="boat-recovery-order" class="{recovery.orderClasses}">
              <div id="boat-recovery-copy" class="label recovery-copy tone-muted">{i18n.boatRepairCopy}</div>
              <div id="boat-recovery-costs" class="recovery-costs"><company-resource-cost each="row in recovery.materials" key="{row.id}" row="{row}" /></div>
              <div id="boat-recovery-actions" class="recovery-actions"><button id="boat-recovery-expedite" class="recovery-action console-action" disabled="{recovery.disabled}" onclick="{recovery.expedite}">{i18n.boatRepairExpedite}</button></div>
            </div>
          </div>

          <div id="boat-readiness-heading" class="section-title label heading tone-edge">{i18n.boatReadinessHeading}</div>
          <div id="boat-readiness-list" class="slot-list">
            <button each="row in readinessRows" key="{row.id}" id="{row.id}" class="{row.classes}" onclick="{row.select}">
              <div id="{row.barId}" class="{row.barClasses}" />
              <div id="{row.textId}" class="readiness-text">
                <div id="{row.titleId}" class="label heading readiness-title">{row.title}</div>
                <div id="{row.detailId}" class="label tone-muted readiness-detail">{row.detail}</div>
              </div>
            </button>
          </div>
        </div>
      </div>
    </div>

    <div id="boat-deck-feedback" class="{feedbackClasses}">{feedbackText}</div>
    <canvas id="boat-drag-ghost" class="boat-drag-ghost" width="1920" height="1080" />
  </div>
</template>

<style>
  .header-stock-slot { flex-direction: column; width: 640px; height: 46px; }
  .company-credit-bill { height: 36px; }

  .boat-deck-root { flex-direction: column; padding: 10px; gap: 7px; border-width: 2px; overflow: hidden; }
  .label { overflow: hidden; }
  .heading { font-family: heading; }
  .section-title { height: 19px; padding: 1px 3px; }
  .compact-action { width: 146px; height: 26px; padding: 3px 7px; border-width: 3px; text-align: center; font-family: heading; }

  .room-bar { flex-direction: row; align-items: center; height: 54px; padding: 4px 8px; gap: 10px; }
  #boat-deck-room-name { width: 230px; }
  .bay-navigator { flex-direction: row; width: 205px; height: 24px; gap: 3px; }
  .bay-step { width: 32px; height: 24px; padding: 2px; }
  .bay-position { width: 0px; height: 24px; flex-grow: 1; padding: 4px; text-align: center; border-width: 1px; }
  .room-summary { width: 0px; min-height: 32px; flex-grow: 1; text-align: right; white-space: normal; }
  .material-stock-strip { flex-direction: row; align-items: center; width: 380px; height: 24px; gap: 6px; }
  .material-stock { flex-direction: row; align-items: center; width: 0px; flex-grow: 1; height: 22px; gap: 5px; padding: 1px 4px; }
  .material-stock .material-icon { width: 18px; height: 18px; }
  .material-stock .material-label { width: 0px; flex-grow: 1; height: 14px; }

  .deck-body { flex-direction: row; width: 100%; height: 0px; flex-grow: 1; gap: 7px; overflow: hidden; }

  .bay-stage { flex-direction: column; width: 0px; flex-grow: 1; padding: 5px; gap: 3px; border-width: 1px; overflow: hidden; }
  .stage-heading { flex-direction: row; align-items: center; width: 100%; height: 19px; padding: 0px 3px; gap: 8px; }
  #boat-deck-stage-title { width: 420px; }
  .stage-status { width: 0px; flex-grow: 1; text-align: right; }
  .boat-scrap { width: 112px; height: 19px; padding: 0px 6px; font-family: heading; text-align: center; color: #d88a76; }
  .boat-scrap.armed { background-color: #4a1c18; border-color: #e0604c; color: #ffd2c4; }
  .reserve-store { width: 128px; height: 19px; padding: 0px 6px; font-family: heading; text-align: center; color: #9fc3d0; }
  .reserve-store.armed { background-color: #17323c; border-color: #6fb6cf; color: #d6f1fa; }
  .reserve-strip { flex-direction: column; width: 100%; height: 132px; padding: 7px; gap: 3px; border-width: 1px; border-color: #3f6a78; background-color: #111b1f; overflow: hidden; }
  .reserve-title { height: 16px; }
  .reserve-list { flex-direction: column; width: 100%; height: 0px; flex-grow: 1; gap: 2px; overflow: scroll; }
  .reserve-row { flex-direction: row; align-items: center; width: 100%; height: 24px; gap: 6px; padding: 0px 3px; }
  .reserve-name { width: 150px; height: 16px; }
  .reserve-line { width: 0px; flex-grow: 1; height: 16px; }
  .reserve-recall { width: 72px; height: 20px; padding: 0px 4px; font-family: heading; text-align: center; }
  .reserve-recall.blocked { opacity: 0.5; }
  .bay-canvas { width: 100%; height: 0px; flex-grow: 1; }

  .bay-sealed-note { width: 100%; min-height: 64px; padding: 8px; border-width: 1px; border-color: #b99f65; background-color: #202c28; white-space: normal; }
  .boat-overview { flex-direction: column; width: 380px; padding: 9px; gap: 7px; border-width: 1px; overflow: hidden; }
  .boat-list { flex-direction: column; height: 0px; flex-grow: 1; gap: 5px; overflow: scroll; }
  .boat-card { flex-direction: column; width: 100%; height: 112px; padding: 9px; gap: 2px; border-width: 1px; text-align: left; }
  .boat-card.selected { background-color: #2a3632; border-color: #dfc588; }
  .boat-card.vacant { background-color: #121719; border-color: #243849; opacity: 0.72; }
  .boat-card.vacant.selected { background-color: #2a3632; border-color: #dfc588; opacity: 1; }
  .boat-card-berth { height: 16px; }
  .boat-card-name { height: 22px; font-family: title; }
  .boat-card-line { height: 17px; }

  .boat-fabrication { flex-direction: column; width: 430px; gap: 6px; overflow: hidden; }
  .fabrication-yard { flex-direction: column; width: 100%; height: 0px; flex-grow: 1; padding: 7px; gap: 5px; overflow: hidden; }
  .fabrication-copy { width: 100%; min-height: 40px; white-space: normal; overflow: hidden; }
  .fabrication-costs { flex-direction: column; width: 100%; height: 144px; gap: 2px; overflow: hidden; }
  .boat-fabrication-actions { flex-direction: row; height: 32px; }
  .fabricate-action { width: 160px; height: 30px; text-align: center; }
  .fabricate-action.blocked { border-color: #8f3f44; background-color: #251419; }

  .boat-fitting { flex-direction: row; width: 352px; gap: 7px; overflow: hidden; }
  .boat-recovery { flex-direction: column; padding: 7px; gap: 5px; }
  .recovery-status { white-space: normal; min-height: 38px; }
  .recovery-track { flex-direction: row; width: 100%; height: 5px; background-color: #18252d; overflow: hidden; }
  .recovery-fill { height: 100%; background-color: #dfc588; }
  .boat-recovery-order { height: 234px; flex-direction: column; gap: 5px; }
  .recovery-copy { white-space: normal; min-height: 64px; }
  .recovery-costs { flex-direction: column; height: 126px; gap: 2px; }
  .recovery-actions { flex-direction: row; height: 32px; }
  .recovery-action { width: 210px; height: 32px; }
  .boat-strip { flex-direction: column; align-items: start; height: 96px; padding: 7px; gap: 3px; }
  .boat-name { height: 27px; font-family: title; }
  .boat-identity { height: 18px; }
  .boat-spec-name { width: 100%; height: 22px; font-family: title; }
  .stage-back { width: 86px; height: 19px; padding: 0px 6px; font-family: heading; text-align: center; }

  /* The stores and specifications frame the Mech Lab's do; the cards, meters and slot card
     inside them are the fitting kit's own. */
  .catalog-panel { flex-direction: column; width: 410px; padding: 7px; gap: 5px; border-width: 1px; overflow: hidden; }
  .catalog-heading { height: 25px; font-family: title; }
  .catalog-copy { min-height: 48px; white-space: normal; }
  .category-filters { flex-direction: row; align-items: center; width: 100%; height: 34px; gap: 3px; }
  .catalog-kicker-row { flex-direction: row; align-items: center; width: 100%; height: 20px; gap: 6px; }
  .catalog-kicker { width: 0px; flex-grow: 1; }
  .catalog-list { flex-direction: column; height: 0px; flex-grow: 1; gap: 4px; padding: 4px; overflow: scroll; background-color: #0d1214; border-width: 1px; border-color: #050809; }
  .drag-drop-note { flex-direction: column; width: 100%; height: 42px; padding: 4px; gap: 1px; }
  .drag-drop-note.drop-active { background-color: #203a29; border-color: #78d494; border-width: 2px; }
  #boat-drag-drop-title, #boat-drag-drop-copy { height: 16px; }
  .performance-card { flex-direction: column; width: 100%; height: 160px; padding: 5px 6px; gap: 3px; border-width: 1px; }
  .specs-header { flex-direction: row; align-items: center; width: 100%; height: 16px; }
  .specs-doctrine { width: 0px; flex-grow: 1; height: 16px; text-align: right; }
  .performance-grid { flex-direction: column; width: 100%; height: 104px; gap: 1px; }
  .slot-panel { flex-direction: column; width: 340px; padding: 6px; gap: 4px; overflow: hidden; }
  .slot-copy { height: 20px; }
  .slot-list { flex-direction: column; height: 0px; flex-grow: 1; gap: 4px; overflow: scroll; }
  .readiness-row { flex-direction: row; height: 50px; gap: 8px; padding: 6px 8px; background-color: #0d1215; border-width: 1px; border-color: #20292c; }
  .readiness-link:hover { background-color: #18211f; border-color: #dfc588; }
  .readiness-bar { width: 5px; height: 100%; }
  .readiness-bar-danger { background-color: #e85a4a; }
  .readiness-bar-warn { background-color: #edc273; }
  .readiness-bar-good { background-color: #7ee09a; }
  .readiness-bar-muted { background-color: #5d6660; }
  .readiness-text { flex-direction: column; width: 0px; flex-grow: 1; gap: 2px; }
  .readiness-title { height: 20px; color: #d3d0c5; }
  .readiness-danger .readiness-title { color: #e85a4a; }
  .readiness-warn .readiness-title { color: #edc273; }
  .readiness-good .readiness-title { color: #7ee09a; }
  .readiness-detail { height: 17px; }
  .boat-drag-ghost { position: absolute; left: 0px; top: 0px; width: 100%; height: 100%; pointer-events: none; }
  .material-cost { flex-direction: row; width: 100%; height: 16px; padding: 0px 3px; gap: 4px; background-color: #121719; border-width: 1px; }
  .material-cost.short { border-color: #8f3f44; background-color: #251419; }
  .material-icon { width: 13px; height: 13px; }
  .material-label { width: 0px; height: 14px; flex-grow: 1; }
  .catalog-reason { height: 16px; padding: 0px 2px; }

  .boat-deck-feedback { height: 29px; padding: 6px 9px; border-width: 1px; overflow: hidden; }
  .hidden { display: none; }
  .workshop-service-plate { width: 42px; height: 22px; pointer-events: none; }
  .room-bar { border-width: 1px; background-color: #252b2c; border-color: #596362; }
  .garage-heading, .stage-heading { border-width: 0px; border-color: #596362; }
</style>
