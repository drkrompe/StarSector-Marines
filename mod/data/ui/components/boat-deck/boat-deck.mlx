<template props="catalogClasses,stageTitle,stageStatus,recovery,wings,fabricationActionLabel,bayNoteClasses,contextLabel,activeBayLabel,bayNavigatorClasses,previousBay,nextBay,deckSummary,materialStock,boatRows,selectedBoatName,selectedBoatIdentity,performanceMeters,slotRows,selectedSlotTitle,selectedSlotCopy,catalogRows,overviewClasses,fittingClasses,fabricationClasses,fabricationBerthLabel,fabricationPatternName,fabricationCopy,fabricationMaterials,fabricationActionClasses,fabricationBlocked,fabricationReason,fabricate,backToDeck,feedbackText,feedbackClasses,returnAction,hqAction,barracksAction,armoryAction,mechLabAction,boatsAction,engineeringAction,hqClasses,barracksClasses,armoryClasses,mechLabClasses,engineeringClasses,boatsClasses">
  <div id="boat-deck-root" class="boat-deck-root">
    <marine-ops-page-nav returnAction="{returnAction}" hqAction="{hqAction}" barracksAction="{barracksAction}" armoryAction="{armoryAction}" mechLabAction="{mechLabAction}" boatsAction="{boatsAction}" engineeringAction="{engineeringAction}" engineeringClasses="{engineeringClasses}" hqClasses="{hqClasses}" barracksClasses="{barracksClasses}" armoryClasses="{armoryClasses}" mechLabClasses="{mechLabClasses}" boatsClasses="{boatsClasses}" contextLabel="{contextLabel}" />
    <div id="boat-deck-room-bar" class="panel room-bar">
      <img id="boat-deck-service-plate" class="workshop-service-plate" src="graphics/ui/console/service-plate.svg" />
      <div id="boat-deck-room-name" class="label heading tone-edge">{i18n.openingUiBoatDeckBoatDeckHangar}</div>
      <div id="boat-bay-navigator" class="{bayNavigatorClasses}">
        <button id="boat-previous-bay" class="bay-step console-action" onclick="{previousBay}">‹</button>
        <div id="boat-active-bay" class="label heading tone-accent bay-position">{activeBayLabel}</div>
        <button id="boat-next-bay" class="bay-step console-action" onclick="{nextBay}">›</button>
      </div>

      <div id="boat-deck-summary" class="label tone-muted room-summary">{deckSummary}</div>
      <div id="boat-deck-stock-slot" class="header-stock-slot">
        <company-resource-stock stockId="boat-material-stock" rows="{materialStock}" />
      </div>
    </div>

    <div id="boat-deck-body" class="deck-body">
      <div id="boat-catalog" class="{catalogClasses}">
        <div id="boat-catalog-kicker" class="section-title label heading tone-edge">{i18n.openingUiBoatDeckYardWorkSelectedSlot}</div>
        <div id="boat-catalog-heading" class="label catalog-heading tone-accent">{selectedSlotTitle}</div>
        <div id="boat-catalog-copy" class="label tone-muted catalog-copy">{selectedSlotCopy}</div>
        <div id="boat-catalog-list" class="catalog-list">
          <div each="item in catalogRows" key="{item.id}" id="{item.id}" class="{item.classes}" style="{item.cardStyle}">
            <canvas id="{item.previewId}" class="catalog-preview" width="152" height="200" />
            <div id="{item.bodyId}" class="catalog-body">
            <div id="{item.copyId}" class="catalog-item-copy" style="{item.copyStyle}">
              <div id="{item.nameId}" class="label heading catalog-name">{item.name}</div>
              <div id="{item.lineId}" class="catalog-line">
                <div id="{item.tierId}" class="label heading tone-edge catalog-tier">{item.tier}</div>
                <div id="{item.effectId}" class="label tone-accent catalog-effect">{item.effect}</div>
              </div>
              <div id="{item.provenanceId}" class="label tone-muted catalog-provenance">{item.provenance}</div>
              <div id="{item.materialsId}" class="material-costs" style="{item.materialsStyle}">
                <company-resource-cost each="material in item.materials" key="{material.id}" row="{material}" />
              </div>
            </div>
            <div id="{item.reasonId}" class="label heading tone-muted catalog-reason">{item.reason}</div>
            <button id="{item.actionId}" class="catalog-action console-action" disabled="{item.actionDisabled}" onclick="{item.action}">{item.actionLabel}</button>
            </div>
          </div>
        </div>
      </div>

      <div id="boat-deck-stage" class="bay-stage">
        <div id="boat-deck-stage-heading" class="stage-heading">
          <div id="boat-deck-stage-title" class="label heading tone-edge">{stageTitle}</div>
          <div id="boat-deck-stage-status" class="label heading tone-muted stage-status">{stageStatus}</div>
        </div>
        <canvas id="boat-deck-canvas" class="bay-canvas" width="900" height="520" />
      </div>

      <div id="boat-overview" class="{overviewClasses}">
        <button id="wings-resume" class="{wings.resumeClasses}" onclick="{wings.open}">{i18n.openingUiBoatDeckSecondhandWingsMaraSOffer}</button>
        <div id="boat-overview-heading" class="section-title label heading tone-edge">{i18n.openingUiBoatDeckBoatsAboard}</div>
        <div id="boat-list" class="boat-list">
          <button each="boat in boatRows" key="{boat.id}" id="{boat.id}" class="{boat.classes}" onclick="{boat.select}">
            <div id="{boat.berthId}" class="label heading tone-edge boat-card-berth">{boat.berth}</div>
            <div id="{boat.nameId}" class="label heading tone-accent boat-card-name">{boat.name}</div>
            <div id="{boat.patternId}" class="label tone-muted boat-card-line">{boat.pattern}</div>
            <div id="{boat.platingId}" class="label boat-card-line">{boat.plating}</div>
            <div id="{boat.driveId}" class="label boat-card-line">{boat.drive}</div>
          </button>
        </div>
        <div id="bay-sealed-note" class="{bayNoteClasses}">{i18n.openingUiBoatDeckSecondBaySealedNote}</div>
      </div>

      <div id="boat-fabrication" class="{fabricationClasses}">
        <div id="boat-fabrication-header" class="panel boat-strip">
          <div id="boat-fabrication-berth" class="label boat-name tone-accent">{fabricationBerthLabel}</div>
          <div id="boat-fabrication-pattern" class="label tone-muted boat-identity">{fabricationPatternName}</div>
          <button id="boat-fabrication-back" class="compact-action console-action" onclick="{backToDeck}">{i18n.openingUiBoatDeckBackToDeck}</button>
        </div>

        <div id="boat-fabrication-yard" class="panel fabrication-yard">
          <div id="boat-fabrication-kicker" class="section-title label heading tone-edge">{i18n.openingUiBoatDeckYardWorkAirframe}</div>
          <div id="boat-fabrication-copy" class="label tone-muted fabrication-copy">{fabricationCopy}</div>
          <div id="boat-fabrication-materials" class="fabrication-costs">
            <company-resource-cost each="material in fabricationMaterials" key="{material.id}" row="{material}" />
          </div>
          <div id="boat-fabrication-reason" class="label heading tone-muted catalog-reason">{fabricationReason}</div>
          <div id="boat-fabrication-actions" class="boat-fabrication-actions">
            <button id="boat-fabricate" class="{fabricationActionClasses}" disabled="{fabricationBlocked}" onclick="{fabricate}">{fabricationActionLabel}</button>
          </div>
        </div>
      </div>

      <div id="boat-fitting" class="{fittingClasses}">
        <div id="boat-fitting-side" class="fitting-side">
          <div id="boat-fitting-header" class="panel boat-strip">
            <div id="selected-boat-name" class="label boat-name tone-accent">{selectedBoatName}</div>
            <div id="selected-boat-identity" class="label tone-muted boat-identity">{selectedBoatIdentity}</div>
            <button id="boat-back-to-deck" class="compact-action console-action" onclick="{backToDeck}">{i18n.openingUiBoatDeckBackToDeck}</button>
          </div>

          <div id="boat-recovery" class="{recovery.classes}" style="{recovery.style}">
            <div id="boat-recovery-status" class="label recovery-status tone-accent">{recovery.status}</div>
            <div id="boat-recovery-track" class="recovery-track"><div id="boat-recovery-fill" class="recovery-fill" style="{recovery.fillStyle}" /></div>
            <div id="boat-recovery-order" class="{recovery.orderClasses}">
              <div id="boat-recovery-copy" class="label recovery-copy tone-muted">{i18n.boatRepairCopy}</div>
              <div id="boat-recovery-costs" class="recovery-costs"><company-resource-cost each="row in recovery.materials" key="{row.id}" row="{row}" /></div>
              <div id="boat-recovery-actions" class="recovery-actions"><button id="boat-recovery-expedite" class="recovery-action console-action" disabled="{recovery.disabled}" onclick="{recovery.expedite}">{i18n.boatRepairExpedite}</button></div>
            </div>
          </div>

          <div id="boat-performance-grid" class="panel performance-grid">
            <div each="meter in performanceMeters" key="{meter.id}" id="{meter.id}" class="performance-meter surface-dark">
              <div id="{meter.labelId}" class="label heading tone-muted meter-label">{meter.label}</div>
              <div id="{meter.valueId}" class="label heading tone-edge meter-value">{meter.value}</div>
              <div id="{meter.trackId}" class="meter-track">
                <div id="{meter.fillId}" class="meter-fill" style="{meter.fillStyle}" />
              </div>
            </div>
          </div>

          <div id="boat-slot-rack" class="panel slot-panel">
            <div id="boat-slot-heading" class="section-title label heading tone-edge">{i18n.openingUiBoatDeckFittedSlots}</div>
            <div id="boat-slot-list" class="slot-list">
              <button each="slot in slotRows" key="{slot.id}" id="{slot.id}" class="{slot.classes}" onclick="{slot.select}">
                <div id="{slot.nameId}" class="label heading tone-edge slot-name">{slot.name}</div>
                <div id="{slot.fittingId}" class="label slot-fitting">{slot.fitting}</div>
                <div id="{slot.tierId}" class="label heading tone-muted slot-tier">{slot.tier}</div>
              </button>
            </div>
          </div>
        </div>


      </div>
    </div>

    <div id="boat-deck-feedback" class="{feedbackClasses}">{feedbackText}</div>
    <div id="wings-modal" class="{wings.classes}">
      <div id="wings-space-above" class="wings-space" />
      <div id="wings-dialog" class="wings-dialog console-readout">
        <div id="wings-title" class="label heading tone-edge wings-title">{wings.title}</div>
        <div id="wings-dialogue" class="wings-dialogue">
          <img id="wings-portrait" class="wings-portrait" src="{wings.portrait}" />
          <div id="wings-copy" class="label wings-copy">{wings.copy}</div>
        </div>
        <div id="wings-exchange" class="wings-exchange">
          <div id="wings-old-card" class="wings-craft-card">
            <img id="wings-old" class="wings-craft" src="{wings.oldArt}" />
            <div id="wings-old-name" class="label heading tone-muted wings-craft-name">{wings.oldName}</div>
            <div id="wings-old-seats" class="label tone-muted wings-craft-seats">{wings.oldSeats}</div>
          </div>
          <div id="wings-arrow" class="label heading tone-edge wings-arrow">{wings.arrow}</div>
          <div id="wings-new-card" class="wings-craft-card">
            <img id="wings-new" class="wings-craft" src="{wings.newArt}" />
            <div id="wings-new-name" class="label heading wings-craft-name">{wings.newName}</div>
            <div id="wings-new-seats" class="label wings-craft-seats">{wings.newSeats}</div>
          </div>
          <div id="wings-trade" class="label wings-trade tone-muted">{wings.trade}</div>
        </div>
        <div id="wings-price" class="{wings.priceClasses}">
          <div id="wings-price-label" class="label heading tone-muted wings-price-label">{wings.priceLabel}</div>
          <img id="wings-price-icon" class="wings-price-icon" src="graphics/ui/company/credits.svg" />
          <div id="wings-price-value" class="label heading wings-price-value">{wings.price}</div>
          <div id="wings-price-stock" class="{wings.stockClasses}">{wings.stock}</div>
        </div>
        <div id="wings-reason" class="label tone-muted wings-reason">{wings.reason}</div>
        <div id="wings-controls" class="wings-controls">
          <button id="wings-action" class="wings-action console-action" disabled="{wings.disabled}" onclick="{wings.action}">{wings.actionLabel}</button>
          <button id="wings-later" class="wings-action console-action" onclick="{wings.dismiss}">{i18n.openingUiBoatDeckCloseLater}</button>
        </div>
      </div>
      <div id="wings-space-below" class="wings-space" />
    </div>
  </div>
</template>

<style>
  .header-stock-slot { flex-direction: column; width: 640px; height: 46px; }
  .company-credit-bill { height: 36px; }
  .wings-resume { width: 100%; height: 32px; text-align: center; font-family: heading; }
  .wings-backdrop { position: absolute; left: 0px; top: 0px; width: 100%; height: 100%; flex-direction: column; align-items: center; background-color: #080e12d9; }
  .wings-hidden { position: absolute; width: 0px; height: 0px; opacity: 0; pointer-events: none; overflow: hidden; }
  .wings-space { height: 0px; flex-grow: 1; }
  .wings-dialog { width: 900px; height: 470px; padding: 18px; gap: 12px; flex-direction: column; border-width: 2px; border-color: #dfc588; background-color: #202d28; }
  .wings-title { height: 24px; }
  .wings-dialogue { flex-direction: row; height: 150px; gap: 18px; }
  .wings-portrait { width: 150px; height: 150px; }
  .wings-copy { width: 0px; flex-grow: 1; height: 150px; white-space: normal; }
  .wings-exchange { flex-direction: row; height: 128px; gap: 10px; align-items: center; padding: 6px 10px; background-color: #1a2522; }
  .wings-craft-card { flex-direction: column; align-items: center; width: 130px; height: 116px; gap: 2px; }
  .wings-craft { width: 60px; height: 76px; }
  .wings-craft-name { width: 100%; height: 18px; text-align: center; }
  .wings-craft-seats { width: 100%; height: 16px; text-align: center; }
  .wings-arrow { width: 24px; height: 20px; text-align: center; }
  .wings-trade { width: 0px; flex-grow: 1; height: 96px; padding-left: 14px; white-space: normal; }
  .wings-price { flex-direction: row; align-items: center; height: 40px; padding: 0px 12px; gap: 10px; border-width: 1px; border-color: #46554b; background-color: #121719; }
  .wings-price.short { border-color: #a05d52; }
  .wings-price-label { width: 160px; height: 18px; }
  .wings-price-icon { width: 20px; height: 20px; }
  .wings-price-value { width: 0px; flex-grow: 1; height: 20px; color: #dfc588; }
  .wings-price-stock { width: 260px; height: 18px; text-align: right; }
  .wings-price-stock.short { color: #eea296; }
  .wings-reason { height: 20px; white-space: normal; }
  .wings-controls { height: 32px; flex-direction: row; gap: 12px; }
  .wings-action { width: 190px; height: 32px; font-family: heading; text-align: center; }

  .boat-deck-root { flex-direction: column; padding: 10px; gap: 7px; border-width: 2px; overflow: hidden; }
  .label { overflow: hidden; }
  .heading { font-family: heading; }
  .section-title { height: 19px; padding: 1px 3px; }
  .compact-action { width: 146px; height: 26px; padding: 3px 7px; border-width: 3px; text-align: center; font-family: heading; }

  .room-bar { flex-direction: row; align-items: center; height: 54px; padding: 4px 8px; gap: 10px; }
  #boat-deck-room-name { width: 230px; }
  .bay-navigator { flex-direction: row; width: 205px; height: 24px; gap: 3px; }
  .bay-step { width: 32px; height: 24px; padding: 2px; }
  .bay-position { width: 0px; height: 24px; flex-grow: 1; padding: 4px; text-align: center; border-width: 1px; }
  .room-summary { width: 0px; height: 32px; flex-grow: 1; text-align: right; white-space: normal; }
  .material-stock-strip { flex-direction: row; align-items: center; width: 380px; height: 24px; gap: 6px; }
  .material-stock { flex-direction: row; align-items: center; width: 0px; flex-grow: 1; height: 22px; gap: 5px; padding: 1px 4px; }
  .material-stock .material-icon { width: 18px; height: 18px; }
  .material-stock .material-label { width: 0px; flex-grow: 1; height: 14px; }

  .deck-body { flex-direction: row; width: 100%; height: 0px; flex-grow: 1; gap: 7px; overflow: hidden; }

  .bay-stage { flex-direction: column; width: 0px; flex-grow: 1; padding: 5px; gap: 3px; border-width: 1px; overflow: hidden; }
  .stage-heading { flex-direction: row; width: 100%; height: 19px; padding: 0px 3px; }
  #boat-deck-stage-title { width: 420px; }
  .stage-status { width: 0px; flex-grow: 1; text-align: right; }
  .bay-canvas { width: 100%; height: 0px; flex-grow: 1; }

  .bay-sealed-note { width: 100%; height: 64px; padding: 8px; border-width: 1px; border-color: #b99f65; background-color: #202c28; white-space: normal; }
  .boat-overview { flex-direction: column; width: 380px; padding: 9px; gap: 7px; border-width: 1px; overflow: hidden; }
  .boat-list { flex-direction: column; height: 0px; flex-grow: 1; gap: 5px; overflow: scroll; }
  .boat-card { flex-direction: column; width: 100%; height: 112px; padding: 9px; gap: 2px; border-width: 1px; text-align: left; }
  .boat-card.selected { background-color: #2a3632; border-color: #dfc588; }
  .boat-card.vacant { background-color: #121719; border-color: #243849; opacity: 0.72; }
  .boat-card.vacant.selected { background-color: #2a3632; border-color: #dfc588; opacity: 1; }
  .boat-card-berth { height: 16px; }
  .boat-card-name { height: 22px; font-family: title; }
  .boat-card-line { height: 17px; }

  .boat-fabrication { flex-direction: column; width: 430px; gap: 6px; overflow: hidden; }
  .fabrication-yard { flex-direction: column; width: 100%; height: 0px; flex-grow: 1; padding: 7px; gap: 5px; overflow: hidden; }
  .fabrication-copy { width: 100%; height: 40px; white-space: normal; overflow: hidden; }
  .fabrication-costs { flex-direction: column; width: 100%; height: 144px; gap: 2px; overflow: hidden; }
  .boat-fabrication-actions { flex-direction: row; height: 32px; }
  .fabricate-action { width: 160px; height: 30px; text-align: center; }
  .fabricate-action.blocked { border-color: #8f3f44; background-color: #251419; }

  .boat-fitting { flex-direction: row; width: 330px; gap: 7px; overflow: hidden; }
  .boat-recovery { flex-direction: column; padding: 7px; gap: 5px; }
  .recovery-status { white-space: normal; height: 38px; }
  .recovery-track { flex-direction: row; height: 5px; background-color: #18252d; }
  .recovery-fill { height: 100%; background-color: #dfc588; }
  .boat-recovery-order { height: 234px; flex-direction: column; gap: 5px; }
  .recovery-copy { white-space: normal; height: 64px; }
  .recovery-costs { flex-direction: column; height: 126px; gap: 2px; }
  .recovery-actions { flex-direction: row; height: 32px; }
  .recovery-action { width: 210px; height: 32px; }
  .fitting-side { flex-direction: column; width: 330px; gap: 6px; overflow: hidden; }
  .boat-strip { flex-direction: column; align-items: start; height: 96px; padding: 7px; gap: 3px; }
  .boat-name { height: 27px; font-family: title; }
  .boat-identity { height: 18px; }

  .performance-grid { flex-direction: column; height: 122px; padding: 7px; gap: 4px; }
  .performance-meter { flex-direction: row; width: 100%; height: 22px; padding: 3px 5px; gap: 5px; border-width: 1px; }
  .meter-label { width: 88px; padding-top: 1px; }
  .meter-value { width: 84px; padding-top: 1px; text-align: right; }
  .meter-track { flex-direction: row; width: 0px; flex-grow: 1; height: 8px; padding-top: 4px; background-color: #121719; border-width: 1px; }
  .meter-fill { height: 100%; background-color: #76b9d4; }

  .slot-panel { flex-direction: column; height: 0px; flex-grow: 1; padding: 7px; gap: 5px; overflow: hidden; }
  .slot-list { flex-direction: column; height: 0px; flex-grow: 1; gap: 4px; overflow: scroll; }
  .boat-slot { flex-direction: column; width: 100%; height: 61px; padding: 5px; gap: 1px; border-width: 1px; text-align: left; }
  .boat-slot.selected, .catalog-row.selected { background-color: #2a3632; border-color: #dfc588; }
  .slot-name, .slot-tier { height: 16px; }
  .slot-fitting { height: 17px; }

  .catalog-panel { flex-direction: column; width: 420px; padding: 7px; gap: 5px; overflow: hidden; }
  .catalog-heading { height: 25px; font-family: title; }
  .catalog-copy { height: 36px; white-space: normal; overflow: hidden; }
  .catalog-list { flex-direction: column; height: 0px; flex-grow: 1; gap: 5px; overflow: scroll; }
  .catalog-row { flex-direction: row; align-items: start; width: 100%; height: 220px; padding: 7px; gap: 8px; border-width: 1px; }
  .catalog-preview { width: 76px; height: 100px; }
  .catalog-body { flex-direction: column; align-items: start; width: 0px; flex-grow: 1; gap: 3px; }
  .catalog-item-copy { flex-direction: column; width: 100%; height: auto; gap: 2px; }
  .catalog-name { height: 19px; }
  .catalog-line { flex-direction: column; width: 100%; height: 34px; gap: 1px; }
  .catalog-tier { width: 100%; height: 16px; }
  .catalog-effect { width: 100%; height: 16px; }
  .catalog-provenance { height: 64px; white-space: normal; overflow: hidden; }
  .material-costs { flex-direction: column; width: 100%; height: 144px; gap: 2px; overflow: hidden; }
  .material-cost { flex-direction: row; width: 100%; height: 16px; padding: 0px 3px; gap: 4px; background-color: #121719; border-width: 1px; }
  .material-cost.short { border-color: #8f3f44; background-color: #251419; }
  .material-icon { width: 13px; height: 13px; }
  .material-label { width: 0px; height: 14px; flex-grow: 1; }
  .catalog-reason { height: 16px; padding: 0px 2px; }
  .catalog-action { width: 182px; height: 26px; padding: 3px 7px; border-width: 3px; text-align: center; font-family: heading; }

  .boat-deck-feedback { height: 29px; padding: 6px 9px; border-width: 1px; overflow: hidden; }
  .hidden { width: 0px; height: 0px; padding: 0px; gap: 0px; border-width: 0px; overflow: hidden; opacity: 0; }
  .workshop-service-plate { width: 42px; height: 22px; pointer-events: none; }
  .room-bar { border-width: 1px; background-color: #252b2c; border-color: #596362; }
  .garage-heading, .stage-heading { border-width: 0px; border-color: #596362; }
</style>
