<template props="returnAction,hqAction,barracksAction,armoryAction,mechLabAction,hqClasses,barracksClasses,armoryClasses,mechLabClasses,contextLabel">
  <div id="marine-ops-page-nav" class="panel surface-dark">
    <div id="marine-ops-page-routes">
      <button id="page-nav-return" onclick="{returnAction}">RETURN</button>
      <button id="page-nav-hq" class="{hqClasses}" onclick="{hqAction}">HQ</button>
      <button id="page-nav-barracks" class="{barracksClasses}" onclick="{barracksAction}">BARRACKS</button>
      <button id="page-nav-armory" class="{armoryClasses}" onclick="{armoryAction}">ARMORY</button>
      <button id="page-nav-mech-lab" class="{mechLabClasses}" onclick="{mechLabAction}">MECH LAB</button>
    </div>
    <div id="marine-ops-page-context" class="label heading tone-edge">{contextLabel}</div>
  </div>
</template>

<style>
  #marine-ops-page-nav {
    flex-direction: row;
    height: 34px;
    padding: 4px;
    gap: 8px;
  }

  #marine-ops-page-routes { flex-direction: row; width: 662px; gap: 6px; }
  #marine-ops-page-routes button {
    width: 108px;
    padding: 3px 8px;
    border-width: 1px;
    overflow: hidden;
    font-family: heading;
    text-align: center;
  }

  #marine-ops-page-routes .page-nav-current {
    background-color: #183b50;
    border-color: #ffd464;
    color: #ffd464;
    opacity: 1;
  }

  #marine-ops-page-routes .page-nav-current:hover {
    background-color: #21536f;
    border-color: #ffe6a3;
  }

  /* A room the ship does not have. The button stays so the player can see the
     berth the hull lacks, rather than wondering where a page went. */
  #marine-ops-page-routes .page-nav-absent {
    background-color: #12181c;
    border-color: #2b3238;
    color: #55626b;
    opacity: 0.55;
  }

  #marine-ops-page-routes .page-nav-absent:hover {
    background-color: #12181c;
    border-color: #2b3238;
    color: #55626b;
  }

  #marine-ops-page-context {
    width: 0px;
    flex-grow: 1;
    padding: 5px 7px;
    text-align: right;
  }
</style>
