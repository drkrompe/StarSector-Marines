<template props="returnAction,hqAction,missionsAction,missionsClasses,barracksAction,armoryAction,mechLabAction,boatsAction,engineeringAction,hqClasses,barracksClasses,armoryClasses,mechLabClasses,boatsClasses,engineeringClasses,shopAction,shopClasses,settingsAction,settingsClasses">
  <div id="marine-ops-page-nav" class="">
    <div id="marine-ops-page-bar">
    <img id="marine-ops-page-holder" src="graphics/ui/console/page-bar.svg" />
    <img id="marine-ops-page-holder-compact" src="graphics/ui/console/page-bar-compact.svg" />
    <div id="marine-ops-page-routes">
      <button id="page-nav-return" onclick="{returnAction}">
        <div id="page-nav-return-lamp" class="console-toggle-lamp" />
        <div id="page-nav-return-legend" class="console-key-legend" accesskey="r">{i18n.openingUiMarineOpsPageNavReturn}</div>
      </button>
      <button id="page-nav-missions" class="{missionsClasses}" onclick="{missionsAction}">
        <div id="page-nav-missions-lamp" class="console-toggle-lamp" />
        <img id="page-nav-missions-status" class="page-nav-status" src="graphics/ui/console/nav-attention-work.svg" />
        <div id="page-nav-missions-news" class="page-nav-news">{i18n.openingUiMarineOpsPageNavNew}</div>
        <div id="page-nav-missions-legend" class="console-key-legend" accesskey="n">{i18n.openingUiMarineOpsPageNavMissions}</div>
      </button>
      <button id="page-nav-hq" class="{hqClasses}" onclick="{hqAction}">
        <div id="page-nav-hq-lamp" class="console-toggle-lamp" />
        <div id="page-nav-hq-news" class="page-nav-news">{i18n.openingUiMarineOpsPageNavNew}</div>
        <div id="page-nav-hq-legend" class="console-key-legend" accesskey="h">{i18n.openingUiMarineOpsPageNavHq}</div>
      </button>
      <button id="page-nav-barracks" class="{barracksClasses}" onclick="{barracksAction}">
        <div id="page-nav-barracks-lamp" class="console-toggle-lamp" />
        <img id="page-nav-barracks-status" class="page-nav-status" src="graphics/ui/console/nav-attention-wounded.svg" />
        <div id="page-nav-barracks-news" class="page-nav-news">{i18n.openingUiMarineOpsPageNavNew}</div>
        <div id="page-nav-barracks-legend" class="console-key-legend" accesskey="b">{i18n.openingUiMarineOpsPageNavBarracks}</div>
      </button>
      <button id="page-nav-mech-lab" class="{mechLabClasses}" onclick="{mechLabAction}">
        <div id="page-nav-mech-lab-lamp" class="console-toggle-lamp" />
        <img id="page-nav-mech-lab-status" class="page-nav-status" src="graphics/ui/console/nav-attention-repair.svg" />
        <div id="page-nav-mech-lab-news" class="page-nav-news">{i18n.openingUiMarineOpsPageNavNew}</div>
        <div id="page-nav-mech-lab-legend" class="console-key-legend" accesskey="m">{i18n.openingUiMarineOpsPageNavMechLab}</div>
      </button>
      <button id="page-nav-boats" class="{boatsClasses}" onclick="{boatsAction}">
        <div id="page-nav-boats-lamp" class="console-toggle-lamp" />
        <img id="page-nav-boats-status" class="page-nav-status" src="graphics/ui/console/nav-attention-repair.svg" />
        <div id="page-nav-boats-news" class="page-nav-news">{i18n.openingUiMarineOpsPageNavNew}</div>
        <div id="page-nav-boats-legend" class="console-key-legend" accesskey="s">{i18n.openingUiMarineOpsPageNavBoats}</div>
      </button>
      <button id="page-nav-engineering" class="{engineeringClasses}" onclick="{engineeringAction}">
        <div id="page-nav-engineering-lamp" class="console-toggle-lamp" />
        <img id="page-nav-engineering-news" class="page-nav-news page-nav-news-icon" src="graphics/ui/console/nav-news-engineering.svg" />
        <div id="page-nav-engineering-legend" class="console-key-legend" accesskey="e">{i18n.openingUiMarineOpsPageNavEngineering}</div>
      </button>
      <button id="page-nav-shop" class="{shopClasses}" onclick="{shopAction}">
        <div id="page-nav-shop-lamp" class="console-toggle-lamp" />
        <img id="page-nav-shop-news" class="page-nav-news page-nav-news-icon" src="graphics/ui/icons/fleettab/credits_24x24.png" />
        <div id="page-nav-shop-legend" class="console-key-legend" accesskey="t">{i18n.openingUiMarineOpsPageNavStore}</div>
      </button>
      <button id="page-nav-settings" class="{settingsClasses}" onclick="{settingsAction}">
        <div id="page-nav-settings-lamp" class="console-toggle-lamp" />
        <div id="page-nav-settings-news" class="page-nav-news">{i18n.openingUiMarineOpsPageNavNew}</div>
        <div id="page-nav-settings-legend" class="console-key-legend" accesskey="g">{i18n.openingUiMarineOpsPageNavSettings}</div>
      </button>
    </div>
    </div>
  </div>
</template>

<style>
  /* The mod's own bottom menu, in the screen's bottom left corner: nine slots (148x30 on
     a 155 pitch, the first at 14,22 in the art) hold the nine routes, and a silver wedge
     rises 12 px above them at the left. Every page's root insets this bar by 12 px and clips
     nothing, so the offsets below reach the corner, and the bar's own row keeps the
     pages' content out from under the wedge. Past 100% UI scale, where everything is already
     drawn larger, page-bar-compact.svg (107x20 on a 114 pitch) takes over. A tenth route means
     redrawing both. Nothing here scales, so the art stays one to one. */
  #marine-ops-page-nav {
    flex-direction: row;
    align-items: center;
    height: 45px;
    border-width: 0px;
  }

  #marine-ops-page-bar { width: 1401px; height: 45px; }
  #marine-ops-page-holder { position: absolute; left: -12px; top: 0px; width: 1413px; height: 57px; pointer-events: none; }
  #marine-ops-page-holder-compact { display: none; position: absolute; left: -12px; top: 0px; width: 1044px; height: 47px; pointer-events: none; }
  #marine-ops-page-routes {
    position: absolute;
    left: 2px;
    top: 22px;
    flex-direction: row;
    width: 1388px;
    height: 30px;
    gap: 7px;
  }
  #marine-ops-page-routes button {
    flex-direction: row;
    align-items: center;
    width: 140px;
    height: 30px;
    gap: 2px;
    padding: 0px 4px;
    border-width: 0px;
    overflow: hidden;
    text-align: center;
  }

  #marine-ops-page-routes .console-key-legend { width: 0px; flex-grow: 1; white-space: nowrap; }


  /* A room the ship does not have. The button stays so the player can see the
     berth the hull lacks, rather than wondering where a page went. */
  #marine-ops-page-routes .page-nav-absent {
    background-color: #12181c;
    border-color: #1e323e;
    color: #565d64;
    opacity: 0.55;
  }

  #marine-ops-page-routes .page-nav-absent:hover {
    background-color: #12181c;
    border-color: #1e323e;
    color: #565d64;
  }

  /* A room aboard a ship still being laid out. Told apart from one she does not
     have, because a hull that cannot hold a bay never will and this is a wait
     of a second or two. */
  #marine-ops-page-routes .page-nav-waiting {
    background-color: #101a22;
    border-color: #2d4250;
    color: #757f88;
    opacity: 0.8;
  }

  #marine-ops-page-routes .page-nav-waiting:hover {
    background-color: #101a22;
    border-color: #2d4250;
    color: #757f88;
  }

  /* A room with something waiting on the player: what it is shows in the room. */
  .page-nav-status { display: none; width: 16px; height: 16px; pointer-events: none; }
  #marine-ops-page-routes .page-nav-attention .page-nav-status { display: flex; }
  .page-nav-news { display: none; }
  #marine-ops-page-routes .page-nav-new .page-nav-news { display: flex; color: #ffd200; }
  /* Engineering's news is a wrench and the store's the game's credit sign, in the gold of the word. */
  .page-nav-news-icon { width: 16px; height: 16px; pointer-events: none; }
  .console-toggle-lamp { display: none; }
  .doc-narrow #marine-ops-page-nav { height: 35px; }
  .doc-narrow #marine-ops-page-bar { width: 1032px; height: 35px; }
  .doc-narrow #marine-ops-page-holder { display: none; }
  .doc-narrow #marine-ops-page-holder-compact { display: flex; }
  .doc-narrow #marine-ops-page-routes { width: 1019px; height: 20px; }
  .doc-narrow #marine-ops-page-routes button { width: 99px; height: 20px; }
</style>
