<template props="returnAction,hqAction,barracksAction,armoryAction,mechLabAction,boatsAction,hqClasses,barracksClasses,armoryClasses,mechLabClasses,boatsClasses,contextLabel">
  <div id="marine-ops-page-nav" class="panel surface-dark">
    <img id="marine-ops-console-lock" src="graphics/ui/console/locking-plate.svg" />
    <div id="marine-ops-page-routes">
      <button id="page-nav-return" onclick="{returnAction}">
        <div id="page-nav-return-lamp" class="console-toggle-lamp" />
        <div id="page-nav-return-legend" class="console-key-legend">RETURN</div>
      </button>
      <button id="page-nav-hq" class="{hqClasses}" onclick="{hqAction}">
        <div id="page-nav-hq-lamp" class="console-toggle-lamp" />
        <div id="page-nav-hq-legend" class="console-key-legend">HQ</div>
      </button>
      <button id="page-nav-barracks" class="{barracksClasses}" onclick="{barracksAction}">
        <div id="page-nav-barracks-lamp" class="console-toggle-lamp" />
        <div id="page-nav-barracks-legend" class="console-key-legend">BARRACKS</div>
      </button>
      <button id="page-nav-armory" class="{armoryClasses}" onclick="{armoryAction}">
        <div id="page-nav-armory-lamp" class="console-toggle-lamp" />
        <div id="page-nav-armory-legend" class="console-key-legend">ARMORY</div>
      </button>
      <button id="page-nav-mech-lab" class="{mechLabClasses}" onclick="{mechLabAction}">
        <div id="page-nav-mech-lab-lamp" class="console-toggle-lamp" />
        <div id="page-nav-mech-lab-legend" class="console-key-legend">MECH LAB</div>
      </button>
      <button id="page-nav-boats" class="{boatsClasses}" onclick="{boatsAction}">
        <div id="page-nav-boats-lamp" class="console-toggle-lamp" />
        <div id="page-nav-boats-legend" class="console-key-legend">BOATS</div>
      </button>
    </div>
    <div id="marine-ops-page-context" class="label heading tone-edge">{contextLabel}</div>
    <img id="marine-ops-console-vent" src="graphics/ui/console/vent-plate.svg" />
  </div>
</template>

<style>
  #marine-ops-page-nav {
    flex-direction: row;
    height: 34px;
    padding: 4px;
    gap: 8px;
    border-width: 2px;
  }

  #marine-ops-console-lock { width: 34px; height: 34px; pointer-events: none; }
  #marine-ops-console-vent { width: 78px; height: 34px; pointer-events: none; }
  #marine-ops-page-routes { flex-direction: row; width: 740px; gap: 6px; }
  #marine-ops-page-routes button {
    flex-direction: row;
    align-items: center;
    gap: 5px;
    width: 0px;
    flex-grow: 1;
    padding: 3px 8px;
    border-width: 2px;
    overflow: hidden;
    font-family: heading;
    text-align: center;
  }

  #marine-ops-page-routes .page-nav-current {
    background-color: #183b50;
    border-color: #ffd464;
    color: #ffd464;
    opacity: 1;
  }

  #marine-ops-page-routes .page-nav-current:hover {
    background-color: #21536f;
    border-color: #ffe6a3;
  }

  /* A room the ship does not have. The button stays so the player can see the
     berth the hull lacks, rather than wondering where a page went. */
  #marine-ops-page-routes .page-nav-absent {
    background-color: #12181c;
    border-color: #2b3238;
    color: #55626b;
    opacity: 0.55;
  }

  #marine-ops-page-routes .page-nav-absent:hover {
    background-color: #12181c;
    border-color: #2b3238;
    color: #55626b;
  }

  /* A room aboard a ship still being laid out. Told apart from one she does not
     have, because a hull that cannot hold a bay never will and this is a wait
     of a second or two. */
  #marine-ops-page-routes .page-nav-waiting {
    background-color: #101a22;
    border-color: #2d4250;
    color: #6f8797;
    opacity: 0.8;
  }

  #marine-ops-page-routes .page-nav-waiting:hover {
    background-color: #101a22;
    border-color: #2d4250;
    color: #6f8797;
  }

  #marine-ops-page-context {
    width: 0px;
    flex-grow: 1;
    padding: 5px 7px;
    text-align: right;
    border-width: 2px;
  }
  #page-nav-return-lamp { width: 0px; border-width: 0px; }
</style>
