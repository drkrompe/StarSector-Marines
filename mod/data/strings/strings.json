    "gearArmMount": "Arm mount",
    "gearArmorClassPOWERSUIT": "Power suit",
    "gearArmorClassSTANDARD": "Regular infantry",
    "gearArmorRoleASSAULT": "Assault",
    "gearArmorRoleLINE": "Line",
    "gearArmorRoleRECON": "Recon",
