    "openingRefitTierREC_LOUNGEIMPROVED_I": "Rec centre",
    "openingRefitEffectREC_LOUNGEIMPROVED_I": "No replacement arrives Limited, and three in ten arrive Gifted (two in ten without).",
    "openingRefitTierREC_LOUNGEIMPROVED_II": "Shore-leave deck",
