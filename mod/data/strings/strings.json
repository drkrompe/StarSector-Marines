    "gearCatalogWeaponDroneIonDisplayName": "Drone Ion Sting",
    "gearCatalogWeaponDroneIonRole": "DRONE",
    "gearCatalogWeaponDroneIonDescription": "A light ion emitter carried by Tri-Tachyon's sensor and point-defence drones. It stings rather than kills; the drone's real work is seeing and stopping rounds.",
    "gearCatalogWeaponDronePdLaserDisplayName": "Halo PD Laser",
